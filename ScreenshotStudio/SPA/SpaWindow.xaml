<windows:PanelWindow
	x:Class="ScreenshotStudio.SPA.SpaWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:background="clr-namespace:ScreenshotStudio.Studio.Background"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.SPA"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:save="clr-namespace:ScreenshotStudio.Save"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Spa_Title}"
	Width="900"
	Height="536"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	IsEmbedded="False"
	mc:Ignorable="d">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Border
			Grid.RowSpan="2"
			Grid.Column="0"
			Style="{DynamicResource WpfUtilsControlBorder}" />

		<Border
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Style="{DynamicResource WpfUtilsControlBorder}" />

		<StackPanel
			x:Name="Navigation"
			Grid.Row="1"
			Grid.Column="0">

			<StackPanel.OpacityMask>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="White" />
					<GradientStop x:Name="WipeA" Offset="1" Color="White" />
					<GradientStop x:Name="WipeB" Offset="1.1" Color="Transparent" />
				</LinearGradientBrush>
			</StackPanel.OpacityMask>

			<StackPanel.Resources>
				<Style
					BasedOn="{StaticResource WpfUtilsToggleButton}"
					TargetType="{x:Type ToggleButton}">
					<Setter Property="Width" Value="32" />
					<Setter Property="Height" Value="32" />
					<Setter Property="Margin" Value="0" />
				</Style>

				<Style TargetType="{x:Type Line}">
					<Setter Property="Width" Value="24" />
					<Setter Property="Margin" Value="0,3" />
					<Setter Property="Stroke" Value="{DynamicResource BackgroundLightBrush}" />
					<Setter Property="X1" Value="0" />
					<Setter Property="X2" Value="1" />
					<Setter Property="StrokeThickness" Value="1" />
					<Setter Property="Stretch" Value="Fill" />
				</Style>
			</StackPanel.Resources>

			<ToggleButton
				Width="32"
				Height="32"
				Content="{DynamicResource GroupPoseIcon}"
				IsChecked="{Binding IsInGPose}"
				ToolTip="{DynamicResource LOC_ToggleGPose}" />

			<Line />

			<ToggleButton
				IsChecked="{Binding IsLibraryOpen}"
				ToolTip="{DynamicResource LOC_Library}">
				<wpfUtils:IconBlock Icon="Book" />
			</ToggleButton>

			<ToggleButton
				IsChecked="{Binding IsSettingsOpen}"
				ToolTip="{DynamicResource LOC_Settings}">
				<wpfUtils:IconBlock Icon="cogs" />
			</ToggleButton>

			<Line />

			<ToggleButton
				IsChecked="{Binding IsHomeOpen}"
				ToolTip="{DynamicResource LOC_Spa_Home}">
				<wpfUtils:IconBlock Icon="House" />
			</ToggleButton>

			<ToggleButton
				IsChecked="{Binding IsCharacterOpen}"
				ToolTip="{DynamicResource LOC_Spa_Character}">
				<wpfUtils:IconBlock Icon="UserEdit" />
			</ToggleButton>

			<ToggleButton
				IsChecked="{Binding IsPoseOpen}"
				ToolTip="{DynamicResource LOC_Pose}">
				<wpfUtils:IconBlock Icon="Running" />
			</ToggleButton>


			<ToggleButton
				IsChecked="{Binding IsPhotoOpen}"
				ToolTip="{DynamicResource LOC_Photo}">
				<wpfUtils:IconBlock Icon="Image" />
			</ToggleButton>

			<Line />

			<ToggleButton
				IsChecked="{Binding IsSaveOpen}"
				ToolTip="{DynamicResource LOC_Save}">
				<save:SaveIconControl />

			</ToggleButton>
		</StackPanel>

		<background:Targets
			Grid.Row="0"
			Grid.Column="1"
			HorizontalAlignment="Stretch"
			ShowBackground="False" />

		<Grid
			Grid.Row="1"
			Grid.Column="1"
			Background="{DynamicResource ControlBackgroundBrush}">

			<Border
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="3,0,0,0" />
		</Grid>

	</Grid>
</windows:PanelWindow>
