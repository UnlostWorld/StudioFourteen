<panels:PanelWindow
	x:Class="ScreenshotStudio.SPA.SpaWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:ScreenshotStudio.Appearance"
	xmlns:background="clr-namespace:ScreenshotStudio.Studio.Background"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:local="clr-namespace:ScreenshotStudio.SPA"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:ScreenshotStudio.Panels"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:save="clr-namespace:ScreenshotStudio.Save"
	xmlns:settings="clr-namespace:ScreenshotStudio.Settings"
	xmlns:studio="clr-namespace:ScreenshotStudio.Studio"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Spa_Title}"
	Width="900"
	Height="536"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	IsEmbedded="False"
	mc:Ignorable="d">

	<Grid Margin="1">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Border
			CornerRadius="6,6,6,0"
			Style="{DynamicResource WpfUtilsControlBorder}" />

		<background:Targets
			Grid.Row="0"
			Grid.Column="1"
			HorizontalAlignment="Stretch"
			ShowBackground="False" />

		<Grid
			Grid.Row="1"
			Grid.Column="1"
			Margin="0,0,2,20"
			Background="{DynamicResource ControlBackgroundBrush}">

			<Border
				Margin="41,0,0,0"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="3,0,0,0" />
		</Grid>

		<TabControl
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="0"
			Padding="0"
			VerticalContentAlignment="Top"
			Style="{DynamicResource WpfUtilsSideTabs}">

			<!--  Library  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Book" />
				</TabItem.Header>

				<panels:PanelHost
					Margin="1,1,0,0"
					PanelType="{x:Type library:LibraryWindow}" />

			</TabItem>

			<!--  Environment  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Home" />
				</TabItem.Header>
			</TabItem>

			<!--  Character  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="UserEdit" />
				</TabItem.Header>

				<panels:PanelHost
					Margin="2,1,0,0"
					PanelType="{x:Type appearance:CharacterPanel}" />
			</TabItem>

			<!--  Pose  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Running" />
				</TabItem.Header>

				<panels:PanelHost
					Margin="2,1,0,0"
					PanelType="{x:Type pose:PoseWindow}" />
			</TabItem>

			<!--  Screenshot  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Image" />
				</TabItem.Header>

				<panels:PanelHost
					Grid.Column="1"
					Margin="2,1,0,0"
					PanelType="{x:Type studio:PhotoWindow}" />
			</TabItem>

			<!--  Save  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Save"
						IconFont="Solid" />
				</TabItem.Header>

				<panels:PanelHost
					Grid.Column="1"
					Margin="2,1,0,0"
					PanelType="{x:Type save:SaveWindow}" />
			</TabItem>

			<!--  Settings  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Gears" />
				</TabItem.Header>

				<panels:PanelHost
					Grid.Column="1"
					Margin="2,1,0,0"
					PanelType="{x:Type settings:SettingsPanel}" />
			</TabItem>
		</TabControl>

	</Grid>
</panels:PanelWindow>
