<UserControl
	x:Class="ScreenshotStudio.Tags.TagSelector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Tags"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	MinWidth="100"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<converters:StringHasContentToBoolConverter x:Key="StringHasContentToBool" />
		<BooleanToVisibilityConverter x:Key="B2V" />
		<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
		<converters:MultiBoolOrConverter x:Key="MultiBoolOr" />
		<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		<converters:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />
		<converters:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
		<converters:NumberToThicknessLeftConverter x:Key="ThicknessLeft" />

		<DataTemplate DataType="{x:Type local:Tag}">
			<Grid>
				<TextBlock
					Grid.Column="1"
					Margin="3,0,6,0"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>

		<ControlTemplate
			x:Key="TagItem"
			TargetType="{x:Type ListBoxItem}">

			<Grid
				Height="20"
				Margin="2,3"
				Cursor="Hand"
				MouseDown="OnTagMouseDown"
				MouseUp="OnTagMouseUp">

				<Border
					Background="{DynamicResource BackgroundLightBrush}"
					CornerRadius="10,4,4,10"
					Opacity="0.5" />

				<Border
					x:Name="HoverBorder"
					Background="{DynamicResource ControlHighlightBrush}"
					CornerRadius="10,4,4,10"
					Opacity="0" />

				<Border
					x:Name="SelectedBorder"
					BorderBrush="{DynamicResource ForegroundLightBrush}"
					BorderThickness="1"
					CornerRadius="10,4,4,10"
					Opacity="0" />

				<Ellipse
					Width="10"
					Height="10"
					Margin="4"
					HorizontalAlignment="Left"
					Fill="{DynamicResource ControlBackgroundBrush}" />

				<ContentPresenter
					Margin="14,2,2,2"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</Grid>

			<ControlTemplate.Triggers>

				<Trigger Property="IsSelected" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="SelectedBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="SelectedBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.ExitActions>
				</Trigger>

				<Trigger Property="IsMouseOver" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>

							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.ExitActions>
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

	</UserControl.Resources>


	<Grid>
		<Grid x:Name="ContentArea">
			<TextBox
				x:Name="SearchTextBox"
				Grid.Row="0"
				Height="30"
				Padding="{Binding ActualWidth, ElementName=FilterTagsControl, Converter={StaticResource ThicknessLeft}, ConverterParameter='6,0,23,0'}"
				VerticalContentAlignment="Center"
				GotKeyboardFocus="OnTagSearchGotKeyboardFocus"
				LostKeyboardFocus="OnTagSearchLostKeyboardFocus"
				PreviewKeyDown="OnTagSearchPreviewKeyDown"
				Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

			<ListBox
				x:Name="FilterTagsControl"
				Margin="4,1"
				HorizontalAlignment="Left"
				Background="Transparent"
				ItemsSource="{Binding SelectedTags}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							IsItemsHost="True"
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemContainerStyle>
					<Style TargetType="{x:Type ListBoxItem}">
						<Setter Property="Template" Value="{StaticResource TagItem}" />
					</Style>
				</ListBox.ItemContainerStyle>
			</ListBox>

			<wpfUtils:IconBlock
				Margin="0,0,6,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				FontSize="14"
				Foreground="{DynamicResource BackgroundLightBrush}"
				Icon="Search"
				Visibility="{Binding ElementName=SearchTextBox, Path=IsKeyboardFocused, Converter={StaticResource !B2V}}" />

			<Button
				Margin="0,0,2,0"
				HorizontalAlignment="Right"
				Background="Transparent"
				Click="OnShowTagsClicked"
				Focusable="False"
				Visibility="{Binding ElementName=SearchTextBox, Path=IsKeyboardFocused, Converter={StaticResource B2V}}">
				<wpfUtils:IconBlock
					FontSize="14"
					Icon="Tag" />
			</Button>
		</Grid>

		<Popup
			Width="{Binding ActualWidth, ElementName=ContentArea}"
			MaxHeight="250"
			AllowsTransparency="True"
			HorizontalOffset="-6"
			IsOpen="{Binding DataContext.IsSuggestTags, ElementName=ContentArea}"
			PlacementTarget="{Binding ElementName=ContentArea}"
			StaysOpen="False">

			<Grid
				Margin="6"
				DataContext="{Binding DataContext, ElementName=ContentArea, Mode=OneWay}">

				<Border
					x:Name="PanelShadow"
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					x:Name="PanelBackground"
					Background="{DynamicResource BackgroundBrush}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<ListBox
					Margin="3"
					Focusable="False"
					ItemsSource="{Binding SuggestTags}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					SelectedValue="{Binding SelectedSuggestTag}">

					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel IsItemsHost="True" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>

					<ListBox.ItemContainerStyle>
						<Style TargetType="{x:Type ListBoxItem}">
							<Setter Property="Template" Value="{StaticResource TagItem}" />
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>
			</Grid>
		</Popup>
	</Grid>

</UserControl>
