<UserControl
	x:Class="ScreenshotStudio.Tags.TagFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:XivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:converters="clr-namespace:XivToolsWpf.Converters;assembly=XivToolsWpf"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Tags"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	Loaded="OnLoaded"
	mc:Ignorable="d">

	<UserControl.Resources>
		<converters:StringHasContentToBoolConverter x:Key="StringHasContentToBool" />
		<BooleanToVisibilityConverter x:Key="B2V" />
		<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
		<converters:MultiBoolOrConverter x:Key="MultiBoolOr" />
		<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		<converters:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />
		<converters:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
		<converters:NumberToThicknessLeftConverter x:Key="ThicknessLeft" />

		<DataTemplate DataType="{x:Type local:Tag}">
			<Grid>
				<TextBlock
					Grid.Column="1"
					Margin="3,0,6,0"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>

		<!--  Tag animations  -->
		<Storyboard x:Key="AddRemoveIconAreaIn">
			<DoubleAnimation
				Storyboard.TargetName="AddRemoveIconArea"
				Storyboard.TargetProperty="Opacity"
				To="1"
				Duration="0:00:00.150">
				<DoubleAnimation.EasingFunction>
					<SineEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>

		<Storyboard x:Key="AddRemoveIconAreaOut">
			<DoubleAnimation
				Storyboard.TargetName="AddRemoveIconArea"
				Storyboard.TargetProperty="Opacity"
				To="0"
				Duration="0:00:00.250">
				<DoubleAnimation.EasingFunction>
					<SineEase EasingMode="EaseIn" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>

		<!--  Suggested tags (appear as the user types)  -->
		<ControlTemplate
			x:Key="SuggestedTagListboxItem"
			TargetType="{x:Type ListBoxItem}">

			<Grid
				Height="20"
				Margin="1,2"
				Cursor="Hand"
				MouseDown="OnAddTagMouseDown"
				MouseUp="OnAddTagMouseUp">

				<Border
					Background="{DynamicResource BackgroundLightBrush}"
					CornerRadius="10"
					Opacity="0.5" />

				<Border
					x:Name="HoverBorder"
					Background="{DynamicResource ControlHighlightBrush}"
					CornerRadius="10"
					Opacity="0" />

				<Border
					x:Name="SelectedBorder"
					BorderBrush="{DynamicResource ForegroundLightBrush}"
					BorderThickness="1"
					CornerRadius="10"
					Opacity="0" />

				<Ellipse
					Width="10"
					Height="10"
					Margin="4"
					HorizontalAlignment="Left"
					Fill="{DynamicResource ControlBackgroundBrush}" />

				<Grid
					x:Name="AddRemoveIconArea"
					Width="14"
					Height="14"
					Margin="3,1,3,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Opacity="0">

					<XivToolsWpf:IconBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="14"
						Foreground="{DynamicResource ControlHighlightBrush}"
						Icon="PlusCircle" />
				</Grid>

				<ContentPresenter
					Margin="14,2,2,2"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</Grid>

			<ControlTemplate.Triggers>

				<Trigger Property="IsSelected" Value="True">
					<Trigger.EnterActions>
						<StopStoryboard BeginStoryboardName="BeginIconOut" />
						<StopStoryboard BeginStoryboardName="BeginSelectIconOut" />
						<BeginStoryboard
							x:Name="BeginSelectIconIn"
							Storyboard="{StaticResource AddRemoveIconAreaIn}" />
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="SelectedBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<StopStoryboard BeginStoryboardName="BeginIconIn" />
						<StopStoryboard BeginStoryboardName="BeginSelectIconIn" />
						<BeginStoryboard
							x:Name="BeginSelectIconOut"
							Storyboard="{StaticResource AddRemoveIconAreaOut}" />
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="SelectedBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.ExitActions>
				</Trigger>

				<MultiTrigger>
					<MultiTrigger.Conditions>
						<Condition Property="IsSelected" Value="False" />
						<Condition Property="IsMouseOver" Value="True" />
					</MultiTrigger.Conditions>

					<MultiTrigger.EnterActions>
						<StopStoryboard BeginStoryboardName="BeginIconOut" />
						<StopStoryboard BeginStoryboardName="BeginSelectIconOut" />
						<BeginStoryboard
							x:Name="BeginIconIn"
							Storyboard="{StaticResource AddRemoveIconAreaIn}" />
					</MultiTrigger.EnterActions>
					<MultiTrigger.ExitActions>
						<StopStoryboard BeginStoryboardName="BeginIconIn" />
						<StopStoryboard BeginStoryboardName="BeginSelectIconIn" />
						<BeginStoryboard
							x:Name="BeginIconOut"
							Storyboard="{StaticResource AddRemoveIconAreaOut}" />
					</MultiTrigger.ExitActions>
				</MultiTrigger>

				<Trigger Property="IsMouseOver" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>

							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.ExitActions>
				</Trigger>


			</ControlTemplate.Triggers>

		</ControlTemplate>

		<!--  Selected tags (within search box)  -->
		<ControlTemplate
			x:Key="SelectedTagListboxItem"
			TargetType="{x:Type ListBoxItem}">

			<Grid
				Height="20"
				Margin="1"
				Cursor="Hand"
				MouseDown="OnRemoveTagMouseDown"
				MouseUp="OnRemoveTagMouseUp">

				<Grid.LayoutTransform>
					<ScaleTransform x:Name="ScaleTransform" ScaleX="1" />
				</Grid.LayoutTransform>

				<Border
					Background="{DynamicResource BackgroundLightBrush}"
					CornerRadius="10"
					Opacity="0.5" />

				<Border
					x:Name="HoverBorder"
					Background="{DynamicResource ControlHighlightBrush}"
					CornerRadius="10"
					Opacity="0" />

				<Ellipse
					Width="10"
					Height="10"
					Margin="4"
					HorizontalAlignment="Left"
					Fill="{DynamicResource ControlBackgroundBrush}" />

				<Grid
					x:Name="AddRemoveIconArea"
					Width="14"
					Height="14"
					Margin="1,1,3,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Opacity="0">

					<XivToolsWpf:IconBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="14"
						Foreground="{DynamicResource ControlHighlightBrush}"
						Icon="MinusCircle" />
				</Grid>

				<ContentPresenter
					Margin="14,0,2,2"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</Grid>

			<ControlTemplate.Triggers>

				<Trigger Property="IsEnabled" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="ScaleTransform"
									Storyboard.TargetProperty="ScaleX"
									From="0"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
				</Trigger>

				<Trigger Property="IsMouseOver" Value="True">
					<Trigger.EnterActions>
						<StopStoryboard BeginStoryboardName="BeginIconOut" />
						<BeginStoryboard
							x:Name="BeginIconIn"
							Storyboard="{StaticResource AddRemoveIconAreaIn}" />
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<StopStoryboard BeginStoryboardName="BeginIconIn" />
						<BeginStoryboard
							x:Name="BeginIconOut"
							Storyboard="{StaticResource AddRemoveIconAreaOut}" />
					</Trigger.ExitActions>
				</Trigger>

				<Trigger Property="IsMouseOver" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.150">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="HoverBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</Trigger.ExitActions>
				</Trigger>


			</ControlTemplate.Triggers>

		</ControlTemplate>
	</UserControl.Resources>

	<Grid x:Name="ContentArea">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<TextBox
				x:Name="SearchTextBox"
				Grid.Row="0"
				Height="30"
				Padding="{Binding ActualWidth, ElementName=FilterTagsControl, Converter={StaticResource ThicknessLeft}, ConverterParameter='6,0,23,0'}"
				VerticalContentAlignment="Center"
				GotKeyboardFocus="OnTagSearchGotKeyboardFocus"
				LostKeyboardFocus="OnTagSearchLostKeyboardFocus"
				PreviewKeyDown="OnTagSearchPreviewKeyDown"
				Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

			<ListBox
				x:Name="FilterTagsControl"
				Margin="4,1"
				HorizontalAlignment="Left"
				Background="Transparent"
				ItemsSource="{Binding SelectedTags}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							IsItemsHost="True"
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemContainerStyle>
					<Style TargetType="{x:Type ListBoxItem}">
						<Setter Property="Template" Value="{StaticResource SelectedTagListboxItem}" />
					</Style>
				</ListBox.ItemContainerStyle>
			</ListBox>

			<XivToolsWpf:IconBlock
				Margin="0,0,6,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				FontSize="14"
				Foreground="{DynamicResource BackgroundLightBrush}"
				Icon="Search" />
		</Grid>


		<Grid
			Grid.Row="1"
			Height="0"
			Margin="0,1,0,0">

			<Grid.Style>
				<Style>
					<Style.Triggers>
						<DataTrigger
							Binding="{Binding SuggestTags.Count}"
							Value="0">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Height"
											To="0"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Height"
											To="80"
											Duration="0:00:00.150">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>

			<Grid Height="79">

				<Border Style="{DynamicResource XivToolsControlBorder}" />

				<ListBox
					Margin="2,1"
					Focusable="False"
					ItemsSource="{Binding SuggestTags}"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					SelectedValue="{Binding SelectedSuggestTag}">

					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel IsItemsHost="True" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>

					<ListBox.ItemContainerStyle>
						<Style TargetType="{x:Type ListBoxItem}">
							<Setter Property="Template" Value="{StaticResource SuggestedTagListboxItem}" />
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>

				<Grid
					Margin="0,0,3,3"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Visibility="{Binding AvailableTagsExtra, Converter={StaticResource NotZeroToVisibility}}">

					<Rectangle
						Margin="-6,-3,-3,-3"
						Fill="{DynamicResource ControlBackgroundBrush}">
						<Rectangle.Effect>
							<BlurEffect Radius="10" />
						</Rectangle.Effect>
					</Rectangle>

					<StackPanel
						Margin="2"
						Orientation="Horizontal">
						<TextBlock
							Margin="0"
							Style="{DynamicResource Label}"
							Text="+" />
						<TextBlock
							Margin="0"
							Style="{DynamicResource Label}"
							Text="{Binding AvailableTagsExtra}" />
					</StackPanel>
				</Grid>

			</Grid>
		</Grid>
	</Grid>
</UserControl>
