<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel">

	<DataTemplate DataType="{x:Type excel:Item}">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Grid
				Grid.Column="0"
				Width="64"
				Height="64">

				<Image
					Margin="4,3,4,5"
					SnapsToDevicePixels="True"
					Source="{Binding Icon.Source}" />

				<controls:XivTexImage
					x:Name="IconShine"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 0, 96, 96"
					SnapsToDevicePixels="True" />
			</Grid>

			<StackPanel Grid.Column="1">

				<TextBlock
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Name}" />

				<TextBlock
					Grid.Row="1"
					Style="{DynamicResource Body}"
					Text="{Binding Description}" />

				<TextBlock
					Grid.Row="2"
					Style="{DynamicResource Body}"
					Text="{Binding EquipLevel}" />
			</StackPanel>
		</Grid>




	</DataTemplate>

</ResourceDictionary>