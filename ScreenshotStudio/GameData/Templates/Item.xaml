<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel">

	<DataTemplate DataType="{x:Type excel:Item}">
		<Grid Margin="0,-3,0,3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.ColumnSpan="2"
				MinWidth="200"
				Style="{DynamicResource Header}"
				Text="{Binding Name}" />

			<Grid
				Grid.Row="1"
				Grid.RowSpan="4"
				Grid.Column="0"
				Width="72"
				Height="72"
				Margin="-3,0,3,-3">

				<Image
					Margin="6,4,6,7"
					SnapsToDevicePixels="True"
					Source="{Binding Icon.Source}" />

				<controls:XivTexImage
					x:Name="IconShine"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 0, 96, 96"
					SnapsToDevicePixels="True" />
			</Grid>

			<TextBlock
				Grid.Row="1"
				Grid.Column="1"
				Margin="0,2,0,0"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding Description}" />

			<TextBlock
				Grid.Row="2"
				Grid.Column="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding ClassJobs.Name}" />

			<TextBlock
				Grid.Row="3"
				Grid.Column="1"
				Foreground="{DynamicResource ForegroundLightBrush}">
				<Run Text="Lv." />
				<Run Text="{Binding EquipLevel, Mode=OneWay}" />
			</TextBlock>

			<TextBlock
				Grid.Row="4"
				Grid.Column="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding UICategory.Name}" />

		</Grid>
	</DataTemplate>

</ResourceDictionary>