<ResourceDictionary
	x:Class="ScreenshotStudio.Windows.PanelResources"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:XivToolsWpf.Converters;assembly=XivToolsWpf"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf">

	<ControlTemplate
		x:Key="PanelTemplate"
		TargetType="{x:Type local:Panel}">

		<Grid Margin="12">

			<Border
				Background="Black"
				CornerRadius="6"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect
						ShadowDepth="0"
						Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				Background="{DynamicResource BackgroundBrush}"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="6" />

			<ContentPresenter
				Grid.Row="1"
				Margin="12"
				Content="{TemplateBinding Content}"
				ContentTemplate="{TemplateBinding ContentTemplate}" />

		</Grid>
	</ControlTemplate>

	<Style
		x:Key="PanelStyle"
		TargetType="{x:Type local:Panel}">
		<Setter Property="MinWidth" Value="128" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="AllowsTransparency" Value="True" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ResizeMode" Value="CanResizeWithGrip" />
		<Setter Property="WindowStyle" Value="None" />
		<Setter Property="Template" Value="{StaticResource PanelTemplate}" />
	</Style>

	<Style
		BasedOn="{StaticResource PanelStyle}"
		TargetType="{x:Type local:Panel}" />

</ResourceDictionary>