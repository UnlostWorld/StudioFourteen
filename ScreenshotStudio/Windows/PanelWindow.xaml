<ResourceDictionary
	x:Class="ScreenshotStudio.Windows.PanelWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:XivToolsWpf.Converters;assembly=XivToolsWpf"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />

	<ControlTemplate
		x:Key="PanelWindowTemplate"
		TargetType="{x:Type local:PanelWindowBase}">

		<Grid Margin="12">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Border
				x:Name="WindowShadow"
				Grid.RowSpan="2"
				Background="Black"
				CornerRadius="6"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect
						ShadowDepth="0"
						Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBorder"
				Grid.RowSpan="2"
				Background="{DynamicResource BackgroundBrush}"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="6" />

			<Grid
				Grid.Row="0"
				Height="22"
				Margin="0,0,0,3">

				<Border
					Margin="1,1,1,-1"
					Background="{DynamicResource ControlBackgroundBrush}"
					CornerRadius="6,6,0,0"
					MouseDown="OnTitleMouseDown" />

				<StackPanel
					Margin="6,0"
					IsHitTestVisible="False"
					Orientation="Horizontal">

					<xivToolsWpf:IconBlock
						Width="12"
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{TemplateBinding TitleIcon}" />

					<TextBlock
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Text="{TemplateBinding Title}" />
				</StackPanel>

				<StackPanel
					HorizontalAlignment="Right"
					Orientation="Horizontal">

					<Button
						Width="22"
						Height="22"
						Background="Transparent"
						Style="{DynamicResource TransparentIconButton}"
						Visibility="{Binding CanManualyClose, Converter={StaticResource B2V}}">
						<xivToolsWpf:IconBlock
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="Times" />
					</Button>

				</StackPanel>
			</Grid>

			<ContentPresenter
				Grid.Row="1"
				Margin="12"
				Content="{TemplateBinding Content}"
				ContentTemplate="{TemplateBinding ContentTemplate}" />


		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsActive" Value="True">
				<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
			</Trigger>
		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="PanelWindowBaseStyle"
		TargetType="{x:Type local:PanelWindowBase}">
		<Setter Property="MinWidth" Value="128" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="AllowsTransparency" Value="True" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ResizeMode" Value="CanResizeWithGrip" />
		<Setter Property="WindowStyle" Value="None" />
		<Setter Property="Template" Value="{StaticResource PanelWindowTemplate}" />
	</Style>

	<Style
		BasedOn="{StaticResource PanelWindowBaseStyle}"
		TargetType="{x:Type local:PanelWindowBase}" />

</ResourceDictionary>