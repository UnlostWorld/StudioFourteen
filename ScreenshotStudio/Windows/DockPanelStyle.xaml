<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="PanelStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style
		x:Key="DockPanelStyle"
		BasedOn="{StaticResource PanelStyle}"
		TargetType="{x:Type local:DockPanel}">
		<Setter Property="Width" Value="9999" />
		<Setter Property="Height" Value="9999" />
		<Setter Property="MaxWidth" Value="1920" />
		<Setter Property="MaxHeight" Value="1080" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />

	</Style>
</ResourceDictionary>