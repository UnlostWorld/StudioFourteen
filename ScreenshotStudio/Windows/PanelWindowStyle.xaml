<ResourceDictionary
	x:Class="ScreenshotStudio.Windows.PanelWindowResources"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ControlTemplate
		x:Key="PanelWindowTemplate"
		TargetType="{x:Type local:PanelWindow}">

		<AdornerDecorator>

			<Grid Margin="12">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Border
					x:Name="WindowShadow"
					Grid.RowSpan="2"
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					x:Name="WindowBorder"
					Grid.RowSpan="2"
					Background="{DynamicResource BackgroundBrush}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<Grid
					Grid.Row="0"
					Height="22"
					Margin="0,0,0,3">

					<Border
						Margin="1,1,1,-1"
						Background="{DynamicResource ControlBackgroundBrush}"
						CornerRadius="6,6,0,0"
						MouseDown="OnTitleMouseDown" />

					<StackPanel
						Margin="6,0"
						IsHitTestVisible="False"
						Orientation="Horizontal">

						<wpfUtils:IconBlock
							MinWidth="12"
							Margin="0,1,6,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="{TemplateBinding TitleIcon}" />

						<TextBlock
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{TemplateBinding Title}" />

						<Ellipse
							x:Name="SubtitleSeperator"
							Width="4"
							Height="4"
							Margin="6,1,6,0"
							VerticalAlignment="Center"
							Fill="{DynamicResource ForegroundLightBrush}" />

						<TextBlock
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{TemplateBinding Subtitle}" />
					</StackPanel>

					<StackPanel
						Grid.Row="0"
						Margin="1"
						HorizontalAlignment="Right"
						Orientation="Horizontal">

						<ItemsControl ItemsSource="{TemplateBinding Actions}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:PanelWindowAction}">
									<Button
										Width="28"
										Height="22"
										Margin="-3,0,0,0"
										Background="Transparent"
										Command="{Binding Command}"
										ToolTip="{Binding ToolTip}">
										<wpfUtils:IconBlock
											Foreground="{DynamicResource ForegroundLightBrush}"
											Icon="{Binding Icon}" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>

						</ItemsControl>

						<!--  Close Button  -->
						<Button
							Width="26"
							Height="Auto"
							Margin="-3,2,2,0"
							Background="Transparent"
							Click="OnCloseClicked"
							IsEnabled="{TemplateBinding CanClose}"
							ToolTip="{DynamicResource ClosePanelTooltip}">
							<wpfUtils:IconBlock
								Foreground="{DynamicResource ForegroundLightBrush}"
								Icon="Times" />
						</Button>

					</StackPanel>

				</Grid>

				<ContentPresenter
					Grid.Row="1"
					Margin="3,0,3,3"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />

				<Thumb
					x:Name="ResizeGrip"
					Grid.Row="1"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					DragDelta="OnResizeThumbDragDelta"
					Style="{DynamicResource WpfUtilsResizeThumbCorner}"
					Visibility="Collapsed" />
			</Grid>
		</AdornerDecorator>

		<ControlTemplate.Triggers>
			<Trigger Property="ResizeMode" Value="CanResizeWithGrip">
				<Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible" />
			</Trigger>

			<Trigger Property="IsActive" Value="True">
				<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
			</Trigger>
			<Trigger Property="Subtitle" Value="{x:Null}">
				<Setter TargetName="SubtitleSeperator" Property="Visibility" Value="Collapsed" />
			</Trigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding IsShown}" Value="True" />
					<Condition Binding="{Binding IsUiVisible}" Value="True" />
				</MultiDataTrigger.Conditions>

				<MultiDataTrigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.100">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</MultiDataTrigger.EnterActions>

				<MultiDataTrigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.200">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</MultiDataTrigger.ExitActions>
			</MultiDataTrigger>
		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="PanelWindowStyle"
		TargetType="{x:Type local:PanelWindow}">
		<Setter Property="MinWidth" Value="128" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="AllowsTransparency" Value="True" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ResizeMode" Value="CanResizeWithGrip" />
		<Setter Property="WindowStyle" Value="None" />
		<Setter Property="Template" Value="{StaticResource PanelWindowTemplate}" />
		<Setter Property="UseLayoutRounding" Value="True" />
	</Style>

</ResourceDictionary>