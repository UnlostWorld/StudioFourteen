<windows:Panel
	x:Class="ScreenshotStudio.Save.ActorAssignmentWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ap="WpfUtils.AttachedProperties"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Save"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_ActorAssignment}"
	Width="300"
	MinHeight="100"
	MaxHeight="600"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	SizeToContent="Height"
	TitleIcon="UserTag"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<ContentPresenter
				Width="48"
				Height="48"
				Margin="3,6,3,3"
				VerticalAlignment="Top"
				Content="{Binding SceneType}"
				TextBlock.Foreground="{DynamicResource ForegroundBrush}">
				<ContentPresenter.Resources>
					<ResourceDictionary Source="../Library/LibraryIconTemplates.xaml" />
				</ContentPresenter.Resources>
			</ContentPresenter>

			<StackPanel
				Grid.Column="1"
				Margin="2">
				<TextBlock
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Title}" />
				<TextBlock
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Author}" />
				<TextBlock
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Version}" />
				<TextBlock
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Description}" />
			</StackPanel>
		</Grid>

		<ItemsControl
			Grid.Row="1"
			Margin="3"
			ItemsSource="{Binding Assignments, FallbackValue=1}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type local:Assignment}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>



						<Button
							Height="Auto"
							HorizontalContentAlignment="Stretch"
							Click="OnChooseAppearanceClicked">
							<Button.Content>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition />
									</Grid.RowDefinitions>

									<TextBlock
										Grid.Row="0"
										Grid.ColumnSpan="2"
										VerticalAlignment="Center"
										Style="{DynamicResource LeftLabel}"
										Text="{Binding Role}" />

									<ContentPresenter
										Grid.Row="1"
										Grid.Column="0"
										Height="48"
										Margin="0,6,6,12"
										VerticalAlignment="Top"
										Content="{Binding Appearance}"
										TextBlock.Foreground="{DynamicResource ForegroundBrush}">
										<ContentPresenter.Resources>
											<ResourceDictionary Source="../Library/LibraryIconTemplates.xaml" />
										</ContentPresenter.Resources>
									</ContentPresenter>

									<TextBlock
										Grid.Row="1"
										Grid.Column="1"
										Margin="2,0"
										Text="{Binding Appearance.Name}" />

								</Grid>
							</Button.Content>
						</Button>

					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border
			Grid.Row="2"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Button
					Width="100"
					HorizontalAlignment="Right"
					Click="OnConfirmClicked"
					Content="Confirm" />

				<Button
					Width="100"
					HorizontalAlignment="Left"
					Click="OnCancelClicked"
					Content="Cancel" />
			</Grid>
		</Border>
	</Grid>
</windows:Panel>
