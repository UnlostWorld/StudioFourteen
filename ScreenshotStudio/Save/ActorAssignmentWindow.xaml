<windows:PanelWindow
	x:Class="ScreenshotStudio.Save.ActorAssignmentWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ap="WpfUtils.AttachedProperties"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Save"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_ActorAssignment}"
	Width="300"
	Height="400"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	TitleIcon="UserTag"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ItemsControl ItemsSource="{Binding Assignments}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type local:Assignment}">
					<StackPanel>
						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="{Binding Role}" />

						<ComboBox />
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border
			Grid.Row="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Button
					Width="100"
					HorizontalAlignment="Right"
					Click="OnConfirmClicked"
					Content="Confirm" />

				<Button
					Width="100"
					HorizontalAlignment="Left"
					Click="OnCancelClicked"
					Content="Cancel" />
			</Grid>
		</Border>
	</Grid>
</windows:PanelWindow>
