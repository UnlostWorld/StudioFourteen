<windows:PanelWindow
	x:Class="ScreenshotStudio.Save.SaveWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ap="WpfUtils.AttachedProperties"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Save"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Save}"
	Width="500"
	Height="600"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="FloppyDisk"
	mc:Ignorable="d">

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="250" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Margin="0,0,0,12">

			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<ComboBox
				Grid.Row="0"
				ItemsSource="{Binding RecentDirectories}"
				SelectedItem="{Binding SelectedDirectory}">
				<ComboBox.Resources>
					<DataTemplate DataType="{x:Type local:RecentDirectoryViewModel}">
						<controls:PathDisplay File="{Binding Directory}" />
					</DataTemplate>

					<DataTemplate DataType="{x:Type local:AddDirectoryViewModel}">
						<TextBlock Text="{DynamicResource LOC_Save_BrowseDirectory}" />
					</DataTemplate>
				</ComboBox.Resources>
			</ComboBox>

			<wpfUtils:TextBoxEx
				x:Name="FileNameText"
				Grid.Row="1"
				Grid.ColumnSpan="2"
				Padding="22,0,0,0"
				Text="{Binding FileName}"
				TextWrapping="Wrap">
				<wpfUtils:TextBoxEx.Suffix>
					<TextBlock
						Margin="0"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Text=".studio" />
				</wpfUtils:TextBoxEx.Suffix>
			</wpfUtils:TextBoxEx>

		</Grid>

		<Border
			Grid.Row="1"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid Margin="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="75" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>


				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Author:" />

				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Text="Yuki" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Version:" />

				<TextBox
					Grid.Row="2"
					Grid.Column="1"
					Text="1.0" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Description:" />

				<TextBox
					Grid.Row="3"
					Grid.Column="1"
					Text="Lorem ipsum odor amet, consectetuer adipiscing elit. Conubia pretium dis consectetur sapien class finibus."
					TextAlignment="Left"
					TextWrapping="Wrap" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Tags:" />

				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					Text="Custom, Things" />

			</Grid>
		</Border>


		<ScrollViewer
			Grid.Row="1"
			Grid.Column="1">
			<StackPanel
				Grid.Row="0"
				Margin="2">

				<TextBlock
					Margin="2,2,0,0"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{DynamicResource LOC_Save_Environment}" />
				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeLocation}"
					IsChecked="{Binding Configuration.IncludeLocation}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeWeather}"
					IsChecked="{Binding Configuration.IncludeWeather}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeTimeOfDay}"
					IsChecked="{Binding Configuration.IncludeTimeOfDay}" />




				<TextBlock
					Margin="2,8,0,0"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="Components" />
				<CheckBox
					Margin="1,1,1,1"
					Content="{DynamicResource LOC_Save_IncludeAppearances}"
					IsChecked="{Binding Configuration.IncludeAppearances}"
					ToolTip="{DynamicResource LOC_Save_IncludeAppearancesToolTip}" />

				<CheckBox
					Margin="1,1,1,1"
					Content="{DynamicResource LOC_Save_IncludePoses}"
					IsChecked="{Binding Configuration.IncludePoses}"
					ToolTip="{DynamicResource LOC_Save_IncludePosesToolTip}" />


				<TextBlock
					Margin="2,8,0,0"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding CharactersText}" />

				<ItemsControl ItemsSource="{Binding Characters}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:CharacterViewModel}">

							<Border
								Margin="1"
								Style="{DynamicResource WpfUtilsControlBorder}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<CheckBox
										Grid.Column="0"
										Height="38"
										Margin="0"
										Background="Transparent"
										IsChecked="{Binding IncludeCharacter}"
										ToolTip="{Binding ToolTipText}">
										<Grid VerticalAlignment="Center">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<TextBlock
												Grid.Row="0"
												Margin="2,2,2,0"
												Text="{Binding Nickname}" />
											<TextBlock
												Grid.Row="1"
												Margin="2,0,2,4"
												Style="{DynamicResource Subscript}"
												Text="{Binding Name}" />

										</Grid>
									</CheckBox>

									<Button
										Grid.Column="1"
										Width="28"
										Height="Auto"
										Margin="0,1,1,1"
										VerticalAlignment="Stretch"
										Background="Transparent"
										ToolTip="{Binding ExportAppearanceToolTipText}">
										<wpfUtils:IconBlock Icon="UserShield" />
									</Button>

									<Button
										Grid.Column="2"
										Width="28"
										Height="Auto"
										Margin="0,1,1,1"
										VerticalAlignment="Stretch"
										Background="Transparent"
										ToolTip="{Binding ExportPoseToolTipText}">
										<wpfUtils:IconBlock Icon="Running" />
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="2"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					MinWidth="100"
					Click="OnSaveClicked"
					Content="{DynamicResource LOC_Save_SaveScene}"
					IsEnabled="{Binding CanSave}" />
			</StackPanel>
		</Border>

	</Grid>
</windows:PanelWindow>
