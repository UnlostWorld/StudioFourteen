<windows:Panel
	x:Class="ScreenshotStudio.Save.OpenWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ap="WpfUtils.AttachedProperties"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Save"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_OpenScene}"
	Width="500"
	Height="500"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	Subtitle="{Binding Scene.Title}"
	TitleIcon="Users"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="250" />
		</Grid.ColumnDefinitions>


		<Border
			Grid.Row="0"
			Grid.RowSpan="2"
			Grid.Column="0"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid Margin="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="75" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Viewbox Grid.ColumnSpan="2">
					<Rectangle
						Width="9"
						Height="16"
						Fill="White"
						Opacity="0.25" />
				</Viewbox>

				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Author:" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Author}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Version:" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Version}" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Description:" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Description}"
					TextAlignment="Left"
					TextWrapping="Wrap" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Tags:" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Tags.Count}" />

			</Grid>
		</Border>

		<ScrollViewer
			Grid.Row="0"
			Grid.Column="1"
			HorizontalScrollBarVisibility="Disabled">
			<StackPanel
				Grid.Row="0"
				Margin="2">

				<TextBlock
					Margin="2,2,0,0"
					Style="{DynamicResource LeftLabel}"
					Text="{DynamicResource LOC_Save_Environment}" />
				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeLocation}"
					IsChecked="{Binding Configuration.IncludeLocation}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeWeather}"
					IsChecked="{Binding Configuration.IncludeWeather}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeTimeOfDay}"
					IsChecked="{Binding Configuration.IncludeTimeOfDay}" />

				<TextBlock
					Margin="2,8,0,0"
					Style="{DynamicResource LeftLabel}"
					Text="Characters" />

				<ItemsControl ItemsSource="{Binding Assignments}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:Assignment}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Border
									Grid.Row="1"
									Grid.ColumnSpan="4"
									Style="{DynamicResource WpfUtilsControlBorder}" />

								<TextBlock
									Grid.Row="0"
									Grid.ColumnSpan="4"
									Style="{DynamicResource Body}"
									Text="{Binding Role}" />

								<ToggleButton
									x:Name="IncludeCharacter"
									Grid.Row="1"
									Grid.Column="2"
									MinWidth="28"
									Margin="1"
									IsChecked="False">
									<wpfUtils:IconBlock
										Icon="UserShield"
										IconFont="Solid" />
								</ToggleButton>

								<ToggleButton
									x:Name="IncludePose"
									Grid.Row="1"
									Grid.Column="3"
									MinWidth="28"
									Margin="1"
									IsChecked="True">
									<wpfUtils:IconBlock Icon="Running" />
								</ToggleButton>

								<ComboBox
									x:Name="Selector"
									Grid.Row="1"
									Margin="1"
									Background="Transparent">
									<ComboBoxItem>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="22" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>

											<wpfUtils:IconBlock
												Grid.Column="0"
												Icon="Times" />
											<TextBlock
												Grid.Column="1"
												Text="Ignore" />
										</Grid>
									</ComboBoxItem>

									<ComboBoxItem>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="22" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>

											<wpfUtils:IconBlock
												Grid.Column="0"
												Icon="User"
												IconFont="Solid" />
											<TextBlock
												Grid.Column="1"
												Text="Some Player" />
										</Grid>
									</ComboBoxItem>

									<ComboBoxItem>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="22" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>

											<wpfUtils:IconBlock
												Grid.Column="0"
												Icon="UserPlus" />
											<TextBlock
												Grid.Column="1"
												Text="New Character" />
										</Grid>
									</ComboBoxItem>
								</ComboBox>

								<Button
									x:Name="AppearanceSelector"
									Grid.Row="2"
									Grid.ColumnSpan="4"
									Height="Auto"
									Margin="0,2,0,0"
									HorizontalContentAlignment="Stretch"
									Click="OnChooseAppearanceClicked"
									Visibility="Collapsed">
									<Button.Content>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>

											<ContentPresenter
												Grid.Column="0"
												Height="32"
												Margin="0,6,6,12"
												VerticalAlignment="Top"
												Content="{Binding Appearance}"
												TextBlock.Foreground="{DynamicResource ForegroundBrush}">
												<ContentPresenter.Resources>
													<ResourceDictionary Source="../Library/LibraryIconTemplates.xaml" />
												</ContentPresenter.Resources>
											</ContentPresenter>

											<TextBlock
												Grid.Column="1"
												Margin="2,0"
												Text="{Binding Appearance.Name}" />

										</Grid>
									</Button.Content>
								</Button>

							</Grid>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding="{Binding ElementName=Selector, Path=SelectedIndex}"
									Value="0">
									<Setter TargetName="IncludeCharacter" Property="IsEnabled" Value="False" />
									<Setter TargetName="IncludeCharacter" Property="IsChecked" Value="False" />
									<Setter TargetName="IncludePose" Property="IsEnabled" Value="False" />
									<Setter TargetName="IncludePose" Property="IsChecked" Value="False" />
								</DataTrigger>

								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding ElementName=Selector, Path=SelectedIndex}" Value="2" />
										<Condition Binding="{Binding ElementName=IncludeCharacter, Path=IsChecked}" Value="false" />
									</MultiDataTrigger.Conditions>
									<Setter TargetName="AppearanceSelector" Property="Visibility" Value="Visible" />
								</MultiDataTrigger>

							</DataTemplate.Triggers>

						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="1"
			Grid.Column="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Button
					Width="100"
					HorizontalAlignment="Right"
					Click="OnConfirmClicked"
					Content="Confirm" />

				<Button
					Width="100"
					HorizontalAlignment="Left"
					Click="OnCancelClicked"
					Content="Cancel" />
			</Grid>
		</Border>
	</Grid>
</windows:Panel>
