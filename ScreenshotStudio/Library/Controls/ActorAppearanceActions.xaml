<studio:View
	x:Class="ScreenshotStudio.Library.Controls.ActorAppearanceActions"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Library.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:studio="clr-namespace:ScreenshotStudio"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="150"
	Loaded="OnLoaded"
	Unloaded="OnUnloaded"
	mc:Ignorable="d">

	<Grid x:Name="ContentArea">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel>

				<Button
					Click="OnApplyClicked"
					IsEnabled="{Binding CanApply}">
					<Button.Content>
						<TextBlock>
							<Run Text="Apply to" />
							<Run Text="{Binding ActorName, Mode=OneWay}" />
						</TextBlock>
					</Button.Content>
				</Button>
			</StackPanel>
		</Border>
	</Grid>

</studio:View>
