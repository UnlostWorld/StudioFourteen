<windows:PanelWindow
	x:Class="ScreenshotStudio.Library.LibraryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:WpfUtils.Behaviours;assembly=WpfUtils"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:tags="clr-namespace:ScreenshotStudio.Tags"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="Library"
	Width="1000"
	Height="650"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Books"
	mc:Ignorable="d">

	<Grid>

		<Grid
			x:Name="ContentArea"
			Margin="3,0,3,3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="256" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<!--  Tab Bar  -->
			<Grid
				Grid.Row="0"
				Grid.ColumnSpan="2">

				<ListBox
					ItemsSource="{Binding Tabs}"
					SelectedItem="{Binding CurrentTab}"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:LibraryTab}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<wpfUtils:IconBlock
									Grid.Column="0"
									Margin="0,0,6,0"
									Icon="{Binding Icon}" />
								<TextBlock
									Grid.Column="1"
									Text="{Binding Name}" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>

			<!--  Sidebar  -->
			<Grid
				Grid.Row="2"
				Grid.Column="1"
				Margin="3,0,0,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<ContentPresenter
					Width="48"
					Height="48"
					Margin="3,6,3,3"
					VerticalAlignment="Center"
					Content="{Binding SelectedEntry}"
					TextBlock.Foreground="{DynamicResource ForegroundBrush}">
					<ContentPresenter.Resources>
						<ResourceDictionary Source="./LibraryIconTemplates.xaml" />
					</ContentPresenter.Resources>
				</ContentPresenter>

				<ContentPresenter
					Grid.Row="0"
					Grid.Column="1"
					VerticalAlignment="Center"
					Content="{Binding SelectedEntry}"
					TextBlock.Foreground="{DynamicResource ForegroundBrush}">
					<ContentPresenter.Resources>
						<ResourceDictionary Source="./LibraryInfoTemplates.xaml" />
					</ContentPresenter.Resources>
				</ContentPresenter>


				<tags:TagDisplay
					Grid.Row="1"
					Grid.ColumnSpan="2"
					Margin="0,0,0,4"
					TagSelected="OnInfoTagSelected"
					Tags="{Binding SelectedEntry.Tags}" />

				<ContentPresenter
					Grid.Row="2"
					Grid.ColumnSpan="2"
					Content="{Binding SelectedEntry}"
					TextBlock.Foreground="{DynamicResource ForegroundBrush}">
					<ContentPresenter.Resources>
						<ResourceDictionary Source="./LibrarySidebarTemplates.xaml" />
					</ContentPresenter.Resources>
				</ContentPresenter>

			</Grid>

			<!--  Toolbar  -->
			<Grid
				Grid.Row="1"
				Grid.ColumnSpan="2"
				Margin="0,3,0,3">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition MinWidth="170" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border
					Grid.ColumnSpan="2"
					Margin="0,0,1,0"
					Style="{DynamicResource WpfUtilsControlBorder}" />

				<Button
					Grid.Column="0"
					Width="28"
					Height="Auto"
					Background="Transparent"
					Click="OnBackClicked"
					IsEnabled="{Binding CurrentGroup.IsRoot, Converter={StaticResource !B}}"
					ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">

					<wpfUtils:IconBlock Icon="Up" />

				</Button>

				<ItemsControl
					Grid.Column="1"
					Margin="4,1,3,1"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					ItemsSource="{Binding Path}">

					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button
								Margin="-3,0,0,0"
								Background="Transparent"
								Click="OnDirectorySelected">

								<StackPanel Orientation="Horizontal">

									<wpfUtils:IconBlock
										x:Name="Caret"
										Margin="0,4,6,2"
										FontSize="10"
										Icon="CaretRight" />

									<wpfUtils:IconBlock
										x:Name="Icon"
										Margin="0,4,6,2"
										Icon="Books"
										Visibility="Collapsed" />

									<TextBlock Text="{Binding Name}" />
								</StackPanel>
							</Button>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding="{Binding IsRoot}"
									Value="True">
									<Setter TargetName="Icon" Property="Visibility" Value="Visible" />
									<Setter TargetName="Caret" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>

						</DataTemplate>
					</ItemsControl.ItemTemplate>

				</ItemsControl>

				<tags:TagSelector
					Grid.Column="2"
					Margin="1,0"
					AllTags="{Binding AvailableTags}"
					Search="{Binding Search, Mode=TwoWay}"
					Tags="{Binding TagFilter.Tags}" />

				<Border
					Grid.Column="3"
					Width="64"
					Margin="1,0"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<RadioButton
							Grid.Column="0"
							Height="Auto"
							Background="Transparent"
							IsChecked="{Binding ViewList, Converter={StaticResource !B}}"
							ToolTip="{DynamicResource LOC_Library_IconViewTooltip}">
							<wpfUtils:IconBlock Icon="BorderAll" />
						</RadioButton>

						<RadioButton
							Grid.Column="1"
							Height="Auto"
							Background="Transparent"
							IsChecked="{Binding ViewList}"
							ToolTip="{DynamicResource LOC_Library_ListViewTooltip}">
							<wpfUtils:IconBlock Icon="List" />
						</RadioButton>
					</Grid>
				</Border>

				<Border
					Grid.Column="4"
					Width="64"
					Margin="1,0,0,0"
					IsEnabled="{Binding CanChangeFlatten}"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<RadioButton
							Grid.Column="0"
							Height="Auto"
							Background="Transparent"
							IsChecked="{Binding Flatten, Converter={StaticResource !B}}"
							ToolTip="{DynamicResource LOC_Library_DirectoryViewTooltip}">
							<wpfUtils:IconBlock Icon="Folder" />
						</RadioButton>

						<RadioButton
							Grid.Column="1"
							Height="Auto"
							Background="Transparent"
							IsChecked="{Binding Flatten}"
							ToolTip="{DynamicResource LOC_Library_FlattenViewTooltip}">
							<wpfUtils:IconBlock Icon="FileAlt" />
						</RadioButton>
					</Grid>
				</Border>
			</Grid>

			<Border
				Grid.Row="3"
				Grid.Column="0"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<!--  Icon Grid  -->
			<ListBox
				Grid.Row="3"
				Grid.Column="0"
				Margin="0,1,1,1"
				Background="Transparent"
				ItemsSource="{Binding Entries, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedEntry}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource !B2V}}">

				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<controls:SmoothScrollingVirtualizingWrapPanel
							IsItemsHost="True"
							VirtualizingPanel.ScrollUnit="Pixel"
							VirtualizingPanel.VirtualizationMode="Recycling" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemTemplate>
					<DataTemplate>

						<Grid
							Width="92"
							Height="128"
							Background="Transparent"
							ToolTip="{Binding .}">

							<Grid.RowDefinitions>
								<RowDefinition Height="96" />
								<RowDefinition Height="32" />
							</Grid.RowDefinitions>

							<ContentPresenter
								Width="96"
								Height="96"
								Content="{Binding .}">
								<ContentPresenter.Resources>
									<ResourceDictionary Source="LibraryIconTemplates.xaml" />
								</ContentPresenter.Resources>
							</ContentPresenter>

							<TextBlock
								Grid.Row="1"
								VerticalAlignment="Top"
								Text="{Binding Name}"
								TextAlignment="Center"
								TextWrapping="Wrap" />
						</Grid>


					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!--  List  -->
			<ListBox
				Grid.Row="3"
				Grid.Column="0"
				Background="Transparent"
				ItemsSource="{Binding Entries, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedEntry}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource B2V}}">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<!--TODO <controls1:EntryIcon
							Width="48"
							Height="48"
							Margin="0,-6,0,-4" />-->

							<TextBlock
								Grid.Column="1"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Text="{Binding Name}"
								TextTrimming="CharacterEllipsis" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>
</windows:PanelWindow>
