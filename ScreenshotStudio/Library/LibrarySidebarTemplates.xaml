<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:libraryControls="clr-namespace:ScreenshotStudio.Library.Controls"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<DataTemplate DataType="{x:Type library:EntryBase}" />
	<DataTemplate DataType="{x:Type excel:LibraryExcelRow}" />



	<DataTemplate x:Key="ActorAppearance">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  a big old picture would look soooo nice right here...  -->

			<!--  actions  -->
			<libraryControls:ActorAppearanceActions
				Grid.Row="3"
				Appearance="{Binding .}" />
		</Grid>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource ActorAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource ActorAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource ActorAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Item}">
		<StackPanel>
			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding Description}"
				TextWrapping="Wrap" />

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding ClassJobs.Name}" />

			<TextBlock Foreground="{DynamicResource ForegroundLightBrush}">
				<Run Text="Lv." />
				<Run Text="{Binding EquipLevel, Mode=OneWay}" />
			</TextBlock>

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding UICategory.Name}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>