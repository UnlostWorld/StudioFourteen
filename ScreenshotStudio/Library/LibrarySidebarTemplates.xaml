<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:libraryControls="clr-namespace:ScreenshotStudio.Library.Controls"
	xmlns:sources="clr-namespace:ScreenshotStudio.Library.Sources"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<DataTemplate DataType="{x:Type library:EntryBase}" />
	<DataTemplate DataType="{x:Type excel:LibraryExcelRow}" />



	<DataTemplate x:Key="CharacterAppearance">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  a big old picture would look soooo nice right here...  -->

			<!--  actions  -->
			<libraryControls:CharacterAppearanceActions
				Grid.Row="3"
				Appearance="{Binding .}" />
		</Grid>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Item}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding ClassJobs.Name}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}">
					<Run Text="Lv." />
					<Run Text="{Binding EquipLevel, Mode=OneWay}" />
				</TextBlock>

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding UICategory.Name}" />
			</StackPanel>

			<!--  actions  -->
			<libraryControls:ItemActions
				VerticalAlignment="Bottom"
				Item="{Binding .}" />
		</Grid>
	</DataTemplate>



	<DataTemplate DataType="{x:Type sources:FileEntry}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Author}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}">
					<Run Text="Ver: " />
					<Run Text="{Binding Version, Mode=OneWay}" />
				</TextBlock>
			</StackPanel>

			<Image
				Grid.Row="1"
				Margin="6"
				Source="{Binding Image}" />
		</Grid>
	</DataTemplate>

</ResourceDictionary>