<windows:PanelWindow
	x:Class="ScreenshotStudio.Library.QuickSearch"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tags="clr-namespace:ScreenshotStudio.Tags"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	Title="Library Search"
	Width="300"
	Height="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding SearchTitle}"
	TitleIcon="Search"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<tags:TagFilter
			Grid.Row="0"
			Margin="0,1"
			AllTags="{Binding AvailableTags}"
			Tags="{Binding Tags}" />

		<ListBox
			Grid.Row="1"
			Margin="0,1,0,0">
			<ListBoxItem Content="Hi" />
			<ListBoxItem Content="these" />
			<ListBoxItem Content="should" />
			<ListBoxItem Content="be" />
			<ListBoxItem Content="results" />
		</ListBox>
	</Grid>
</windows:PanelWindow>
