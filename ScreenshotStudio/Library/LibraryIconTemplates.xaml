<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:services="clr-namespace:ScreenshotStudio.Services"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<DataTemplate DataType="{x:Type library:EntryBase}" />



	<DataTemplate DataType="{x:Type gameData:DataSheetLibrarySource}">
		<controls:XivIconImage Id="065012" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type services:GroupPoseCharactersLibrarySource}">
		<controls:XivIconImage Id="061546" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<Viewbox>
			<wpfUtils:IconBlock
				FontSize="72"
				Icon="User" />
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<Viewbox>
			<wpfUtils:IconBlock
				FontSize="72"
				Icon="UserTie" />
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<Viewbox>
			<wpfUtils:IconBlock
				Margin="10,0"
				FontSize="72"
				Icon="UserShield" />
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type services:ActorBackupAppearance}">
		<Viewbox>
			<wpfUtils:IconBlock
				FontSize="72"
				Icon="User" />
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Item}">
		<Grid Margin="0,0,6,0">

			<controls:XivTexImage
				x:Name="IconBack"
				Margin="0,-1,0,1"
				Path="ui/uld/icona_frame_hr1.tex"
				Rect="0, 192, 96, 96"
				SnapsToDevicePixels="True"
				Visibility="Collapsed" />

			<Image
				Margin="4,2,4,5"
				SnapsToDevicePixels="True"
				Source="{Binding Icon.Source}" />

			<controls:XivTexImage
				x:Name="IconShine"
				Path="ui/uld/icona_frame_hr1.tex"
				Rect="0, 0, 96, 96"
				SnapsToDevicePixels="True" />
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Stain}">
		<Grid
			Grid.RowSpan="3"
			Grid.Column="0"
			Width="48"
			Height="48"
			Margin="0,0,6,0">

			<controls:XivTexImage
				x:Name="IconBack"
				Margin="0,-1,0,1"
				Path="ui/uld/icona_frame_hr1.tex"
				Rect="0, 192, 96, 96"
				SnapsToDevicePixels="True"
				Visibility="Collapsed" />

			<Image
				Margin="4,3,4,5"
				SnapsToDevicePixels="True"
				Source="{Binding Item.Icon.Source}" />

			<controls:XivTexImage
				x:Name="IconShine"
				Path="ui/uld/icona_frame_hr1.tex"
				Rect="0, 0, 96, 96"
				SnapsToDevicePixels="True" />
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Item.Icon}"
				Value="{x:Null}">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>

	</DataTemplate>


</ResourceDictionary>