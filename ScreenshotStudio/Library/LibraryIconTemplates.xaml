<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:services="clr-namespace:ScreenshotStudio.Services"
	xmlns:sources="clr-namespace:ScreenshotStudio.Library.Sources"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<DataTemplate DataType="{x:Type library:LibraryEntryBase}" />



	<DataTemplate DataType="{x:Type gameData:DataSheetLibrarySource}">

		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					FontSize="72"
					Icon="Folder"
					IconFont="Solid" />

				<controls:XivIconImage
					Width="42"
					Height="42"
					Margin="0,0,0,8"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Id="076351" />

			</Grid>
		</Viewbox>

	</DataTemplate>



	<DataTemplate DataType="{x:Type services:GroupPoseCharactersLibrarySource}">
		<controls:XivIconImage Id="061546" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					FontSize="72"
					Icon="File"
					IconFont="Solid" />
				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="{DynamicResource BackgroundBrush}"
					Icon="User"
					IconFont="Solid" />
			</Grid>
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					FontSize="72"
					Icon="File"
					IconFont="Solid" />
				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="{DynamicResource BackgroundBrush}"
					Icon="UserTie"
					IconFont="Solid" />
			</Grid>
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					FontSize="72"
					Icon="File"
					IconFont="Solid" />
				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="{DynamicResource BackgroundBrush}"
					Icon="UserShield"
					IconFont="Solid" />
			</Grid>
		</Viewbox>
	</DataTemplate>



	<DataTemplate DataType="{x:Type services:CharacterBackupAppearance}">
		<Viewbox CacheMode="BitmapCache">
			<wpfUtils:IconBlock
				FontSize="72"
				Icon="User"
				IconFont="Solid" />
		</Viewbox>
	</DataTemplate>



	<DataTemplate x:Key="SimpleIconTemplate">
		<Viewbox>
			<Grid
				Width="48"
				Height="48"
				Margin="0,0,6,0">

				<controls:XivTexImage
					x:Name="IconBack"
					Margin="0,-1,0,1"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 192, 96, 96"
					SnapsToDevicePixels="True"
					Visibility="Collapsed" />

				<Image
					Margin="4,3,4,3"
					SnapsToDevicePixels="True"
					Source="{Binding Icon.Source}" />

				<controls:XivTexImage
					x:Name="IconShine"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 0, 96, 96"
					SnapsToDevicePixels="True" />
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>


	<DataTemplate DataType="{x:Type excel:Item}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleIconTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Stain}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleIconTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Glasses}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleIconTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Ornament}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleIconTemplate}" />
	</DataTemplate>


	<DataTemplate DataType="{x:Type sources:FileEntry}">

		<Grid>

			<Viewbox
				x:Name="FallbackIcon"
				CacheMode="BitmapCache"
				Visibility="Collapsed">
				<Grid>
					<wpfUtils:IconBlock
						FontSize="72"
						Icon="File"
						IconFont="Solid" />
					<wpfUtils:IconBlock
						Margin="5,0,0,-25"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontSize="40"
						Foreground="{DynamicResource BackgroundBrush}"
						Icon="Running"
						IconFont="Solid" />
				</Grid>

			</Viewbox>

			<Grid
				x:Name="Thumbnail"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

				<Border
					Name="Mask"
					Background="Black"
					CornerRadius="4" />

				<Image Source="{Binding IconPath}">
					<Image.OpacityMask>
						<VisualBrush Visual="{Binding ElementName=Mask}" />
					</Image.OpacityMask>
				</Image>
			</Grid>
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding IconPath}"
				Value="{x:Null}">
				<Setter TargetName="Thumbnail" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>



	<DataTemplate DataType="{x:Type sources:DirectoryEntry}">
		<Viewbox CacheMode="BitmapCache">

			<wpfUtils:IconBlock
				FontSize="72"
				Icon="Folder"
				IconFont="Solid" />
		</Viewbox>
	</DataTemplate>

	<DataTemplate DataType="{x:Type sources:FileSource}">
		<Viewbox CacheMode="BitmapCache">

			<wpfUtils:IconBlock
				FontSize="72"
				Icon="Folder"
				IconFont="Solid" />
		</Viewbox>
	</DataTemplate>

</ResourceDictionary>