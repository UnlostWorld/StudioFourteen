<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library.Controls"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<StackPanel>
			<TextBlock
				Grid.Row="0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				x:Name="DescriptionBlock"
				Grid.Row="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding Description}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />
		</StackPanel>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<TextBlock
			Grid.Row="0"
			Text="{Binding Name}"
			TextWrapping="Wrap" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<TextBlock
			Grid.Row="0"
			Text="{Binding Name}"
			TextWrapping="Wrap" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Item}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>


			<TextBlock
				Grid.Row="0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				x:Name="DescriptionBlock"
				Grid.Row="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding Description}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />

			<TextBlock
				Grid.Row="2"
				Style="{DynamicResource Subscript}"
				Text="{Binding ClassJobs.Name}"
				TextWrapping="NoWrap" />
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Description}"
				Value="{x:Null}">
				<Setter TargetName="DescriptionBlock" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>


	<DataTemplate DataType="{x:Type excel:Stain}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Grid.Row="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Text="{Binding Item.Description}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />
		</Grid>
	</DataTemplate>


</ResourceDictionary>