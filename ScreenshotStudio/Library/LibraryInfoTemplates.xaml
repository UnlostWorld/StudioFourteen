<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<DataTemplate DataType="{x:Type gameData:DataSheetLibrarySource}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<controls:XivIconImage
				Grid.Row="0"
				Grid.RowSpan="2"
				Grid.Column="0"
				Width="72"
				Height="72"
				Margin="6,0"
				Id="065012" />

			<TextBlock
				Grid.Row="0"
				Grid.Column="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{DynamicResource LOC_Library_DataSheetLibrarySourceDesc}" />
		</Grid>
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<wpfUtils:IconBlock
				Margin="6,0"
				FontSize="72"
				Icon="User" />

			<TextBlock
				Grid.Row="0"
				Grid.Column="1"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{Binding Description}" />
		</Grid>
	</DataTemplate>

</ResourceDictionary>