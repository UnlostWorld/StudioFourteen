<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:gameData="clr-namespace:ScreenshotStudio.GameData"
	xmlns:library="clr-namespace:ScreenshotStudio.Library"
	xmlns:libraryControls="clr-namespace:ScreenshotStudio.Library.Controls"
	xmlns:services="clr-namespace:ScreenshotStudio.Services"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<DataTemplate DataType="{x:Type library:LibraryEntryBase}">
		<TextBlock
			Margin="3,0,0,0"
			Text="{Binding Name}"
			TextWrapping="Wrap" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:LibraryExcelRow}">
		<TextBlock
			Margin="3,0,0,0"
			Text="{Binding Name}"
			TextWrapping="Wrap" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type gameData:DataSheetLibrarySource}">
		<StackPanel>
			<TextBlock
				Margin="3,0,0,0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{DynamicResource LOC_Library_DataSheetLibrarySourceDesc}" />
		</StackPanel>
	</DataTemplate>



	<DataTemplate DataType="{x:Type services:GroupPoseCharactersLibrarySource}">
		<StackPanel>
			<TextBlock
				Margin="3,0,0,0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{DynamicResource LOC_Library_GroupPoseCharactersLibrarySourceDesc}" />
		</StackPanel>
	</DataTemplate>




	<DataTemplate x:Key="SimpleInfoTemplate">
		<StackPanel>
			<TextBlock
				Grid.Row="0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Grid.Row="2"
				Style="{DynamicResource Subscript}"
				Text="{Binding Description}"
				TextWrapping="NoWrap" />
		</StackPanel>
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleInfoTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Item}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleInfoTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Stain}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleInfoTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Glasses}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleInfoTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Ornament}">
		<ContentPresenter ContentTemplate="{StaticResource SimpleInfoTemplate}" />
	</DataTemplate>


</ResourceDictionary>