<windows:CharacterWindow
	x:Class="ScreenshotStudio.Posing.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Pose}"
	Width="700"
	Height="600"
	MinWidth="700"
	MinHeight="600"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	TitleIcon="Running"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid
			Grid.RowSpan="2"
			Grid.Column="0">

			<Rectangle
				Fill="Transparent"
				MouseDown="OnBackgroundMouseDown" />

			<TabControl x:Name="GuiTabs">
				<TabItem Header="Body">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<pose:SkeletonView
							Grid.RowSpan="3"
							Grid.Column="0"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Body]}" />

						<pose:SkeletonView
							Grid.RowSpan="3"
							Grid.Column="1"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Clothes]}" />

						<pose:SkeletonView
							Grid.Row="0"
							Grid.Column="2"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Tail]}" />

						<pose:SkeletonView
							Grid.Row="1"
							Grid.Column="2"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Panis]}" />

						<pose:SkeletonView
							Grid.Row="2"
							Grid.Column="2"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Vagina]}" />

					</Grid>
				</TabItem>
				<TabItem Header="Matrix" />
				<TabItem Header="Tree" />
			</TabControl>
		</Grid>

		<!--  Transform  -->
		<StackPanel
			Grid.Row="0"
			Grid.Column="1"
			Width="180"
			IsEnabled="{Binding Selection, Converter={StaticResource NotNullToBoolConverter}}">

			<TextBlock
				HorizontalAlignment="Center"
				Style="{DynamicResource Header}"
				Text="{Binding Selection.Name}" />

			<StackPanel>
				<Border
					Grid.Column="1"
					Margin="1"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal">
						<Button Background="Transparent">
							<wpfUtils:IconBlock Icon="ArrowCircleUp" />
						</Button>

						<Button Background="Transparent">
							<wpfUtils:IconBlock Icon="TimesCircle" />
						</Button>

						<Button Background="Transparent">
							<wpfUtils:IconBlock Icon="ArrowCircleDown" />
						</Button>

						<ToggleButton IsChecked="{Binding LockTransform}">
							<wpfUtils:IconBlock Icon="Lock" />
						</ToggleButton>

					</StackPanel>
				</Border>
			</StackPanel>

			<Grid Margin="1">
				<Border Style="{DynamicResource WpfUtilsControlBorder}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid
							Grid.Row="0"
							Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}">
							<pose:RotationGizmo Rotation="{Binding WorldRotation, Mode=TwoWay}" />
						</Grid>

						<ListBox
							Grid.Row="1"
							ItemsSource="{Binding EditModes}"
							SelectedValue="{Binding Services.Pose.EditMode}"
							Style="{DynamicResource WpfUtilsSwitchSelectorNoBorder}">
							<ListBox.ItemTemplate>
								<DataTemplate DataType="{x:Type pose:PoseEditModes}">
									<wpfUtils:IconBlock
										x:Name="Icon"
										Foreground="{DynamicResource ForegroundLightBrush}"
										Icon="Arrows"
										ToolTip="{DynamicResource TransformT}" />

									<DataTemplate.Triggers>
										<DataTrigger
											Binding="{Binding Path=.}"
											Value="Translation">
											<Setter TargetName="Icon" Property="Icon" Value="Arrows" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding Path=.}"
											Value="Rotation">
											<Setter TargetName="Icon" Property="Icon" Value="Rotate" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding Path=.}"
											Value="Scale">
											<Setter TargetName="Icon" Property="Icon" Value="ArrowsMaximize" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

					</Grid>
				</Border>
			</Grid>

			<!--  Translate  -->
			<Expander IsExpanded="{Binding ExpandTranslationSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						X="{Binding TranslationX}"
						Y="{Binding TranslationY}"
						Z="{Binding TranslationZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="Arrows"
								ToolTip="{DynamicResource TransformT}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:RelativeSlider
						Grid.Row="0"
						Grid.Column="1"
						RelativeRange="5"
						RelativeValue="{Binding TranslationX}" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:RelativeSlider
						Grid.Row="1"
						Grid.Column="1"
						RelativeRange="5"
						RelativeValue="{Binding TranslationY}" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:RelativeSlider
						Grid.Row="2"
						Grid.Column="1"
						RelativeRange="5"
						RelativeValue="{Binding TranslationZ}" />
				</Grid>
			</Expander>

			<!--  Rotate  -->
			<Expander IsExpanded="{Binding ExpandRotationSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						X="{Binding EulerRotationX}"
						Y="{Binding EulerRotationY}"
						Z="{Binding EulerRotationZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="Rotate"
								ToolTip="{DynamicResource TransformR}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:Slider
						Grid.Row="0"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						MouseDown="OnEulerDown"
						MouseUp="OnEulerUp"
						SmallChange="1"
						Value="{Binding EulerRotationX}" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:Slider
						Grid.Row="1"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						SmallChange="1"
						Value="{Binding EulerRotationY}" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:Slider
						Grid.Row="2"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						SmallChange="1"
						Value="{Binding EulerRotationZ}" />
				</Grid>
			</Expander>

			<!--  Scale  -->
			<Expander IsExpanded="{Binding ExpandScaleSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						X="{Binding ScaleX}"
						Y="{Binding ScaleY}"
						Z="{Binding ScaleZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="ArrowsMaximize"
								ToolTip="{DynamicResource TransformS}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:RelativeSlider
						Grid.Row="0"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleX}" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:RelativeSlider
						Grid.Row="1"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleY}" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:RelativeSlider
						Grid.Row="2"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleZ}" />
				</Grid>
			</Expander>
		</StackPanel>

		<Border
			Grid.Row="1"
			Grid.Column="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel Orientation="Horizontal">
				<Button
					Click="OnRevertClicked"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>
			</StackPanel>
		</Border>

	</Grid>
</windows:CharacterWindow>
