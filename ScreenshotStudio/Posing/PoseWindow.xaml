<windows:CharacterPanelBase
	x:Class="ScreenshotStudio.Posing.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Pose}"
	Width="700"
	Height="600"
	MinWidth="700"
	MinHeight="600"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	TitleIcon="Running"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="180" />
		</Grid.ColumnDefinitions>

		<Grid
			Grid.RowSpan="2"
			Grid.Column="0"
			Margin="0,0,2,0">

			<Rectangle
				Fill="Transparent"
				MouseDown="OnBackgroundMouseDown" />

			<TabControl x:Name="GuiTabs">
				<TabItem Header="Body">
					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="BodyView"
								Path="Visibility" />
							<Binding
								ElementName="ClothesView"
								Path="Visibility" />
							<Binding
								ElementName="TailView"
								Path="Visibility" />
							<Binding
								ElementName="PenisView"
								Path="Visibility" />
							<Binding
								ElementName="VaginaView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>

					<ScrollViewer PanningMode="Both">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<pose:SkeletonView
								x:Name="BodyView"
								Grid.RowSpan="3"
								Grid.Column="0"
								FlipSides="{Binding FlipSides}"
								ObjectTableIndex="{Binding TargetObjectIndex}"
								ViewDefinition="{Binding Services.Data.SkeletonViews[Body]}" />

							<pose:SkeletonView
								x:Name="ClothesView"
								Grid.RowSpan="3"
								Grid.Column="1"
								FlipSides="{Binding FlipSides}"
								ObjectTableIndex="{Binding TargetObjectIndex}"
								ViewDefinition="{Binding Services.Data.SkeletonViews[Clothes]}" />

							<pose:SkeletonView
								x:Name="TailView"
								Grid.Row="0"
								Grid.Column="2"
								FlipSides="{Binding FlipSides}"
								ObjectTableIndex="{Binding TargetObjectIndex}"
								ViewDefinition="{Binding Services.Data.SkeletonViews[Tail]}" />

							<pose:SkeletonView
								x:Name="PenisView"
								Grid.Row="1"
								Grid.Column="2"
								FlipSides="{Binding FlipSides}"
								ObjectTableIndex="{Binding TargetObjectIndex}"
								ViewDefinition="{Binding Services.Data.SkeletonViews[Penis]}" />

							<pose:SkeletonView
								x:Name="VaginaView"
								Grid.Row="2"
								Grid.Column="2"
								FlipSides="{Binding FlipSides}"
								ObjectTableIndex="{Binding TargetObjectIndex}"
								ViewDefinition="{Binding Services.Data.SkeletonViews[Vagina]}" />

						</Grid>
					</ScrollViewer>
				</TabItem>

				<TabItem Header="Hands">
					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="HandsView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>

					<Grid VerticalAlignment="Center">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<pose:SkeletonView
							x:Name="HandsView"
							Grid.Row="0"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Hands]}" />
					</Grid>
				</TabItem>

				<TabItem Header="Face">
					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="FaceView"
								Path="Visibility" />
							<Binding
								ElementName="TongueView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<pose:SkeletonView
							x:Name="FaceView"
							Grid.Row="0"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Face]}" />

						<pose:SkeletonView
							x:Name="TongueView"
							Grid.Row="1"
							Margin="0,-100,0,0"
							HorizontalAlignment="Right"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Tongue]}" />
					</Grid>
				</TabItem>

				<TabItem Header="Wings">
					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="DiabolosView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>
					<Grid>
						<pose:SkeletonView
							x:Name="DiabolosView"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[DiabolosWings]}" />
					</Grid>
				</TabItem>

				<TabItem Header="Matrix" />
				<TabItem Header="Tree">
					<TreeView
						BorderThickness="0"
						ItemsSource="{Binding Partials}">

						<TreeView.Template>
							<ControlTemplate>
								<Border Style="{DynamicResource WpfUtilsControlBorder}">
									<ScrollViewer
										Padding="4"
										CanContentScroll="False"
										Focusable="False">
										<ItemsPresenter />
									</ScrollViewer>
								</Border>
							</ControlTemplate>
						</TreeView.Template>


						<TreeView.ItemTemplate>
							<HierarchicalDataTemplate
								DataType="{x:Type pose:BoneTreeNode}"
								ItemsSource="{Binding Children}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<Button
										Grid.Column="0"
										Margin="0"
										Background="Transparent"
										Click="OnTreeClicked"
										IsEnabled="{Binding Selection, Converter={StaticResource NotNullToBoolConverter}}">
										<TextBlock
											Grid.Column="1"
											Foreground="{DynamicResource ForegroundBrush}"
											Text="{Binding Name}" />
									</Button>
								</Grid>
							</HierarchicalDataTemplate>
						</TreeView.ItemTemplate>
					</TreeView>
				</TabItem>
			</TabControl>
		</Grid>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel
				Grid.Row="0"
				IsEnabled="{Binding Selection, Converter={StaticResource NotNullToBoolConverter}}">
				<Border
					Margin="1"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<Grid>
						<StackPanel
							HorizontalAlignment="Left"
							Orientation="Horizontal">

							<ToggleButton
								Width="26"
								Background="Transparent"
								IsChecked="{Binding FlipSides}"
								ToolTip="{DynamicResource LOC_Pose_FlipSides}">
								<wpfUtils:IconBlock Icon="ArrowRightArrowLeft" />
							</ToggleButton>

							<Button
								Width="26"
								Background="Transparent"
								Click="OnClearClicked"
								ToolTip="{DynamicResource LOC_Pose_SelectCharacter}">
								<wpfUtils:IconBlock
									Icon="User"
									IconFont="Solid" />
							</Button>

							<ToggleButton
								Width="26"
								Background="Transparent"
								IsChecked="{Binding Selection.LockTransform, FallbackValue=false}"
								IsEnabled="{Binding Selection.CanLockTransform, FallbackValue=false}"
								ToolTip="{DynamicResource LOC_Pose_LockTransform}">
								<wpfUtils:IconBlock Icon="Lock" />
							</ToggleButton>
						</StackPanel>

						<Button
							Width="26"
							HorizontalAlignment="Right"
							Background="Transparent"
							Click="OnRevertClicked"
							ToolTip="{Binding RevertTooltip}">
							<wpfUtils:IconBlock Icon="Undo" />
						</Button>
					</Grid>
				</Border>
			</StackPanel>

			<StackPanel Grid.Row="1">
				<TextBlock
					HorizontalAlignment="Center"
					Style="{DynamicResource Header}"
					Text="{Binding Selection.Name}" />

				<TextBlock
					HorizontalAlignment="Center"
					Style="{DynamicResource Subscript}"
					Text="{Binding Selection.Subtitle}" />
			</StackPanel>


			<ScrollViewer
				Grid.Row="2"
				HorizontalScrollBarVisibility="Disabled"
				PanningMode="VerticalOnly">
				<StackPanel>
					<Grid Margin="1,3,1,1">
						<Border Style="{DynamicResource WpfUtilsControlBorder}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>

								<Grid
									Grid.Row="0"
									Height="168">
									<pose:RotationGizmo Rotation="{Binding WorldRotation, Mode=TwoWay}" />
								</Grid>

								<ListBox
									Grid.Row="1"
									ItemsSource="{Binding EditModes}"
									SelectedValue="{Binding Services.Pose.EditMode}"
									Style="{DynamicResource WpfUtilsSwitchSelectorNoBorder}">
									<ListBox.ItemTemplate>
										<DataTemplate DataType="{x:Type pose:PoseEditModes}">
											<wpfUtils:IconBlock
												x:Name="Icon"
												Foreground="{DynamicResource ForegroundLightBrush}"
												Icon="Arrows"
												ToolTip="{DynamicResource LOC_Translate}" />

											<DataTemplate.Triggers>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Translation">
													<Setter TargetName="Icon" Property="Icon" Value="Arrows" />
													<Setter TargetName="Icon" Property="ToolTip" Value="{DynamicResource LOC_Translate}" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Rotation">
													<Setter TargetName="Icon" Property="Icon" Value="Rotate" />
													<Setter TargetName="Icon" Property="ToolTip" Value="{DynamicResource LOC_Rotate}" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Scale">
													<Setter TargetName="Icon" Property="Icon" Value="Maximize" />
													<Setter TargetName="Icon" Property="ToolTip" Value="{DynamicResource LOC_Scale}" />
												</DataTrigger>
											</DataTemplate.Triggers>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

							</Grid>
						</Border>
					</Grid>

					<!--  Translate  -->
					<Expander IsExpanded="{Binding ExpandTranslationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding TranslationX}"
								Y="{Binding TranslationY}"
								Z="{Binding TranslationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Arrows"
										ToolTip="{DynamicResource LOC_Translate}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationX}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationY}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationZ}"
								SmallChange="0.01" />
						</Grid>
					</Expander>

					<!--  Rotate  -->
					<Expander IsExpanded="{Binding ExpandRotationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding EulerRotationX}"
								Y="{Binding EulerRotationY}"
								Z="{Binding EulerRotationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Rotate"
										ToolTip="{DynamicResource LOC_Rotation}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:Slider
								Grid.Row="0"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								MouseDown="OnEulerDown"
								MouseUp="OnEulerUp"
								SmallChange="1"
								Value="{Binding EulerRotationX}" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:Slider
								Grid.Row="1"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								SmallChange="1"
								Value="{Binding EulerRotationY}" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:Slider
								Grid.Row="2"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								SmallChange="1"
								Value="{Binding EulerRotationZ}" />
						</Grid>
					</Expander>

					<!--  Scale  -->
					<Expander IsExpanded="{Binding ExpandScaleSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding ScaleX}"
								Y="{Binding ScaleY}"
								Z="{Binding ScaleZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Maximize"
										ToolTip="{DynamicResource LOC_Scale}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleX}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleY}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleZ}"
								SmallChange="0.01" />
						</Grid>
					</Expander>
				</StackPanel>
			</ScrollViewer>


			<!--<Border
				Grid.Row="3"
				Style="{DynamicResource WpfUtilsControlBorder}">
				<StackPanel Orientation="Horizontal">
					
				</StackPanel>
			</Border>-->
		</Grid>

	</Grid>
</windows:CharacterPanelBase>
