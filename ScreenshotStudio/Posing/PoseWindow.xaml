<windows:CharacterPanelBase
	x:Class="ScreenshotStudio.Posing.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:windows="clr-namespace:ScreenshotStudio.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Pose}"
	Width="700"
	Height="550"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	Subtitle="{Binding CharacterName}"
	TitleIcon="Running"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="180" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid
			Grid.Column="0"
			Margin="0,0,2,0">

			<Rectangle
				Fill="Transparent"
				MouseDown="OnBackgroundMouseDown" />

			<TabControl
				x:Name="GuiTabs"
				Padding="2"
				Style="{DynamicResource WpfUtilsSideTabs}">
				<TabItem>
					<TabItem.Header>
						<wpfUtils:IconBlock
							Margin="12"
							Icon="Person" />
					</TabItem.Header>

					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="BodyView"
								Path="Visibility" />
							<Binding
								ElementName="ClothesView"
								Path="Visibility" />
							<Binding
								ElementName="TailView"
								Path="Visibility" />
							<Binding
								ElementName="PenisView"
								Path="Visibility" />
							<Binding
								ElementName="VaginaView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>


					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<pose:SkeletonView
							x:Name="BodyView"
							Grid.RowSpan="3"
							Grid.Column="0"
							Margin="-40,-45,-40,0"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Body]}" />

						<pose:SkeletonView
							x:Name="ClothesView"
							Grid.RowSpan="3"
							Grid.Column="1"
							Margin="-40,-45,-40,0"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Clothes]}" />

						<pose:SkeletonView
							x:Name="TailView"
							Grid.Row="0"
							Grid.Column="2"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Tail]}" />

						<pose:SkeletonView
							x:Name="PenisView"
							Grid.Row="1"
							Grid.Column="2"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Penis]}" />

						<pose:SkeletonView
							x:Name="VaginaView"
							Grid.Row="2"
							Grid.Column="2"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Vagina]}" />

					</Grid>
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<wpfUtils:IconBlock
							Margin="12"
							Icon="Hand"
							IconFont="Solid" />
					</TabItem.Header>

					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="HandsView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>

					<Grid VerticalAlignment="Center">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<pose:SkeletonView
							x:Name="HandsView"
							Grid.Row="0"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[Hands]}" />
					</Grid>
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<wpfUtils:IconBlock
							Margin="12"
							Icon="FaceGrin"
							IconFont="Solid" />
					</TabItem.Header>

					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="FaceView"
								Path="Visibility" />
							<Binding
								ElementName="TongueView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>

					<TabControl>
						<TabItem Header="Expression" />

						<TabItem Header="Bones">
							<Grid>
								<pose:SkeletonView
									x:Name="FaceView"
									FlipSides="{Binding FlipSides}"
									ObjectTableIndex="{Binding TargetObjectIndex}"
									ViewDefinition="{Binding Services.Data.SkeletonViews[Face]}" />

								<pose:SkeletonView
									x:Name="TongueView"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom"
									FlipSides="{Binding FlipSides}"
									ObjectTableIndex="{Binding TargetObjectIndex}"
									ViewDefinition="{Binding Services.Data.SkeletonViews[Tongue]}" />
							</Grid>
						</TabItem>
					</TabControl>
				</TabItem>

				<TabItem>
					<TabItem.Header>
						<!--  TODO: wing Icon  -->
						<wpfUtils:IconBlock
							Margin="12"
							Icon="Dove"
							IconFont="Solid" />
					</TabItem.Header>

					<TabItem.Visibility>
						<MultiBinding Converter="{StaticResource MultiOrVisibility}">
							<Binding
								ElementName="DiabolosView"
								Path="Visibility" />
						</MultiBinding>
					</TabItem.Visibility>
					<Grid>
						<pose:SkeletonView
							x:Name="DiabolosView"
							FlipSides="{Binding FlipSides}"
							ObjectTableIndex="{Binding TargetObjectIndex}"
							ViewDefinition="{Binding Services.Data.SkeletonViews[DiabolosWings]}" />
					</Grid>
				</TabItem>

			</TabControl>
		</Grid>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--<StackPanel Grid.Row="0">
				<Border
					Margin="1"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<Grid>
						<UniformGrid Rows="1">

							<ToggleButton
								Background="Transparent"
								IsChecked="{Binding FlipSides}"
								ToolTip="{DynamicResource LOC_Pose_FlipSides}">
								<wpfUtils:IconBlock Icon="ArrowRightArrowLeft" />
							</ToggleButton>




							<ToggleButton
								Background="Transparent"
								IsChecked="{Binding Selection.LockTransform, FallbackValue=false}"
								IsEnabled="{Binding Selection.CanLockTransform, FallbackValue=false}"
								ToolTip="{DynamicResource LOC_Pose_LockTransform}">
								<wpfUtils:IconBlock Icon="Lock" />
							</ToggleButton>
						</UniformGrid>


					</Grid>
				</Border>
			</StackPanel>-->

			<StackPanel Grid.Row="1">
				<TextBlock
					HorizontalAlignment="Center"
					Style="{DynamicResource Header}"
					Text="{Binding Selection.Name}" />

				<TextBlock
					HorizontalAlignment="Center"
					Style="{DynamicResource Subscript}"
					Text="{Binding Selection.Subtitle}" />
			</StackPanel>


			<ScrollViewer
				Grid.Row="2"
				HorizontalScrollBarVisibility="Disabled"
				PanningMode="VerticalOnly">
				<StackPanel>
					<Grid Margin="1,3,1,1">
						<Border Style="{DynamicResource WpfUtilsControlBorder}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>

								<Grid
									Grid.Row="0"
									Height="168">
									<pose:RotationGizmo Rotation="{Binding WorldRotation, Mode=TwoWay}" />
								</Grid>

								<ListBox
									Grid.Row="1"
									ItemsSource="{Binding EditModes}"
									SelectedValue="{Binding Services.Pose.EditMode}"
									Style="{DynamicResource WpfUtilsSwitchSelectorNoBorder}">
									<ListBox.ItemTemplate>
										<DataTemplate DataType="{x:Type pose:PoseEditModes}">
											<wpfUtils:IconBlock
												x:Name="Icon"
												Foreground="{DynamicResource ForegroundLightBrush}"
												Icon="Arrows" />

											<DataTemplate.Triggers>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Translation">
													<Setter TargetName="Icon" Property="Icon" Value="Arrows" />
													<Setter Property="ToolTip" Value="{DynamicResource LOC_Translate}" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Rotation">
													<Setter TargetName="Icon" Property="Icon" Value="Rotate" />
													<Setter Property="ToolTip" Value="{DynamicResource LOC_Rotate}" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding Path=.}"
													Value="Scale">
													<Setter TargetName="Icon" Property="Icon" Value="Maximize" />
													<Setter Property="ToolTip" Value="{DynamicResource LOC_Scale}" />
												</DataTrigger>
											</DataTemplate.Triggers>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

							</Grid>
						</Border>
					</Grid>

					<!--  Translate  -->
					<Expander IsExpanded="{Binding ExpandTranslationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding TranslationX}"
								Y="{Binding TranslationY}"
								Z="{Binding TranslationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Arrows"
										ToolTip="{DynamicResource LOC_Translate}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								LargeChange="{Binding Selection.TranslationLargeChange, FallbackValue=0.1}"
								RelativeRange="{Binding Selection.TranslationRange, FallbackValue=1}"
								RelativeValue="{Binding TranslationX}"
								SmallChange="{Binding Selection.TranslationSmallChange, FallbackValue=0.01}" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								LargeChange="{Binding Selection.TranslationLargeChange, FallbackValue=0.1}"
								RelativeRange="{Binding Selection.TranslationRange, FallbackValue=1}"
								RelativeValue="{Binding TranslationY}"
								SmallChange="{Binding Selection.TranslationSmallChange, FallbackValue=0.01}" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								LargeChange="{Binding Selection.TranslationLargeChange, FallbackValue=0.1}"
								RelativeRange="{Binding Selection.TranslationRange, FallbackValue=1}"
								RelativeValue="{Binding TranslationZ}"
								SmallChange="{Binding Selection.TranslationSmallChange, FallbackValue=0.01}" />
						</Grid>
					</Expander>

					<!--  Rotate  -->
					<Expander IsExpanded="{Binding ExpandRotationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding EulerRotationX}"
								Y="{Binding EulerRotationY}"
								Z="{Binding EulerRotationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Rotate"
										ToolTip="{DynamicResource LOC_Rotation}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:Slider
								Grid.Row="0"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								MouseDown="OnEulerDown"
								MouseUp="OnEulerUp"
								SmallChange="1"
								Value="{Binding EulerRotationX}" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:Slider
								Grid.Row="1"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								SmallChange="1"
								Value="{Binding EulerRotationY}" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:Slider
								Grid.Row="2"
								Grid.Column="1"
								Maximum="179.9"
								Minimum="-179.9"
								SmallChange="1"
								Value="{Binding EulerRotationZ}" />
						</Grid>
					</Expander>

					<!--  Scale  -->
					<Expander IsExpanded="{Binding ExpandScaleSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								DecimalPlaces="2"
								X="{Binding ScaleX}"
								Y="{Binding ScaleY}"
								Z="{Binding ScaleZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Maximize"
										ToolTip="{DynamicResource LOC_Scale}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleX}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleY}"
								SmallChange="0.01" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleZ}"
								SmallChange="0.01" />
						</Grid>
					</Expander>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="2"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Background="Transparent"
					Click="OnRevertClicked"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>

				<Button
					Background="Transparent"
					Click="OnClearClicked"
					ToolTip="{DynamicResource LOC_Pose_SelectCharacter}">
					<wpfUtils:IconBlock
						Icon="User"
						IconFont="Solid" />
				</Button>

				<Button
					Background="Transparent"
					Click="OnReferenceClicked"
					ToolTip="{DynamicResource LOC_Pose_Reference}">
					<wpfUtils:IconBlock
						Icon="Person"
						IconFont="Solid" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnImportClicked">
					<TextBlock Text="Import" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnExportClicked">
					<TextBlock Text="Export" />
				</Button>

			</StackPanel>
		</Border>
	</Grid>
</windows:CharacterPanelBase>
