<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:ScreenshotStudio.Mvm"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:windows="clr-namespace:ScreenshotStudio.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	mc:Ignorable="d">

	<ControlTemplate
		x:Key="TransforInspectorTemplate"
		TargetType="{x:Type pose:TransformInspector}">

		<Grid IsEnabled="{Binding Selection.IsReady, RelativeSource={RelativeSource Mode=TemplatedParent}}">
			<StackPanel>
				<Grid Margin="1,3,1,1">
					<Border Style="{DynamicResource WpfUtilsControlBorder}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid
								Grid.Row="0"
								Height="168">
								<pose:RotationGizmo Rotation="{Binding WorldRotation, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=TwoWay}" />
							</Grid>

							<ListBox
								Grid.Row="1"
								ItemsSource="{Binding EditModes, RelativeSource={RelativeSource Mode=TemplatedParent}}"
								SelectedValue="{Binding Services.Pose.EditMode, RelativeSource={RelativeSource Mode=TemplatedParent}}"
								Style="{DynamicResource WpfUtilsSwitchSelectorNoBorder}">
								<ListBox.ItemTemplate>
									<DataTemplate DataType="{x:Type pose:PoseEditModes}">
										<wpfUtils:IconBlock
											x:Name="Icon"
											Foreground="{DynamicResource ForegroundLightBrush}"
											Icon="Arrows" />

										<DataTemplate.Triggers>
											<DataTrigger
												Binding="{Binding ., RelativeSource={RelativeSource Mode=TemplatedParent}}"
												Value="Translation">
												<Setter TargetName="Icon" Property="Icon" Value="Arrows" />
												<Setter Property="ToolTip" Value="{DynamicResource LOC_Translate}" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding ., RelativeSource={RelativeSource Mode=TemplatedParent}}"
												Value="Rotation">
												<Setter TargetName="Icon" Property="Icon" Value="Rotate" />
												<Setter Property="ToolTip" Value="{DynamicResource LOC_Rotate}" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding ., RelativeSource={RelativeSource Mode=TemplatedParent}}"
												Value="Scale">
												<Setter TargetName="Icon" Property="Icon" Value="Maximize" />
												<Setter Property="ToolTip" Value="{DynamicResource LOC_Scale}" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

						</Grid>
					</Border>
				</Grid>

				<!--  Translate  -->
				<Expander IsExpanded="{Binding ExpandTranslationSliders, RelativeSource={RelativeSource Mode=TemplatedParent}}">
					<Expander.Header>
						<wpfUtils:MultiNumberBox
							Margin="0"
							DecimalPlaces="{Binding DecimalPlacesDisplay}"
							X="{Binding TranslationX, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Y="{Binding TranslationY, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Z="{Binding TranslationZ, RelativeSource={RelativeSource Mode=TemplatedParent}}">
							<wpfUtils:MultiNumberBox.Prefix>
								<wpfUtils:IconBlock
									Margin="6,1,2,0"
									Foreground="{DynamicResource BackgroundLightBrush}"
									Icon="Arrows"
									ToolTip="{DynamicResource LOC_Translate}" />
							</wpfUtils:MultiNumberBox.Prefix>
						</wpfUtils:MultiNumberBox>

					</Expander.Header>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="X:" />
						<wpfUtils:RelativeSlider
							Grid.Row="0"
							Grid.Column="1"
							LargeChange="{Binding Selection.TranslationLargeChange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeRange="{Binding Selection.TranslationRange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeValue="{Binding TranslationX, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="{Binding Selection.TranslationSmallChange, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Y:" />
						<wpfUtils:RelativeSlider
							Grid.Row="1"
							Grid.Column="1"
							LargeChange="{Binding Selection.TranslationLargeChange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeRange="{Binding Selection.TranslationRange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeValue="{Binding TranslationY, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="{Binding Selection.TranslationSmallChange, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Z:" />
						<wpfUtils:RelativeSlider
							Grid.Row="2"
							Grid.Column="1"
							LargeChange="{Binding Selection.TranslationLargeChange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeRange="{Binding Selection.TranslationRange, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							RelativeValue="{Binding TranslationZ, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="{Binding Selection.TranslationSmallChange, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
					</Grid>
				</Expander>

				<!--  Rotate  -->
				<Expander IsExpanded="{Binding ExpandRotationSliders}">
					<Expander.Header>
						<wpfUtils:MultiNumberBox
							Margin="0"
							DecimalPlaces="{Binding DecimalPlacesDisplay}"
							X="{Binding EulerRotationX, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Y="{Binding EulerRotationY, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Z="{Binding EulerRotationZ, RelativeSource={RelativeSource Mode=TemplatedParent}}">
							<wpfUtils:MultiNumberBox.Prefix>
								<wpfUtils:IconBlock
									Margin="6,1,2,0"
									Foreground="{DynamicResource BackgroundLightBrush}"
									Icon="Rotate"
									ToolTip="{DynamicResource LOC_Rotation}" />
							</wpfUtils:MultiNumberBox.Prefix>
						</wpfUtils:MultiNumberBox>

					</Expander.Header>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="X:" />
						<wpfUtils:Slider
							x:Name="PART_EulerSliderX"
							Grid.Row="0"
							Grid.Column="1"
							Maximum="179.9"
							Minimum="-179.9"
							SmallChange="1"
							Value="{Binding EulerRotationX, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Y:" />
						<wpfUtils:Slider
							x:Name="PART_EulerSliderY"
							Grid.Row="1"
							Grid.Column="1"
							Maximum="179.9"
							Minimum="-179.9"
							SmallChange="1"
							Value="{Binding EulerRotationY, RelativeSource={RelativeSource Mode=TemplatedParent}}" />

						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Z:" />
						<wpfUtils:Slider
							x:Name="PART_EulerSliderZ"
							Grid.Row="2"
							Grid.Column="1"
							Maximum="179.9"
							Minimum="-179.9"
							SmallChange="1"
							Value="{Binding EulerRotationZ, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
					</Grid>
				</Expander>

				<!--  Scale  -->
				<Expander IsExpanded="{Binding ExpandScaleSliders}">
					<Expander.Header>
						<wpfUtils:MultiNumberBox
							Margin="0"
							DecimalPlaces="{Binding DecimalPlacesDisplay}"
							X="{Binding ScaleX, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Y="{Binding ScaleY, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							Z="{Binding ScaleZ, RelativeSource={RelativeSource Mode=TemplatedParent}}">
							<wpfUtils:MultiNumberBox.Prefix>
								<wpfUtils:IconBlock
									Margin="6,1,2,0"
									Foreground="{DynamicResource BackgroundLightBrush}"
									Icon="Maximize"
									ToolTip="{DynamicResource LOC_Scale}" />
							</wpfUtils:MultiNumberBox.Prefix>
						</wpfUtils:MultiNumberBox>

					</Expander.Header>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="X:" />
						<wpfUtils:RelativeSlider
							Grid.Row="0"
							Grid.Column="1"
							RelativeRange="1"
							RelativeValue="{Binding ScaleX, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="0.01" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Y:" />
						<wpfUtils:RelativeSlider
							Grid.Row="1"
							Grid.Column="1"
							RelativeRange="1"
							RelativeValue="{Binding ScaleY, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="0.01" />

						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="3,0"
							Style="{DynamicResource RightLabel}"
							Text="Z:" />
						<wpfUtils:RelativeSlider
							Grid.Row="2"
							Grid.Column="1"
							RelativeRange="1"
							RelativeValue="{Binding ScaleZ, RelativeSource={RelativeSource Mode=TemplatedParent}}"
							SmallChange="0.01" />
					</Grid>
				</Expander>
			</StackPanel>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type pose:TransformInspector}">
		<Setter Property="Template" Value="{StaticResource TransforInspectorTemplate}" />
	</Style>

</ResourceDictionary>
