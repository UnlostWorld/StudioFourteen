<mvm:View
	x:Class="ScreenshotStudio.Posing.ExpressionsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:ScreenshotStudio.Mvm"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="450"
	d:DesignWidth="500"
	mc:Ignorable="d">
	<Canvas>
		<Image
			Opacity="{Binding BackgroundOpacity}"
			Source="/ScreenshotStudio;component/Assets/PoseCharacterFaceBackground.png" />

		<Button
			Canvas.Left="155"
			Canvas.Top="250"
			Width="150"
			Height="60"
			Click="OnMouthClicked"
			Opacity="0.5" />

		<Button
			Canvas.Left="90"
			Canvas.Top="100"
			Width="100"
			Height="50"
			Click="OnRightEyeClicked"
			Opacity="0.5" />

		<Button
			Canvas.Left="260"
			Canvas.Top="100"
			Width="100"
			Height="50"
			Click="OnLeftEyeClicked"
			Opacity="0.5" />

	</Canvas>
</mvm:View>
