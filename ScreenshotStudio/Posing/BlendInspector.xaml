<mvm:View
	x:Class="ScreenshotStudio.Posing.BlendInspector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:librarySource="clr-namespace:ScreenshotStudio.Library.Sources"
	xmlns:local="clr-namespace:ScreenshotStudio.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:ScreenshotStudio.Mvm"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="400"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<Grid>
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<ItemsControl ItemsSource="{Binding Selection.Targets}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type pose:BlendTarget}">

						<Button
							Height="64"
							Padding="0"
							Click="OnTargetClicked">
							<Grid>
								<Grid
									x:Name="FallbackIcon"
									Visibility="Collapsed">
									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Style="{DynamicResource WpfUtilsTextBlock}"
										Text="{Binding Name}" />
								</Grid>


								<Image
									x:Name="Thumbnail"
									VerticalAlignment="Center"
									Opacity="0.25"
									Source="{Binding Icon}"
									Stretch="Uniform" />
							</Grid>
						</Button>

						<DataTemplate.Triggers>
							<DataTrigger
								Binding="{Binding Icon}"
								Value="{x:Null}">
								<Setter TargetName="Thumbnail" Property="Visibility" Value="Collapsed" />
								<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
							</DataTrigger>
						</DataTemplate.Triggers>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<Popup
			Width="175"
			Height="Auto"
			AllowsTransparency="True"
			IsOpen="{Binding IsBlendOpen}"
			Placement="Center"
			PlacementTarget="{Binding BlendTargetElement}"
			StaysOpen="False">

			<Grid Margin="16">
				<Border
					Background="Black"
					CornerRadius="6">
					<Border.Effect>
						<DropShadowEffect
							Direction="270"
							ShadowDepth="0" />
					</Border.Effect>
				</Border>

				<wpfUtils:Slider
					Maximum="1"
					Minimum="0"
					Value="{Binding BlendValue}" />


			</Grid>
		</Popup>

	</Grid>
</mvm:View>
