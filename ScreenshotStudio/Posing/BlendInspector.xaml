<mvm:View
	x:Class="ScreenshotStudio.Posing.BlendInspector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:librarySource="clr-namespace:ScreenshotStudio.Library.Sources"
	xmlns:local="clr-namespace:ScreenshotStudio.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:ScreenshotStudio.Mvm"
	xmlns:pose="clr-namespace:ScreenshotStudio.Posing"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<Grid Margin="1">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Image
			Grid.Row="0"
			Height="70"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Opacity="0.25"
			Source="{Binding Selection.Target.Icon}"
			Stretch="Uniform" />


		<StackPanel Grid.Row="1">
			<CheckBox
				Margin="1"
				Content="Flip" />
			<CheckBox
				Margin="1"
				Content="Mirror" />

			<Button>
				<wpfUtils:IconBlock Icon="RotateLeft" />
			</Button>
		</StackPanel>


		<wpfUtils:NumberBox
			Grid.Row="2"
			Maximum="{Binding BlendMaximum}"
			Minimum="{Binding BlendMinimum}"
			Slider="Absolute"
			UncapTextInput="True"
			Value="{Binding BlendValue}">
			<wpfUtils:NumberBox.Suffix>
				<TextBlock
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource BackgroundLightBrush}"
					Style="{DynamicResource WpfUtilsTextBlock}"
					Text="%" />
			</wpfUtils:NumberBox.Suffix>
		</wpfUtils:NumberBox>
	</Grid>
</mvm:View>
