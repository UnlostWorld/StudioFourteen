<panels:PanelWindow
	x:Class="ScreenshotStudio.Studio.BackgroundWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:background="clr-namespace:ScreenshotStudio.Studio.Background"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:ScreenshotStudio.Panels"
	xmlns:studio="clr-namespace:ScreenshotStudio"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="1080"
	d:DesignWidth="1920"
	AllowsTransparency="True"
	Background="Transparent"
	ResizeMode="NoResize"
	SnapsToDevicePixels="True"
	UseLayoutRounding="True"
	WindowStyle="None"
	mc:Ignorable="d">

	<panels:PanelWindow.Template>
		<ControlTemplate TargetType="{x:Type panels:PanelWindow}">
			<AdornerDecorator>
				<ContentPresenter
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</AdornerDecorator>

			<ControlTemplate.Triggers>
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsUiVisible}" Value="True" />
					</MultiDataTrigger.Conditions>

					<MultiDataTrigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.100">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</MultiDataTrigger.EnterActions>

					<MultiDataTrigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.200">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</MultiDataTrigger.ExitActions>
				</MultiDataTrigger>

			</ControlTemplate.Triggers>
		</ControlTemplate>
	</panels:PanelWindow.Template>

	<Grid x:Name="ContentArea">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<!--  Navigation  -->
		<background:Navigation
			x:Name="NavigationArea"
			Grid.Column="0"
			Margin="10,0,0,0"
			VerticalAlignment="Center"
			Visibility="{Binding Services.Settings.Current.IsSpa, Converter={StaticResource !B2V}}" />


		<Grid
			Grid.Column="2"
			Width="{Binding ActualWidth, ElementName=NavigationArea}" />

		<background:Targets
			Grid.Column="1"
			Margin="0,10,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top" />

		<Button
			Name="StudioButton"
			Grid.ColumnSpan="2"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Click="OnStudioClicked"
			IsEnabled="{Binding IsFullyLoaded}"
			Style="{StaticResource StudioButton}" />

		<!--
		<Button
			Margin="0,60,0,0"
			VerticalAlignment="Top"
			Click="OnShutdownClicked"
			Content="X" />
		-->

	</Grid>
</panels:PanelWindow>
