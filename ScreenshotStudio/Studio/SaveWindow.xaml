<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.SaveWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Save}"
	Width="450"
	Height="600"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="FloppyDisk"
	mc:Ignorable="d">

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="200" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid Margin="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="75" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>



				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Author:" />

				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Text="Yuki" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Version:" />

				<TextBox
					Grid.Row="2"
					Grid.Column="1"
					Text="1.0" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Description:" />

				<TextBox
					Grid.Row="3"
					Grid.Column="1"
					Text="Lorem ipsum odor amet, consectetuer adipiscing elit. Conubia pretium dis consectetur sapien class finibus."
					TextAlignment="Left"
					TextWrapping="Wrap" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Tags:" />

				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					Text="Custom, Things" />

			</Grid>
		</Border>


		<ScrollViewer
			Grid.Row="0"
			Grid.Column="1">
			<StackPanel
				Grid.Row="0"
				Margin="2">
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="Components" />
				<CheckBox
					Margin="1,1,1,1"
					Content="All Appearances" />

				<CheckBox
					Margin="1,1,1,1"
					Content="All Poses" />


				<TextBlock
					Margin="1,20,1,1"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="Global" />

				<Expander
					Padding="20,0,0,0"
					IsExpanded="{Binding IncludeEnvironment}"
					Style="{DynamicResource WpfUtilsInvisibleExpander}">
					<Expander.Header>
						<CheckBox
							Margin="1"
							Content="{DynamicResource LOC_Save_IncludeEnvironment}"
							IsChecked="{Binding IncludeEnvironment}" />
					</Expander.Header>

					<StackPanel>
						<CheckBox
							Margin="1"
							Content="{DynamicResource LOC_Save_IncludeLocation}"
							IsChecked="{Binding IncludeLocation}" />

						<CheckBox
							Margin="1"
							Content="{DynamicResource LOC_Save_IncludeWeather}"
							IsChecked="{Binding IncludeWeather}" />

						<CheckBox
							Margin="1"
							Content="{DynamicResource LOC_Save_IncludeTimeOfDay}"
							IsChecked="{Binding IncludeTimeOfDay}" />


					</StackPanel>

				</Expander>


				<TextBlock
					Margin="1,20,1,1"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding CharactersText}" />

				<ItemsControl ItemsSource="{Binding Characters}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:CharacterSave}">

							<Expander
								Padding="20,0,0,0"
								IsExpanded="{Binding IncludeCharacter}"
								Style="{DynamicResource WpfUtilsInvisibleExpander}">

								<Expander.Header>
									<CheckBox
										Grid.Row="0"
										Content="{Binding Name}"
										IsChecked="{Binding IncludeCharacter}"
										ToolTip="{Binding TooltipText}" />
								</Expander.Header>

								<Grid>

									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>

									<CheckBox
										Grid.Row="0"
										Margin="1"
										Padding="0,0,25,0"
										Content="{DynamicResource LOC_Save_IncludeAppearance}"
										ToolTip="{Binding AppearanceTooltipText}" />

									<Button
										Grid.Row="0"
										Width="28"
										Height="24"
										Margin="2"
										HorizontalAlignment="Right"
										Background="Transparent"
										ToolTip="{Binding ExportAppearanceToolTipText}">
										<wpfUtils:IconBlock Icon="FileArrowDown" />
									</Button>

									<CheckBox
										Grid.Row="1"
										Margin="1"
										Padding="0,0,25,0"
										Content="{DynamicResource LOC_Save_IncludePose}"
										ToolTip="{Binding PoseTooltipText}" />

									<Button
										Grid.Row="1"
										Width="28"
										Height="24"
										Margin="2"
										HorizontalAlignment="Right"
										Background="Transparent"
										ToolTip="{Binding ExportPoseToolTipText}">
										<wpfUtils:IconBlock Icon="FileArrowDown" />
									</Button>


								</Grid>
							</Expander>


						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="0,2,0,0"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Button
				MinWidth="100"
				HorizontalAlignment="Right"
				Click="OnSaveClicked"
				Content="{Binding SaveLabel}" />
		</Border>

	</Grid>
</windows:PanelWindow>
