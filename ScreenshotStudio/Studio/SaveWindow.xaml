<local:PanelWindow
	x:Class="ScreenshotStudio.Studio.SaveWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{DynamicResource LOC_Save}"
	Width="250"
	Height="600"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="FloppyDisk"
	mc:Ignorable="d">
	<Grid />
</local:PanelWindow>
