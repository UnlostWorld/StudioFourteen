<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.CustomizeWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:customize="clr-namespace:ScreenshotStudio.Studio.Customize"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="{DynamicResource Customize}"
	Width="300"
	Height="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding ActorName}"
	TitleIcon="UserEdit"
	mc:Ignorable="d">

	<ScrollViewer>
		<StackPanel IsEnabled="{Binding HasValidTarget}">

			<StackPanel.Resources>
				<Style
					x:Key="LeftLabel"
					BasedOn="{StaticResource Subscript}"
					TargetType="{x:Type TextBlock}">
					<Setter Property="HorizontalAlignment" Value="Left" />
					<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
					<Setter Property="Margin" Value="2,2,0,0" />
				</Style>
			</StackPanel.Resources>

			<!--  Race  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="Race" />
			<ComboBox
				Grid.Column="0"
				ItemsSource="{Binding AvailableRaces}"
				SelectedItem="{Binding Race}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<!--  Tribe  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="Tribe" />
			<ListBox
				ItemsSource="{Binding Race.Tribes}"
				SelectedItem="{Binding Tribe}"
				Style="{DynamicResource XivToolsSwitchSelector}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!--  Gender  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="Gender" />
			<ListBox
				ItemsSource="{Binding Race.Genders}"
				SelectedItem="{Binding Gender}"
				Style="{DynamicResource XivToolsSwitchSelector}" />

			<!--  Age  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="Age" />
			<ListBox
				ItemsSource="{Binding Tribe.Ages}"
				SelectedItem="{Binding Age}"
				Style="{DynamicResource XivToolsSwitchSelector}" />

			<!--  Height  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="Height" />
			<xivToolsWpf:NumberBox
				Maximum="100"
				Minimum="0"
				Slider="Absolute"
				Value="{Binding ActorHeight}" />

			<!--  Muscle Tone  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding MakeType.EarMuscleTailSizes.Name}"
				Visibility="{Binding Race.RowEnum, Converter={StaticResource EnumToVisibility}, ConverterParameter=Hyur|Roegadyn}" />

			<xivToolsWpf:NumberBox
				Maximum="{Binding MakeType.EarMuscleTailSizes.Max}"
				Minimum="{Binding MakeType.EarMuscleTailSizes.Min}"
				Slider="Absolute"
				Visibility="{Binding Race.RowEnum, Converter={StaticResource EnumToVisibility}, ConverterParameter=Hyur|Roegadyn}"
				Value="{Binding EarMuscleTailSize}" />

			<!--  Bust Size  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding MakeType.Busts.Name}"
				Visibility="{Binding Gender, Converter={StaticResource EnumToVisibility}, ConverterParameter=Feminine}" />
			<xivToolsWpf:NumberBox
				Maximum="{Binding MakeType.Busts.Max}"
				Minimum="{Binding MakeType.Busts.Min}"
				Slider="Absolute"
				Visibility="{Binding Gender, Converter={StaticResource EnumToVisibility}, ConverterParameter=Feminine}"
				Value="{Binding Bust}" />


			<!--  Tail Shape  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding MakeType.TailEarsTypes.Name}"
				Visibility="{Binding Race.RowEnum, Converter={StaticResource EnumToVisibility}, ConverterParameter=Hrothgar|Miqote|AuRa}" />
			<Grid Visibility="{Binding Race.RowEnum, Converter={StaticResource EnumToVisibility}, ConverterParameter=Hrothgar|Miqote|AuRa}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<customize:CustomizeIconOption
					Grid.RowSpan="2"
					Grid.Column="0"
					Margin="0,0,1,0"
					Menu="{Binding MakeType.TailEarsTypes}"
					Value="{Binding TailEarsType}" />

				<customize:CustomizeNumberOption
					Grid.Row="0"
					Grid.Column="1"
					Menu="{Binding MakeType.TailEarsTypes}"
					Value="{Binding TailEarsType}" />

				<xivToolsWpf:NumberBox
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Margin="0,1,0,1"
					Maximum="{Binding MakeType.EarMuscleTailSizes.Max}"
					Minimum="{Binding MakeType.EarMuscleTailSizes.Min}"
					Slider="Absolute"
					TickFrequency="1"
					Value="{Binding EarMuscleTailSize}" />
			</Grid>

			<!--  Face  -->
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding MakeType.Faces.Name}" />
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<customize:CustomizeIconOption
					Grid.RowSpan="2"
					Grid.Column="0"
					Margin="0,0,1,0"
					Menu="{Binding MakeType.Faces}"
					Value="{Binding Face}" />

				<customize:CustomizeNumberOption
					Grid.Row="0"
					Grid.Column="1"
					Menu="{Binding MakeType.Faces}"
					Value="{Binding Face}" />


			</Grid>

			<!--  Skin Color  -->
			<TextBlock
				Style="{StaticResource LeftLabel}"
				Text="{Binding MakeType.SkinTones.Name}" />

			<customize:CustomizeColorOption
				Menu="{Binding MakeType.SkinTones}"
				Value="{Binding SkinTone}" />

		</StackPanel>
	</ScrollViewer>

</windows:PanelWindow>
