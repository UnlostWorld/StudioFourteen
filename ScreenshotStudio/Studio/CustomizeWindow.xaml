<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.CustomizeWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="{DynamicResource Customize}"
	Width="350"
	Height="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding ActorName}"
	TitleIcon="UserEdit"
	mc:Ignorable="d">

	<ScrollViewer>
		<StackPanel IsEnabled="{Binding HasValidTarget}">
			<Grid
				Grid.Row="0"
				Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<ComboBox
					Grid.Column="0"
					ItemsSource="{Binding Races}"
					SelectedItem="{Binding Race}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<ComboBox
					Grid.Column="1"
					ItemsSource="{Binding Race.Tribes}"
					SelectedItem="{Binding Tribe}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</Grid>


		</StackPanel>
	</ScrollViewer>

</windows:PanelWindow>
