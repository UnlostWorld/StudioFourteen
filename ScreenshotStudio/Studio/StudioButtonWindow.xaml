<windows:Panel
	x:Class="ScreenshotStudio.Studio.StudioButtonWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	Title="StudioButtonWindow"
	ShowBackground="False"
	SizeToContent="WidthAndHeight"
	mc:Ignorable="d">
	<Grid
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		MouseDown="OnMouseDown"
		MouseMove="OnMouseMove"
		MouseUp="OnMouseUp">

		<Grid
			x:Name="IconGrid"
			Width="48"
			Height="45">

			<Grid.Effect>
				<DropShadowEffect
					BlurRadius="10"
					ShadowDepth="0" />
			</Grid.Effect>

			<Image Source="pack://application:,,,/ScreenshotStudio;component/Assets/icon-back-shadow.png" />

			<Rectangle Fill="{DynamicResource ForegroundLightBrush}">
				<Rectangle.OpacityMask>
					<ImageBrush ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/icon-back-mask.png" />
				</Rectangle.OpacityMask>
			</Rectangle>
			<!--<Rectangle Fill="{DynamicResource TrimBrush}">
					<Rectangle.OpacityMask>
						<ImageBrush ImageSource="/Assets/icon-front-mask.png" />
					</Rectangle.OpacityMask>
				</Rectangle>-->

			<Grid>
				<Grid.OpacityMask>
					<ImageBrush ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/icon-front-mask.png" />
				</Grid.OpacityMask>

				<Image Source="pack://application:,,,/ScreenshotStudio;component/Assets/rainbow-wheel.png">
					<Image.LayoutTransform>
						<RotateTransform x:Name="ColorWheelTransform" Angle="0" />
					</Image.LayoutTransform>
				</Image>

			</Grid>
		</Grid>
	</Grid>
</windows:Panel>
