<windows:CharacterPanelBase
	x:Class="ScreenshotStudio.Studio.GearWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:excel="clr-namespace:ScreenshotStudio.GameData.Excel"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:studio="clr-namespace:ScreenshotStudio.Studio"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Gear}"
	Width="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	SizeToContent="Height"
	Subtitle="{Binding CharacterName}"
	TitleIcon="ShieldHalved"
	mc:Ignorable="d">

	<Grid IsEnabled="{Binding HasValidTarget}">
		<Grid.Resources>


			<Style
				x:Key="IconButton"
				BasedOn="{StaticResource WpfUtilsButton}"
				TargetType="{x:Type Button}">

				<Setter Property="Width" Value="54" />
				<Setter Property="Height" Value="54" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Button}">
							<Grid
								Cursor="Hand"
								TextBlock.Foreground="{DynamicResource ForegroundLightBrush}">

								<Grid Margin="2">

									<Border
										x:Name="HoverBackground"
										CornerRadius="4"
										Opacity="0"
										Style="{DynamicResource WpfUtilsControlHoverBorder}"
										Visibility="Collapsed" />

									<Grid x:Name="IconHost">
										<Image
											Margin="4,3,4,5"
											SnapsToDevicePixels="True"
											Source="{TemplateBinding Content}" />

										<controls:XivTexImage
											x:Name="IconShine"
											Path="ui/uld/icona_frame_hr1.tex"
											Rect="0, 0, 96, 96"
											SnapsToDevicePixels="True" />
									</Grid>

									<controls:XivTexImage
										x:Name="HoverBorder"
										Margin="-10"
										Opacity="0"
										Path="ui/uld/icona_frame_hr1.tex"
										Rect="480, 0, 145, 145"
										SnapsToDevicePixels="True" />
								</Grid>

							</Grid>

							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="true">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="HoverBackground"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetName="HoverBorder"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="HoverBackground"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="0:0:0.250">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetName="HoverBorder"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="0:0:0.250">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="Content" Value="{x:Null}">
									<Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
									<Setter TargetName="HoverBorder" Property="Visibility" Value="Collapsed" />
									<Setter TargetName="HoverBackground" Property="Visibility" Value="Visible" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>


			<DataTemplate x:Key="ItemView">
				<Grid
					Height="56"
					Margin="0,2,0,2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Border
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="1"
						Style="{DynamicResource WpfUtilsControlBorder}" />

					<controls:XivTexImage
						x:Name="BackgroundIcon"
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="6"
						Opacity="0.75"
						Path="ui/uld/character_hr1.tex"
						Rect="0, 144, 64, 64" />

					<Button
						Grid.RowSpan="2"
						Grid.Column="0"
						Click="OnChangeClicked"
						Content="{Binding Item.Icon.Source}"
						MouseUp="OnMouseUp"
						Style="{DynamicResource IconButton}"
						ToolTip="{Binding Item}" />

					<Button
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="3"
						HorizontalContentAlignment="Stretch"
						Click="OnChangeClicked"
						MouseUp="OnMouseUp">

						<TextBlock
							Grid.Column="0"
							Margin="0,0,3,0"
							Style="{DynamicResource Body}"
							Text="{Binding Item.Name}"
							TextWrapping="NoWrap" />

					</Button>


					<wpfUtils:MultiNumberBox
						Grid.Row="1"
						Grid.Column="1"
						X="{Binding Set}"
						Y="{Binding Base}"
						Z="{Binding Variant}" />

					<Grid
						Grid.Row="1"
						Grid.Column="2"
						Margin="1">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Border
							Grid.ColumnSpan="2"
							Height="26"
							Style="{DynamicResource WpfUtilsControlBorder}" />

						<Button
							Grid.Column="0"
							Width="26"
							Margin="0,0,-3,0"
							Padding="0"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Background="Transparent"
							Click="OnChangeDye1Clicked"
							ToolTip="{Binding Stain0}">

							<Border
								Margin="4"
								BorderBrush="{DynamicResource BackgroundBrush}"
								BorderThickness="1"
								CornerRadius="3">

								<Border.Background>
									<ImageBrush ImageSource="{Binding Stain0.Item.Icon.Source}" />
								</Border.Background>
							</Border>
						</Button>

						<Button
							Grid.Column="1"
							Width="26"
							Margin="1,0,0,0"
							Padding="0"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Background="Transparent"
							Click="OnChangeDye2Clicked"
							ToolTip="{Binding Stain1}">

							<Border
								Margin="4"
								BorderBrush="{DynamicResource BackgroundBrush}"
								BorderThickness="1"
								CornerRadius="3">

								<Border.Background>
									<ImageBrush ImageSource="{Binding Stain1.Item.Icon.Source}" />
								</Border.Background>
							</Border>
						</Button>
					</Grid>
				</Grid>

				<DataTemplate.Triggers>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="OffHand">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="64, 144, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Head">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="128, 144, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Body">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="192, 144, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Hands">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="256, 144, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Legs">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="384, 144, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Feet">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="0, 208, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Ears">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="64, 208, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Neck">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="128, 208, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="Wrists">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="192, 208, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="RFinger">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="256, 208, 64, 64" />
					</DataTrigger>
					<DataTrigger
						Binding="{Binding Slot}"
						Value="LFinger">
						<Setter TargetName="BackgroundIcon" Property="Rect" Value="256, 208, 64, 64" />
					</DataTrigger>
				</DataTemplate.Triggers>

			</DataTemplate>

			<DataTemplate
				x:Key="AccessoryView"
				DataType="{x:Type studio:AccessoryViewModel}">
				<Grid
					Height="56"
					Margin="0,2,0,2"
					IsEnabled="{Binding HasValidTarget, FallbackValue=false}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Border
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="1"
						Style="{DynamicResource WpfUtilsControlBorder}" />

					<controls:XivTexImage
						x:Name="BackgroundIcon"
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="6"
						Opacity="0.75"
						Path="ui/uld/character_hr1.tex"
						Rect="0, 376, 64, 64" />

					<Button
						Grid.RowSpan="2"
						Grid.Column="0"
						Click="OnChangeClicked"
						Content="{Binding Item.Icon.Source}"
						MouseUp="OnMouseUp"
						Style="{DynamicResource IconButton}"
						ToolTip="{Binding Item}" />

					<Button
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="3"
						HorizontalContentAlignment="Stretch"
						Click="OnChangeClicked"
						MouseUp="OnMouseUp">

						<TextBlock
							Grid.Column="0"
							Margin="0,0,3,0"
							Style="{DynamicResource Body}"
							Text="{Binding Item.Name}"
							TextWrapping="NoWrap" />

					</Button>

					<wpfUtils:NumberBox
						Grid.Row="1"
						Grid.Column="1"
						Minimum="0"
						Value="{Binding Value}" />

				</Grid>
			</DataTemplate>

			<DataTemplate
				x:Key="OrnamentView"
				DataType="{x:Type studio:OrnamentViewModel}">
				<Grid
					Height="56"
					Margin="0,2,0,2"
					IsEnabled="{Binding HasValidTarget, FallbackValue=false}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Border
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="1"
						Style="{DynamicResource WpfUtilsControlBorder}" />


					<Image
						x:Name="BackgroundIcon"
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="6"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Opacity="0.25"
						Source="pack://application:,,,/ScreenshotStudio;component/Assets/icon-fashion-accessories.png" />

					<Button
						Grid.RowSpan="2"
						Grid.Column="0"
						Click="OnChangeClicked"
						Content="{Binding Item.Icon.Source}"
						MouseUp="OnMouseUp"
						Style="{DynamicResource IconButton}"
						ToolTip="{Binding Item}" />

					<Button
						Grid.Row="0"
						Grid.Column="1"
						Grid.ColumnSpan="3"
						HorizontalContentAlignment="Stretch"
						Click="OnChangeClicked"
						MouseUp="OnMouseUp">

						<TextBlock
							Grid.Column="0"
							Margin="0,0,3,0"
							Style="{DynamicResource Body}"
							Text="{Binding Item.Name}"
							TextWrapping="NoWrap" />

					</Button>

					<wpfUtils:NumberBox
						Grid.Row="1"
						Grid.Column="1"
						Minimum="0"
						Value="{Binding Value}" />

				</Grid>

				<DataTemplate.Triggers>
					<DataTrigger
						Binding="{Binding HasValidTarget}"
						Value="False">
						<Setter Property="Opacity" Value="0.5" />
					</DataTrigger>
				</DataTemplate.Triggers>

			</DataTemplate>
		</Grid.Resources>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<UniformGrid Columns="2">

			<ContentPresenter
				Grid.Column="0"
				Margin="0,2,6,2"
				Content="{Binding MainHand}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Grid.Column="1"
				Content="{Binding OffHand}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Margin="0,2,6,2"
				Content="{Binding Head}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Earring}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Margin="0,2,6,2"
				Content="{Binding Chest}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Necklace}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Margin="0,2,6,2"
				Content="{Binding Hands}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Bracelet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Margin="0,2,6,2"
				Content="{Binding Legs}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingRight}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Margin="0,2,6,2"
				Content="{Binding Feet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingLeft}"
				ContentTemplate="{StaticResource ItemView}" />

			<ContentPresenter
				Content="{Binding Glasses}"
				ContentTemplate="{StaticResource AccessoryView}" />

			<ContentPresenter
				Content="{Binding Ornament}"
				ContentTemplate="{StaticResource OrnamentView}" />
		</UniformGrid>

		<Border
			Grid.Row="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel Orientation="Horizontal">
				<Button
					Grid.Column="0"
					Click="OnRevertClicked"
					IsEnabled="{Binding CanRevert}"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>
			</StackPanel>
		</Border>

	</Grid>
</windows:CharacterPanelBase>
