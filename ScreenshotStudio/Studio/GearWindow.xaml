<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.GearWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="{DynamicResource Gear}"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	SizeToContent="WidthAndHeight"
	TitleIcon="HelmetBattle"
	mc:Ignorable="d">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<UniformGrid
			Grid.Row="1"
			Columns="2">
			<UniformGrid.Resources>
				<DataTemplate
					x:Key="ItemView"
					DataType="{x:Type local:ItemEquipViewModel}">
					<Grid
						Width="200"
						Height="56"
						Margin="2,2,6,2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="75" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid
							Grid.RowSpan="2"
							Grid.Column="0"
							Width="48"
							Height="48"
							Margin="0,3,0,0"
							VerticalAlignment="Center">

							<controls:XivTexImage
								x:Name="IconBack"
								Margin="0,-1,0,1"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 192, 96, 96"
								SnapsToDevicePixels="True"
								Visibility="Collapsed" />

							<Image
								Margin="4,3,4,5"
								SnapsToDevicePixels="True"
								Source="{Binding Item.Icon.Source}" />

							<controls:XivTexImage
								x:Name="IconShine"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 0, 96, 96"
								SnapsToDevicePixels="True" />
						</Grid>

						<Button
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="3"
							Margin="0,3,0,0"
							HorizontalContentAlignment="Stretch">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock
									Grid.Column="0"
									Margin="0,0,3,0"
									Style="{DynamicResource Body}"
									Text="{Binding Item.DisplayName}"
									TextWrapping="NoWrap" />

								<xivToolsWpf:IconBlock
									Grid.Column="1"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="ExternalLinkSquare" />
							</Grid>
						</Button>


						<xivToolsWpf:MultiNumberBox
							Grid.Row="1"
							Grid.Column="1"
							Height="24"
							Margin="0,1,1,3"
							X="{Binding Set}"
							Y="{Binding Base}"
							Z="{Binding Variant}" />

						<Button
							Grid.Row="1"
							Grid.Column="2"
							Grid.ColumnSpan="3"
							Margin="0,1,0,3"
							Padding="0"
							HorizontalContentAlignment="Stretch">

							<Grid Margin="4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock
									x:Name="TextArea"
									Grid.Column="1"
									Margin="6,0,3,1"
									Style="{DynamicResource Body}"
									Text="{Binding Dye, FallbackValue=0}" />

								<xivToolsWpf:IconBlock
									Grid.Column="2"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="ExternalLinkSquare" />
							</Grid>
						</Button>

					</Grid>

					<DataTemplate.Triggers>
						<DataTrigger
							Binding="{Binding Item.HasIcon, FallbackValue=False}"
							Value="False">
							<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
						</DataTrigger>
					</DataTemplate.Triggers>

				</DataTemplate>

			</UniformGrid.Resources>

			<ContentPresenter
				Content="{Binding Head}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Earring}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Chest}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Necklace}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Hands}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Bracelet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Legs}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingRight}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Feet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingLeft}"
				ContentTemplate="{StaticResource ItemView}" />
		</UniformGrid>
	</Grid>
</windows:PanelWindow>
