<windows:ActorWindow
	x:Class="ScreenshotStudio.Studio.GearWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="{DynamicResource Gear}"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	SizeToContent="WidthAndHeight"
	Subtitle="{Binding ActorName}"
	TitleIcon="HelmetBattle"
	mc:Ignorable="d">

	<Grid IsEnabled="{Binding HasValidTarget}">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<UniformGrid
			Grid.Row="1"
			Columns="2">
			<UniformGrid.Resources>
				<DataTemplate
					x:Key="ItemView"
					DataType="{x:Type local:ItemEquipViewModel}">
					<Grid
						Width="200"
						Height="56"
						Margin="2,2,6,2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="75" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Button
							Grid.RowSpan="2"
							Grid.Column="0"
							Width="54"
							Height="54"
							Click="OnChangeClicked"
							Content="{Binding Item.Icon.Source}"
							MouseUp="OnMouseUp">

							<Button.Template>
								<ControlTemplate TargetType="Button">

									<Grid
										Cursor="Hand"
										TextBlock.Foreground="{DynamicResource ForegroundLightBrush}">

										<Border
											Background="{TemplateBinding Background}"
											Style="{DynamicResource XivToolsControlBorder}" />

										<Grid Margin="2">

											<Border
												x:Name="HoverBackground"
												CornerRadius="4"
												Opacity="0"
												Style="{DynamicResource XivToolsControlHoverBorder}"
												Visibility="Collapsed" />

											<Grid x:Name="IconHost">
												<Image
													Margin="4,3,4,5"
													SnapsToDevicePixels="True"
													Source="{TemplateBinding Content}" />

												<controls:XivTexImage
													x:Name="IconShine"
													Path="ui/uld/icona_frame_hr1.tex"
													Rect="0, 0, 96, 96"
													SnapsToDevicePixels="True" />
											</Grid>

											<controls:XivTexImage
												x:Name="HoverBorder"
												Margin="-10"
												Opacity="0"
												Path="ui/uld/icona_frame_hr1.tex"
												Rect="480, 0, 145, 145"
												SnapsToDevicePixels="True" />
										</Grid>

									</Grid>

									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="true">
											<Trigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="HoverBackground"
															Storyboard.TargetProperty="Opacity"
															To="1"
															Duration="0:0:0.150">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseOut" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
														<DoubleAnimation
															Storyboard.TargetName="HoverBorder"
															Storyboard.TargetProperty="Opacity"
															To="1"
															Duration="0:0:0.150">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseOut" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</Trigger.EnterActions>
											<Trigger.ExitActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="HoverBackground"
															Storyboard.TargetProperty="Opacity"
															To="0"
															Duration="0:0:0.250">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseIn" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
														<DoubleAnimation
															Storyboard.TargetName="HoverBorder"
															Storyboard.TargetProperty="Opacity"
															To="0"
															Duration="0:0:0.250">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseIn" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</Trigger.ExitActions>
										</Trigger>
										<Trigger Property="Content" Value="{x:Null}">
											<Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
											<Setter TargetName="HoverBorder" Property="Visibility" Value="Collapsed" />
											<Setter TargetName="HoverBackground" Property="Visibility" Value="Visible" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>


						</Button>

						<Button
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="3"
							HorizontalContentAlignment="Stretch"
							Click="OnChangeClicked"
							MouseUp="OnMouseUp">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock
									Grid.Column="0"
									Margin="0,0,3,0"
									Style="{DynamicResource Body}"
									Text="{Binding Item.Name}"
									TextWrapping="NoWrap" />

								<xivToolsWpf:IconBlock
									Grid.Column="1"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="ExternalLinkSquare" />
							</Grid>
						</Button>


						<xivToolsWpf:MultiNumberBox
							Grid.Row="1"
							Grid.Column="1"
							X="{Binding Set}"
							Y="{Binding Base}"
							Z="{Binding Variant}" />

						<Button
							Grid.Row="1"
							Grid.Column="2"
							Grid.ColumnSpan="3"
							Padding="0"
							HorizontalContentAlignment="Stretch">

							<Grid Margin="4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock
									x:Name="TextArea"
									Grid.Column="1"
									Margin="6,0,3,1"
									Style="{DynamicResource Body}"
									Text="{Binding Dye, FallbackValue=0}" />

								<xivToolsWpf:IconBlock
									Grid.Column="2"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="ExternalLinkSquare" />
							</Grid>
						</Button>

					</Grid>

				</DataTemplate>

			</UniformGrid.Resources>

			<ContentPresenter
				Content="{Binding Head}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Earring}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Chest}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Necklace}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Hands}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Bracelet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Legs}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingRight}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding Feet}"
				ContentTemplate="{StaticResource ItemView}" />
			<ContentPresenter
				Content="{Binding RingLeft}"
				ContentTemplate="{StaticResource ItemView}" />
		</UniformGrid>
	</Grid>
</windows:ActorWindow>
