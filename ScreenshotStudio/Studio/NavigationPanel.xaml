<windows:DockPanel
	x:Class="ScreenshotStudio.Studio.NavigationPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="NavigationPanel"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DockPosition="0,0"
	ShowBackground="False"
	SizeToContent="WidthAndHeight"
	mc:Ignorable="d">

	<Grid Margin="0,6,0,0">
		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="StudioButtonStyle.xaml" />
				</ResourceDictionary.MergedDictionaries>

				<BooleanToVisibilityConverter x:Key="B2V" />
				<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
			</ResourceDictionary>
		</Grid.Resources>

		<ContentPresenter
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Content="{Binding .}">
			<ContentPresenter.ContentTemplate>
				<DataTemplate>

					<Border
						x:Name="MainBorder"
						Margin="14,30,0,0"
						Background="{DynamicResource BackgroundBrush}"
						BorderBrush="{DynamicResource BackgroundBrush}"
						BorderThickness="1"
						CornerRadius="0,0,6,6">

						<Border.RenderTransform>
							<TranslateTransform x:Name="PanelTranslate" Y="0" />
						</Border.RenderTransform>

						<Border
							Margin="3"
							Style="{DynamicResource WpfUtilsControlBorder}">
							<StackPanel x:Name="Stack">

								<StackPanel.OpacityMask>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Offset="0" Color="White" />
										<GradientStop x:Name="WipeA" Offset="1" Color="White" />
										<GradientStop x:Name="WipeB" Offset="1.1" Color="Transparent" />
									</LinearGradientBrush>
								</StackPanel.OpacityMask>

								<StackPanel.Resources>
									<Style
										BasedOn="{StaticResource WpfUtilsToggleButton}"
										TargetType="{x:Type ToggleButton}">
										<Setter Property="Width" Value="32" />
										<Setter Property="Height" Value="32" />
										<Setter Property="Margin" Value="0" />
									</Style>

									<Style TargetType="{x:Type Line}">
										<Setter Property="Width" Value="24" />
										<Setter Property="Margin" Value="0,3" />
										<Setter Property="Stroke" Value="{DynamicResource BackgroundLightBrush}" />
										<Setter Property="X1" Value="0" />
										<Setter Property="X2" Value="1" />
										<Setter Property="StrokeThickness" Value="1" />
										<Setter Property="Stretch" Value="Fill" />
									</Style>
								</StackPanel.Resources>

								<Rectangle Height="10" />

								<ToggleButton
									Width="32"
									Height="32"
									IsChecked="{Binding IsInGPose}"
									ToolTip="{DynamicResource LOC_ToggleGPose}">

									<Polygon Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Path=Foreground}">
										<Polygon.Points>
											0,0
											0,8
											1,8
											5,4
											5,7
											6,8
											15,8
											16,7
											16,1
											15,0
											6,0
											5,1
											5,4
											1,0
										</Polygon.Points>
									</Polygon>
								</ToggleButton>

								<Line />

								<ToggleButton
									IsChecked="{Binding IsLibraryOpen}"
									ToolTip="{DynamicResource LOC_Library}">
									<wpfUtils:IconBlock Icon="Books" />
								</ToggleButton>

								<ToggleButton
									IsChecked="{Binding IsZoneOpen}"
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_Zone}">
									<wpfUtils:IconBlock Icon="CloudMoonRain" />
								</ToggleButton>

								<ToggleButton
									IsChecked="{Binding IsCameraOpen}"
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_Camera}">
									<wpfUtils:IconBlock Icon="CameraMovie" />
								</ToggleButton>

								<Line />

								<ToggleButton
									IsChecked="{Binding IsCustomizeOpen}"
									ToolTip="{DynamicResource LOC_Customize}">
									<wpfUtils:IconBlock Icon="UserEdit" />
								</ToggleButton>

								<ToggleButton
									IsChecked="{Binding IsGearOpen}"
									ToolTip="{DynamicResource LOC_Gear}">
									<wpfUtils:IconBlock Icon="HelmetBattle" />
								</ToggleButton>

								<ToggleButton
									IsChecked="{Binding IsShadersOpen}"
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_ShaderParameters}">
									<wpfUtils:IconBlock Icon="Shapes" />
								</ToggleButton>

								<ToggleButton
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_Expression}">
									<wpfUtils:IconBlock Icon="FaceGrinHearts" />
								</ToggleButton>

								<ToggleButton
									IsChecked="{Binding IsPoseOpen}"
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_Pose}">
									<wpfUtils:IconBlock Icon="Running" />
								</ToggleButton>

								<Line />

								<ToggleButton
									x:Name="SettingsButton"
									IsChecked="{Binding IsSettingsOpen}"
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_Settings}">
									<wpfUtils:IconBlock Icon="cogs" />
								</ToggleButton>

								<Line />

								<ToggleButton
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_SaveCharacter}">
									<Grid>
										<wpfUtils:IconBlock
											Margin="-3,-1,3,1"
											Icon="FloppyDisk"
											Style="{DynamicResource IconCircleCutout}" />

										<wpfUtils:IconBlock
											Margin="3,5,-3,-4"
											FontSize="7"
											Icon="User" />
									</Grid>
								</ToggleButton>

								<ToggleButton
									IsEnabled="False"
									ToolTip="{DynamicResource LOC_SavePose}">
									<Grid>
										<wpfUtils:IconBlock
											Margin="-3,-1,3,1"
											Icon="FloppyDisk"
											Style="{DynamicResource IconCircleCutout}" />
										<wpfUtils:IconBlock
											Margin="3,5,-3,-4"
											FontSize="9"
											Icon="Running" />

									</Grid>
								</ToggleButton>


							</StackPanel>
						</Border>
					</Border>

					<DataTemplate.Triggers>

						<DataTrigger
							Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Value="True">
							<Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
						</DataTrigger>

						<DataTrigger
							Binding="{Binding IsExpanded}"
							Value="False">
							<Setter Property="IsHitTestVisible" Value="False" />

							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="PanelTranslate"
											Storyboard.TargetProperty="Y"
											From="0"
											To="-25"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<DoubleAnimation
											Storyboard.TargetName="MainBorder"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="WipeA"
											Storyboard.TargetProperty="Offset"
											From="0"
											To="1"
											Duration="0:00:00.500">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<DoubleAnimation
											Storyboard.TargetName="WipeB"
											Storyboard.TargetProperty="Offset"
											From="0.1"
											To="1.1"
											Duration="0:00:00.500">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<DoubleAnimation
											Storyboard.TargetName="PanelTranslate"
											Storyboard.TargetProperty="Y"
											From="-25"
											To="0"
											Duration="0:00:00.350">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<DoubleAnimation
											Storyboard.TargetName="MainBorder"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:00:00.100">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseIn" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</DataTemplate.Triggers>

				</DataTemplate>
			</ContentPresenter.ContentTemplate>
		</ContentPresenter>

		<Button
			Name="StudioButton"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Click="OnStudioClicked"
			Style="{StaticResource StudioButton}" />

	</Grid>
</windows:DockPanel>
