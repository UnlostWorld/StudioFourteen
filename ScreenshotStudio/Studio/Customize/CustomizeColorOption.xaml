<UserControl
	x:Class="ScreenshotStudio.Studio.Customize.CustomizeColorOption"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:XivToolsWpf.Behaviours;assembly=XivToolsWpf"
	xmlns:controls="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	xmlns:converters="clr-namespace:XivToolsWpf.Converters;assembly=XivToolsWpf"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Customize"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Height="26"
	Margin="1"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/XivToolsWpf;component/Styles/ComboBoxStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="B2V" />
			<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
			<converters:BoolInversionConverter x:Key="!B" />
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid x:Name="ContentArea">

		<Grid.ColumnDefinitions>
			<ColumnDefinition MaxWidth="80" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Border
			Grid.Column="1"
			Margin="0"
			CornerRadius="{Binding RightElementCornerRadius}"
			Style="{DynamicResource XivToolsControlBorder}" />

		<ComboBox
			Grid.Column="0"
			Height="26"
			Margin="0"
			Foreground="Black"
			ItemsSource="{Binding Menu.Options}"
			SelectedItem="{Binding Option}"
			Style="{DynamicResource XivToolsComboBoxNoBorder}">

			<ComboBox.Template>
				<ControlTemplate TargetType="{x:Type ComboBox}">

					<Grid>

						<ToggleButton
							Name="toggleButton"
							Margin="0"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Background="Transparent"
							Foreground="Black"
							IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

							<Border
								Margin="0"
								BorderBrush="{DynamicResource ControlBackgroundBrush}"
								BorderThickness="1"
								CornerRadius="6,0,0,6">
								<Border.Background>
									<SolidColorBrush Color="{Binding Option.Color.WpfColor}" />
								</Border.Background>

								<Path
									x:Name="Chevron"
									Margin="3"
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									Data="M 0,0 5,3 10,0"
									Stroke="{TemplateBinding Foreground}"
									StrokeThickness="1" />
							</Border>

						</ToggleButton>

						<Popup
							Name="PART_Popup"
							Grid.Column="0"
							MinWidth="{Binding ElementName=toggleButton, Path=ActualWidth}"
							Margin="-16"
							AllowsTransparency="True"
							Focusable="False"
							IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							Placement="Bottom"
							PlacementTarget="{Binding ElementName=toggleButton}"
							PopupAnimation="Fade"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
							UseLayoutRounding="{TemplateBinding UseLayoutRounding}">

							<Grid Margin="16">
								<Border
									Background="Black"
									CornerRadius="6">
									<Border.Effect>
										<DropShadowEffect
											Direction="270"
											ShadowDepth="0" />
									</Border.Effect>
								</Border>

								<Border
									Background="{DynamicResource BackgroundBrush}"
									CornerRadius="6" />

								<Border
									Margin="3"
									Style="{DynamicResource XivToolsControlBorder}" />

								<ScrollViewer
									MinHeight="1"
									MaxHeight="{TemplateBinding MaxDropDownHeight}"
									Margin="5"
									behaviours:SmoothScrollBehaviour.SmoothScroll="True">
									<ItemsPresenter Name="ItemsPresenter" />
								</ScrollViewer>

							</Grid>

						</Popup>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chevron" Property="Stroke" Value="#77FFFFFF" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chevron" Property="Opacity" Value="0.1" />
						</Trigger>
					</ControlTemplate.Triggers>

				</ControlTemplate>
			</ComboBox.Template>

			<ComboBox.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="8" />
				</ItemsPanelTemplate>
			</ComboBox.ItemsPanel>

			<ComboBox.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource XivToolsComboBoxItem}"
					TargetType="{x:Type ComboBoxItem}">
					<Setter Property="Padding" Value="0" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Stretch" />
					<Setter Property="HorizontalAlignment" Value="Stretch" />
					<Setter Property="VerticalAlignment" Value="Stretch" />
					<Setter Property="IsEnabled" Value="{Binding Color.Skip, Converter={StaticResource !B}}" />
					<Setter Property="Visibility" Value="{Binding Color.Skip, Converter={StaticResource !B2V}}" />
				</Style>
			</ComboBox.ItemContainerStyle>

			<ComboBox.ItemTemplate>
				<DataTemplate>
					<Border
						Height="20"
						Margin="0"
						BorderThickness="1"
						CornerRadius="3">
						<Border.BorderBrush>
							<SolidColorBrush Color="{Binding Color.WpfColor, FallbackValue=Transparent}" />
						</Border.BorderBrush>

						<Grid>
							<Border
								Width="10"
								HorizontalAlignment="Left"
								CornerRadius="2,0,0,2">
								<Border.Background>
									<SolidColorBrush Color="{Binding Color.WpfColor, FallbackValue=Transparent}" />
								</Border.Background>
							</Border>

							<TextBlock
								Margin="12,2,2,2"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundBrush}"
								Text="{Binding Value}" />
						</Grid>

						<Border.ToolTip>
							<StackPanel Orientation="Vertical">
								<TextBlock Text="{Binding Value}" />
								<TextBlock Text="{Binding Color.Hex}" />
							</StackPanel>
						</Border.ToolTip>
					</Border>
				</DataTemplate>
			</ComboBox.ItemTemplate>

		</ComboBox>

		<controls:NumberBox
			Grid.Column="1"
			Margin="0"
			BorderBrush="Transparent"
			Buttons="True"
			Maximum="255"
			Minimum="0"
			ValueOffset="1"
			Value="{Binding Value}" />

	</Grid>
</UserControl>
