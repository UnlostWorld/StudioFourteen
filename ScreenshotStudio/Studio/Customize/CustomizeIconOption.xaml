<UserControl
	x:Class="ScreenshotStudio.Studio.Customize.CustomizeIconOption"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Customize"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="80"
	mc:Ignorable="d">

	<UserControl.Resources>
		<converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
		<BooleanToVisibilityConverter x:Key="B2V" />
	</UserControl.Resources>

	<Grid x:Name="ContentArea">

		<ComboBox
			Height="54"
			ItemsSource="{Binding Menu.Options}"
			SelectedItem="{Binding Option}">

			<ComboBox.ToolTip>
				<StackPanel>
					<TextBlock Text="{Binding Menu.Name}" />
					<TextBlock
						Text="{Binding Option.Customize.Name}"
						Visibility="{Binding Option.Customize.Name, FallbackValue=Collapsed, Converter={StaticResource NotEmptyToVisibilityConverter}}" />
				</StackPanel>
			</ComboBox.ToolTip>

			<ComboBox.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid
						Width="350"
						Columns="4" />
				</ItemsPanelTemplate>
			</ComboBox.ItemsPanel>

			<ComboBox.ItemTemplate>
				<DataTemplate>
					<Viewbox>
						<Grid Visibility="{Binding Enabled, Converter={StaticResource B2V}}">

							<Grid.ToolTip>
								<TextBlock Text="{Binding Customize.Name}" />
							</Grid.ToolTip>

							<Grid
								x:Name="Icon"
								Width="64"
								Height="64"
								Margin="0,2"
								RenderTransformOrigin="0.5,0.5">

								<Grid.RenderTransform>
									<ScaleTransform ScaleX="1" />
								</Grid.RenderTransform>

								<Border
									BorderThickness="1"
									CornerRadius="6"
									SnapsToDevicePixels="True">
									<Border.Background>
										<ImageBrush
											ImageSource="{Binding Icon.Source}"
											Stretch="Uniform" />
									</Border.Background>
								</Border>

								<Border
									BorderBrush="{DynamicResource ControlBackgroundBrush}"
									BorderThickness="1"
									CornerRadius="6"
									SnapsToDevicePixels="True" />

							</Grid>


							<Image
								Width="20"
								Height="20"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Source="{Binding Customize.ItemIcon.Source}" />

						</Grid>
					</Viewbox>

					<DataTemplate.Triggers>
						<DataTrigger
							Binding="{Binding Flipped, RelativeSource={RelativeSource AncestorType=local:CustomizeIconOption}}"
							Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Icon"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											To="-1"
											Duration="0:0:0.150">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Icon"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											To="1"
											Duration="0:0:0.150">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</DataTemplate.Triggers>

				</DataTemplate>
			</ComboBox.ItemTemplate>


		</ComboBox>

	</Grid>
</UserControl>
