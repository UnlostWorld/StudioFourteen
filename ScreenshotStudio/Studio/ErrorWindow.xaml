<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.ErrorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource Error}"
	Width="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	SizeToContent="Height"
	TitleIcon="ExclamationCircle"
	mc:Ignorable="d">
	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Line
			Grid.Row="0"
			Margin="-2"
			VerticalAlignment="Top"
			Stretch="Fill"
			Stroke="DarkRed"
			StrokeThickness="1"
			X1="0"
			X2="1" />

		<TextBlock
			Grid.Row="1"
			Margin="3,0,3,3"
			Style="{DynamicResource Body}"
			Text="{DynamicResource ErrorBodyMessage}" />

		<TextBlock
			Grid.Row="2"
			Margin="15"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Style="{DynamicResource Body}"
			Text="{Binding ErrorMessage}" />

		<StackPanel Grid.Row="3">
			<TextBlock
				Margin="3,3,3,0"
				HorizontalAlignment="Center"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				Text="{DynamicResource ErrorBodyLog}" />

			<TextBlock
				Margin="3,3,3,6"
				HorizontalAlignment="Center"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				Text="{DynamicResource ErrorBodyCheck}" />
		</StackPanel>

		<Border
			Grid.Row="4"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<StackPanel
					HorizontalAlignment="Left"
					Orientation="Horizontal">

					<Button
						Background="Transparent"
						Click="OnConsoleClicked">
						<TextBlock
							Margin="3,0"
							Text="{DynamicResource Console}" />
					</Button>

					<Button
						Background="Transparent"
						Click="OnGitHubClicked">
						<StackPanel
							Margin="3,0"
							Orientation="Horizontal">
							<wpfUtils:IconBlock
								Margin="0,0,6,0"
								FontSize="10"
								Icon="Github"
								IconStyle="Brand" />
							<TextBlock Text="{DynamicResource GitHub}" />
						</StackPanel>
					</Button>

					<Button
						Background="Transparent"
						Click="OnDiscordClicked">
						<StackPanel
							Margin="3,0"
							Orientation="Horizontal">
							<wpfUtils:IconBlock
								Margin="0,0,6,0"
								FontSize="10"
								Icon="Discord"
								IconStyle="Brand" />
							<TextBlock Text="{DynamicResource Discord}" />
						</StackPanel>
					</Button>

				</StackPanel>

				<Button
					Width="75"
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnConfirmClicked">
					<TextBlock Text="{DynamicResource Confirm}" />
				</Button>
			</Grid>
		</Border>


	</Grid>
</windows:PanelWindow>
