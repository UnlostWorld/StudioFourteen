<windows:DockPanel
	x:Class="ScreenshotStudio.Studio.TargetPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="TargetPanel"
	Width="800"
	Height="56"
	HorizontalAlignment="Center"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DockPosition="0.5,0"
	IsShown="{Binding IsInGPose}"
	mc:Ignorable="d">

	<StackPanel
		Margin="1"
		HorizontalAlignment="Center"
		VerticalAlignment="Top"
		Orientation="Horizontal">
		<Border
			Margin="1"
			Style="{DynamicResource XivToolsControlBorder}">
			<ItemsControl
				MinWidth="75"
				ItemsSource="{Binding Actors}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type local:ActorViewModel}">

						<Grid
							x:Name="ContentArea"
							Width="0">

							<ToggleButton
								Width="75"
								HorizontalAlignment="Center"
								Background="Transparent"
								IsChecked="{Binding IsCurrent}">
								<TextBlock
									HorizontalAlignment="Center"
									Text="{Binding Name}" />
							</ToggleButton>
						</Grid>

						<DataTemplate.Triggers>
							<DataTrigger
								Binding="{Binding IsValid}"
								Value="True">
								<DataTrigger.EnterActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation
												Storyboard.TargetName="ContentArea"
												Storyboard.TargetProperty="Width"
												To="75"
												Duration="0:00:00.150">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</DataTrigger.EnterActions>
								<DataTrigger.ExitActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation
												Storyboard.TargetName="ContentArea"
												Storyboard.TargetProperty="Width"
												To="0"
												Duration="0:00:00.250">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</DataTrigger.ExitActions>
							</DataTrigger>
						</DataTemplate.Triggers>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<Button
			Width="32"
			Click="OnAddActorClicked">
			<xivToolsWpf:IconBlock Icon="Plus" />
		</Button>

		<Button
			Width="32"
			Click="OnRemoveActorClicked">
			<xivToolsWpf:IconBlock Icon="TrashAlt" />
		</Button>

	</StackPanel>

</windows:DockPanel>
