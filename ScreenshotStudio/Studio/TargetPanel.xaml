<windows:DockPanel
	x:Class="ScreenshotStudio.Studio.TargetPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="TargetPanel"
	Width="800"
	HorizontalAlignment="Center"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DockPosition="0.5,0"
	SizeToContent="Height"
	mc:Ignorable="d">

	<StackPanel
		Margin="1"
		Orientation="Horizontal">
		<!--<ListBox
			ItemsSource="{Binding Actors}"
			SelectedItem="{Binding Services.Targets.CurrentTarget}"
			Style="{DynamicResource XivToolsSwitchSelector}">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="{x:Type structs:ActorViewModel}">
					<Grid Width="75">
						<TextBlock
							HorizontalAlignment="Center"
							Text="{Binding DisplayName}" />
					</Grid>

				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>-->

		<Button Width="32">
			<xivToolsWpf:IconBlock Icon="Plus" />
		</Button>

		<Button
			Width="32"
			IsEnabled="False">
			<xivToolsWpf:IconBlock Icon="TrashAlt" />
		</Button>

	</StackPanel>

</windows:DockPanel>
