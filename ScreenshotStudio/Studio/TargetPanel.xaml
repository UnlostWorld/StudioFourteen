<windows:DockPanel
	x:Class="ScreenshotStudio.Studio.TargetPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:services="clr-namespace:ScreenshotStudio.Services"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	Title="TargetPanel"
	Width="450"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DockPosition="0.5,0"
	SizeToContent="Height"
	mc:Ignorable="d">

	<StackPanel>
		<ListBox
			ItemsSource="{Binding Services.Targets.Actors}"
			SelectedItem="{Binding Services.Targets.CurrentTarget}"
			Style="{DynamicResource XivToolsSwitchSelector}">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="{x:Type services:Actor}">
					<TextBlock Text="{Binding DisplayName}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</StackPanel>

</windows:DockPanel>
