<windows:PanelWindow
	x:Class="ScreenshotStudio.Studio.ZoneWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Zone}"
	Width="350"
	Height="150"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	TitleIcon="HelmetBattle"
	mc:Ignorable="d">
	<Grid>

		<Grid>



			<Button
				Click="OnChangeZoneClicked"
				Content="Change Zone"
				IsEnabled="{Binding CanChangeZone}"
				ToolTipService.ShowOnDisabled="True">
				<Button.Style>
					<Style
						BasedOn="{StaticResource WpfUtilsButton}"
						TargetType="{x:Type Button}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding CanChangeZone}"
								Value="False">
								<Setter Property="ToolTip">
									<Setter.Value>
										<Grid MaxWidth="300">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>

											<wpfUtils:IconBlock
												Grid.Column="0"
												FontSize="32"
												Icon="TriangleExclamation" />
											<TextBlock
												Grid.Column="1"
												Margin="12,0,0,0"
												Text="{DynamicResource ChangeZoneWarning}" />
										</Grid>
									</Setter.Value>
								</Setter>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</Grid>
	</Grid>
</windows:PanelWindow>
