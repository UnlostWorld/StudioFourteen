<windows:DockPanel
	x:Class="ScreenshotStudio.Studio.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:xivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	Title="{DynamicResource Pose}"
	Height="600"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DockPosition="1,0"
	ShowBackground="False"
	SizeToContent="Width"
	mc:Ignorable="d">

	<Grid
		Width="160"
		Margin="10"
		VerticalAlignment="Top">
		<StackPanel>

			<!--  Transform  -->
			<Grid>
				<Border
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<StackPanel Margin="3">

					<StackPanel
						Margin="6,0"
						IsHitTestVisible="False"
						Orientation="Horizontal">

						<xivToolsWpf:IconBlock
							MinWidth="12"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="Box" />

						<TextBlock
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="Transform" />
					</StackPanel>

					<Grid
						Width="150"
						Height="150"
						Margin="0,10">
						<Ellipse Fill="{DynamicResource ControlBackgroundBrush}" />
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="Gizmo" />
					</Grid>


					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>


						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{DynamicResource RightLabel}"
							Text="Rot:" />
						<xivToolsWpf:MultiNumberBox
							Grid.Row="0"
							Grid.Column="1" />
						<ToggleButton
							Grid.Row="0"
							Grid.Column="2"
							Style="{DynamicResource XivToolsComboBoxButton}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{DynamicResource RightLabel}"
							Text="Pos:" />
						<xivToolsWpf:MultiNumberBox
							Grid.Row="1"
							Grid.Column="1" />
						<ToggleButton
							Grid.Row="1"
							Grid.Column="2"
							Style="{DynamicResource XivToolsComboBoxButton}" />

						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Style="{DynamicResource RightLabel}"
							Text="Scale:" />
						<xivToolsWpf:MultiNumberBox
							Grid.Row="2"
							Grid.Column="1" />
						<ToggleButton
							Grid.Row="2"
							Grid.Column="2"
							Style="{DynamicResource XivToolsComboBoxButton}" />
					</Grid>
				</StackPanel>
			</Grid>

			<!--  Posing  -->
			<Grid Margin="0,10,0,0">
				<Border
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<StackPanel Margin="3">

					<StackPanel
						Margin="6,0"
						IsHitTestVisible="False"
						Orientation="Horizontal">

						<xivToolsWpf:IconBlock
							MinWidth="12"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="Running" />

						<TextBlock
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="Pose" />
					</StackPanel>

					<CheckBox>
						<TextBlock Text="Enable Posing" />
					</CheckBox>

					<Expander Header="Views">
						<Border
							Grid.Column="1"
							Margin="0,2"
							Style="{DynamicResource XivToolsControlBorder}">
							<StackPanel>

								<CheckBox
									Content="Bone GUI"
									Style="{DynamicResource StudioVisibilityCheckBox}" />

								<CheckBox
									Content="Gizmo GUI"
									Style="{DynamicResource StudioVisibilityCheckBox}" />

								<CheckBox
									Content="Bone Overlay"
									Style="{DynamicResource StudioVisibilityCheckBox}" />

								<CheckBox
									Content="Gizmo Overlay"
									Style="{DynamicResource StudioVisibilityCheckBox}" />

								<CheckBox
									Content="Control Deck"
									Style="{DynamicResource StudioVisibilityCheckBox}" />

							</StackPanel>
						</Border>
					</Expander>

					<TextBlock
						Margin="0,10,0,0"
						HorizontalAlignment="Center"
						Style="{DynamicResource Header}"
						Text="Some Bone Name" />

					<Border
						Grid.Column="1"
						Style="{DynamicResource XivToolsControlBorder}">

						<StackPanel
							HorizontalAlignment="Center"
							Orientation="Horizontal">
							<Button
								Background="Transparent"
								Style="{StaticResource TransparentIconButton}">
								<xivToolsWpf:IconBlock Icon="ArrowCircleUp" />
							</Button>

							<Button
								Background="Transparent"
								Style="{StaticResource TransparentIconButton}">
								<xivToolsWpf:IconBlock Icon="TimesCircle" />
							</Button>

							<Button
								Background="Transparent"
								Style="{StaticResource TransparentIconButton}">
								<xivToolsWpf:IconBlock Icon="ArrowCircleDown" />
							</Button>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</StackPanel>
	</Grid>
</windows:DockPanel>
