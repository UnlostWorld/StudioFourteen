<studio:View
	x:Class="ScreenshotStudio.Studio.Background.Navigation"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Background"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:save="clr-namespace:ScreenshotStudio.Save"
	xmlns:studio="clr-namespace:ScreenshotStudio"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<studio:View.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../../Resources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</studio:View.Resources>

	<Grid VerticalAlignment="Top">
		<Grid.Resources>
			<Storyboard x:Key="Expand">
				<DoubleAnimation
					Storyboard.TargetName="WipeA"
					Storyboard.TargetProperty="Offset"
					From="0"
					To="1"
					Duration="0:00:00.500">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseOut" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>

				<DoubleAnimation
					Storyboard.TargetName="WipeB"
					Storyboard.TargetProperty="Offset"
					From="0.1"
					To="1.1"
					Duration="0:00:00.500">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseOut" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>

				<DoubleAnimation
					Storyboard.TargetName="MainBorder"
					Storyboard.TargetProperty="Opacity"
					To="1"
					Duration="0:00:00.100">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseIn" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>
			</Storyboard>

			<Storyboard x:Key="Collapse">
				<DoubleAnimation
					Storyboard.TargetName="MainBorder"
					Storyboard.TargetProperty="Opacity"
					To="0"
					Duration="0:00:00.250">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseOut" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>
			</Storyboard>
		</Grid.Resources>

		<Grid.Triggers>
			<triggers:StoryboardBindingTrigger
				Binding="{Binding Services.Studio.IsOpen}"
				EnterStoryboard="{StaticResource Expand}"
				ExitStoryboard="{StaticResource Collapse}"
				Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
				Value="True" />
		</Grid.Triggers>

		<Border
			x:Name="MainBorder"
			Background="{DynamicResource BackgroundBrush}"
			CornerRadius="6">

			<Border
				Margin="3"
				Style="{DynamicResource WpfUtilsControlBorder}">
				<StackPanel x:Name="Stack">

					<StackPanel.OpacityMask>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Offset="0" Color="White" />
							<GradientStop x:Name="WipeA" Offset="1" Color="White" />
							<GradientStop x:Name="WipeB" Offset="1.1" Color="Transparent" />
						</LinearGradientBrush>
					</StackPanel.OpacityMask>

					<StackPanel.Resources>
						<Style
							BasedOn="{StaticResource WpfUtilsToggleButton}"
							TargetType="{x:Type ToggleButton}">
							<Setter Property="Width" Value="32" />
							<Setter Property="Height" Value="32" />
							<Setter Property="Margin" Value="0" />
						</Style>

						<Style TargetType="{x:Type Line}">
							<Setter Property="Width" Value="24" />
							<Setter Property="Margin" Value="0,3" />
							<Setter Property="Stroke" Value="{DynamicResource BackgroundLightBrush}" />
							<Setter Property="X1" Value="0" />
							<Setter Property="X2" Value="1" />
							<Setter Property="StrokeThickness" Value="1" />
							<Setter Property="Stretch" Value="Fill" />
						</Style>
					</StackPanel.Resources>

					<ToggleButton
						Width="32"
						Height="32"
						Content="{DynamicResource GroupPoseIcon}"
						IsChecked="{Binding IsInGPose}"
						ToolTip="{DynamicResource LOC_ToggleGPose}" />

					<Line />

					<ToggleButton
						IsChecked="{Binding IsLibraryOpen}"
						ToolTip="{DynamicResource LOC_Library}">
						<wpfUtils:IconBlock Icon="Book" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsSettingsOpen}"
						ToolTip="{DynamicResource LOC_Settings}">
						<wpfUtils:IconBlock Icon="cogs" />
					</ToggleButton>

					<Line />

					<ToggleButton
						IsChecked="{Binding IsZoneOpen}"
						IsEnabled="False"
						ToolTip="{DynamicResource LOC_Zone}">
						<wpfUtils:IconBlock Icon="CloudMoonRain" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsCameraOpen}"
						IsEnabled="False"
						ToolTip="{DynamicResource LOC_Camera}">
						<wpfUtils:IconBlock Icon="Camera" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsCustomizeOpen}"
						ToolTip="{DynamicResource LOC_Customize}">
						<wpfUtils:IconBlock Icon="UserEdit" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsGearOpen}"
						ToolTip="{DynamicResource LOC_Gear}">
						<wpfUtils:IconBlock Icon="ShieldHalved" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsShadersOpen}"
						IsEnabled="False"
						ToolTip="{DynamicResource LOC_ShaderParameters}">
						<wpfUtils:IconBlock Icon="Shapes" />
					</ToggleButton>

					<ToggleButton
						IsEnabled="False"
						ToolTip="{DynamicResource LOC_Expression}">
						<wpfUtils:IconBlock Icon="FaceGrinHearts" />
					</ToggleButton>

					<ToggleButton
						IsChecked="{Binding IsPoseOpen}"
						ToolTip="{DynamicResource LOC_Pose}">
						<wpfUtils:IconBlock Icon="Running" />
					</ToggleButton>


					<ToggleButton
						IsChecked="{Binding IsPhotoOpen}"
						ToolTip="{DynamicResource LOC_Photo}">
						<wpfUtils:IconBlock Icon="Image" />
					</ToggleButton>

					<Line />

					<ToggleButton
						IsChecked="{Binding IsSaveOpen}"
						ToolTip="{DynamicResource LOC_Save}">
						<save:SaveIconControl />

					</ToggleButton>
				</StackPanel>
			</Border>
		</Border>

	</Grid>
</studio:View>
