<studio:View
	x:Class="ScreenshotStudio.Studio.Background.Targets"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Background"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:structs="clr-namespace:ScreenshotStudio.Structs"
	xmlns:studio="clr-namespace:ScreenshotStudio"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	HorizontalAlignment="Center"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<studio:View.Resources>
		<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
		<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		<BooleanToVisibilityConverter x:Key="B2V" />
	</studio:View.Resources>

	<Grid>

		<Grid.Resources>
			<Storyboard x:Key="Expand">
				<DoubleAnimation
					Storyboard.TargetName="MainBorder"
					Storyboard.TargetProperty="Opacity"
					To="1"
					Duration="0:00:00.250">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseIn" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>
			</Storyboard>

			<Storyboard x:Key="Collapse">
				<DoubleAnimation
					Storyboard.TargetName="MainBorder"
					Storyboard.TargetProperty="Opacity"
					To="0"
					Duration="0:00:00.250">
					<DoubleAnimation.EasingFunction>
						<SineEase EasingMode="EaseOut" />
					</DoubleAnimation.EasingFunction>
				</DoubleAnimation>
			</Storyboard>
		</Grid.Resources>

		<Grid.Triggers>
			<triggers:StoryboardBindingTrigger
				Binding="{Binding IsInGPose}"
				EnterStoryboard="{StaticResource Expand}"
				ExitStoryboard="{StaticResource Collapse}"
				Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
				Value="True" />
		</Grid.Triggers>

		<Border
			x:Name="MainBorder"
			Background="{DynamicResource BackgroundBrush}"
			BorderBrush="{DynamicResource BackgroundBrush}"
			BorderThickness="1"
			CornerRadius="6">

			<Border
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>


					<StackPanel
						Grid.Column="0"
						Margin="1"
						Orientation="Horizontal">

						<StackPanel.Resources>
							<sys:Double x:Key="ButtonWidth">100</sys:Double>
						</StackPanel.Resources>


						<ItemsControl ItemsSource="{Binding Characters}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:CharacterViewModel}">

									<Grid
										x:Name="ContentArea"
										Width="0">

										<ToggleButton
											Width="{StaticResource ButtonWidth}"
											HorizontalAlignment="Center"
											Background="Transparent"
											IsChecked="{Binding IsCurrent}">
											<Grid Margin="6,3">

												<Grid.RowDefinitions>
													<RowDefinition />
													<RowDefinition Height="Auto" />
												</Grid.RowDefinitions>

												<TextBlock
													Grid.Row="0"
													Margin="0"
													HorizontalAlignment="Center"
													Style="{DynamicResource Body}"
													Text="{Binding Name}"
													TextTrimming="CharacterEllipsis"
													TextWrapping="NoWrap" />
											</Grid>

										</ToggleButton>
									</Grid>

									<DataTemplate.Triggers>
										<DataTrigger
											Binding="{Binding IsValid}"
											Value="True">
											<DataTrigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="ContentArea"
															Storyboard.TargetProperty="Width"
															To="{StaticResource ButtonWidth}"
															Duration="0:00:00.150">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseOut" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.EnterActions>
											<DataTrigger.ExitActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="ContentArea"
															Storyboard.TargetProperty="Width"
															To="0"
															Duration="0:00:00.250">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseIn" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.ExitActions>
										</DataTrigger>
									</DataTemplate.Triggers>

								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<Button
						Grid.Column="1"
						Width="38"
						VerticalAlignment="Stretch"
						Background="Transparent"
						Click="OnAddCharacterClicked"
						ToolTip="{DynamicResource LOC_Target_CreateCharacter}">
						<wpfUtils:IconBlock Icon="UserPlus" />
					</Button>

					<Button
						Grid.Column="2"
						Width="32"
						Background="Transparent"
						Click="OnRemoveCharacterClicked"
						IsEnabled="{Binding Target, Converter={StaticResource NotNullToBoolConverter}}"
						ToolTip="{Binding RemoveCharacterTooltip}">

						<wpfUtils:IconBlock
							Icon="TrashAlt"
							IconFont="Solid" />
					</Button>
				</Grid>
			</Border>
		</Border>
	</Grid>

</studio:View>
