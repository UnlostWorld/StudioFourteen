<windows:CharacterWindow
	x:Class="ScreenshotStudio.Studio.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pose="clr-namespace:ScreenshotStudio.Studio.Pose"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Pose}"
	Width="700"
	Height="600"
	MinWidth="700"
	MinHeight="600"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	TitleIcon="Running"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0">
			<TabControl x:Name="GuiTabs">
				<TabItem Header="Matrix" />
				<TabItem Header="Tree" />
			</TabControl>

		</Grid>


		<StackPanel Grid.Column="1">

			<!--  Transform  -->
			<Grid>
				<StackPanel Width="180">

					<TextBlock
						HorizontalAlignment="Center"
						Style="{DynamicResource Header}"
						Text="{Binding Services.Pose.Selection.Name}" />

					<StackPanel IsEnabled="{Binding SelectedBones, Converter={StaticResource NotNullToBoolConverter}}">
						<Border
							Grid.Column="1"
							Style="{DynamicResource WpfUtilsControlBorder}">

							<StackPanel
								HorizontalAlignment="Center"
								Orientation="Horizontal">
								<Button Background="Transparent">
									<wpfUtils:IconBlock Icon="ArrowCircleUp" />
								</Button>

								<Button Background="Transparent">
									<wpfUtils:IconBlock Icon="TimesCircle" />
								</Button>

								<Button Background="Transparent">
									<wpfUtils:IconBlock Icon="ArrowCircleDown" />
								</Button>
							</StackPanel>
						</Border>
					</StackPanel>

					<Grid
						Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
						Margin="1">
						<Border Style="{DynamicResource WpfUtilsControlBorder}" />
					</Grid>

					<!--  Translate  -->
					<Expander IsExpanded="{Binding ExpandTranslationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								X="{Binding TranslationX}"
								Y="{Binding TranslationY}"
								Z="{Binding TranslationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Arrows"
										ToolTip="{DynamicResource TransformT}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationX}" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationY}" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="5"
								RelativeValue="{Binding TranslationZ}" />
						</Grid>
					</Expander>

					<!--  Rotate  -->
					<Expander IsExpanded="{Binding ExpandRotationSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								X="{Binding EulerRotationX}"
								Y="{Binding EulerRotationY}"
								Z="{Binding EulerRotationZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="Rotate"
										ToolTip="{DynamicResource TransformR}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="180"
								RelativeValue="{Binding EulerRotationX}"
								SmallChange="1" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="180"
								RelativeValue="{Binding EulerRotationY}"
								SmallChange="1" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="180"
								RelativeValue="{Binding EulerRotationZ}"
								SmallChange="1" />
						</Grid>
					</Expander>

					<!--  Scale  -->
					<Expander IsExpanded="{Binding ExpandScaleSliders}">
						<Expander.Header>
							<wpfUtils:MultiNumberBox
								Margin="0"
								X="{Binding ScaleX}"
								Y="{Binding ScaleY}"
								Z="{Binding ScaleZ}">
								<wpfUtils:MultiNumberBox.Prefix>
									<wpfUtils:IconBlock
										Margin="6,1,2,0"
										Foreground="{DynamicResource BackgroundLightBrush}"
										Icon="ArrowsMaximize"
										ToolTip="{DynamicResource TransformS}" />
								</wpfUtils:MultiNumberBox.Prefix>
							</wpfUtils:MultiNumberBox>

						</Expander.Header>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="X:" />
							<wpfUtils:RelativeSlider
								Grid.Row="0"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleX}" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Y:" />
							<wpfUtils:RelativeSlider
								Grid.Row="1"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleY}" />

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="Z:" />
							<wpfUtils:RelativeSlider
								Grid.Row="2"
								Grid.Column="1"
								RelativeRange="1"
								RelativeValue="{Binding ScaleZ}" />
						</Grid>
					</Expander>



				</StackPanel>
			</Grid>
		</StackPanel>
	</Grid>
</windows:CharacterWindow>
