<windows:ActorWindow
	x:Class="ScreenshotStudio.Studio.Pose.BoneWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Pose"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource BonesGui}"
	Width="800"
	Height="550"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	IsShown="{Binding ShouldShow}"
	Subtitle="{Binding ActorName}"
	TitleIcon="Bone"
	mc:Ignorable="d">
	<Grid IsEnabled="{Binding HasValidTarget}">
		<TabControl>
			<TabItem Header="{DynamicResource PoseGui}">
				<local:PoseGuiView x:Name="Gui" />
			</TabItem>
			<TabItem Header="{DynamicResource PoseMatrix}">
				<local:PoseMatrixView x:Name="Matrix" />
			</TabItem>
			<TabItem Header="{DynamicResource PoseList}">
				<local:PoseListView x:Name="List" />
			</TabItem>
		</TabControl>
	</Grid>
</windows:ActorWindow>
