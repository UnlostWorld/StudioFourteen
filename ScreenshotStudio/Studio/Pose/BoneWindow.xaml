<windows:ActorWindow
	x:Class="ScreenshotStudio.Studio.Pose.BoneWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio.Pose"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	Title="{DynamicResource BonesGui}"
	Width="900"
	Height="512"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding ActorName}"
	TitleIcon="Bone"
	mc:Ignorable="d">
	<Grid>
		<TabControl Style="{DynamicResource XivToolsSideTabs}">
			<TabItem Header="GUI">
				<local:PoseGuiView />
			</TabItem>
			<TabItem Header="Matrix">
				<local:PoseMatrixView />
			</TabItem>
			<TabItem Header="All" />
		</TabControl>
	</Grid>
</windows:ActorWindow>
