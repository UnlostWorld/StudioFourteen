<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:windows="clr-namespace:ScreenshotStudio.Windows"
	mc:Ignorable="d">


	<ControlTemplate
		x:Key="StudioButtonTemplate"
		TargetType="{x:Type Button}">
		<Grid
			x:Name="IconGrid"
			Width="48"
			Height="45">

			<Grid.Effect>
				<DropShadowEffect
					BlurRadius="10"
					ShadowDepth="0" />
			</Grid.Effect>

			<Image Source="pack://application:,,,/ScreenshotStudio;component/Assets/icon-back-shadow.png" />

			<Rectangle Fill="{DynamicResource ForegroundLightBrush}">
				<Rectangle.OpacityMask>
					<ImageBrush ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/icon-back-mask.png" />
				</Rectangle.OpacityMask>
			</Rectangle>

			<Grid RenderTransformOrigin="0.5,0.5">

				<Grid.Background>
					<ImageBrush ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/icon-front-background.png" />
				</Grid.Background>

				<Grid.RenderTransform>
					<ScaleTransform x:Name="MeteorTransform" ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" />
				</Grid.RenderTransform>

				<Grid Background="{DynamicResource TrimBrush}">

					<Grid.OpacityMask>
						<ImageBrush ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/icon-front-mask.png" />
					</Grid.OpacityMask>

					<Ellipse
						x:Name="ColorWheel"
						Width="32"
						Height="32"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<Ellipse.Fill>
							<ImageBrush
								ImageSource="pack://application:,,,/ScreenshotStudio;component/Assets/rainbow-wheel.png"
								Stretch="None">

								<ImageBrush.RelativeTransform>
									<RotateTransform x:Name="ColorWheelTransform" Angle="0" CenterX="0.5" CenterY="0.5" />
								</ImageBrush.RelativeTransform>
							</ImageBrush>
						</Ellipse.Fill>
					</Ellipse>

				</Grid>
			</Grid>
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.EnterActions>
					<StopStoryboard BeginStoryboardName="IsEnabledEnterStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverExitStory" />
					<StopStoryboard BeginStoryboardName="PressedInEnterStory" />
					<StopStoryboard BeginStoryboardName="PressedInExitStory" />
					<BeginStoryboard x:Name="IsMouseOverEnterStory">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ColorWheelTransform"
								Storyboard.TargetProperty="Angle"
								From="0"
								To="1800"
								Duration="0:00:01.000">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseInOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="MeteorTransform"
								Storyboard.TargetProperty="ScaleX"
								Duration="0:00:01.000">
								<EasingDoubleKeyFrame
									KeyTime="0:00:00.000"
									Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseInOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:00.500"
									Value="1.15">
									<EasingDoubleKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseInOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:01.000"
									Value="1.1" />
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<StopStoryboard BeginStoryboardName="IsEnabledEnterStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverEnterStory" />
					<StopStoryboard BeginStoryboardName="PressedInEnterStory" />
					<StopStoryboard BeginStoryboardName="PressedInExitStory" />
					<BeginStoryboard x:Name="IsMouseOverExitStory">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="MeteorTransform"
								Storyboard.TargetProperty="ScaleX"
								To="1"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>

			<Trigger Property="IsPressed" Value="True">
				<Trigger.EnterActions>
					<StopStoryboard BeginStoryboardName="IsEnabledEnterStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverExitStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverEnterStory" />
					<StopStoryboard BeginStoryboardName="PressedInExitStory" />
					<BeginStoryboard x:Name="PressedInEnterStory">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ColorWheelTransform"
								Storyboard.TargetProperty="Angle"
								From="0"
								To="360"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="MeteorTransform"
								Storyboard.TargetProperty="ScaleX"
								To="1"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="ColorWheel"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<StopStoryboard BeginStoryboardName="IsEnabledEnterStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverExitStory" />
					<StopStoryboard BeginStoryboardName="IsMouseOverEnterStory" />
					<StopStoryboard BeginStoryboardName="PressedInEnterStory" />
					<BeginStoryboard x:Name="PressedInExitStory">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ColorWheelTransform"
								Storyboard.TargetProperty="Angle"
								From="0"
								To="360"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="MeteorTransform"
								Storyboard.TargetProperty="ScaleX"
								To="1.1"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="ColorWheel"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>

			<Trigger Property="IsEnabled" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard x:Name="IsEnabledEnterStory">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ColorWheelTransform"
								Storyboard.TargetProperty="Angle"
								From="0"
								To="1800"
								Duration="0:00:01.000">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseInOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="MeteorTransform"
								Storyboard.TargetProperty="ScaleX"
								Duration="0:00:01.000">
								<EasingDoubleKeyFrame
									KeyTime="0:00:00.000"
									Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseInOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:00.500"
									Value="1.15">
									<EasingDoubleKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseInOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:01.000"
									Value="1.1" />
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
			</Trigger>

		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style
		x:Key="StudioButton"
		TargetType="{x:Type Button}">
		<Setter Property="Template" Value="{StaticResource StudioButtonTemplate}" />
		<Setter Property="Width" Value="48" />
		<Setter Property="Height" Value="48" />
		<Setter Property="Margin" Value="10,0" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

</ResourceDictionary>
