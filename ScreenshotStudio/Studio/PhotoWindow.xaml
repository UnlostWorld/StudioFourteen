<local:PanelWindow
	x:Class="ScreenshotStudio.Studio.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{DynamicResource LOC_Photo}"
	Width="400"
	Height="250"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	CanClose="True"
	TitleIcon="ImagePolaroid"
	mc:Ignorable="d">

	<Grid>
		<controls:GameCapture />
	</Grid>
</local:PanelWindow>
