<local:Panel
	x:Class="ScreenshotStudio.Studio.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ScreenshotStudio.Windows"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{DynamicResource LOC_Photo}"
	Width="1024"
	Height="565"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Image"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid
			Grid.Row="0"
			Grid.Column="0">
			<controls:GameCapture x:Name="Capture" />

			<Rectangle
				x:Name="Flash"
				Width="{Binding ActualWidth, ElementName=Capture}"
				Height="{Binding ActualHeight, ElementName=Capture}"
				Fill="White"
				Opacity="0">
				<Rectangle.Resources>
					<Storyboard x:Key="Flash">
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="Flash"
							Storyboard.TargetProperty="Opacity">
							<EasingDoubleKeyFrame KeyTime="0:00:00.000" Value="0" />
							<EasingDoubleKeyFrame KeyTime="0:00:00.10" Value="0.5" />
							<EasingDoubleKeyFrame KeyTime="0:00:00.500" Value="0">
								<EasingDoubleKeyFrame.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</EasingDoubleKeyFrame.EasingFunction>
							</EasingDoubleKeyFrame>
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</Rectangle.Resources>
			</Rectangle>

		</Grid>

		<Grid
			Grid.Row="0"
			Grid.Column="1"
			Width="120"
			Margin="6"
			VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				Style="{DynamicResource RightLabel}"
				Text="Map:" />
			<TextBlock
				Grid.Column="1"
				Style="{DynamicResource Body}"
				Text="{Binding MetaData.MapId, FallbackValue=0}" />

		</Grid>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Style="{DynamicResource WpfUtilsControlBorder}">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					Margin="6,3"
					VerticalAlignment="Center"
					Style="{DynamicResource Body}"
					Text="{Binding SaveDirectory}" />

				<Button
					Grid.Column="1"
					MinWidth="100"
					Background="Transparent"
					Click="OnSaveClicked"
					Content="Save" />
			</Grid>
		</Border>

	</Grid>
</local:Panel>
