<panels:PanelWindow
	x:Class="StudioFourteen.AIO.AioWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:targets="clr-namespace:StudioFourteen.Targets"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:launcher="clr-namespace:StudioFourteen.Launcher"
	xmlns:local="clr-namespace:StudioFourteen.AIO"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{Binding CurrentTitle}"
	Width="900"
	Height="700"
	MinWidth="450"
	MinHeight="500"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	IsEmbedded="False"
	TitleMargin="45,0,0,0"
	Topmost="False"
	mc:Ignorable="d"
	RememberState="False"
	x:Name="AioWindowMain">

	<Grid Margin="1">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="50" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<panels:PanelHost
			Grid.Row="0"
			Grid.Column="1"
			Context="{Binding Context}"
			PanelType="{x:Type targets:TargetsPanel}" />

		<Button
			x:Name="LaunchButton"
			Grid.RowSpan="2"
			Grid.ColumnSpan="2"
			Margin="0,-24,0,0"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Click="OnLaunchClicked"
			Style="{DynamicResource LauncherButton}" />

		<launcher:TaskBarControl
			Grid.Row="1"
			Grid.Column="0"
			HideBackground="True"
			Context="{Binding Context}" />

		<Popup
			x:Name="LauncherMenuPopup"
			HorizontalOffset="50"
			IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
			Placement="RelativePoint"
			PlacementTarget="{Binding ElementName=LaunchButton}"
			StaysOpen="False"
			VerticalOffset="0">

			<launcher:LauncherMenu
				Context="{Binding Context, ElementName=AioWindowMain}"
				IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />

		</Popup>

		<panels:PanelHost
			x:Name="PanelArea"
			Context="{Binding Context}"
			Grid.Row="1"
			Grid.Column="1"
			Margin="0,4,0,0" />

	</Grid>
</panels:PanelWindow>
