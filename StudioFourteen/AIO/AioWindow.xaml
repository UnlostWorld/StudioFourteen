<panels:PanelWindow
	x:Class="StudioFourteen.AIO.AioWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:launcher="clr-namespace:StudioFourteen.Launcher"
	xmlns:local="clr-namespace:StudioFourteen.AIO"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:selection="clr-namespace:StudioFourteen.Selection"
	Title="{Binding CurrentTitle}"
	Width="900"
	Height="700"
	MinWidth="450"
	MinHeight="500"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	IsEmbedded="False"
	Topmost="True"
	mc:Ignorable="d"
	RememberState="False"
	x:Name="AioWindowMain">

	<Grid Margin="1">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="48" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<ToggleButton
				Height="42"
				Margin="3,0,3,3"
				Style="{DynamicResource WpfUtilsIconToggleButton}"
				IsChecked="{Binding IsStudioAttached}"
				HorizontalContentAlignment="Stretch"
				Content="{DynamicResource ICON_Launcher_Start}" />

			<launcher:TaskBarControl
				IsEnabled="{Binding IsStudioAttached}"
				x:Name="TaskBar"
				Grid.Row="1"
				HideBackground="True"
				Context="{Binding Context}" />
		</Grid>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<panels:PanelHost
				Visibility="{Binding ShowTargetBar, Converter={StaticResource B2V}}"
				Grid.Row="0"
				Grid.Column="1"
				Context="{Binding Context}"
				PanelType="{x:Type selection:SelectionPanel}" />

			<panels:PanelHost
				x:Name="PanelArea"
				Context="{Binding Context}"
				Grid.Row="1"
				Grid.Column="1"
				Margin="0,4,0,0" />
		</Grid>

	</Grid>
</panels:PanelWindow>
