<panels:Panel
	x:Class="StudioFourteen.History.HistoryPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.History"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_History}"
	Width="300"
	Height="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="CanResizeWithGrip"
	TitleIcon="History"
	mc:Ignorable="d">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ListBox
			x:Name="HistoryList"
			ItemsSource="{Binding History}"
			SelectedIndex="{Binding SelectedIndex}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="32" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<fa:IconBlock
							Grid.Column="0"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="{Binding Icon}" />
						<TextBlock
							Grid.Column="1"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding Description}" />

					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>

			<ListBox.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource WpfUtilsListBoxItem}"
					TargetType="{x:Type ListBoxItem}">
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type ListBoxItem}">
								<Border
									Margin="{TemplateBinding Margin}"
									Background="Transparent"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									ClipToBounds="{TemplateBinding ClipToBounds}">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition />
										</Grid.RowDefinitions>

										<Line
											Grid.Row="0"
											Margin="0,2"
											HorizontalAlignment="Stretch"
											Stretch="Fill"
											Stroke="{DynamicResource TrimBrush}"
											StrokeThickness="1"
											Visibility="{TemplateBinding IsSelected,
											                             Converter={StaticResource B2V}}"
											X1="0"
											X2="1" />

										<Border
											x:Name="HoverBorder"
											Grid.Row="1"
											Margin="1"
											Style="{DynamicResource WpfUtilsControlHoverBorder}"
											Visibility="{TemplateBinding IsMouseOver,
											                             Converter={StaticResource B2V}}" />

										<ContentPresenter
											Grid.Row="1"
											Margin="{TemplateBinding Padding}"
											HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
											Content="{TemplateBinding Content}"
											ContentTemplate="{TemplateBinding ContentTemplate}"
											ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
											Focusable="False"
											RecognizesAccessKey="False"
											SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
									</Grid>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>
		</ListBox>


		<Border
			Grid.Row="1"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">

				<Button
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnUndoClicked"
					IsEnabled="{Binding Services.History.CanUndo}">
					<wpfUtils:IconBlock Icon="UndoAlt" />
				</Button>

				<Button
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnRedoClicked"
					IsEnabled="{Binding Services.History.CanRedo}">
					<wpfUtils:IconBlock Icon="RedoAlt" />
				</Button>
			</StackPanel>
		</Border>


	</Grid>
</panels:Panel>
