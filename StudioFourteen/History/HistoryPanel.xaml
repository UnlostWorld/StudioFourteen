<panels:Panel
	x:Class="StudioFourteen.History.HistoryPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.History"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_History}"
	Width="300"
	Height="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="CanResizeWithGrip"
	TitleIcon="{DynamicResource ICON_Title_History}"
	mc:Ignorable="d">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Margin="1" Style="{DynamicResource WpfUtilsControlBorder}">
			<ItemsControl
				x:Name="HistoryList"
				ItemsSource="{Binding History}"
				VirtualizingPanel.ScrollUnit="Pixel">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.Template>
					<ControlTemplate TargetType="ItemsControl">
						<ScrollViewer
							Padding="{TemplateBinding Padding}"
							CanContentScroll="True"
							Focusable="False">
							<ItemsPresenter />
						</ScrollViewer>
					</ControlTemplate>
				</ItemsControl.Template>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button
							Margin="0"
							Padding="12,0,6,0"
							HorizontalContentAlignment="Stretch"
							Background="Transparent"
							BorderThickness="0"
							Click="OnOperationClicked">
							<Grid x:Name="ButtonContent">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="1*" />
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="2*" />
								</Grid.ColumnDefinitions>

								<TextBlock
									Grid.Column="0"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding Operation.TargetName}"
									TextAlignment="Right" />

								<fa:IconBlock
									Grid.Column="1"
									FontSize="10"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Icon="{Binding Operation.Icon}"
									IconFont="Solid"
									TextAlignment="Center" />

								<TextBlock
									Grid.Column="2"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding Operation.Description}" />

							</Grid>
						</Button>

						<DataTemplate.Triggers>
							<DataTrigger Binding="{Binding IsPast}" Value="False">
								<Setter TargetName="ButtonContent" Property="Opacity" Value="0.5" />
							</DataTrigger>
						</DataTemplate.Triggers>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>


		<Border
			Grid.Row="1"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

				<Button
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnUndoClicked"
					IsEnabled="{Binding Services.History.CanUndo}">
					<wpfUtils:IconBlock Icon="UndoAlt" />
				</Button>

				<Button
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnRedoClicked"
					IsEnabled="{Binding Services.History.CanRedo}">
					<wpfUtils:IconBlock Icon="RedoAlt" />
				</Button>
			</StackPanel>
		</Border>


	</Grid>
</panels:Panel>
