<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ControlTemplate x:Key="StudioSpinnerTemplate" TargetType="{x:Type ProgressBar}">

		<Grid x:Name="IconGrid">
			<Ellipse x:Name="ColorWheel" StrokeThickness="5">
				<Ellipse.Stroke>
					<ImageBrush ImageSource="pack://application:,,,/StudioFourteen;component/Assets/rainbow-wheel.png" Stretch="None">
						<ImageBrush.RelativeTransform>
							<RotateTransform x:Name="ColorWheelTransform" Angle="0" CenterX="0.5" CenterY="0.5" />
						</ImageBrush.RelativeTransform>
					</ImageBrush>
				</Ellipse.Stroke>
			</Ellipse>
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsIndeterminate" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard x:Name="SpinStoryboard">
						<Storyboard RepeatBehavior="Forever">
							<DoubleAnimation
								Storyboard.TargetName="ColorWheelTransform"
								Storyboard.TargetProperty="Angle"
								From="0"
								To="1800"
								Duration="0:00:01.000">
								<DoubleAnimation.EasingFunction>
									<ExponentialEase EasingMode="EaseInOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<StopStoryboard BeginStoryboardName="SpinStoryboard" />
				</Trigger.ExitActions>
			</Trigger>

		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="Spinner" TargetType="{x:Type ProgressBar}">
		<Setter Property="Height" Value="32" />
		<Setter Property="IsIndeterminate" Value="True" />
		<Setter Property="Margin" Value="3" />
		<Setter Property="Template" Value="{StaticResource StudioSpinnerTemplate}" />
		<Setter Property="Width" Value="32" />
	</Style>

</ResourceDictionary>
