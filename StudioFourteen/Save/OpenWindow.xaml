<panels:Panel
	x:Class="StudioFourteen.Save.OpenWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ap="WpfUtils.AttachedProperties"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:local="clr-namespace:StudioFourteen.Save"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:ss="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_OpenScene}"
	Width="500"
	Height="500"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	Subtitle="{Binding Scene.Title}"
	TitleIcon="fa-Users"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="250" />
		</Grid.ColumnDefinitions>


		<Border
			Grid.Row="0"
			Grid.RowSpan="2"
			Grid.Column="0"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid Margin="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="75" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Viewbox Grid.ColumnSpan="2">
					<Rectangle
						Width="9"
						Height="16"
						Fill="White"
						Opacity="0.25" />
				</Viewbox>

				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Author:" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Author}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Version:" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Version}" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Description:" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Description}"
					TextAlignment="Left"
					TextWrapping="Wrap" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="0,0,2,0"
					VerticalAlignment="Center"
					Style="{DynamicResource RightLabel}"
					Text="Tags:" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="1"
					Style="{DynamicResource Body}"
					Text="{Binding Scene.Tags.Count}" />

			</Grid>
		</Border>

		<ScrollViewer
			Grid.Row="0"
			Grid.Column="1"
			HorizontalScrollBarVisibility="Disabled">
			<StackPanel
				Grid.Row="0"
				Margin="2">

				<TextBlock
					Margin="2,2,0,0"
					Style="{DynamicResource LeftLabel}"
					Text="{DynamicResource LOC_Save_Environment}" />
				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeLocation}"
					IsChecked="{Binding Configuration.IncludeLocation}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeWeather}"
					IsChecked="{Binding Configuration.IncludeWeather}" />

				<CheckBox
					Margin="1"
					Content="{DynamicResource LOC_Save_IncludeTimeOfDay}"
					IsChecked="{Binding Configuration.IncludeTimeOfDay}" />

				<TextBlock
					Margin="2,8,0,0"
					Style="{DynamicResource LeftLabel}"
					Text="{DynamicResource LOC_OpenScene_Characters}" />

				<ItemsControl ItemsSource="{Binding Actors}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:Assignment}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Border
									Grid.Row="1"
									Grid.ColumnSpan="4"
									Style="{DynamicResource WpfUtilsControlBorder}" />

								<TextBlock
									Grid.Row="0"
									Grid.ColumnSpan="4"
									Style="{DynamicResource Body}"
									Text="{Binding Actor.Role}" />

								<ToggleButton
									Grid.Row="1"
									Grid.Column="2"
									MinWidth="28"
									Margin="1"
									IsChecked="{Binding IncludeAppearance}"
									IsEnabled="{Binding CanIncludeAppearance}"
									Style="{DynamicResource WpfUtilsIconToggleButton}"
									ToolTip="{Binding ApplyAppearanceTooltip}">
									<wpfUtils:IconBlock
										Icon="UserShield"
										IconFont="Solid" />
								</ToggleButton>

								<ToggleButton
									Grid.Row="1"
									Grid.Column="3"
									MinWidth="28"
									Margin="1"
									IsChecked="{Binding IncludePose}"
									IsEnabled="{Binding CanIncludePose}"
									Style="{DynamicResource WpfUtilsIconToggleButton}"
									ToolTip="{Binding ApplyPoseTooltip}">
									<wpfUtils:IconBlock Icon="Running" />
								</ToggleButton>

								<ComboBox
									Grid.Row="1"
									Margin="1"
									Background="Transparent"
									ItemsSource="{Binding Characters, RelativeSource={RelativeSource AncestorType={x:Type local:OpenWindow}}}"
									SelectedItem="{Binding Character}">

									<ComboBox.Resources>
										<DataTemplate DataType="{x:Type local:OpenCharacterViewModel}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="22" />
													<ColumnDefinition />
												</Grid.ColumnDefinitions>

												<wpfUtils:IconBlock
													Grid.Column="0"
													Icon="User"
													IconFont="Solid" />
												<TextBlock
													Grid.Column="1"
													Text="{Binding Name}" />
											</Grid>
										</DataTemplate>
										<DataTemplate DataType="{x:Type local:OpenCreateCharacterViewModel}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="22" />
													<ColumnDefinition />
												</Grid.ColumnDefinitions>

												<wpfUtils:IconBlock
													Grid.Column="0"
													Icon="UserPlus" />
												<TextBlock
													Grid.Column="1"
													Text="Create Character" />
											</Grid>
										</DataTemplate>
										<DataTemplate DataType="{x:Type local:OpenIgnoreCharacterViewModel}">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="22" />
													<ColumnDefinition />
												</Grid.ColumnDefinitions>

												<wpfUtils:IconBlock
													Grid.Column="0"
													Icon="Times" />
												<TextBlock
													Grid.Column="1"
													Text="Ignore" />
											</Grid>
										</DataTemplate>
									</ComboBox.Resources>
								</ComboBox>

								<librarySelector:LibrarySelectorButton
									Grid.Row="2"
									Grid.ColumnSpan="4"
									Margin="0,2,0,0"
									Type="{x:Type appearance:ICharacterAppearance}"
									Visibility="{Binding CanSelectAppearance, Converter={StaticResource B2V}}"
									Value="{Binding Appearance}" />

							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="1"
			Grid.Column="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Width="100"
					HorizontalAlignment="Right"
					Click="OnConfirmClicked"
					Content="{DynamicResource LOC_Apply}" />

			</StackPanel>
		</Border>
	</Grid>
</panels:Panel>
