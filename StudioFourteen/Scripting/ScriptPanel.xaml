<panels:Panel
	x:Class="StudioFourteen.Scripting.ScriptPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Scripting"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="Script"
	Width="400"
	Height="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,0.5"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Manual"
	TitleIcon="Robot"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ProgressBar
			Grid.Row="0"
			Margin="6"
			IsIndeterminate="{Binding IsIndeterminate}"
			Maximum="100"
			Minimum="0"
			Value="{Binding Progress}" />

		<TextBlock
			Grid.Row="1"
			Margin="2,2,2,10"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundLightBrush}"
			Text="{Binding Status}" />

		<Border
			Grid.Row="2"
			Style="{DynamicResource WpfUtilsGroupBorder}">

			<ScrollViewer
				x:Name="Scroller"
				HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ScriptLog}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:LogEntry}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="32" />
									<ColumnDefinition />
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<wpfUtils:IconBlock
									x:Name="Icon"
									Grid.Column="0"
									Margin="3"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Icon="InfoCircle" />

								<TextBlock
									Grid.Column="1"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding Message}" />

								<TextBlock
									Grid.Column="2"
									HorizontalAlignment="Right"
									Margin="2,2,6,2"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding Location}" />

							</Grid>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding="{Binding Level}"
									Value="Message">
									<Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
									<Setter TargetName="Icon" Property="Icon" Value="InfoCircle" />
								</DataTrigger>

								<DataTrigger
									Binding="{Binding Level}"
									Value="Warning">
									<Setter TargetName="Icon" Property="Foreground" Value="Orange" />
									<Setter TargetName="Icon" Property="Icon" Value="Warning" />
								</DataTrigger>

								<DataTrigger
									Binding="{Binding Level}"
									Value="Error">
									<Setter TargetName="Icon" Property="Foreground" Value="Red" />
									<Setter TargetName="Icon" Property="Icon" Value="Warning" />
								</DataTrigger>
							</DataTemplate.Triggers>

						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<Border
			Grid.Row="3"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					MinWidth="75"
					Click="OnCloseClicked"
					Content="Close" />
			</StackPanel>
		</Border>

	</Grid>
</panels:Panel>
