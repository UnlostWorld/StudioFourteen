<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:cameras="clr-namespace:StudioFourteen.Cameras"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<DataTemplate DataType="{x:Type cameras:FreeCamera}">
		<StackPanel>
			<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

			<TextBlock Style="{DynamicResource LeftLabel}"
				Text="{DynamicResource LOC_FreeCamera_Position}" />
			<controls:Vector3Control Change="0.01" Value="{Binding Position}" />

			<TextBlock Style="{DynamicResource LeftLabel}"
				Text="{DynamicResource LOC_Camera_Rotation}" />
			<controls:QuaternionControl Value="{Binding Rotation}" Change="1" />

		</StackPanel>
	</DataTemplate>

</ResourceDictionary>