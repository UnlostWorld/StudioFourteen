<local:Panel
	x:Class="StudioFourteen.Panels.CameraPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cameras="clr-namespace:StudioFourteen.Cameras"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:controls1="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{DynamicResource LOC_Camera}"
	Width="350"
	Height="450"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	TitleIcon="VideoCamera"
	mc:Ignorable="d">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<ListBox
			Grid.Column="0"
			ItemsSource="{Binding Services.Camera.Cameras}"
			SelectedValue="{Binding Services.Camera.Current}"
			Style="{DynamicResource WpfUtilsSwitchSelectorVertical}">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock
						Margin="6"
						Text="{Binding Name}" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

		<ContentPresenter
			Grid.Column="1"
			Content="{Binding Services.Camera.Current}">
			<ContentPresenter.Resources>
				<DataTemplate DataType="{x:Type cameras:OrbitCamera}">
					<StackPanel>
						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Position" />
						<controls1:Vector3Box
							TickFrequency="0.01"
							Value="{Binding Target}" />

						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Field of View" />
						<controls:NumberBox
							Maximum="2.2"
							Minimum="0"
							Slider="Absolute"
							TickFrequency="0.01"
							Value="{Binding FieldOfView}" />

						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Distance" />
						<controls:NumberBox
							Maximum="300"
							Minimum="0.1"
							Slider="Absolute"
							TickFrequency="1"
							Value="{Binding Distance}" />
					</StackPanel>
				</DataTemplate>

				<DataTemplate DataType="{x:Type cameras:OrbitTargetCamera}">
					<StackPanel>
						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Offset" />
						<controls1:Vector3Box
							TickFrequency="0.01"
							Value="{Binding TargetOffset}" />

						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Field of View" />
						<controls:NumberBox
							Maximum="2.2"
							Minimum="0"
							Slider="Absolute"
							TickFrequency="0.01"
							Value="{Binding FieldOfView}" />

						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Distance" />
						<controls:NumberBox
							Maximum="300"
							Minimum="0.1"
							Slider="Absolute"
							TickFrequency="1"
							Value="{Binding Distance}" />

						<TextBlock
							Style="{DynamicResource LeftLabel}"
							Text="Angle" />
						<controls1:Vector3Box
							Maximum="360"
							Minimum="0"
							TickFrequency="1"
							Wrap="True"
							Value="{Binding Angle}" />

					</StackPanel>
				</DataTemplate>
			</ContentPresenter.Resources>
		</ContentPresenter>

	</Grid>
</local:Panel>
