<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:vectors="http://sharpvectors.codeplex.com/svgc/"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Controls/PopOutStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<ControlTemplate
		x:Key="TagSelectorTemplate"
		TargetType="{x:Type tags:TagSelector}">

		<Grid>

			<ToggleButton
				x:Name="TagSearchToggle"
				Padding="2,1,2,1"
				HorizontalContentAlignment="Stretch"
				IsChecked="{Binding PopOutOpen, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}"
				Style="{DynamicResource WpfUtilsIconToggleButton}">

				<Grid VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="32" />
					</Grid.ColumnDefinitions>

					<tags:TagsControl
						Grid.Column="0"
						VerticalAlignment="Center"
						Background="Transparent"
						IsEnabled="False"
						Style="{DynamicResource LinearTagsControl}"
						Tags="{TemplateBinding SelectedTags}" />

					<vectors:SvgIcon
						Grid.Column="1"
						Height="12"
						Margin="6"
						VerticalAlignment="Center"
						Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-tags-add.svg" />
				</Grid>
			</ToggleButton>

			<wpfUtils:PopOut
				Width="350"
				Height="350"
				Background="{DynamicResource ControlBackgroundBrush}"
				IsOpen="{Binding PopOutOpen, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}"
				PlacementTarget="{Binding ElementName=TagSearchToggle}"
				StaysOpen="False"
				Style="{StaticResource WpfUtilsPopOut}">

				<wpfUtils:PopOut.Header>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>


						<tags:TagsControl
							x:Name="PART_PopOutSelectedTagDisplay"
							Grid.Row="1"
							Tags="{TemplateBinding SelectedTags}" />

						<TextBlock
							Grid.Row="2"
							Margin="10"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{DynamicResource LOC_Tags_Title}" />

						<TextBox
							x:Name="PART_SearchBox"
							Grid.Row="3" />
					</Grid>
				</wpfUtils:PopOut.Header>
				<ScrollViewer
					Grid.Row="1"
					HorizontalScrollBarVisibility="Disabled">
					<tags:TagsControl
						x:Name="PART_PopOutTagDisplay"
						Tags="{TemplateBinding SearchTags}" />
				</ScrollViewer>
			</wpfUtils:PopOut>

		</Grid>
	</ControlTemplate>

	<Style
		x:Key="TagSelectorStyle"
		TargetType="{x:Type tags:TagSelector}">
		<Setter Property="Template" Value="{StaticResource TagSelectorTemplate}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Height" Value="28" />
	</Style>

	<Style
		BasedOn="{StaticResource TagSelectorStyle}"
		TargetType="{x:Type tags:TagSelector}" />


</ResourceDictionary>