<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:vectors="http://sharpvectors.codeplex.com/svgc/"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Controls/PopOutStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />

	<ControlTemplate
		x:Key="TagSelectorTemplate"
		TargetType="{x:Type tags:TagSelector}">

		<Grid>

			<ToggleButton
				x:Name="TagSearchToggle"
				Padding="2,1,2,1"
				HorizontalContentAlignment="Stretch"
				IsChecked="{Binding PopOutOpen, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}"
				Style="{DynamicResource WpfUtilsIconToggleButton}">

				<Grid VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="32" />
					</Grid.ColumnDefinitions>

					<tags:TagsControl
						Grid.Column="0"
						VerticalAlignment="Center"
						Background="Transparent"
						IsEnabled="False"
						Style="{DynamicResource LinearTagsControl}"
						Tags="{TemplateBinding SelectedTags}" />

					<vectors:SvgIcon
						Grid.Column="1"
						Height="12"
						Margin="6"
						VerticalAlignment="Center"
						Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-tags-add.svg" />
				</Grid>
			</ToggleButton>

			<wpfUtils:PopOut
				Width="350"
				IsOpen="{Binding PopOutOpen, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}"
				PlacementTarget="{Binding ElementName=TagSearchToggle}"
				StaysOpen="False"
				Style="{StaticResource WpfUtilsPopOut}">

				<StackPanel>
					<TextBlock
						Style="{DynamicResource Subscript}"
						Text="{DynamicResource LOC_Tags_Remove}" />
					<tags:TagsControl
						MinHeight="26"
						x:Name="PART_PopOutSelectedTagDisplay"
						Grid.Row="1"
						Tags="{TemplateBinding SelectedTags}" />

					<Button x:Name="PART_ClearButton" HorizontalAlignment="Right" Content="{DynamicResource LOC_Tags_Clear}"/>

					<TextBlock
						Style="{DynamicResource Subscript}"
						Text="{DynamicResource LOC_Tags_Add}" />

					<Grid>
						<TextBox
							Padding="25,0,3,0"
							x:Name="PART_SearchBox" />

						<wpfUtils:IconBlock
							Margin="8,0,0,0"
							HorizontalAlignment="Left"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="Search" />
					</Grid>

					<tags:TagsControl
						x:Name="PART_PopOutTagDisplay"
						Grid.Row="1"
						MinHeight="26"
						Tags="{TemplateBinding SearchTags}" />

					<TextBlock
						HorizontalAlignment="Right"
						Style="{DynamicResource Subscript}"
						Visibility="{Binding InvisibleSearchTagsCount, Converter={StaticResource NotZeroToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}">
						<Run Text="+" />
						<Run Text="{Binding InvisibleSearchTagsCount, RelativeSource={RelativeSource AncestorType={x:Type tags:TagSelector}}}" />
						<Run Text="more..." />
					</TextBlock>
				</StackPanel>

			</wpfUtils:PopOut>

		</Grid>
	</ControlTemplate>

	<Style
		x:Key="TagSelectorStyle"
		TargetType="{x:Type tags:TagSelector}">
		<Setter Property="Template" Value="{StaticResource TagSelectorTemplate}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Height" Value="28" />
	</Style>

	<Style
		BasedOn="{StaticResource TagSelectorStyle}"
		TargetType="{x:Type tags:TagSelector}" />


</ResourceDictionary>