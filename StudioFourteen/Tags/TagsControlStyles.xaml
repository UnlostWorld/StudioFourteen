<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Tags"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	x:Name="View"
	d:DesignHeight="300"
	d:DesignWidth="300"
	mc:Ignorable="d">

	<converters:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
	<BooleanToVisibilityConverter x:Key="B2V" />

	<ControlTemplate x:Key="TagsControlTemplate" TargetType="{x:Type local:TagsControl}">

		<Grid>
			<Border
				Margin="1"
				Background="{TemplateBinding Background}"
				Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>


					<ItemsControl
						x:Name="PART_ItemsControl"
						Grid.Column="0"
						VerticalAlignment="Center"
						ItemsPanel="{TemplateBinding ItemsPanelTemplate}"
						ItemsSource="{TemplateBinding Tags}"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled">

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<local:TagControl Value="{Binding Path=.}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock
						Grid.Column="1"
						Margin="3"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Style="{DynamicResource Subscript}"
						Visibility="{Binding InvisibleCount, RelativeSource={RelativeSource AncestorType={x:Type local:TagsControl}}, Converter={StaticResource NotZeroToVisibility}}">
						<Run Text="+" />
						<Run Text="{Binding InvisibleCount, RelativeSource={RelativeSource AncestorType={x:Type local:TagsControl}}}" />
					</TextBlock>
				</Grid>
			</Border>


		</Grid>
	</ControlTemplate>



	<Style x:Key="LinearTagsControl" TargetType="{x:Type local:TagsControl}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />

		<Setter Property="ItemsPanelTemplate">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel IsItemsHost="True" Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template" Value="{StaticResource TagsControlTemplate}" />
	</Style>

	<Style BasedOn="{StaticResource LinearTagsControl}" TargetType="{x:Type local:TagsControl}">

		<Setter Property="ItemsPanelTemplate">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel IsItemsHost="True" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
