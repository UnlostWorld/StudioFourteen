<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Tags"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	x:Name="View"
	d:DesignHeight="300"
	d:DesignWidth="300"
	mc:Ignorable="d">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
	<converters:NullToVisibilityConverter x:Key="NullToVisibility" />

	<ControlTemplate x:Key="TagControlTemplate" TargetType="{x:Type local:TagControl}">

		<Button
			x:Name="PART_TagButton"
			Height="Auto"
			Margin="0"
			Padding="3"
			Background="Transparent"
			Style="{DynamicResource WpfUtilsButtonNoDisabledFade}"
			ToolTip="{TemplateBinding TagToolTip}">

			<StackPanel Margin="2,0" Orientation="Horizontal">
				<wpfUtils:IconBlock
					Margin="0,0,4,0"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Icon="Tag" />
				<TextBlock
					Foreground="{TemplateBinding TagColor}"
					Text="{TemplateBinding TagName}"
					Visibility="{TemplateBinding TagColor,
												 Converter={StaticResource NotNullToVisibility}}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{TemplateBinding TagName}"
					Visibility="{TemplateBinding TagColor,
												 Converter={StaticResource NullToVisibility}}" />
			</StackPanel>
		</Button>
	</ControlTemplate>

	<Style TargetType="{x:Type local:TagControl}">
		<Setter Property="Template" Value="{StaticResource TagControlTemplate}" />
	</Style>


</ResourceDictionary>
