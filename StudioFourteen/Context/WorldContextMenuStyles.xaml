<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:context="clr-namespace:StudioFourteen.Context"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Context"
	xmlns:tags="clr-namespace:StudioFourteen.Tags">

	<BooleanToVisibilityConverter x:Key="B2V" />

	<ControlTemplate x:Key="WorldContextMenuTemplate" TargetType="{x:Type ContentControl}">

		<Grid Margin="12">
			<Grid>
				<Grid.Effect>
					<DropShadowEffect Direction="270" ShadowDepth="0" />
				</Grid.Effect>

				<Border
					Background="{TemplateBinding Background}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<Polygon
					Margin="-11"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Fill="{DynamicResource BackgroundBrush}"
					Points="0,12 16,0, 32,12" />
			</Grid>

			<Grid>
				<StackPanel Margin="3">

					<TextBlock
						Margin="10"
						Foreground="{DynamicResource ForegroundBrush}"
						Text="{Binding ObjectName, RelativeSource={RelativeSource AncestorType={x:Type local:WorldContextMenu}}}"
						TextWrapping="Wrap" />

					<Border Style="{DynamicResource ControlBorder}">
						<StackPanel>

							<ItemsControl ItemsSource="{Binding IconMenus, RelativeSource={RelativeSource AncestorType={x:Type local:WorldContextMenu}}}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type context:MenuEntry}">
										<Button
											Width="32"
											Height="32"
											Command="{Binding OnClicked}"
											IsEnabled="{Binding IsEnabled}"
											ToolTip="{Binding Label}">
											<icons:IconView Height="14" Icon="{Binding Icon}" />
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Menu ItemsSource="{Binding Menus, RelativeSource={RelativeSource AncestorType={x:Type local:WorldContextMenu}}}">

								<Menu.ItemTemplate>
									<HierarchicalDataTemplate DataType="{x:Type context:MenuEntry}" ItemsSource="{Binding Path=Children}" />
								</Menu.ItemTemplate>

								<Menu.ItemContainerStyle>
									<Style BasedOn="{StaticResource MenuItem}"
										TargetType="{x:Type MenuItem}">
										<Setter Property="MenuItem.Command" Value="{Binding OnClicked}" />
										<Setter Property="MenuItem.Header" Value="{Binding Label}" />
										<Setter Property="MenuItem.Icon" Value="{Binding Icon}" />
										<Setter Property="MenuItem.IsEnabled" Value="{Binding IsEnabled}" />
										<Setter Property="MenuItem.ItemsSource" Value="{Binding Children}" />
									</Style>
								</Menu.ItemContainerStyle>
							</Menu>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Grid>

	</ControlTemplate>

	<Style BasedOn="{StaticResource PopOut}" TargetType="{x:Type local:WorldContextMenu}">
		<Setter Property="StaysOpen" Value="False" />
		<Setter Property="Template" Value="{StaticResource WorldContextMenuTemplate}" />
		<Setter Property="Width" Value="250" />
	</Style>

</ResourceDictionary>
