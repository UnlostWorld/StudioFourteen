<Grid Margin="10, 100, 0, 0">

	<Grid.Resources>
		<ControlTheme x:Key="ActorButton" TargetType="{x:Type Button}">
			<Setter Property="Margin" Value="1" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Foreground" Value="{DynamicResource Foreground}" />
			<Setter Property="Padding" Value="0, 0, 50, 0" />
			<Setter Property="ClipToBounds" Value="False" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<ControlTemplate>
					<Panel>
						<Border
							CornerRadius="32, 0, 0, 32"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							BorderThickness="1">

							<Border.Background>
								<LinearGradientBrush
									StartPoint="0%,0%"
									EndPoint="100%,0%">
									<GradientStop Color="#99222222" Offset="0.5" />
									<GradientStop Color="#00222222" Offset="1.0" />
								</LinearGradientBrush>
							</Border.Background>

							<Border.BorderBrush>
								<LinearGradientBrush
									StartPoint="0%,0%"
									EndPoint="100%,0%">
									<GradientStop Color="#99000000" Offset="0.0" />
									<GradientStop Color="#00000000" Offset="1.0" />
								</LinearGradientBrush>
							</Border.BorderBrush>

							<Border
								CornerRadius="31, 0, 0, 31"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								BorderThickness="1">

								<Border.BorderBrush>
									<LinearGradientBrush
										StartPoint="0%,0%"
										EndPoint="100%,0%">
										<GradientStop Color="#99666666" Offset="0.0" />
										<GradientStop Color="#00666666" Offset="1.0" />
									</LinearGradientBrush>
								</Border.BorderBrush>

								<Border
									Name="Border"
									CornerRadius="31, 0, 0, 31"
									Opacity="0.25"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch">

									<Border.Background>
										<LinearGradientBrush
											StartPoint="0%,0%"
											EndPoint="100%,0%">
											<GradientStop Color="#FF888888" Offset="0.0" />
											<GradientStop Color="#00888888" Offset="1.0" />
										</LinearGradientBrush>
									</Border.Background>

									<Border.Transitions>
										<Transitions>
											<DoubleTransition Property="Opacity"
												Duration="0:0:0.1" />
										</Transitions>
									</Border.Transitions>
								</Border>
							</Border>
						</Border>

						<Grid>
							<ContentPresenter
								Name="PART_ContentPresenter"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Center"
								Margin="{TemplateBinding Padding}"
								Content="{TemplateBinding Content}" />
						</Grid>
					</Panel>
				</ControlTemplate>
			</Setter>

			<Style Selector="^:pointerover">
				<Style Selector="^ /template/ Border#Border">
					<Setter Property="Opacity" Value="0.6" />
				</Style>
			</Style>

			<Style Selector="^:pressed">
				<Style Selector="^ /template/ Border#Border">
					<Setter Property="Opacity" Value="0.4" />
				</Style>
			</Style>
		</ControlTheme>

		<ControlTheme x:Key="OtherButton" TargetType="{x:Type Button}">
			<Setter Property="Margin" Value="1" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Foreground" Value="{DynamicResource Foreground}" />
			<Setter Property="Padding" Value="0, 0, 50, 0" />
			<Setter Property="ClipToBounds" Value="False" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<ControlTemplate>
					<Panel>
						<Border
							CornerRadius="16, 0, 0, 16"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							BorderThickness="1">

							<Border.Background>
								<LinearGradientBrush
									StartPoint="0%,0%"
									EndPoint="100%,0%">
									<GradientStop Color="#99222222" Offset="0.5" />
									<GradientStop Color="#00222222" Offset="1.0" />
								</LinearGradientBrush>
							</Border.Background>

							<Border.BorderBrush>
								<LinearGradientBrush
									StartPoint="0%,0%"
									EndPoint="100%,0%">
									<GradientStop Color="#99000000" Offset="0.0" />
									<GradientStop Color="#00000000" Offset="1.0" />
								</LinearGradientBrush>
							</Border.BorderBrush>

							<Border
								CornerRadius="15, 0, 0, 15"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								BorderThickness="1">

								<Border.BorderBrush>
									<LinearGradientBrush
										StartPoint="0%,0%"
										EndPoint="100%,0%">
										<GradientStop Color="#99666666" Offset="0.0" />
										<GradientStop Color="#00666666" Offset="1.0" />
									</LinearGradientBrush>
								</Border.BorderBrush>

								<Border
									Name="Border"
									CornerRadius="15, 0, 0, 15"
									Opacity="0.25"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch">

									<Border.Background>
										<LinearGradientBrush
											StartPoint="0%,0%"
											EndPoint="100%,0%">
											<GradientStop Color="#FF888888" Offset="0.0" />
											<GradientStop Color="#00888888" Offset="1.0" />
										</LinearGradientBrush>
									</Border.Background>

									<Border.Transitions>
										<Transitions>
											<DoubleTransition Property="Opacity"
												Duration="0:0:0.1" />
										</Transitions>
									</Border.Transitions>
								</Border>
							</Border>
						</Border>

						<Grid>
							<ContentPresenter
								Name="PART_ContentPresenter"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Center"
								Margin="{TemplateBinding Padding}"
								Content="{TemplateBinding Content}" />
						</Grid>
					</Panel>
				</ControlTemplate>
			</Setter>

			<Style Selector="^:pointerover">
				<Style Selector="^ /template/ Border#Border">
					<Setter Property="Opacity" Value="0.6" />
				</Style>
			</Style>

			<Style Selector="^:pressed">
				<Style Selector="^ /template/ Border#Border">
					<Setter Property="Opacity" Value="0.4" />
				</Style>
			</Style>
		</ControlTheme>

	</Grid.Resources>

	<StackPanel>
		<Button Theme="{DynamicResource ActorButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Ellipse
					Width="42"
					Height="42"
					Fill="#55000000"
					Grid.Row="0"
					Grid.RowSpan="2"
					Grid.Column="0"
					Margin="6,1,10,1" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Meteor Survivor"
					FontSize="16" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Text="Hyur"
					FontSize="12" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource ActorButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Ellipse
					Width="42"
					Height="42"
					Fill="#55000000"
					Grid.Row="0"
					Grid.RowSpan="2"
					Grid.Column="0"
					Margin="6,1,10,1" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Y'shtola Rhul"
					FontSize="16" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Text="Miqote"
					FontSize="12" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource ActorButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Ellipse
					Width="42"
					Height="42"
					Fill="#55000000"
					Grid.Row="0"
					Grid.RowSpan="2"
					Grid.Column="0"
					Margin="6,1,10,1" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Papalimo"
					FontSize="16" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Text="Lalafel"
					FontSize="12" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource OtherButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<studio:Svg
					Source="Icons/Camera.svg"
					Margin="12, 0"
					Width="20"
					Height="20"
					Foreground="#FFFFFFFF" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Editor Camera"
					VerticalAlignment="Center"
					FontSize="16" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource OtherButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<studio:Svg
					Source="Icons/Light On.svg"
					Margin="12, 0"
					Width="20"
					Height="20"
					Foreground="#FFFFFFFF" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Point Light"
					FontSize="16" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource OtherButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<studio:Svg
					Source="Icons/Light On.svg"
					Margin="12, 0"
					Width="20"
					Height="20"
					Foreground="#FFFFFFFF" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Point Light 2"
					FontSize="16" />

			</Grid>
		</Button>

		<Button Theme="{DynamicResource OtherButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<studio:Svg
					Source="Icons/Light On.svg"
					Margin="12, 0"
					Width="20"
					Height="20"
					Foreground="#FFFFFFFF" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					Text="Point Light 3"
					FontSize="16" />

			</Grid>
		</Button>

	</StackPanel>
</Grid>