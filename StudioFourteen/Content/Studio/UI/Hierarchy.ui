<Grid Margin="10, 10, 0, 0">
	<StackPanel>

		<Border
			BoxShadow="0 3 17 2 #88000000"
			CornerRadius="20"
			BorderThickness="1"
			BorderBrush="#99000000"
			Background="#99222222"
			Name="Chrome"
			Margin="0,0,0,10"
			HorizontalAlignment="Left">

			<Border
				BorderThickness="1"
				CornerRadius="19"
				BorderBrush="#99666666">

				<StackPanel Orientation="Horizontal">
					<Button
						Height="30"
						Width="30"
						Padding="0"
						Background="{DynamicResource WarningRed}"
						Command="{Binding CloseStudioCommand}"
						ToolTip.Tip="Close Studio Fourteen.">
						<S14:Svg
							Height="22"
							Source="Icons/Close.svg"
							Foreground="{DynamicResource Foreground}" />
					</Button>

					<Button
						ToolTip.Tip="Save the current scene."
						Height="30"
						Padding="8,4,14,4">
						<StackPanel Orientation="Horizontal">
							<S14:Svg
								Height="22"
								Source="Icons/Save.svg"
								Foreground="{DynamicResource Foreground}"
								Margin="0,0,4,0" />
							<TextBlock Text="Untitled Scene *" />
						</StackPanel>
					</Button>

					<Button
						Height="30"
						Width="30"
						Padding="0">
						<S14:Svg
							Height="20"
							Source="Icons/Library.svg"
							Foreground="{DynamicResource Foreground}" />
					</Button>

					<Button
						Height="30"
						Width="30"
						Padding="0">
						<S14:Svg
							Height="20"
							Source="Icons/Undo.svg"
							Foreground="{DynamicResource Foreground}" />
					</Button>

					<Button
						Height="30"
						Width="30"
						Padding="0">
						<S14:Svg
							Height="20"
							Source="Icons/Redo.svg"
							Foreground="{DynamicResource Foreground}" />
					</Button>

				</StackPanel>
			</Border>
		</Border>

		<StackPanel
			HorizontalAlignment="Left">

			<ListBox
				ItemsSource="{Binding SceneObjects}"
				SelectionMode="Multiple">

				<ListBox.Resources>

					<!-- List Box Item -->
					<ControlTheme x:Key="{x:Type ListBoxItem}"
						TargetType="{x:Type ListBoxItem}">

						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0" />

						<Setter Property="Template">
							<ControlTemplate>
								<Panel
									StudioFourteen.Interface.Behaviors:HoverCommand.Command="{Binding InterfaceHoverCommand}">
									<Border
										HorizontalAlignment="Left"
										VerticalAlignment="Stretch"
										BoxShadow="0 3 17 2 #88000000"
										CornerRadius="999"
										BorderThickness="1"
										BorderBrush="#99000000"
										Background="#99222222">

										<Border
											BorderThickness="1"
											CornerRadius="999"
											BorderBrush="#99666666">

											<Panel>
												<Border
													Name="Border"
													CornerRadius="30, 0, 0, 30"
													Opacity="0.25"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Stretch" />

												<Border
													Name="SelectionBorder"
													CornerRadius="999"
													Opacity="0"
													Margin="-1"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Stretch"
													BorderThickness="1"
													BorderBrush="{DynamicResource Trim}">

													<Border.Transitions>
														<Transitions>
															<DoubleTransition Property="Opacity"
																Duration="0:0:0.1" />
														</Transitions>
													</Border.Transitions>
												</Border>

												<ContentPresenter
													Name="PART_ContentPresenter"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Center"
													Margin="{TemplateBinding Padding}"
													Content="{TemplateBinding Content}"
													ContentTemplate="{TemplateBinding ContentTemplate}" />
											</Panel>
										</Border>
									</Border>
								</Panel>
							</ControlTemplate>
						</Setter>

						<Style Selector="^:pointerover">
							<Style Selector="^ /template/ Border#Border">
								<Setter Property="Opacity" Value="0.6" />
							</Style>
						</Style>

						<Style Selector="^:pressed">
							<Style Selector="^ /template/ Border#Border">
								<Setter Property="Opacity" Value="0.4" />
							</Style>
						</Style>

						<Style Selector="^:selected">
							<Style Selector="^ /template/ Border#SelectionBorder">
								<Setter Property="Opacity" Value="1.0" />
							</Style>
						</Style>

					</ControlTheme>
				</ListBox.Resources>

				<ListBox.Template>
					<ControlTemplate>
						<ItemsPresenter Name="PART_ItemsPresenter" />
					</ControlTemplate>
				</ListBox.Template>

				<ListBox.ItemTemplate>

					<!-- Character -->
					<DataTemplate DataType="{x:Type StudioFourteen.Scene:Character}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<Ellipse
								Width="48"
								Height="48"
								Fill="#55000000"
								Margin="2">
								<Ellipse.Fill>
									<ImageBrush
										Source="{Binding Portrait}"
										Stretch="UniformToFill"
										AlignmentY="Top" />
								</Ellipse.Fill>

								<ToolTip.Tip>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock
											Grid.Row="0"
											Text="{Binding Name}"
											FontSize="16" />

										<TextBlock
											Grid.Row="1"
											Grid.Column="1"
											Text="{Binding Subtitle}"
											FontSize="12" />
									</Grid>
								</ToolTip.Tip>

							</Ellipse>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<Button
				HorizontalAlignment="Center"
				Height="32"
				Width="32"
				Padding="0"
				ToolTip.Tip="Add a new or existing object to the hierarchy.">
				<StackPanel Orientation="Horizontal">
					<S14:Svg
						Height="22"
						Source="Icons/Add.svg"
						Foreground="{DynamicResource Foreground}" />
				</StackPanel>
			</Button>
		</StackPanel>

	</StackPanel>

</Grid>