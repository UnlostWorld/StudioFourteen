<ResourceDictionary>

	<ControlTemplate
		x:Key="LibraryInspectorTemplate"
		TargetType="{x:Type S14:LibraryInspector}">
		<Grid RowDefinitions="Auto,*">

			<ContentPresenter
				Name="PART_Header"
				Grid.Row="0"
				Content="{TemplateBinding Header}" />

			<ListBox
				Grid.Row="1"
				ItemsSource="{TemplateBinding Entries}"
				SelectedItem="{TemplateBinding Value, Mode=TwoWay}"
				Background="Transparent"
				BorderBrush="Transparent"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Background" Value="#888888" />
						<Setter Property="Foreground" Value="{DynamicResource Foreground}" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0,2" />
						<Setter Property="HorizontalAlignment" Value="Stretch" />

						<Setter Property="Template">
							<ControlTemplate>
								<Panel>

									<Border
										CornerRadius="16"
										HorizontalAlignment="Stretch"
										VerticalAlignment="Stretch"
										BorderThickness="1"
										BorderBrush="#99000000">
										<Border
											Name="PART_Border"
											CornerRadius="15"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Stretch"
											BorderThickness="1"
											BorderBrush="#99666666">

											<Panel
												Name="PART_HoverElement"
												Opacity="0.25">
												<Panel.Transitions>
													<Transitions>
														<DoubleTransition Property="Opacity"
															Duration="0:0:0.1" />
													</Transitions>
												</Panel.Transitions>

												<Border
													CornerRadius="14"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Stretch"
													Background="{TemplateBinding Background}" />
											</Panel>
										</Border>
									</Border>

									<ContentPresenter
										Name="PART_ContentPresenter"
										Padding="{TemplateBinding Padding}"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
										Content="{TemplateBinding Content}"
										ContentTemplate="{TemplateBinding ContentTemplate}" />
								</Panel>
							</ControlTemplate>
						</Setter>

						<Style Selector="^:pointerover">
							<Style Selector="^ /template/ Panel#PART_HoverElement">
								<Setter Property="Opacity" Value="0.6" />
							</Style>
						</Style>

						<Style Selector="^:pressed">
							<Style Selector="^ /template/ Panel#PART_HoverElement">
								<Setter Property="Opacity" Value="0.4" />
							</Style>
						</Style>

						<Style Selector="^:selected">
							<Style Selector="^ /template/ Border#PART_Border">
								<Setter Property="BorderBrush" Value="{DynamicResource Trim}" />
							</Style>
						</Style>

						<Style Selector="^:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>

						<Style Selector="^:selected /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>

						<Style Selector="^:selected:focus /template/ ContentPresenter">
							<Setter Property="Background"
								Value="Transparent" />
						</Style>

						<Style Selector="^:selected:pointerover /template/ ContentPresenter">
							<Setter Property="Background"
								Value="Transparent" />
						</Style>

						<Style Selector="^:selected:focus:pointerover /template/ ContentPresenter">
							<Setter Property="Background"
								Value="Transparent" />
						</Style>
					</Style>

				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid
							ColumnDefinitions="auto, *"
							RowDefinitions="Auto,Auto"
							Background="Transparent">

							<ToolTip.Tip>
								<StackPanel MaxWidth="256">
									<TextBlock Text="{Binding Name}" />
									<TextBlock Text="{Binding Description}"
										IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

									<TextBlock>
										<Run Text="Lv." />
										<Run Text="{Binding EquipLevel}" />
										<Run Text=" - " />
										<Run Text="{Binding UICategory.Name}" />
									</TextBlock>

									<ItemsControl
										Margin="0,6,0,0"
										ItemsSource="{Binding ClassJobs.ClassJobs}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<S14:TextureIcon Id="062000"
													Offset="{Binding RowId}" Width="22"
													Height="22" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!--<TextBlock Text="{Binding ClassJobs.Name}" />
									<TextBlock Text="{Binding EquipRestriction.Name}" />
									<TextBlock Text="{Binding EquipSlot.Name}" />-->
								</StackPanel>
							</ToolTip.Tip>

							<!--<ContentPresenter
								Grid.RowSpan="2"
								Grid.Column="0"
								Width="42"
								Height="42"
								Content="{Binding Icon}" />-->

							<Border
								CornerRadius="15, 4, 4, 15"
								Height="48"
								Width="48"
								Grid.RowSpan="2"
								Grid.Column="0"
								Margin="2,2,10,2">
								<Border.Background>
									<ImageBrush
										Source="{Binding Icon.Source}"
										Stretch="Uniform"
										AlignmentX="Left" />
								</Border.Background>
							</Border>

							<TextBlock
								Grid.Row="0"
								Grid.Column="1"
								Text="{Binding Name}"
								VerticalAlignment="Bottom"
								TextTrimming="PrefixCharacterEllipsis" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="1"
								Text="{Binding SubTitle}"
								Opacity="0.5"
								VerticalAlignment="Top" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</ControlTemplate>

	<ControlTheme
		x:Key="{x:Type S14:LibraryInspector}"
		TargetType="{x:Type S14:LibraryInspector}">

		<Setter Property="Template" Value="{StaticResource LibraryInspectorTemplate}" />
	</ControlTheme>
</ResourceDictionary>