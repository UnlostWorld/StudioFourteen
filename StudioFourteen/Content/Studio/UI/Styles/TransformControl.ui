<ResourceDictionary>
	<ControlTheme
		x:Key="{x:Type S14:TransformControl}"
		TargetType="{x:Type S14:TransformControl}">

		<Setter Property="Foreground" Value="White" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<S14:Svg
							Grid.Row="0"
							Grid.Column="0"
							Margin="0,0,6,0"
							Foreground="{TemplateBinding Foreground}"
							Source="Icons/Translate.svg"
							Width="16" />

						<S14:Vector3Control
							Grid.Row="0"
							Grid.Column="1"
							Value="{TemplateBinding Translation, Mode=TwoWay}" />

						<S14:Svg
							Grid.Row="1"
							Grid.Column="0"
							Width="16"
							Margin="0,0,6,0"
							Foreground="{TemplateBinding Foreground}"
							Source="Icons/Rotate.svg" />

						<S14:Vector3Control
							Grid.Row="1"
							Grid.Column="1"
							Value="{TemplateBinding Euler, Mode=TwoWay}" />

						<S14:Svg
							Grid.Row="2"
							Grid.Column="0"
							Width="16"
							Margin="0,0,6,0"
							Foreground="{TemplateBinding Foreground}"
							Source="Icons/Scale.svg" />

						<S14:Vector3Control
							Grid.Row="2"
							Grid.Column="1"
							Value="{TemplateBinding Scale, Mode=TwoWay}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</ControlTheme>
</ResourceDictionary>