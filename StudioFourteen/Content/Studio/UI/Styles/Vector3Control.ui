<ResourceDictionary>
	<ControlTheme
		x:Key="{x:Type S14:Vector3Control}"
		TargetType="{x:Type S14:Vector3Control}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Ellipse
							Grid.Column="0"
							Width="10"
							Height="10"
							Margin="8,0,2,0"
							Fill="{TemplateBinding XForeground}" />

						<S14:NumberBox
							Grid.Column="1"
							Margin="0"
							Value="{TemplateBinding X, Mode=TwoWay}" />

						<Ellipse
							Grid.Column="2"
							Width="10"
							Height="10"
							Margin="8,0,2,0"
							Fill="{TemplateBinding YForeground}" />

						<S14:NumberBox
							Grid.Column="3"
							Margin="0"
							Value="{TemplateBinding Y, Mode=TwoWay}" />

						<Ellipse
							Grid.Column="4"
							Width="10"
							Height="10"
							Margin="8,0,2,0"
							Fill="{TemplateBinding ZForeground}" />

						<S14:NumberBox
							Grid.Column="5"
							Margin="0"
							Value="{TemplateBinding Z, Mode=TwoWay}" />

					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</ControlTheme>
</ResourceDictionary>