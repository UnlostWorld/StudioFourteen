<ResourceDictionary>

	<ControlTheme x:Key="{x:Type ContextMenu}"
		TargetType="{x:Type ContextMenu}">

		<Setter Property="Focusable" Value="True" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="MinWidth" Value="200" />
		<Setter Property="TextBlock.FontSize" Value="{DynamicResource FontSizeNormal}" />
		<Setter Property="TextBlock.FontWeight" Value="Normal" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource Foreground}" />

		<Setter Property="Template">
			<ControlTemplate>
				<Border
					BoxShadow="0 3 17 2 #88000000"
					CornerRadius="10"
					BorderThickness="1"
					Margin="20"
					BorderBrush="#99000000"
					Background="#99222222"
					Name="Chrome">

					<ScrollViewer Theme="{StaticResource SimpleMenuScrollViewer}">
						<ItemsPresenter Name="PART_ItemsPresenter"
							ItemsPanel="{TemplateBinding ItemsPanel}"
							KeyboardNavigation.TabNavigation="Continue"
							Margin="4" />
					</ScrollViewer>
				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

</ResourceDictionary>