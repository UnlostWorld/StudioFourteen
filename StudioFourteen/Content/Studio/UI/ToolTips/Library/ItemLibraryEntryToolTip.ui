<DataTemplate
	DataType="{x:Type StudioFourteen.Services.Library.GameData.Library:ItemLibraryEntry}">

	<StackPanel
		MaxWidth="256">
		<TextBlock Text="{Binding Name}" />
		<TextBlock Text="{Binding Description}"
			IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

		<TextBlock>
			<Run Text="Lv." />
			<Run Text="{Binding EquipLevel}" />
			<Run Text=" - " />
			<Run Text="{Binding UICategory.Name}" />
		</TextBlock>

		<ItemsControl
			Margin="0,6,0,0"
			ItemsSource="{Binding ClassJobs.ClassJobs}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<S14:TextureIcon Id="062000"
						Offset="{Binding RowId}" Width="22"
						Height="22" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Viewbox>
			<S14:PreviewControl
				Item="{Binding Item}"
				Margin="0,4" />
		</Viewbox>

		<!--
		<TextBlock Text="{Binding ClassJobs.Name}" />
		<TextBlock Text="{Binding EquipRestriction.Name}" />
		<TextBlock Text="{Binding EquipSlot.Name}" />
		-->

	</StackPanel>
</DataTemplate>