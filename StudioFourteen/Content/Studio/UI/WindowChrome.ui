<Border
	BoxShadow="0 3 17 2 #FF000000"
	CornerRadius="20"
	BorderThickness="1"
	Margin="20"
	BorderBrush="#FF000000"
	Background="#99222222">

	<Border
		BorderThickness="1"
		CornerRadius="19"
		BorderBrush="#FF666666">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid
				Grid.Row="0"
				HorizontalAlignment="Right">
				<Ellipse
					Fill="#FFFF5555"
					Width="12"
					Height="12"
					Margin="12"/>
			</Grid>

			<ContentControl
				Grid.Row="1"
				Name="WindowContents"
				Margin="6,0,6,6" />
		</Grid>
	</Border>

</Border>