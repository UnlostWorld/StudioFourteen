<ScrollViewer>
	<StackPanel>
		<StackPanel.Resources>

			<DataTemplate
				x:Key="Equipment"
				DataType="{x:Type StudioFourteen.Scene.DrawData:Equipment}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Border
						CornerRadius="15, 4, 4, 15"
						Height="48"
						Width="48"
						Margin="2">
						<Border.Background>
							<ImageBrush
								Source="{Binding Item.Icon.Source}"
								Stretch="Uniform"
								AlignmentX="Left" />
						</Border.Background>
					</Border>

					<StackPanel Grid.Column="1" Margin="6">
						<TextBlock Text="{Binding Slot}" Opacity="0.5" />
						<TextBlock Text="{Binding Item.Name}" />
					</StackPanel>

					<S14:Svg
						Grid.Column="2"
						Source="Icons/Forward.svg"
						Margin="6" />

				</Grid>
			</DataTemplate>
		</StackPanel.Resources>

		<TextBlock Text="Equipment" Margin="8" />

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Head}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Head}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Head.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Body}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Body}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Body.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Hands}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Hands}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Hands.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Legs}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Legs}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Legs.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Feet}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Feet}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Feet.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<TextBlock Text="Accessories" Margin="8" />

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Ears}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Ears}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Ears.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Neck}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Neck}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Neck.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding Wrists}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding Wrists}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding Wrists.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding RFinger}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding RFinger}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding RFinger.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>

		<S14:InspectorLink
			Margin="4,2"
			Padding="0"
			HorizontalContentAlignment="Stretch"
			ContentTemplate="{DynamicResource Equipment}"
			Content="{Binding LFinger}"
			PagePath="UI/Inspectors/Character/EquipmentPage.ui"
			DestinationDataContext="{Binding LFinger}">
			<ToolTip.Tip>
				<S14:DataTemplatePresenter
					Target="{Binding LFinger.Item}"
					TemplateDirectory="UI/ToolTips/Library/" />
			</ToolTip.Tip>
		</S14:InspectorLink>
	</StackPanel>
</ScrollViewer>