<Grid
	Height="700"
	Width="350">

	<Ellipse
		Width="32"
		Height="32"
		VerticalAlignment="Top"
		HorizontalAlignment="Right"
		Fill="#55000000"
		Margin="6,6,6,6">
		<Ellipse.Fill>
			<ImageBrush
				Source="{Binding Target.Portrait}"
				Stretch="UniformToFill"
				AlignmentY="Top" />
		</Ellipse.Fill>
	</Ellipse>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Command="{Binding ClosePageCommand}"
				Classes.Collapse="{Binding !IsPageOpen}"
				Padding="0"
				Width="32"
				Height="32">

				<Panel>
					<S14:Svg
						Source="Icons/Back.svg"
						Foreground="{DynamicResource Foreground}"
						Height="20"
						IsVisible="{Binding IsPageOpen}" />

					<S14:Svg
						Source="Icons/Close.svg"
						Foreground="{DynamicResource Foreground}"
						Height="20"
						IsVisible="{Binding !IsPageOpen}" />
				</Panel>
			</Button>

			<TextBlock
				Grid.Column="1"
				Text="{Binding Target.Name}"
				Margin="4,0,0,0"
				FontSize="16"
				VerticalAlignment="Center" />
		</Grid>

		<!-- Inspector Area -->
		<Panel
			Grid.Row="1"
			Classes="Page"
			Classes.PageCollapse-Left="{Binding IsPageOpen}">

			<S14:ContentControl
				ContentPath="{Binding InspectorPath}"
				ContentDataContext="{Binding Target}" />
		</Panel>

		<!-- Page Area -->
		<Panel
			Grid.Row="1"
			Classes="Page"
			Classes.PageCollapse-Right="{Binding !IsPageOpen}">

			<S14:ContentControl
				ContentPath="{Binding Page}"
				ContentDataContext="{Binding PageDataContext}" />
		</Panel>

	</Grid>
</Grid>