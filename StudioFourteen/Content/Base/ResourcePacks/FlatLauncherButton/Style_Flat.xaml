<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<sys:String x:Key="PackName">Flat Launcher Button</sys:String>
	<sys:String x:Key="PackAuthor">Studio Fourteen Team</sys:String>
	<sys:String x:Key="PackIcon">icon.png</sys:String>

	<BitmapImage
		x:Key="LauncherButtonBackground"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher-flat.png" />

	<BitmapImage
		x:Key="LauncherButtonHoverMask"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher-flat-hover-mask.png" />

</ResourceDictionary>
