<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<sys:String x:Key="PackName">Paper Launcher Button</sys:String>
	<sys:String x:Key="PackAuthor">Studio Fourteen Team</sys:String>
	<sys:String x:Key="PackIcon">icon.png</sys:String>

	<BitmapImage
		x:Key="LauncherButtonBackground"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher-paper.png" />

	<BitmapImage
		x:Key="LauncherButtonHoverMask"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher-paper-hover-mask.png" />

</ResourceDictionary>
