<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:modifiers="clr-namespace:StudioFourteen.Scene.Cameras.Modifiers">

	<DataTemplate DataType="{x:Type modifiers:ShakyModifier}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}"
				Text="Position Intensity" />
			<s14:NumberBox Change="0.1" Value="{Binding PositionIntensity}" Minimum="0" Maximum="1" />

			<TextBlock Style="{DynamicResource LeftLabel}"
				Text="Rotation Intensity" />
			<s14:NumberBox Change="0.1" Value="{Binding RotationIntensity}" Minimum="0" Maximum="10" />

			<TextBlock Style="{DynamicResource LeftLabel}"
				Text="Speed" />
			<s14:NumberBox Change="0.1" Value="{Binding Speed}" Minimum="0" Maximum="3" />

		</StackPanel>
	</DataTemplate>

</ResourceDictionary>