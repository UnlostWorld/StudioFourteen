<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cameras="clr-namespace:StudioFourteen.Scene.Cameras"
	xmlns:controls="clr-namespace:StudioFourteen.Controls">

	<DataTemplate DataType="{x:Type cameras:FreeCamera}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border
				Grid.Row="0"
				Style="{DynamicResource WpfUtilsBackgroundBorder}">
				<ScrollViewer VerticalScrollBarVisibility="Disabled">
					<StackPanel>
						<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_FreeCamera_Position}" />
						<controls:Vector3Box Change="0.1" Value="{Binding Position}" />

						<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Camera_Rotation}" />
						<controls:QuaternionBox Change="1" Value="{Binding Rotation}" />
					</StackPanel>
				</ScrollViewer>
			</Border>

			<ContentPresenter
				Grid.Row="1"
				Content="{Binding .}"
				ContentTemplate="{DynamicResource CameraInspector}" />

		</Grid>

	</DataTemplate>

</ResourceDictionary>
