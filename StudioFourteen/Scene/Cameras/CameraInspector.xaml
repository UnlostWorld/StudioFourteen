<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cameras="clr-namespace:StudioFourteen.Scene.Cameras"
	xmlns:controls="clr-namespace:StudioFourteen.Controls">

	<DataTemplate x:Key="CameraInspector" DataType="{x:Type cameras:Camera}">
		<UniformGrid Rows="1">
			<ToggleButton
				Background="Transparent"
				Content="Activate"
				IsChecked="{Binding IsActive}" />
		</UniformGrid>
	</DataTemplate>

</ResourceDictionary>
