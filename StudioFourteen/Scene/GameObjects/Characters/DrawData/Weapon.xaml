<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:libraryData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:drawData="clr-namespace:StudioFourteen.Scene.GameObjects.Characters.DrawData">

	<DataTemplate DataType="{x:Type drawData:Weapon}">
		<Border Margin="0,1" Style="{DynamicResource ControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<librarySelector:LibrarySelectorButton
					Grid.Column="0"
					Background="Transparent"
					PopOutHeader="{Binding SearchTitle}"
					SearchTags="{Binding SearchTags}"
					Type="{Binding LibraryType}"
					Value="{Binding Item}">
					<librarySelector:LibrarySelectorButton.IconBackground>
						<Grid>
							<s14:XivTexImage
								Margin="0"
								Opacity="0.5"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 192, 96, 96" />

							<s14:XivTexImage
								Margin="6"
								Path="ui/uld/character_hr1.tex"
								Rect="{Binding SlotBackgroundRect}" />
						</Grid>
					</librarySelector:LibrarySelectorButton.IconBackground>
				</librarySelector:LibrarySelectorButton>

				<librarySelector:LibrarySelectorButton
					Grid.Column="1"
					Margin="-2,0"
					Background="Transparent"
					PopOutHeader="{Binding DyeSearchTitle}"
					Style="{DynamicResource LibrarySelectorIconOnly}"
					Type="{x:Type libraryData:StainLibraryEntry}"
					Value="{Binding Stain0}">

					<librarySelector:LibrarySelectorButton.IconBackground>
						<Grid>
							<s14:XivTexImage
								Margin="0"
								Opacity="0.5"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 192, 96, 96" />
						</Grid>
					</librarySelector:LibrarySelectorButton.IconBackground>

				</librarySelector:LibrarySelectorButton>

				<librarySelector:LibrarySelectorButton
					Grid.Column="2"
					Margin="-2,0,0,0"
					Background="Transparent"
					PopOutHeader="{Binding DyeSearchTitle}"
					Style="{DynamicResource LibrarySelectorIconOnly}"
					Type="{x:Type libraryData:StainLibraryEntry}"
					Value="{Binding Stain1}">
					<librarySelector:LibrarySelectorButton.IconBackground>
						<Grid>
							<s14:XivTexImage
								Margin="0"
								Opacity="0.5"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 192, 96, 96" />
						</Grid>
					</librarySelector:LibrarySelectorButton.IconBackground>
				</librarySelector:LibrarySelectorButton>
			</Grid>
		</Border>
	</DataTemplate>

</ResourceDictionary>
