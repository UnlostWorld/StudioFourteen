<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Xaml"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	xmlns:scene="clr-namespace:StudioFourteen.Scene"
	xmlns:skeletons="clr-namespace:StudioFourteen.Scene.GameObjects.Characters.Skeletons">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<DataTemplate DataType="{x:Type skeletons:SkeletonBoneGroup}">

		<Border Background="{DynamicResource BackgroundBrush}"
			CornerRadius="{DynamicResource BorderInnerCornerRadius}">

			<StackPanel Margin="2">
				<TextBlock Text="Hello World!" />
			</StackPanel>
		</Border>

	</DataTemplate>

</ResourceDictionary>