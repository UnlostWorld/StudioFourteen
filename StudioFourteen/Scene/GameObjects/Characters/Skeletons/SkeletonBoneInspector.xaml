<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:StudioFourteen.Converters"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	xmlns:scene="clr-namespace:StudioFourteen.Scene"
	xmlns:skeletons="clr-namespace:StudioFourteen.Scene.GameObjects.Characters.Skeletons">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<DataTemplate DataType="{x:Type skeletons:SkeletonBone}">

		<Border Background="{DynamicResource BackgroundBrush}"
			CornerRadius="{DynamicResource BorderInnerCornerRadius}">

			<StackPanel Margin="2">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<controls:SwitchSelector
						Grid.Column="0"
						SelectedValue="{Binding MirrorMode}"
						SelectedValuePath="Tag"
						Visibility="{Binding CanMirror, Converter={StaticResource B2V}}">

						<ComboBoxItem
							Content="{DynamicResource ICON_Pose_Mirror_None}"
							Tag="{x:Static pose:MirrorModes.None}"
							ToolTip="{DynamicResource LOC_Pose_Mirror_None}" />

						<ComboBoxItem
							Content="{DynamicResource ICON_Pose_Mirror_Copy}"
							Tag="{x:Static pose:MirrorModes.MirrorTCopyRS}"
							ToolTip="{DynamicResource LOC_Pose_Mirror_Copy}" />

						<ComboBoxItem
							Content="{DynamicResource ICON_Pose_Mirror_Flip}"
							Tag="{x:Static pose:MirrorModes.MirrorTRCopyS}"
							ToolTip="{DynamicResource LOC_Pose_Mirror_Flip}" />

					</controls:SwitchSelector>

					<Button
						Grid.Column="1"
						Width="28"
						Command="{Binding ResetCommand}"
						Content="{DynamicResource ICON_Pose_Reset}" />

					<ToggleButton
						Grid.Column="2"
						Width="28"
						Content="{DynamicResource ICON_Pose_LockTransform}"
						IsChecked="{Binding LockTransform, FallbackValue=false}"
						Style="{DynamicResource IconToggleButton}"
						ToolTip="{DynamicResource LOC_Pose_LockTransform}" />

				</Grid>

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Style="{DynamicResource LabelLeft}"
					Text="Transform" />
				<ContentPresenter Content="{Binding .}" ContentTemplate="{DynamicResource TransformSceneObjectBaseInspector}" />

			</StackPanel>
		</Border>

	</DataTemplate>

</ResourceDictionary>
