		<ResourceDictionary Source="./Styles/TabControlStyles.xaml" />
		<ResourceDictionary Source="./Styles/TextBoxStyles.xaml" />
		<ResourceDictionary Source="./Styles/TextBoxExStyles.xaml" />
		<ResourceDictionary Source="./Styles/ComboBoxStyles.xaml" />
		<ResourceDictionary Source="./Styles/MenuStyles.xaml" />
		<ResourceDictionary Source="./Styles/WindowStyles.xaml" />
		<ResourceDictionary Source="./Styles/ScrollBarStyles.xaml" />
		<ResourceDictionary Source="./Styles/ProgressBarStyles.xaml" />
		<ResourceDictionary Source="./Styles/CheckBoxStyles.xaml" />
		<ResourceDictionary Source="./Styles/ListBoxStyles.xaml" />
		<ResourceDictionary Source="./Styles/SliderStyles.xaml" />
		<ResourceDictionary Source="./Styles/ToolTipStyles.xaml" />
		<ResourceDictionary Source="./Styles/ResizeGripStyles.xaml" />
		<ResourceDictionary Source="./Styles/RadioButtonStyles.xaml" />
		<ResourceDictionary Source="./Styles/SeparatorStyles.xaml" />
		<ResourceDictionary Source="./Styles/PopupStyles.xaml" />
		<ResourceDictionary Source="./Styles/ContextMenuStyles.xaml" />
		<ResourceDictionary Source="./Styles/SpinnerStyle.xaml" />
		<ResourceDictionary Source="./Styles/ToggleButtonStyles.xaml" />

		<ResourceDictionary Source="../Icons/IconStyles.xaml" />
		<ResourceDictionary Source="../Launcher/LauncherStyles.xaml" />
		<ResourceDictionary Source="../Launcher/TaskBarStyles.xaml" />
		<ResourceDictionary Source="../Launcher/LauncherMenuStyles.xaml" />

		<!--  Custom controls  -->
		<ResourceDictionary Source="../Panels/PanelWindowStyle.xaml" />
		<ResourceDictionary Source="../Library/Selector/LibrarySelectorStyles.xaml" />
		<ResourceDictionary Source="../Library/Selector/LibrarySelectorButtonStyles.xaml" />
		<ResourceDictionary Source="../Library/LibraryMenu/LibraryContextMenuStyles.xaml" />
		<ResourceDictionary Source="../Context/WorldContextMenuStyles.xaml" />
		<ResourceDictionary Source="../Tags/TagControlStyles.xaml" />
		<ResourceDictionary Source="../Tags/TagsControlStyles.xaml" />
		<ResourceDictionary Source="../Tags/TagSelectorStyles.xaml" />
		<ResourceDictionary Source="./Controls/SliderStyles.xaml" />
		<ResourceDictionary Source="./Controls/IconSliderStyles.xaml" />
		<ResourceDictionary Source="../Posing/Shared/SkeletonBoneControlStyles.xaml" />
		<ResourceDictionary Source="./Controls/TransformControlStyles.xaml" />
		<ResourceDictionary Source="./Controls/NumberBoxStyles.xaml" />
		<ResourceDictionary Source="./Controls/MultiNumberBoxStyles.xaml" />
		<ResourceDictionary Source="./Controls/GripStyles.xaml" />
		<ResourceDictionary Source="./Controls/OrderableItemsControlStyles.xaml" />
		<ResourceDictionary Source="./Controls/RadioButtonHighlighterStyles.xaml" />
		<ResourceDictionary Source="./Controls/AreaSliderStyles.xaml" />
		<ResourceDictionary Source="./Controls/PopOutStyles.xaml" />
		<ResourceDictionary Source="./Controls/SwitchSelectorStyles.xaml" />

		<ResourceDictionary Source="../Appearance/Customize/ExcelLibraryEntryMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/ColorMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/SelectorMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/IconMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/DoubleColorMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/MultiIconMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/PercentageMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/ListMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/CustomizeLibraryEntryMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/ToggleMenu.xaml" />
		<ResourceDictionary Source="../Appearance/Customize/GenderMenu.xaml" />

		<!--  Default Language  -->
		<ResourceDictionary Source="../Icons/Icons.xaml" />
		<ResourceDictionary Source="../Languages/English.xaml" />

		<!--  Templates  -->
		<ResourceDictionary Source="../Library/LibraryBodyTemplates.xaml" />

		<!-- Inspectors -->
		<ResourceDictionary Source="../Scene/InspectorHeader.xaml" />
		<ResourceDictionary Source="../Scene/TransformObjectInspector.xaml" />
		<ResourceDictionary Source="../Scene/GameObjects/Characters/CharacterInspector.xaml" />
		<ResourceDictionary
			Source="../Scene/GameObjects/Characters/Skeletons/SkeletonBoneInspector.xaml" />
		<ResourceDictionary
			Source="../Scene/GameObjects/Characters/Skeletons/SkeletonBoneGroupInspector.xaml" />
		<ResourceDictionary Source="../Scene/GameObjects/Characters/DrawData/Weapon.xaml" />
		<ResourceDictionary Source="../Scene/GameObjects/Characters/DrawData/Equipment.xaml" />
		<ResourceDictionary Source="../Scene/Cameras/CameraInspector.xaml" />
		<ResourceDictionary Source="../Scene/Cameras/OrbitCameraInspector.xaml" />
		<ResourceDictionary Source="../Scene/Cameras/OrbitTargetCameraInspector.xaml" />
		<ResourceDictionary Source="../Scene/Cameras/FreeCameraInspector.xaml" />

	</ResourceDictionary.MergedDictionaries>

	<!--  Custom converters  -->
	<BooleanToVisibilityConverter x:Key="B2V" />
	<s14:AbsoluteNumberConverter x:Key="AbsoluteNumber" />
	<s14:BoolInversionConverter x:Key="!B" />
	<s14:ColorToBrushConverter x:Key="ColorToBrush" />
	<s14:EnumToBoolConverter x:Key="EnumToBool" />
	<s14:EnumToIndexConverter x:Key="EnumToIndex" />
	<s14:EnumToVisibilityConverter x:Key="EnumToVisibility" />
	<s14:GreaterThanToVisibilityConverter x:Key="GreaterThanToVisibility" />
	<s14:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<s14:IsEmptyToVisibilityConverter x:Key="IsEmptyToVisibilityConverter" />
	<s14:IsZeroToBoolConverter x:Key="IsZeroToBool" />
	<s14:IsZeroToVisibilityConverter x:Key="IsZeroToVisibility" />
	<s14:LessThanToBoolConverter x:Key="LessThanToBool" />
	<s14:LessThanToVisibilityConverter x:Key="LessThanToVisibility" />
	<s14:ListToStringConverter x:Key="ListToStringConverter" />
	<s14:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
	<s14:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
	<s14:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	<s14:NotZeroToBoolConverter x:Key="NotZeroToBool" />
	<s14:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
	<s14:NullToBoolConverter x:Key="NullToBoolConverter" />
	<s14:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
	<s14:NumberConverter x:Key="NumberConverter" />
	<s14:RadiansToDegreesConverter x:Key="Rad2Deg" />
	<s14:StringHasContentToBoolConverter x:Key="StringHasContentToBool" />
	<s14:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />

	<!--  Multi converters  -->
	<s14:AnyBoolIsFalseToBoolMultiConverter x:Key="AnyBoolIsFalseToBool" />
	<s14:MultiBoolAndConverter x:Key="MultiBoolAnd" />
	<s14:MultiBoolAndToVisibilityConverter x:Key="MultiBoolAndToVisibility" />
	<s14:MultiBoolOrConverter x:Key="MultiBoolOr" />
	<s14:MultiBoolOrToVisibilityConverter x:Key="MultiBoolOrToVisibility" />
	<s14:MultiOrVisibilityConverter x:Key="MultiOrVisibility" />

	<Style BasedOn="{StaticResource ScrollViewerStyle}" TargetType="{x:Type ScrollViewer}" />
	<Style BasedOn="{StaticResource AreaSlider}" TargetType="{x:Type s14:AreaSlider}" />
	<Style BasedOn="{StaticResource Button}" TargetType="{x:Type Button}" />
	<Style BasedOn="{StaticResource CheckBox}" TargetType="{x:Type CheckBox}" />
	<Style BasedOn="{StaticResource ComboBox}" TargetType="{x:Type ComboBox}" />
	<Style BasedOn="{StaticResource ContextMenu}" TargetType="{x:Type ContextMenu}" />
	<Style BasedOn="{StaticResource Expander}" TargetType="{x:Type Expander}" />
	<Style BasedOn="{StaticResource GroupBox}" TargetType="{x:Type GroupBox}" />
	<Style BasedOn="{StaticResource ListBox}" TargetType="{x:Type s14:ListBoxEx}" />
	<Style BasedOn="{StaticResource ListBox}" TargetType="{x:Type ListBox}" />
	<Style BasedOn="{StaticResource ListBoxItem}" TargetType="{x:Type s14:ListBoxItemEx}" />
	<Style BasedOn="{StaticResource ListBoxItem}" TargetType="{x:Type ListBoxItem}" />
	<Style BasedOn="{StaticResource Menu}" TargetType="{x:Type Menu}" />
	<Style BasedOn="{StaticResource MenuItem}" TargetType="{x:Type MenuItem}" />
	<Style BasedOn="{StaticResource PopOut}" TargetType="{x:Type s14:PopOut}" />
	<Style BasedOn="{StaticResource Popup}" TargetType="{x:Type Popup}" />
	<Style BasedOn="{StaticResource ProgressBar}" TargetType="{x:Type ProgressBar}" />
	<Style BasedOn="{StaticResource RadioButton}" TargetType="{x:Type RadioButton}" />
	<Style BasedOn="{StaticResource RadioButtonHighlighter}"
		TargetType="{x:Type s14:RadioButtonHighlighter}" />
	<Style BasedOn="{StaticResource Separator}" TargetType="{x:Type Separator}" />
	<Style BasedOn="{StaticResource TabControl}" TargetType="{x:Type TabControl}" />
	<Style BasedOn="{StaticResource TextBlock}" TargetType="{x:Type TextBlock}" />
	<Style BasedOn="{StaticResource TextBox}" TargetType="{x:Type TextBox}" />
	<Style BasedOn="{StaticResource TextBoxEx}" TargetType="{x:Type s14:TextBoxEx}" />
	<Style BasedOn="{StaticResource ToggleButton}" TargetType="{x:Type ToggleButton}" />
	<Style BasedOn="{StaticResource ToolTip}" TargetType="{x:Type ToolTip}" />
	<Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"
		BasedOn="{StaticResource FocusVisualStyle}" />

	<!-- Default colors -->
	<SolidColorBrush x:Key="ForegroundBrush" Color="#ECECEC" />
	<SolidColorBrush x:Key="ForegroundLightBrush" Color="#838383" />
	<SolidColorBrush x:Key="BackgroundBrush" Color="#222222" />
	<SolidColorBrush x:Key="BackgroundLightBrush" Color="#333333" />
	<SolidColorBrush x:Key="TrimBrush" Color="#FF1493" />
	<SolidColorBrush x:Key="ControlBackgroundBrush" Color="#171717" />
	<SolidColorBrush x:Key="ControlHighlightBrush" Color="#343434" />
	<SolidColorBrush x:Key="ControlForegroundHighlightBrush" Color="#ECECEC" />
	<SolidColorBrush x:Key="ControlBackgroundSelectedBrush" Color="#222222" />

	<!-- Default Launcher Button -->
	<BitmapImage x:Key="LauncherButtonBackground"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher.png" />
	<BitmapImage x:Key="LauncherButtonHoverMask"
		UriSource="pack://application:,,,/StudioFourteen;component/Assets/launcher-hover-mask.png" />

</s14:XamlResources>