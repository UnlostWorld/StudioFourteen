<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml">

	<ControlTemplate x:Key="AreaSliderThumbTemplate" TargetType="{x:Type Thumb}">

		<Grid>
			<Ellipse
				x:Name="BackgroundEllipse"
				Fill="{DynamicResource ControlHighlightBrush}"
				Opacity="0" />
			<Ellipse
				x:Name="ForegroundEllipse"
				Margin="3"
				Fill="{DynamicResource ForegroundLightBrush}" />
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="BackgroundEllipse" Property="Opacity" Value="1" />
			</Trigger>
			<Trigger Property="IsDragging" Value="True">
				<Setter TargetName="ForegroundEllipse" Property="Fill"
					Value="{DynamicResource TrimBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="AreaSliderThumb" TargetType="{x:Type Thumb}">
		<Setter Property="Height" Value="20" />
		<Setter Property="Template" Value="{StaticResource AreaSliderThumbTemplate}" />
		<Setter Property="Width" Value="20" />
	</Style>

	<ControlTemplate x:Key="AreaSliderTemplate" TargetType="{x:Type s14:AreaSlider}">
		<Grid>
			<Border Style="{DynamicResource ControlBorder}">
				<Canvas>
					<Thumb
						x:Name="PART_Thumb"
						Canvas.Left="0"
						Canvas.Top="0"
						Style="{StaticResource AreaSliderThumb}" />
				</Canvas>
			</Border>
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="CircularAreaSliderTemplate"
		TargetType="{x:Type s14:AreaSlider}">
		<Grid>
			<Ellipse
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Fill="{DynamicResource ControlBackgroundBrush}" />
			<Canvas>
				<Thumb
					x:Name="PART_Thumb"
					Canvas.Left="0"
					Canvas.Top="0"
					Style="{StaticResource AreaSliderThumb}" />
			</Canvas>
		</Grid>
	</ControlTemplate>

	<Style x:Key="AreaSlider" TargetType="{x:Type s14:AreaSlider}">
		<Setter Property="CircularTemplate"
			Value="{StaticResource CircularAreaSliderTemplate}" />
		<Setter Property="IsCircular" Value="False" />
		<Setter Property="Margin" Value="1" />
		<Setter Property="MinHeight" Value="100" />
		<Setter Property="MinWidth" Value="100" />
		<Setter Property="SquareTemplate" Value="{StaticResource AreaSliderTemplate}" />
	</Style>

</ResourceDictionary>