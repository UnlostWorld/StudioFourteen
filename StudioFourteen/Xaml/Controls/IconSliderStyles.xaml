<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:StudioFourteen.Xaml"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:shapes="clr-namespace:StudioFourteen.Shapes">

	<ControlTemplate x:Key="StudioIconSliderTemplate" TargetType="{x:Type local:IconSlider}">

		<Grid Background="Transparent">

			<Ellipse Fill="{TemplateBinding Background}" />

			<Ellipse
				x:Name="HoverEllipse"
				Margin="3"
				Opacity="0"
				Fill="{DynamicResource ControlHighlightBrush}" />

			<Grid x:Name="Content">
				<Grid Margin="10">
					<icons:IconView
						Width="14"
						Height="14"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Foreground="{TemplateBinding Background}"
						Icon="{TemplateBinding DownIcon}" />

					<icons:IconView
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Width="20"
						Height="20"
						Foreground="{TemplateBinding Background}"
						Icon="{TemplateBinding LeftIcon}" />

					<icons:IconView
						Width="16"
						Height="16"
						VerticalAlignment="Top"
						HorizontalAlignment="Center"
						Foreground="{TemplateBinding Background}"
						Icon="{TemplateBinding TopIcon}" />

					<icons:IconView
						Width="20"
						Height="20"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"
						Foreground="{TemplateBinding Background}"
						Icon="{TemplateBinding RightIcon}" />

					<icons:IconView
						Width="14"
						Height="14"
						Opacity="{TemplateBinding DownOpacity}"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						Icon="{TemplateBinding DownIcon}" />

					<icons:IconView
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Width="20"
						Height="20"
						Opacity="{TemplateBinding LeftOpacity}"
						Foreground="{TemplateBinding Foreground}"
						Icon="{TemplateBinding LeftIcon}" />

					<icons:IconView
						Width="16"
						Height="16"
						VerticalAlignment="Top"
						Opacity="{TemplateBinding TopOpacity}"
						HorizontalAlignment="Center"
						Foreground="{TemplateBinding Foreground}"
						Icon="{TemplateBinding TopIcon}" />

					<icons:IconView
						Width="20"
						Height="20"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"
						Opacity="{TemplateBinding RightOpacity}"
						Foreground="{TemplateBinding Foreground}"
						Icon="{TemplateBinding RightIcon}" />
				</Grid>

				<shapes:PointArc
					Margin="3"
					Spread="23"
					Maximum="{TemplateBinding Maximum}"
					Minimum="{TemplateBinding Minimum}"
					Stroke="{TemplateBinding Foreground}"
					AngleOffset="180"
					StrokeThickness="6"
					Value="{TemplateBinding Value}" />
			</Grid>
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground"
					Value="{DynamicResource ControlForegroundHighlightBrush}" />
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverEllipse"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="00:00:00.1" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverEllipse"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="00:00:00.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>

			<Trigger Property="IsMouseDown" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource TrimBrush}" />
			</Trigger>

			<Trigger Property="IsEnabled" Value="false">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="Content"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0.5"
								Duration="00:00:00.1" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="Content"
								Storyboard.TargetProperty="Opacity"
								From="0.5"
								To="1"
								Duration="00:00:00.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="{x:Type local:IconSlider}" x:Key="StudioIconSlider">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Template" Value="{StaticResource StudioIconSliderTemplate}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style TargetType="{x:Type local:IconSlider}" BasedOn="{StaticResource StudioIconSlider}" />

</ResourceDictionary>