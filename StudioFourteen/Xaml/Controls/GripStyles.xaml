<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Xaml"
	xmlns:shapes="clr-namespace:StudioFourteen.Shapes">

	<ControlTemplate x:Key="StudioGripTemplate" TargetType="{x:Type local:Grip}">
		<Grid Background="Transparent">
			<icons:IconView
				x:Name="Icon"
				Margin="3"
				Foreground="{DynamicResource BackgroundLightBrush}"
				Icon="{DynamicResource ICON_GrabVertical}" />
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="Direction" Value="Omni">
				<Setter TargetName="Icon" Property="Icon" Value="{DynamicResource ICON_GripOmni}" />
			</Trigger>
			<Trigger Property="Direction" Value="Vertical">
				<Setter TargetName="Icon" Property="Icon"
					Value="{DynamicResource ICON_GripVertical}" />
			</Trigger>
			<Trigger Property="Direction" Value="Horizontal">
				<Setter TargetName="Icon" Property="Icon"
					Value="{DynamicResource ICON_GripHorizontal}" />
			</Trigger>
		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style TargetType="{x:Type local:Grip}">
		<Setter Property="Template" Value="{StaticResource StudioGripTemplate}" />
	</Style>

</ResourceDictionary>