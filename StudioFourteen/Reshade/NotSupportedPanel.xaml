<panels:Panel
	x:Class="StudioFourteen.Reshade.NotSupportedPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	Width="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Height"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<StackPanel>
		<TextBlock
			Grid.Row="1"
			Margin="12,12,12,3"
			Style="{DynamicResource Body}"
			Text="{DynamicResource LOC_Reshade_NotSupportedBody}"
			TextAlignment="Center" />

		<TextBlock
			Margin="12,3,12,12"
			Foreground="{DynamicResource ForegroundLightBrush}"
			Opacity="0.5"
			Style="{DynamicResource Subscript}"
			Text="{DynamicResource LOC_Reshade_NotSupportedInfo}"
			TextAlignment="Center" />

		<Grid
			Width="300"
			Margin="0,0,0,6"
			HorizontalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				Margin="0,0,6,0"
				fa:Awesome.Inline="{DynamicResource LOC_Reshade_NotSupportedHelp}"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				TextAlignment="Right" />


			<Grid Grid.Column="1" HorizontalAlignment="Center">
				<Border
					x:Name="WindowShadow"
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect ShadowDepth="0" Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					BorderBrush="{DynamicResource BackgroundLightBrush}"
					BorderThickness="1"
					CornerRadius="6">

					<Border Margin="2" Style="{DynamicResource WpfUtilsControlBorder}">

						<StackPanel Orientation="Horizontal">

							<icons:IconView
								Margin="12,6,6,6"
								Foreground="{DynamicResource TrimBrush}"
								Icon="{DynamicResource ICON_GlobalOverlay}" />

							<icons:IconView
								Margin="6,6,6,6"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Icon="{DynamicResource ICON_VisibilityOn}"
								Opacity="0.25" />

							<icons:IconView
								Margin="6,6,12,6"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Icon="{DynamicResource ICON_OverlayLayers}"
								Opacity="0.25" />
						</StackPanel>
					</Border>
				</Border>
			</Grid>
		</Grid>

		<Border
			Grid.Row="3"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>

				<CheckBox
					x:Name="DontNotifyCheckbox"
					HorizontalAlignment="Left"
					Content="{DynamicResource LOC_Reshade_NotSupportedDontNotify}" />

				<Button
					Width="75"
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnConfirmClicked">
					<TextBlock Text="{DynamicResource LOC_Confirm}" />
				</Button>
			</Grid>
		</Border>


	</StackPanel>
</panels:Panel>
