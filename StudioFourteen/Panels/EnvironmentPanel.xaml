<local:Panel
	x:Class="StudioFourteen.Panels.EnvironmentPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	Title="{DynamicResource LOC_Environment}"
	Width="300"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="300"
	SizeToContent="Height"
	TitleIcon="{DynamicResource ICON_Title_Environment}"
	mc:Ignorable="d">
	<Grid>
		<StackPanel>

			<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Environment_Territory}" />
			<librarySelector:LibrarySelectorButton
				IsEnabled="{Binding Services.Environment.CanChangeTerritory}"
				Type="{x:Type gameData:TerritoryTypeLibraryEntry}"
				Value="{Binding Territory}" />

			<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Environment_Weather}" />
			<librarySelector:LibrarySelectorButton
				PopOutHeader="{DynamicResource LOC_Environment_WeatherSelect}"
				SearchTags="{Binding WeatherTags}"
				Type="{x:Type gameData:WeatherLibraryEntry}"
				Value="{Binding Weather}" />

			<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Environment_Time}" />

			<ToggleButton Content="{DynamicResource LOC_Environment_FreezeTime}" IsChecked="{Binding Services.Environment.FreezeTime}" />

			<Border
				Grid.Column="0"
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition Width="64" />
					</Grid.ColumnDefinitions>

					<controls:IconControl
						Grid.Column="0"
						Width="14"
						Height="14"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.33"
						Icon="Night" />

					<controls:IconControl
						Grid.Column="1"
						Width="20"
						Height="20"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.33"
						Icon="Sunrise" />

					<controls:IconControl
						Grid.Column="2"
						Width="16"
						Height="16"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.33"
						Icon="Noon" />

					<controls:IconControl
						Grid.Column="3"
						Width="20"
						Height="20"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.33"
						Icon="Sunset" />

					<controls:IconControl
						Grid.Column="4"
						Width="14"
						Height="14"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.33"
						Icon="Night" />

					<Slider
						Grid.ColumnSpan="5"
						Background="Transparent"
						IsEnabled="{Binding Services.Environment.FreezeTime}"
						Maximum="1439"
						Minimum="0"
						Value="{Binding Services.Environment.MinuteOfDay}" />

					<TextBlock
						Grid.Column="6"
						Margin="4,3"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Text="{Binding Services.Environment.Time, FallbackValue=00:00}" />
				</Grid>
			</Border>

			<Border Margin="1" Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition />
						<ColumnDefinition Width="64" />
					</Grid.ColumnDefinitions>

					<wpfUtils:NumberBox
						Grid.ColumnSpan="4"
						Background="Transparent"
						IsEnabled="{Binding Services.Environment.FreezeTime}"
						Maximum="30"
						Minimum="1"
						Value="{Binding Services.Environment.DayOfMonth}" />

					<icons:IconView
						Grid.Column="0"
						Width="14"
						Height="14"
						Foreground="{DynamicResource ForegroundLightBrush}"
						IsHitTestVisible="False"
						Opacity="0.33"
						Icon="{DynamicResource ICON_MoonWaxing}" />

					<icons:IconView
						Grid.Column="1"
						Width="14"
						Height="14"
						Foreground="{DynamicResource ForegroundLightBrush}"
						IsHitTestVisible="False"
						Opacity="0.33"
						Icon="{DynamicResource ICON_MoonFull}" />

					<icons:IconView
						Grid.Column="2"
						Width="14"
						Height="14"
						Foreground="{DynamicResource ForegroundLightBrush}"
						IsHitTestVisible="False"
						Opacity="0.33"
						Icon="{DynamicResource ICON_MoonWaning}" />



				</Grid>
			</Border>

		</StackPanel>
	</Grid>
</local:Panel>
