<local:Panel
	x:Class="StudioFourteen.Panels.EnvironmentPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Environment}"
	Width="300"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="100"
	d:DesignWidth="300"
	SizeToContent="Height"
	TitleIcon="CloudMoonRain"
	mc:Ignorable="d">
	<Grid>
		<StackPanel>

			<Button
				Height="64"
				HorizontalContentAlignment="Stretch"
				Click="OnChangeTerritoryClicked"
				IsEnabled="{Binding Services.Environment.CanChangeTerritory}">

				<Grid Grid.Row="0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<ContentPresenter
						Width="48"
						Height="48"
						Margin="-3,-3,0,0"
						Content="{Binding Services.Environment.CurrentTerritory}"
						Style="{StaticResource LibraryIcon}" />

				</Grid>
			</Button>

			<Button
				Height="64"
				HorizontalContentAlignment="Stretch"
				Click="OnChangeWeatherClicked"
				IsEnabled="{Binding CanChangeWeather}">

				<Grid Grid.Row="0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<ContentPresenter
						Width="48"
						Height="48"
						Margin="-3,-3,0,0"
						Content="{Binding Services.Environment.CurrentWeather}"
						Style="{StaticResource LibraryIcon}" />

				</Grid>

			</Button>

		</StackPanel>
	</Grid>
</local:Panel>
