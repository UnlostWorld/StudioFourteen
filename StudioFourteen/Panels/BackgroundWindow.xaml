<panels:PanelWindow
	x:Class="StudioFourteen.Studio.BackgroundWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:background="clr-namespace:StudioFourteen.Studio.Background"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:effects="clr-namespace:StudioFourteen.Effects"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:overlays="clr-namespace:StudioFourteen.Overlays"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:studio="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="1080"
	d:DesignWidth="1920"
	AllowsTransparency="True"
	Background="Transparent"
	ResizeMode="NoResize"
	SnapsToDevicePixels="True"
	UseLayoutRounding="True"
	WindowStyle="None"
	mc:Ignorable="d">

	<panels:PanelWindow.Template>
		<ControlTemplate TargetType="{x:Type panels:PanelWindow}">
			<AdornerDecorator>
				<ContentPresenter
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</AdornerDecorator>

			<ControlTemplate.Triggers>
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsUiVisible}" Value="True" />
					</MultiDataTrigger.Conditions>

					<MultiDataTrigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.100">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</MultiDataTrigger.EnterActions>

					<MultiDataTrigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.200">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</MultiDataTrigger.ExitActions>
				</MultiDataTrigger>

			</ControlTemplate.Triggers>
		</ControlTemplate>
	</panels:PanelWindow.Template>

	<Grid x:Name="ContentArea">
		<Grid
			Background="Transparent"
			Focusable="False"
			Visibility="{Binding Services.Studio.IsOpen, Converter={StaticResource B2V}}">
			<Grid.Effect>
				<effects:WindowMaskEffect />
			</Grid.Effect>

			<Rectangle
				Fill="#01000000"
				MouseDown="OnMouseDown"
				MouseEnter="OnMouseEnter"
				MouseLeave="OnMouseLeave"
				MouseMove="OnMouseMove"
				MouseUp="OnMouseUp" />

			<overlays:OverlayRenderer ClipToBounds="True" />
		</Grid>


		<background:Targets
			Grid.Column="1"
			Margin="0,10,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top" />

		<overlays:OverlayBar
			Margin="10"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}" />

		<background:Navigation
			x:Name="StudioButton"
			Width="60"
			Margin="10,10,0,0"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			DragDelta="OnDragDelta" />


	</Grid>
</panels:PanelWindow>
