<ResourceDictionary
	x:Class="ScreenshotStudio.Panels.PanelWindowResources"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:ScreenshotStudio.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:local="clr-namespace:ScreenshotStudio.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:BoolInversionConverter x:Key="!B" />
	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:MultiOrVisibilityConverter x:Key="MultiOrVisibility" />

	<Style
		x:Key="TitlebarToggleButton"
		BasedOn="{StaticResource WpfUtilsToggleButton}"
		TargetType="{x:Type ToggleButton}">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Margin" Value="0" />
	</Style>

	<Style
		x:Key="TitlebarButton"
		BasedOn="{StaticResource WpfUtilsButton}"
		TargetType="{x:Type Button}">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Margin" Value="0" />
	</Style>

	<ControlTemplate
		x:Key="ZoomComboBox"
		TargetType="{x:Type ComboBox}">
		<Grid>

			<ToggleButton
				Name="toggleButton"
				IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
				Style="{StaticResource TitlebarToggleButton}">

				<Grid Margin="2,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<wpfUtils:IconBlock
						Grid.Column="0"
						Margin="4,0,0,0"
						VerticalAlignment="Center"
						FontSize="10"
						Icon="UpRightAndDownLeftFromCenter" />

					<ContentPresenter
						Name="contentPresenter"
						Grid.Column="1"
						Margin="{TemplateBinding Padding}"
						VerticalAlignment="Center"
						Content="{TemplateBinding SelectionBoxItem}"
						ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
						ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
						ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
						IsHitTestVisible="False" />

				</Grid>

			</ToggleButton>

			<Popup
				Name="PART_Popup"
				Grid.Column="0"
				AllowsTransparency="True"
				Focusable="False"
				IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
				Placement="Bottom"
				PlacementTarget="{Binding ElementName=toggleButton}"
				PopupAnimation="Fade"
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				UseLayoutRounding="{TemplateBinding UseLayoutRounding}">

				<Grid
					MinWidth="{TemplateBinding ActualWidth}"
					MaxHeight="{TemplateBinding MaxDropDownHeight}"
					Margin="16">
					<Border
						Background="Black"
						CornerRadius="6">
						<Border.Effect>
							<DropShadowEffect
								Direction="270"
								ShadowDepth="0" />
						</Border.Effect>
					</Border>

					<Border
						Background="{DynamicResource BackgroundBrush}"
						CornerRadius="6">
						<Border
							Margin="2"
							Style="{DynamicResource WpfUtilsControlBorder}">
							<ScrollViewer
								MinHeight="1"
								MaxHeight="{TemplateBinding MaxDropDownHeight}">
								<ItemsPresenter
									Name="ItemsPresenter"
									KeyboardNavigation.DirectionalNavigation="Contained" />
							</ScrollViewer>
						</Border>
					</Border>
				</Grid>

			</Popup>
		</Grid>
	</ControlTemplate>



	<ControlTemplate
		x:Key="PanelWindowTemplate"
		TargetType="{x:Type local:PanelWindow}">

		<AdornerDecorator>

			<Grid
				x:Name="MainGrid"
				Margin="12"
				RenderTransformOrigin="0.5,0.5">

				<Grid.RenderTransform>
					<ScaleTransform x:Name="WindowScale" ScaleX="1.0" ScaleY="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ScaleX}" />
				</Grid.RenderTransform>

				<Border
					x:Name="WindowShadow"
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					CornerRadius="6" />


				<Grid ClipToBounds="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.LayoutTransform>
						<ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Scale}" ScaleY="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Scale}" />
					</Grid.LayoutTransform>

					<ContentPresenter
						Grid.Row="1"
						Margin="2,0,2,2"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}" />

					<Grid
						Grid.Row="0"
						Height="28"
						Margin="0,0,0,1">


						<Grid
							Background="Transparent"
							MouseDown="OnTitleMouseDown" />

						<StackPanel
							Margin="8,1"
							VerticalAlignment="Center"
							IsHitTestVisible="False"
							Orientation="Horizontal">

							<wpfUtils:IconBlock
								MinWidth="12"
								Margin="0,1,6,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Icon="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Panel.TitleIcon}"
								IconFont="Solid" />

							<TextBlock
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Title}" />

							<Ellipse
								x:Name="SubtitleSeperator"
								Width="4"
								Height="4"
								Margin="6,1,6,0"
								VerticalAlignment="Center"
								Fill="{DynamicResource ForegroundLightBrush}"
								Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Panel.Subtitle, Converter={StaticResource NotEmptyToVisibilityConverter}}" />

							<TextBlock
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Panel.Subtitle}" />
						</StackPanel>

						<Border
							Margin="0,3,3,0"
							HorizontalAlignment="Right"
							Background="{DynamicResource ControlBackgroundBrush}"
							Style="{DynamicResource WpfUtilsControlBorder}">

							<Border.Visibility>
								<MultiBinding Converter="{StaticResource MultiOrVisibility}">
									<Binding
										ElementName="EmbedButton"
										Path="Visibility" />
									<Binding
										ElementName="CloseButton"
										Path="Visibility" />
								</MultiBinding>
							</Border.Visibility>

							<StackPanel
								Grid.Row="0"
								HorizontalAlignment="Right"
								Orientation="Horizontal">

								<!--  Zoom Button  -->
								<ComboBox
									Height="Auto"
									Margin="0"
									VerticalAlignment="Stretch"
									ItemsSource="{Binding ZoomOptions}"
									SelectedValue="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=Scale}"
									Template="{StaticResource ZoomComboBox}">

									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Margin="2,0,0,1"
												FontSize="12"
												Text="{Binding ., StringFormat={}{0:P0}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<!--  Pop out button  -->
								<ToggleButton
									x:Name="EmbedButton"
									Width="32"
									IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=IsEmbedded, Converter={StaticResource !B}}"
									Style="{StaticResource TitlebarToggleButton}"
									ToolTip="{DynamicResource LOC_EmbedPanelTooltip}"
									Visibility="{TemplateBinding CanChangeEmbed,
																 Converter={StaticResource B2V}}">
									<Grid>
										<wpfUtils:IconBlock
											FontSize="10"
											Icon="ArrowRightFromBracket"
											Visibility="{TemplateBinding IsEmbedded,
																		 Converter={StaticResource B2V}}" />

										<wpfUtils:IconBlock
											FontSize="10"
											Icon="ArrowRightToBracket"
											Visibility="{TemplateBinding IsEmbedded,
																		 Converter={StaticResource !B2V}}" />
									</Grid>
								</ToggleButton>

								<!--  Maximize button  -->
								<ToggleButton
									x:Name="MaximizeButton"
									Width="32"
									IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=IsMaximized}"
									Style="{StaticResource TitlebarToggleButton}"
									ToolTip="{DynamicResource LOC_EmbedPanelTooltip}"
									Visibility="Collapsed">
									<Grid>
										<wpfUtils:IconBlock
											FontSize="10"
											Icon="WindowRestore"
											Visibility="{TemplateBinding IsMaximized,
																		 Converter={StaticResource B2V}}" />

										<wpfUtils:IconBlock
											FontSize="10"
											Icon="WindowMaximize"
											Visibility="{TemplateBinding IsMaximized,
																		 Converter={StaticResource !B2V}}" />
									</Grid>
								</ToggleButton>

								<!--  Close Button  -->
								<Button
									x:Name="CloseButton"
									Width="48"
									Click="OnCloseClicked"
									Style="{StaticResource TitlebarButton}"
									ToolTip="{DynamicResource LOC_ClosePanelTooltip}"
									Visibility="{TemplateBinding CanClose,
																 Converter={StaticResource B2V}}">

									<Button.Resources>
										<SolidColorBrush
											x:Key="ControlHighlightBrush"
											Color="#883434" />
									</Button.Resources>

									<wpfUtils:IconBlock Icon="Times" />
								</Button>

							</StackPanel>
						</Border>

					</Grid>

					<Thumb
						x:Name="ResizeGrip"
						Grid.Row="1"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						DragDelta="OnResizeThumbDragDelta"
						Style="{DynamicResource WpfUtilsResizeThumbCorner}"
						Visibility="Collapsed" />

				</Grid>

				<Border
					x:Name="WindowBorder"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />
			</Grid>
		</AdornerDecorator>

		<ControlTemplate.Triggers>
			<Trigger Property="ResizeMode" Value="CanResizeWithGrip">
				<Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible" />
				<Setter TargetName="MaximizeButton" Property="Visibility" Value="Visible" />
			</Trigger>

			<Trigger Property="IsActive" Value="True">
				<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
			</Trigger>

			<Trigger Property="IsEmbedded" Value="False">
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX">
								<EasingDoubleKeyFrame KeyTime="0:00:00.200" Value="0.98">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame KeyTime="0:00:00.300" Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX">
								<EasingDoubleKeyFrame KeyTime="0:00:00.200" Value="1.02">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame KeyTime="0:00:00.300" Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
			</Trigger>

			<EventTrigger RoutedEvent="UserControl.Loaded">
				<BeginStoryboard x:Name="LoadIn">
					<Storyboard>
						<DoubleAnimation
							Storyboard.TargetProperty="Opacity"
							From="0"
							To="1"
							Duration="0:00:00.250">
							<DoubleAnimation.EasingFunction>
								<SineEase EasingMode="EaseIn" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding Panel.IsShown, FallbackValue=True}" Value="True" />
					<Condition Binding="{Binding IsUiVisible}" Value="True" />
					<Condition Binding="{Binding Services.Studio.IsOpen}" Value="True" />
				</MultiDataTrigger.Conditions>

				<MultiDataTrigger.EnterActions>
					<StopStoryboard BeginStoryboardName="LoadIn" />
					<StopStoryboard BeginStoryboardName="VisibleOut" />
					<BeginStoryboard x:Name="VisibileIn">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.100">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</MultiDataTrigger.EnterActions>

				<MultiDataTrigger.ExitActions>
					<StopStoryboard BeginStoryboardName="LoadIn" />
					<StopStoryboard BeginStoryboardName="VisibileIn" />
					<BeginStoryboard x:Name="VisibleOut">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.200">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</MultiDataTrigger.ExitActions>
			</MultiDataTrigger>

			<Trigger Property="IsMaximized" Value="True">
				<Setter TargetName="WindowShadow" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
				<Setter TargetName="MainGrid" Property="Margin" Value="2" />
			</Trigger>

		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="PanelWindowStyle"
		TargetType="{x:Type local:PanelWindow}">
		<Setter Property="MinWidth" Value="128" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="AllowsTransparency" Value="True" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ResizeMode" Value="CanResizeWithGrip" />
		<Setter Property="WindowStyle" Value="None" />
		<Setter Property="Template" Value="{StaticResource PanelWindowTemplate}" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Icon" Value="../Assets/icon.ico" />
	</Style>

</ResourceDictionary>