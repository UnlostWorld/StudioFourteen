<ResourceDictionary
	x:Class="StudioFourteen.Panels.PanelWindowResources"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:BoolInversionConverter x:Key="!B" />
	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:MultiOrVisibilityConverter x:Key="MultiOrVisibility" />
	<converters:MultiBoolOrConverter x:Key="MultiBoolOr" />

	<Style
		x:Key="TitleBarToggleButton"
		BasedOn="{StaticResource WpfUtilsIconToggleButton}"
		TargetType="{x:Type ToggleButton}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<Style
		x:Key="TitleBarButton"
		BasedOn="{StaticResource WpfUtilsButton}"
		TargetType="{x:Type Button}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>

	<ControlTemplate
		x:Key="PanelWindowTemplate"
		TargetType="{x:Type local:PanelWindow}">

		<AdornerDecorator x:Name="MainGrid">

			<Grid
				x:Name="InnerMainGrid"
				Margin="12"
				RenderTransformOrigin="0.5,0.5">

				<Grid.RenderTransform>
					<ScaleTransform x:Name="WindowScale" ScaleX="0.01" ScaleY="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ScaleX}" />
				</Grid.RenderTransform>

				<Grid
					Margin="-12"
					Background="Transparent" />

				<Border
					x:Name="WindowShadow"
					Background="Black"
					CornerRadius="6"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />


				<Grid ClipToBounds="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.LayoutTransform>
						<ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Scale}" ScaleY="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Scale}" />
					</Grid.LayoutTransform>

					<Grid
						Grid.Row="0"
						Height="28"
						Margin="0,0,0,1">

						<Grid
							Background="Transparent"
							MouseDown="OnTitleMouseDown">
							<Grid.ContextMenu>
								<ContextMenu DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PanelWindow}}}">
									<MenuItem
										Command="{TemplateBinding PopOutCommand}"
										Header="Pop out"
										Icon="{DynamicResource ICON_Window_PopOut}"
										IsEnabled="{TemplateBinding IsEmbedded}" />
									<MenuItem
										Command="{TemplateBinding PopInCommand}"
										Header="Pop in"
										Icon="{DynamicResource ICON_Window_PopOut}"
										IsEnabled="{Binding IsEmbedded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource !B}}" />
									<MenuItem
										Header="Zoom"
										Icon="{DynamicResource ICON_Window_Zoom}">
										<MenuItem
											Command="{TemplateBinding SetZoom75Command}"
											Header="75%" />
										<MenuItem
											Command="{TemplateBinding SetZoom100Command}"
											Header="100%"
											IsChecked="true" />
										<MenuItem
											Command="{TemplateBinding SetZoom125Command}"
											Header="125%" />
										<MenuItem
											Command="{TemplateBinding SetZoom150Command}"
											Header="150%" />
										<MenuItem
											Command="{TemplateBinding SetZoom200Command}"
											Header="200%" />
									</MenuItem>
								</ContextMenu>
							</Grid.ContextMenu>
						</Grid>

						<Grid Margin="{TemplateBinding TitleMargin}">
							<StackPanel
								Margin="8,1"
								VerticalAlignment="Center"
								IsHitTestVisible="False"
								Orientation="Horizontal">

								<icons:IconView
									Height="16"
									MinWidth="12"
									Margin="0,1,4,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Icon="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleIcon}"
									Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasIcon, Converter={StaticResource B2V}}" />

								<TextBlock
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Title}" />

								<Ellipse
									x:Name="SubtitleSeperator"
									Width="4"
									Height="4"
									Margin="6,1,6,0"
									VerticalAlignment="Center"
									Fill="{DynamicResource ForegroundLightBrush}"
									Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasSubtitle, Converter={StaticResource B2V}}" />

								<TextBlock
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Panel.Subtitle}" />
							</StackPanel>
						</Grid>

						<StackPanel
							Grid.Row="0"
							HorizontalAlignment="Right"
							Orientation="Horizontal">

							<!--  Minimize button  -->
							<Button
								Width="32"
								Padding="8"
								Command="{TemplateBinding MinimizeCommand}"
								Content="{DynamicResource ICON_Window_Minimze}"
								Style="{StaticResource TitleBarButton}" />

							<!--  Maximize button  -->
							<ToggleButton
								x:Name="MaximizeButton"
								Width="32"
								Padding="7"
								IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=IsMaximized}"
								Style="{StaticResource TitleBarToggleButton}"
								ToolTip="{DynamicResource LOC_EmbedPanelTooltip}"
								Visibility="Collapsed">
								<Grid>
									<icons:IconView
										Icon="{DynamicResource ICON_Window_Restore}"
										Visibility="{TemplateBinding IsMaximized,
										                             Converter={StaticResource B2V}}" />

									<icons:IconView
										Icon="{DynamicResource ICON_Window_Maximize}"
										Visibility="{TemplateBinding IsMaximized,
										                             Converter={StaticResource !B2V}}" />
								</Grid>
							</ToggleButton>

							<!--  Close Button  -->
							<Button
								x:Name="CloseButton"
								Width="48"
								Padding="6"
								Command="{TemplateBinding CloseCommand}"
								Content="{DynamicResource ICON_Window_Close}"
								Style="{StaticResource TitleBarButton}"
								ToolTip="{DynamicResource LOC_ClosePanelTooltip}"
								Visibility="{TemplateBinding CanClose,
								                             Converter={StaticResource B2V}}">

								<Button.Resources>
									<SolidColorBrush
										x:Key="ControlHighlightBrush"
										Color="#883434" />
								</Button.Resources>
							</Button>

						</StackPanel>

					</Grid>

					<ContentPresenter
						Grid.Row="1"
						Margin="2,0,2,2"
						Content="{TemplateBinding Content}"
						ContentTemplate="{TemplateBinding ContentTemplate}" />
				</Grid>

				<Border
					x:Name="WindowBorder"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

				<Grid
					x:Name="ResizeGrip"
					Grid.Row="1"
					Margin="-10"
					Visibility="Collapsed">
					<Thumb
						DragDelta="OnResizeThumbDragDelta"
						Style="{DynamicResource WpfUtilsResizeThumbCorner}" />
				</Grid>
			</Grid>
		</AdornerDecorator>

		<ControlTemplate.Triggers>
			<Trigger Property="ResizeMode" Value="CanResizeWithGrip">
				<Setter TargetName="MaximizeButton" Property="Visibility" Value="Visible" />
				<Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible" />
			</Trigger>

			<Trigger Property="IsForeground" Value="True">
				<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
			</Trigger>

			<Trigger Property="IsEmbedded" Value="False">
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX">
								<EasingDoubleKeyFrame
									KeyTime="0:00:00.200"
									Value="0.98">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:00.300"
									Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimationUsingKeyFrames
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX">
								<EasingDoubleKeyFrame
									KeyTime="0:00:00.200"
									Value="1.02">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>

								<EasingDoubleKeyFrame
									KeyTime="0:00:00.300"
									Value="1">
									<EasingDoubleKeyFrame.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</EasingDoubleKeyFrame.EasingFunction>
								</EasingDoubleKeyFrame>
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
			</Trigger>

			<DataTrigger
				Binding="{Binding IsOpen}"
				Value="True">

				<Setter Property="Opacity" Value="1" />

				<DataTrigger.EnterActions>
					<BeginStoryboard x:Name="LoadIn">
						<Storyboard FillBehavior="HoldEnd">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX"
								From="0.75"
								To="1"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<QuadraticEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>
				<DataTrigger.ExitActions>
					<BeginStoryboard x:Name="LoadOut">
						<Storyboard FillBehavior="Stop">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX"
								To="0.75"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<QuadraticEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>


			<DataTrigger
				Binding="{Binding IsUiVisibleAndOpen}"
				Value="False">
				<DataTrigger.EnterActions>
					<StopStoryboard BeginStoryboardName="FadeIn" />
					<BeginStoryboard x:Name="FadeOut">
						<Storyboard FillBehavior="HoldEnd">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.100">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>

				<DataTrigger.ExitActions>
					<StopStoryboard BeginStoryboardName="FadeOut" />
					<BeginStoryboard x:Name="FadeIn">
						<Storyboard FillBehavior="Stop">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.200">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>

			<Trigger Property="IsMaximized" Value="True">
				<Setter TargetName="InnerMainGrid" Property="Margin" Value="2" />
				<Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
				<Setter TargetName="WindowShadow" Property="Visibility" Value="Collapsed" />
			</Trigger>

		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="PanelWindowStyle"
		TargetType="{x:Type local:PanelWindow}">
		<Setter Property="AllowsTransparency" Value="True" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Icon" Value="../Assets/icon.ico" />
		<Setter Property="MinHeight" Value="128" />
		<Setter Property="MinWidth" Value="128" />
		<Setter Property="ResizeMode" Value="CanResizeWithGrip" />
		<Setter Property="Template" Value="{StaticResource PanelWindowTemplate}" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="WindowStyle" Value="None" />
	</Style>


	<ControlTemplate
		x:Key="PanelToolbarTemplate"
		TargetType="{x:Type local:PanelWindow}">

		<AdornerDecorator x:Name="MainGrid">

			<Grid
				Margin="12"
				HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
				RenderTransformOrigin="0.5,0.5">

				<Grid.RenderTransform>
					<ScaleTransform x:Name="WindowScale" ScaleX="0.01" ScaleY="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ScaleX}" />
				</Grid.RenderTransform>

				<Border
					x:Name="WindowShadow"
					Background="Black"
					CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
					Opacity="0.25">
					<Border.BitmapEffect>
						<DropShadowBitmapEffect
							ShadowDepth="0"
							Softness="0.75" />
					</Border.BitmapEffect>
				</Border>

				<Border
					Background="{DynamicResource BackgroundBrush}"
					CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

				<Border
					x:Name="WindowBorder"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

				<ContentPresenter
					Margin="3"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</Grid>
		</AdornerDecorator>

		<ControlTemplate.Triggers>
			<Trigger Property="IsForeground" Value="True">
				<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
			</Trigger>

			<DataTrigger
				Binding="{Binding IsOpen}"
				Value="True">

				<Setter Property="Opacity" Value="1" />

				<DataTrigger.EnterActions>
					<BeginStoryboard x:Name="LoadIn">
						<Storyboard FillBehavior="HoldEnd">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX"
								From="0.75"
								To="1"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<QuadraticEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>
				<DataTrigger.ExitActions>
					<BeginStoryboard x:Name="LoadOut">
						<Storyboard FillBehavior="Stop">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WindowScale"
								Storyboard.TargetProperty="ScaleX"
								To="0.75"
								Duration="0:00:00.250">
								<DoubleAnimation.EasingFunction>
									<QuadraticEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>


			<DataTrigger
				Binding="{Binding IsUiVisibleAndOpen}"
				Value="False">
				<DataTrigger.EnterActions>
					<StopStoryboard BeginStoryboardName="FadeIn" />
					<BeginStoryboard x:Name="FadeOut">
						<Storyboard FillBehavior="HoldEnd">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.100">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>

				<DataTrigger.ExitActions>
					<StopStoryboard BeginStoryboardName="FadeOut" />
					<BeginStoryboard x:Name="FadeIn">
						<Storyboard FillBehavior="Stop">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.200">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>

		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="PanelToolbarStyle"
		BasedOn="{StaticResource PanelWindowStyle}"
		TargetType="{x:Type local:PanelWindow}">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="MinWidth" Value="32" />
		<Setter Property="ShowInTaskbar" Value="False" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Template" Value="{DynamicResource PanelToolbarTemplate}" />
	</Style>

	<ControlTemplate
		x:Key="PanelWidgetTemplate"
		TargetType="{x:Type local:PanelWindow}">

		<AdornerDecorator x:Name="MainGrid">

			<ContentPresenter
				Margin="3"
				Content="{TemplateBinding Content}"
				ContentTemplate="{TemplateBinding ContentTemplate}" />
		</AdornerDecorator>

		<ControlTemplate.Triggers>
			<DataTrigger
				Binding="{Binding IsUiVisibleAndOpen}"
				Value="False">
				<DataTrigger.EnterActions>
					<StopStoryboard BeginStoryboardName="FadeIn" />
					<BeginStoryboard x:Name="FadeOut">
						<Storyboard FillBehavior="HoldEnd">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.100">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>

				<DataTrigger.ExitActions>
					<StopStoryboard BeginStoryboardName="FadeOut" />
					<BeginStoryboard x:Name="FadeIn">
						<Storyboard FillBehavior="Stop">
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.200">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>

		</ControlTemplate.Triggers>

	</ControlTemplate>


	<Style
		x:Key="PanelWidgetStyle"
		BasedOn="{StaticResource PanelWindowStyle}"
		TargetType="{x:Type local:PanelWindow}">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="MinWidth" Value="32" />
		<Setter Property="ShowInTaskbar" Value="False" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Template" Value="{DynamicResource PanelWidgetTemplate}" />
	</Style>

</ResourceDictionary>