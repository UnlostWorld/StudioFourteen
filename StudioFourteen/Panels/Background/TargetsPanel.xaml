<windows:Panel
	x:Class="StudioFourteen.Studio.Background.TargetsPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Studio.Background"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:structs="clr-namespace:StudioFourteen.Structs"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:windows="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	Title="Targets"
	Width="1024"
	Height="58"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,0"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	mc:Ignorable="d">

	<Grid x:Name="MainBorder">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Column="0"
				Margin="0,0,2,0"
				Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>

					<ComboBox
						Width="256"
						ItemsSource="{Binding ValidCharacters}"
						SelectedItem="{Binding Target}"
						Visibility="{Binding ValidCharacters.Count, Converter={StaticResource GreaterThanToVisibility}, ConverterParameter=6}">

						<wpfUtils:PopOut.Header>
							<TextBlock
								Margin="10"
								Text="{DynamicResource LOC_Target_Change}" />
						</wpfUtils:PopOut.Header>

						<ComboBox.ItemTemplate>
							<DataTemplate DataType="{x:Type local:CharacterViewModel}">
								<Grid>
									<TextBlock
										Margin="6,3"
										HorizontalAlignment="Center"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap" />

								</Grid>

								<DataTemplate.Triggers>
									<DataTrigger
										Binding="{Binding IsValid}"
										Value="False">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>


					<StackPanel
						Orientation="Horizontal"
						Visibility="{Binding ValidCharacters.Count, Converter={StaticResource LessThanToVisibility}, ConverterParameter=7}">
						<StackPanel.Resources>
							<sys:Double x:Key="ButtonWidth">100</sys:Double>
						</StackPanel.Resources>

						<ItemsControl ItemsSource="{Binding Characters}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:CharacterViewModel}">

									<Grid
										x:Name="ContentArea"
										Width="0">

										<ToggleButton
											Width="{StaticResource ButtonWidth}"
											HorizontalAlignment="Center"
											Background="Transparent"
											IsChecked="{Binding IsCurrent}"
											Style="{DynamicResource WpfUtilsIconToggleButton}">
											<Grid Margin="6,3">

												<Grid.RowDefinitions>
													<RowDefinition />
													<RowDefinition Height="Auto" />
												</Grid.RowDefinitions>

												<TextBlock
													Grid.Row="0"
													Margin="0"
													HorizontalAlignment="Center"
													Text="{Binding Name}"
													TextTrimming="CharacterEllipsis"
													TextWrapping="NoWrap" />
											</Grid>

										</ToggleButton>
									</Grid>

									<DataTemplate.Triggers>
										<DataTrigger
											Binding="{Binding IsValid}"
											Value="True">
											<DataTrigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="ContentArea"
															Storyboard.TargetProperty="Width"
															To="{StaticResource ButtonWidth}"
															Duration="0:00:00.150">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseOut" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.EnterActions>
											<DataTrigger.ExitActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation
															Storyboard.TargetName="ContentArea"
															Storyboard.TargetProperty="Width"
															To="0"
															Duration="0:00:00.250">
															<DoubleAnimation.EasingFunction>
																<SineEase EasingMode="EaseIn" />
															</DoubleAnimation.EasingFunction>
														</DoubleAnimation>
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.ExitActions>
										</DataTrigger>
									</DataTemplate.Triggers>

								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Grid>
			</Border>


			<Border
				Grid.Column="1"
				Grid.ColumnSpan="2"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<ToggleButton
				x:Name="AddCharacterButton"
				Grid.Column="1"
				Width="38"
				VerticalAlignment="Stretch"
				Background="Transparent"
				Style="{DynamicResource WpfUtilsIconToggleButton}"
				ToolTip="{DynamicResource LOC_Target_CreateCharacter}">
				<wpfUtils:IconBlock Icon="UserPlus" />
			</ToggleButton>

			<Button
				Grid.Column="2"
				Width="32"
				Background="Transparent"
				Click="OnRemoveCharacterClicked"
				IsEnabled="{Binding Target, Converter={StaticResource NotNullToBoolConverter}}"
				ToolTip="{Binding RemoveCharacterTooltip}">

				<wpfUtils:IconBlock
					Icon="TrashAlt"
					IconFont="Solid" />
			</Button>
		</Grid>

		<librarySelector:LibrarySelector
			Header="Select a character to spawn:"
			IsOpen="{Binding ElementName=AddCharacterButton, Path=IsChecked}"
			PlacementTarget="{Binding ElementName=AddCharacterButton}"
			StaysOpen="False"
			Favorites="{Binding SpawnFavorites}"
			CloseOnSelection="True"
			Type="{x:Type appearance:ICharacterAppearance}"
			SelectedItem="{Binding SelectedCharacterToSpawn}"/>

	</Grid>
</windows:Panel>
