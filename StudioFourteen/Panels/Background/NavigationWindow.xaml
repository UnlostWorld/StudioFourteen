<panels:PanelWindow
	x:Class="StudioFourteen.Studio.Background.NavigationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Studio.Background"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:save="clr-namespace:StudioFourteen.Save"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:vectors="http://sharpvectors.codeplex.com/svgc/"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="64"
	Height="512"
	MinWidth="32"
	MinHeight="32"
	d:DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
	MouseLeave="OnMouseLeave"
	SizeToContent="Manual"
	mc:Ignorable="d">

	<panels:PanelWindow.Template>
		<ControlTemplate TargetType="{x:Type local:NavigationWindow}">
			<AdornerDecorator x:Name="MainGrid">
				<Grid
					Margin="12"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					RenderTransformOrigin="0.5,0.5">

					<Border
						x:Name="WindowShadow"
						Background="Black"
						CornerRadius="6"
						Opacity="0.25">
						<Border.BitmapEffect>
							<DropShadowBitmapEffect
								ShadowDepth="0"
								Softness="0.75" />
						</Border.BitmapEffect>
					</Border>

					<Border
						x:Name="WindowBackground"
						Background="{DynamicResource BackgroundBrush}"
						CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

					<Border
						x:Name="WindowBorder"
						BorderBrush="{DynamicResource BackgroundBrush}"
						BorderThickness="1"
						CornerRadius="6" />

					<Grid>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid
							Grid.Row="0"
							Height="20"
							Background="Transparent"
							MouseDown="OnTitleMouseDown" />

						<ToggleButton
							x:Name="StudioToggle"
							Grid.Row="1"
							Margin="-12,-6"
							VerticalAlignment="Top"
							Click="OnStudioClicked"
							Focusable="False"
							Style="{StaticResource StudioButton}" />

						<Grid Grid.Row="2">
							<Grid.OpacityMask>
								<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
									<GradientStop Offset="0" Color="White" />
									<GradientStop x:Name="WipeA" Offset="1" Color="White" />
									<GradientStop x:Name="WipeB" Offset="1.1" Color="Transparent" />
								</LinearGradientBrush>
							</Grid.OpacityMask>

							<ContentPresenter
								x:Name="ContentArea"
								Margin="3"
								ClipToBounds="False"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}" />
						</Grid>
					</Grid>


				</Grid>
			</AdornerDecorator>

			<ControlTemplate.Triggers>
				<Trigger Property="IsActive" Value="True">
					<Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
					<Setter TargetName="WindowShadow" Property="Opacity" Value="1" />
				</Trigger>

				<DataTrigger
					Binding="{Binding ShowStudioButton}"
					Value="False">
					<Setter TargetName="StudioToggle" Property="Opacity" Value="0" />

					<DataTrigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="StudioToggle"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.EnterActions>

					<DataTrigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="StudioToggle"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.250">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseIn" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.ExitActions>

				</DataTrigger>

				<DataTrigger
					Binding="{Binding IsUiVisibleAndOpen}"
					Value="False">
					<Setter TargetName="ContentArea" Property="Opacity" Value="0" />
					<Setter TargetName="WindowBorder" Property="Opacity" Value="0" />
					<Setter TargetName="WindowBackground" Property="Opacity" Value="0" />
					<Setter TargetName="WindowShadow" Property="Opacity" Value="0" />
				</DataTrigger>

				<DataTrigger
					Binding="{Binding IsUiVisibleAndOpen}"
					Value="True">

					<DataTrigger.EnterActions>
						<StopStoryboard BeginStoryboardName="CloseStoryboard" />
						<BeginStoryboard Name="OpenStoryboard">
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="ContentArea"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.050" />

								<DoubleAnimation
									Storyboard.TargetName="WipeA"
									Storyboard.TargetProperty="Offset"
									From="0"
									To="1"
									Duration="0:00:00.350">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>

								<DoubleAnimation
									Storyboard.TargetName="WipeB"
									Storyboard.TargetProperty="Offset"
									From="0.1"
									To="1.1"
									Duration="0:00:00.350">
									<DoubleAnimation.EasingFunction>
										<SineEase EasingMode="EaseOut" />
									</DoubleAnimation.EasingFunction>
								</DoubleAnimation>

								<DoubleAnimation
									Storyboard.TargetName="WindowBorder"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.250" />

								<DoubleAnimation
									Storyboard.TargetName="WindowBackground"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.250" />

								<DoubleAnimation
									BeginTime="0:00:00.200"
									Storyboard.TargetName="WindowShadow"
									Storyboard.TargetProperty="Opacity"
									To="1"
									Duration="0:00:00.100" />


							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.EnterActions>

					<DataTrigger.ExitActions>
						<StopStoryboard BeginStoryboardName="OpenStoryboard" />
						<BeginStoryboard Name="CloseStoryboard">
							<Storyboard>
								<DoubleAnimation
									Storyboard.TargetName="ContentArea"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250" />

								<DoubleAnimation
									Storyboard.TargetName="WindowBorder"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250" />

								<DoubleAnimation
									Storyboard.TargetName="WindowBackground"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250" />

								<DoubleAnimation
									Storyboard.TargetName="WindowShadow"
									Storyboard.TargetProperty="Opacity"
									To="0"
									Duration="0:00:00.250" />
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.ExitActions>

				</DataTrigger>

			</ControlTemplate.Triggers>
		</ControlTemplate>
	</panels:PanelWindow.Template>

	<Grid
		HorizontalAlignment="Center"
		VerticalAlignment="Top">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel x:Name="Stack">
				<StackPanel.Resources>
					<Style
						BasedOn="{StaticResource WpfUtilsIconToggleButton}"
						TargetType="{x:Type ToggleButton}">
						<Setter Property="Width" Value="32" />
						<Setter Property="Height" Value="32" />
						<Setter Property="Margin" Value="0" />
					</Style>

					<Style TargetType="{x:Type Line}">
						<Setter Property="Width" Value="24" />
						<Setter Property="Margin" Value="0,3" />
						<Setter Property="Stroke" Value="{DynamicResource BackgroundLightBrush}" />
						<Setter Property="X1" Value="0" />
						<Setter Property="X2" Value="1" />
						<Setter Property="StrokeThickness" Value="1" />
						<Setter Property="Stretch" Value="Fill" />
					</Style>
				</StackPanel.Resources>

				<ToggleButton
					Width="32"
					Height="32"
					IsChecked="{Binding IsInGPose}"
					ToolTip="{DynamicResource LOC_ToggleGPose}">
					<vectors:SvgIcon
						Margin="8"
						Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-grouppose.svg" />
				</ToggleButton>

				<Line />

				<ToggleButton
					IsChecked="{Binding IsLibraryOpen}"
					ToolTip="{DynamicResource LOC_Library}">
					<wpfUtils:IconBlock Icon="Book" />
				</ToggleButton>

				<Line />

				<ToggleButton
					IsChecked="{Binding IsCameraOpen}"
					ToolTip="{DynamicResource LOC_Camera}">
					<vectors:SvgIcon
						Margin="8"
						Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-camera.svg" />
				</ToggleButton>

				<ToggleButton
					IsChecked="{Binding IsEnvironmentOpen}"
					ToolTip="{DynamicResource LOC_Environment}">
					<wpfUtils:IconBlock Icon="CloudMoonRain" />
				</ToggleButton>

				<ToggleButton
					IsChecked="{Binding IsCharacterOpen}"
					ToolTip="{DynamicResource LOC_Character}">
					<wpfUtils:IconBlock Icon="UserShield" />
				</ToggleButton>

				<ToggleButton
					IsChecked="{Binding IsPoseOpen}"
					ToolTip="{DynamicResource LOC_Pose}">
					<wpfUtils:IconBlock Icon="Running" />
				</ToggleButton>

				<Line />

				<ToggleButton
					IsChecked="{Binding IsPhotoOpen}"
					ToolTip="{DynamicResource LOC_Photo}">
					<wpfUtils:IconBlock Icon="Image" />
				</ToggleButton>

				<ToggleButton
					IsChecked="{Binding IsSaveOpen}"
					ToolTip="{DynamicResource LOC_Save}">
					<save:SaveIconControl />

				</ToggleButton>

				<Line />

				<ToggleButton
					IsChecked="{Binding IsSpaOpen}"
					ToolTip="{DynamicResource LOC_Spa}">
					<wpfUtils:IconBlock Icon="ObjectGroup" />
				</ToggleButton>

				<Line />

				<ToggleButton
					IsChecked="{Binding IsSettingsOpen}"
					ToolTip="{DynamicResource LOC_Settings}">
					<wpfUtils:IconBlock Icon="cogs" />
				</ToggleButton>

			</StackPanel>
		</Border>
	</Grid>
</panels:PanelWindow>
