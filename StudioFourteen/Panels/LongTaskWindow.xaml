<panels:Panel
	x:Class="StudioFourteen.Studio.LongTaskWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="Please Wait"
	Width="400"
	Height="100"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,0.5"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Manual"
	TitleIcon="fa-ExclamationCircle"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<StackPanel>
		<ProgressBar
			Margin="6"
			IsIndeterminate="{Binding Progress, Converter={StaticResource NotNullToBoolConverter}}"
			Maximum="100"
			Minimum="0"
			Value="{Binding Progress}" />

		<TextBlock
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundLightBrush}"
			Text="{Binding Status}" />

	</StackPanel>
</panels:Panel>
