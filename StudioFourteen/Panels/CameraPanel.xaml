<local:Panel
	x:Class="StudioFourteen.Panels.CameraPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:controls1="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{DynamicResource LOC_Camera}"
	Width="250"
	Height="450"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	TitleIcon="VideoCamera"
	mc:Ignorable="d">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="32" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<ListBox
			Grid.Column="0"
			ItemsSource="{Binding Services.Camera.Current}"
			SelectedValue="{Binding Services.Camera.Current}"
			Style="{DynamicResource WpfUtilsSwitchSelectorVertical}">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock
						Margin="6"
						Text="{Binding Index}" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

		<StackPanel
			Grid.Column="1"
			DataContext="{Binding Services.Camera.Current}">
			<TextBox Text="{Binding Name}" />
			<ListBox
				SelectedIndex="0"
				Style="{DynamicResource WpfUtilsSwitchSelector}">
				<ListBoxItem>
					<TextBlock
						Foreground="{DynamicResource ForegroundLightBrush}"
						Text="Orbit" />
				</ListBoxItem>
				<ListBoxItem>
					<TextBlock
						Foreground="{DynamicResource ForegroundLightBrush}"
						Text="Free" />
				</ListBoxItem>
			</ListBox>

			<controls1:Vector3Box
				TickFrequency="0.01"
				Value="{Binding Position}" />

			<TextBlock Text="{Binding Position}" />
			<TextBlock Text="{Binding Rotation}" />

			<controls:NumberBox
				Maximum="300"
				Minimum="1"
				Slider="Absolute"
				TickFrequency="0.5"
				Value="{Binding GroupPoseFov}" />

		</StackPanel>

	</Grid>
</local:Panel>
