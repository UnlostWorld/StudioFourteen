<panels:Panel
	x:Class="StudioFourteen.Studio.ErrorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Error}"
	Width="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Height"
	TitleIcon="fa-ExclamationCircle"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<StackPanel>
		<TextBlock
			Grid.Row="1"
			Margin="6"
			Foreground="Red"
			Style="{DynamicResource Body}"
			Text="{DynamicResource LOC_ErrorBodyMessage}"
			TextAlignment="Center" />

		<TextBlock
			Grid.Row="1"
			Margin="12"
			Style="{DynamicResource Body}"
			Text="{Binding ErrorMessage, FallbackValue=ErrorMessage}"
			TextAlignment="Center" />

		<StackPanel
			Grid.Row="2"
			Margin="0,3,0,3">
			<TextBlock
				Margin="3,3,3,0"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				Text="{DynamicResource LOC_ErrorBodyLog}"
				TextAlignment="Center" />

			<TextBlock
				Margin="3,3,3,6"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				Text="{DynamicResource LOC_ErrorBodyCheck}"
				TextAlignment="Center" />
		</StackPanel>

		<Border
			Grid.Row="3"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<StackPanel
					HorizontalAlignment="Left"
					Orientation="Horizontal">

					<Button
						Background="Transparent"
						Click="OnConsoleClicked">
						<TextBlock
							Margin="3,0"
							Text="{DynamicResource LOC_Console}" />
					</Button>

					<Button
						Background="Transparent"
						Click="OnGitHubClicked">
						<StackPanel
							Margin="3,0"
							Orientation="Horizontal">
							<wpfUtils:IconBlock
								Margin="0,0,6,0"
								FontSize="10"
								Icon="Github" />
							<TextBlock Text="{DynamicResource LOC_GitHub}" />
						</StackPanel>
					</Button>

					<Button
						Background="Transparent"
						Click="OnDiscordClicked">
						<StackPanel
							Margin="3,0"
							Orientation="Horizontal">
							<wpfUtils:IconBlock
								Margin="0,0,6,0"
								FontSize="10"
								Icon="Discord" />
							<TextBlock Text="{DynamicResource LOC_Discord}" />
						</StackPanel>
					</Button>

				</StackPanel>

				<Button
					Width="75"
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnConfirmClicked">
					<TextBlock Text="{DynamicResource LOC_Confirm}" />
				</Button>
			</Grid>
		</Border>


	</StackPanel>
</panels:Panel>
