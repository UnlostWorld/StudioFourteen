<Application
	x:Class="StudioFourteen.Services.Avalonia.StudioApplication"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	RequestedThemeVariant="Default">
	<Application.Styles>
		<SimpleTheme />


		<Style Selector="Grid.ChromeExpander">
			<Setter Property="Width" Value="0" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition
						Property="Width"
						Duration="0:0:0.500"
						Easing="CircularEaseInOut" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Grid.ChromeExpander.Expand">
			<Setter Property="Width" Value="32" />
		</Style>


	</Application.Styles>
</Application>