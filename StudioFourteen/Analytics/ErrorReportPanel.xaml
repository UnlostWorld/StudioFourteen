<panels:Panel
	x:Class="StudioFourteen.Analytics.ErrorReportPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	Width="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Height"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<StackPanel>
		<TextBlock
			Grid.Row="1"
			Margin="6"
			Foreground="Red"
			Style="{DynamicResource Body}"
			Text="{DynamicResource LOC_ErrorBodyMessage}"
			TextAlignment="Center" />

		<TextBlock
			Grid.Row="1"
			Margin="12"
			Style="{DynamicResource Body}"
			Text="{Binding ErrorMessage, FallbackValue=ErrorMessage}"
			TextAlignment="Center" />

		<StackPanel HorizontalAlignment="Center" Visibility="{Binding ReportingEnabled, Converter={StaticResource B2V}}">
			<TextBlock Style="{DynamicResource LeftLabel}" Text="Report code:" />

			<Grid>

				<TextBox
					Grid.Column="1"
					Width="150"
					Padding="3,0,6,3"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Center"
					FontSize="26"
					FontWeight="Bold"
					Foreground="{DynamicResource ForegroundLightBrush}"
					IsReadOnly="True"
					Text="{Binding ShortCode}" />

				<ProgressBar
					Width="20"
					Height="20"
					Margin="10,0,0,0"
					HorizontalAlignment="Left"
					IsIndeterminate="True"
					Style="{DynamicResource Spinner}"
					Visibility="{Binding IsSending, Converter={StaticResource B2V}}" />

				<TextBlock
					Margin="45,0,0,2"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Opacity="0.5"
					Text="Sending..."
					Visibility="{Binding IsSending, Converter={StaticResource B2V}}" />

			</Grid>
		</StackPanel>

		<StackPanel Grid.Row="2" Margin="0,3,0,3">

			<TextBlock
				Margin="3,3,3,6"
				Foreground="{DynamicResource ForegroundLightBrush}"
				Opacity="0.5"
				Style="{DynamicResource Subscript}"
				Text="{DynamicResource LOC_ErrorBodyCheck}"
				TextAlignment="Center" />
		</StackPanel>

		<Border
			Grid.Row="3"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

					<Button
						Background="Transparent"
						Click="OnConsoleClicked"
						Visibility="{Binding IsDebug, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
						<TextBlock Margin="3,0" Text="{DynamicResource LOC_Console}" />
					</Button>

					<Button Background="Transparent" Click="OnGitHubClicked">
						<StackPanel Margin="3,0" Orientation="Horizontal">
							<icons:IconView Margin="0,6,6,6" Icon="{DynamicResource ICON_GitHub}" />
							<TextBlock VerticalAlignment="Center" Text="{DynamicResource LOC_GitHub}" />
						</StackPanel>
					</Button>

					<Button Background="Transparent" Click="OnDiscordClicked">
						<StackPanel Margin="3,0" Orientation="Horizontal">
							<icons:IconView Margin="0,6,6,6" Icon="{DynamicResource ICON_Discord}" />
							<TextBlock VerticalAlignment="Center" Text="{DynamicResource LOC_Discord}" />
						</StackPanel>
					</Button>

				</StackPanel>

				<Button
					Width="75"
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnConfirmClicked">
					<TextBlock Text="{DynamicResource LOC_Confirm}" />
				</Button>
			</Grid>
		</Border>


	</StackPanel>
</panels:Panel>
