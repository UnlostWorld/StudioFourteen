<panels:Panel
	x:Class="StudioFourteen.Analytics.AnalyticsOptPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Analytics_OptTitle}"
	Width="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	SizeToContent="Height"
	TitleIcon="fa-ExclamationCircle"
	VisibilityMode="Always"
	mc:Ignorable="d">

	<StackPanel>
		<TextBlock
			Grid.Row="1"
			Margin="12,12,12,3"
			Style="{DynamicResource Body}"
			Text="{DynamicResource LOC_Analytics_OptPrompt}"
			TextAlignment="Center" />

		<TextBlock
			Margin="12,3,12,12"
			Opacity="0.5"
			Style="{DynamicResource Subscript}"
			Text="{DynamicResource LOC_Analytics_OptPrivacy}"
			TextAlignment="Center" />

		<ToggleButton
			Width="200"
			Content="{DynamicResource LOC_Analytics_Optional}"
			IsChecked="{Binding Services.Settings.Current.SendOptionalAnalytics}" />

		<TextBlock
			Margin="12,3,12,12"
			Opacity="0.5"
			Style="{DynamicResource Subscript}"
			Text="{DynamicResource LOC_Analytics_OptionalDesc}"
			TextAlignment="Center" />

		<ToggleButton
			Width="200"
			Content="{DynamicResource LOC_Analytics_Errors}"
			IsChecked="{Binding Services.Settings.Current.SendErrorReports, FallbackValue=true}" />

		<TextBlock
			Margin="12,3,12,12"
			Opacity="0.5"
			Style="{DynamicResource Subscript}"
			Text="{DynamicResource LOC_Analytics_ErrorsDesc}"
			TextAlignment="Center" />

		<Border
			Grid.Row="3"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Button
					Width="75"
					HorizontalAlignment="Right"
					Background="Transparent"
					Click="OnConfirmClicked">
					<TextBlock Text="{DynamicResource LOC_Confirm}" />
				</Button>
			</Grid>
		</Border>


	</StackPanel>
</panels:Panel>
