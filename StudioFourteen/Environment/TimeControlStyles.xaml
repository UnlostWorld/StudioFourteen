<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:StudioFourteen.Environment"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:shapes="clr-namespace:WpfUtils.Shapes;assembly=WpfUtils">

	<ControlTemplate x:Key="TimeControlTemplate" TargetType="{x:Type local:TimeControl}">

		<Grid Background="Transparent">

			<Ellipse Fill="{TemplateBinding Background}" />

			<Ellipse
				x:Name="HoverEllipse"
				Margin="3"
				Opacity="0"
				Fill="{DynamicResource ControlHighlightBrush}" />

			<Grid Margin="10">
				<icons:IconView
					Width="14"
					Height="14"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Center"
					Foreground="{TemplateBinding Background}"
					Icon="{DynamicResource ICON_Environment_Night}" />

				<icons:IconView
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Width="20"
					Height="20"
					Foreground="{TemplateBinding Background}"
					Icon="{DynamicResource ICON_Environment_Sunrise}" />

				<icons:IconView
					Width="16"
					Height="16"
					VerticalAlignment="Top"
					HorizontalAlignment="Center"
					Foreground="{TemplateBinding Background}"
					Icon="{DynamicResource ICON_Environment_Noon}" />

				<icons:IconView
					Width="20"
					Height="20"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Foreground="{TemplateBinding Background}"
					Icon="{DynamicResource ICON_Environment_Sunset}" />

				<icons:IconView
					Width="14"
					Height="14"
					Opacity="{TemplateBinding NightAlpha}"
					VerticalAlignment="Bottom"
					HorizontalAlignment="Center"
					Foreground="{TemplateBinding Foreground}"
					Icon="{DynamicResource ICON_Environment_Night}" />

				<icons:IconView
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Width="20"
					Height="20"
					Opacity="{TemplateBinding SunriseAlpha}"
					Foreground="{TemplateBinding Foreground}"
					Icon="{DynamicResource ICON_Environment_Sunrise}" />

				<icons:IconView
					Width="16"
					Height="16"
					VerticalAlignment="Top"
					Opacity="{TemplateBinding NoonAlpha}"
					HorizontalAlignment="Center"
					Foreground="{TemplateBinding Foreground}"
					Icon="{DynamicResource ICON_Environment_Noon}" />

				<icons:IconView
					Width="20"
					Height="20"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Opacity="{TemplateBinding SunsetAlpha}"
					Foreground="{TemplateBinding Foreground}"
					Icon="{DynamicResource ICON_Environment_Sunset}" />
			</Grid>

			<shapes:PointArc
				Margin="3"
				Spread="23"
				Maximum="{TemplateBinding Maximum}"
				Minimum="{TemplateBinding Minimum}"
				Stroke="{TemplateBinding Foreground}"
				AngleOffset="180"
				StrokeThickness="6"
				Value="{TemplateBinding Value}" />
		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground"
					Value="{DynamicResource ControlForegroundHighlightBrush}" />
				<Setter TargetName="HoverEllipse" Property="Opacity"
					Value="1" />
			</Trigger>

			<Trigger Property="IsMouseDown" Value="True">
				<Setter Property="Foreground"
					Value="{DynamicResource TrimBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="{x:Type local:TimeControl}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Template" Value="{StaticResource TimeControlTemplate}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
</ResourceDictionary>