<UserControl
	x:Class="StudioFourteen.Rendering.Gizmos.GizmoControlPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:gizmos="clr-namespace:StudioFourteen.Rendering.Gizmos"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Width="300"
	Height="550">

	<ScrollViewer>
		<ItemsControl
			ItemsSource="{Binding Gizmos}">

			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type gizmos:GizmoBase}">
					<Expander Margin="2" Foreground="{DynamicResource ForegroundLightBrush}">

						<Expander.Header>
							<ToggleButton Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
						</Expander.Header>

						<StackPanel Margin="4">
							<ContentPresenter Content="{Binding .}">
								<ContentPresenter.Resources>

									<!--  Grid Gizmo  -->
									<DataTemplate DataType="{x:Type gizmos:GridGizmo}">
										<StackPanel>
											<TextBlock Style="{DynamicResource LabelLeft}" Text="Opacity"/>
											<controls:NumberSlider Value="{Binding Opacity}" Minimum="0" Maximum="1" Change="0.1"/>

											<TextBlock Style="{DynamicResource LabelLeft}" Text="Grid Size"/>
											<controls:NumberSlider Value="{Binding GridSize}" Minimum="0.25" Maximum="100"/>

											<TextBlock Style="{DynamicResource LabelLeft}" Text="Line Thickness"/>
											<controls:NumberSlider Value="{Binding LineThickness}" Minimum="0.1" Maximum="1"/>

											<TextBlock Style="{DynamicResource LabelLeft}" Text="Height"/>
											<controls:NumberSlider Value="{Binding Height}" Minimum="-2000" Maximum="2000" Style="{DynamicResource NumberRelativeSlider}"/>
										</StackPanel>
									</DataTemplate>


								</ContentPresenter.Resources>
							</ContentPresenter>
						</StackPanel>
					</Expander>
				</DataTemplate>
			</ItemsControl.ItemTemplate>

		</ItemsControl>
	</ScrollViewer>
</UserControl>
