<panels:Panel
	x:Class="StudioFourteen.Selection.Widget"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:silk="clr-namespace:StudioFourteen.Xaml.Silk"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	HostStyle="{DynamicResource PanelWidgetStyle}"
	RememberWindowState="False"
	SizeToContent="WidthAndHeight"
	mc:Ignorable="d">

	<Grid Width="300" Height="350">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<silk:AnimationState Binding="{Binding Hide}">
			<silk:AnimationState.Enter>
				<silk:DoubleAnimation
					Delay="200"
					Easing="SineIn"
					Property="Opacity"
					From="1"
					To="0"
					Duration="150" />
			</silk:AnimationState.Enter>

			<silk:AnimationState.Exit>
				<silk:DoubleAnimation
					Delay="200"
					Easing="SineOut"
					Property="Opacity"
					From="0"
					To="1"
					Duration="150" />
			</silk:AnimationState.Exit>
		</silk:AnimationState>

		<Grid
			Grid.Column="0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top">

			<silk:DoubleAnimation
				Key="Opening"
				Easing="SineIn"
				Property="Opacity"
				From="0"
				To="1"
				Duration="100" />

			<silk:DoubleAnimation
				Key="Closing"
				Easing="SineIn"
				Property="Opacity"
				From="1"
				To="0"
				Duration="100" />

			<Border
				Background="Black"
				CornerRadius="{DynamicResource BorderOuterCornerRadius}"
				Opacity="0.5">
				<Border.Effect>
					<DropShadowEffect
						BlurRadius="10"
						Opacity="0.25"
						ShadowDepth="0" />
				</Border.Effect>
			</Border>

			<Border Style="{DynamicResource ControlBorder}" Background="{DynamicResource BackgroundBrush}" />

			<StackPanel>
				<ToggleButton
					Width="28"
					Height="28"
					Content="{DynamicResource ICON_Widget_Expand}"
					IsChecked="{Binding Expanded}"
					Style="{DynamicResource IconToggleButton}"
					Visibility="{Binding CanExpand, Converter={StaticResource B2V}}" />

				<ItemsControl
					Width="28"
					Margin="0"
					ItemsSource="{Binding Gizmos}">

					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<s14:SwitchSelector
								Grid.Column="0"
								ItemsSource="{Binding Gizmos}"
								SelectedValue="{Binding Current}"
								Style="{DynamicResource SwitchSelectorVertical}"
								Visibility="{Binding IsVisible, Converter={StaticResource B2V}}">
								<s14:SwitchSelector.ItemTemplate>
									<DataTemplate>
										<icons:IconView
											Width="24"
											Height="24"
											Icon="{Binding Icon}"
											ToolTip="{Binding Name}" />
									</DataTemplate>
								</s14:SwitchSelector.ItemTemplate>
							</s14:SwitchSelector>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Grid>

		<Grid
			Grid.Column="1"
			Margin="3,0,0,0"
			VerticalAlignment="Top"
			Visibility="{Binding CanExpand, Converter={StaticResource B2V}}">

			<silk:AnimationState Binding="{Binding Expanded}">
				<silk:AnimationState.Enter>
					<silk:DoubleAnimation
						Easing="SineIn"
						Property="Opacity"
						From="0"
						To="1"
						Duration="150" />
				</silk:AnimationState.Enter>

				<silk:AnimationState.Exit>
					<silk:DoubleAnimation
						Easing="SineOut"
						Property="Opacity"
						From="1"
						To="0"
						Duration="150" />
				</silk:AnimationState.Exit>

			</silk:AnimationState>

			<Border Background="Black" CornerRadius="{DynamicResource BorderOuterCornerRadius}">
				<Border.Effect>
					<DropShadowEffect
						BlurRadius="10"
						Opacity="0.25"
						ShadowDepth="0" />
				</Border.Effect>
			</Border>

			<Border Style="{DynamicResource ControlBorder}">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Border
						Margin="2"
						Background="{DynamicResource BackgroundBrush}"
						CornerRadius="{DynamicResource BorderInnerCornerRadius}">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<ContentPresenter
								Grid.Column="0"
								Content="{Binding Current}"
								ContentTemplate="{DynamicResource InspectorHeader}" />

							<ToggleButton
								Grid.Column="1"
								Width="30"
								Height="30"
								Margin="3,0,0,0"
								Background="Transparent"
								Content="{DynamicResource ICON_Window_Close}"
								IsChecked="{Binding Expanded, Converter={StaticResource !B}}"
								Style="{DynamicResource IconToggleButton}" />
						</Grid>
					</Border>

					<ContentPresenter Grid.Row="1" Margin="2" Content="{Binding Current}" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</panels:Panel>
