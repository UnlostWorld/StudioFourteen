<windows:Panel
	x:Class="StudioFourteen.Selection.SelectionPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:gizmos="clr-namespace:StudioFourteen.Rendering.Draw.Gizmos"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:windows="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="600"
	Height="58"
	HorizontalAlignment="Center"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,0"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	mc:Ignorable="d">

	<Grid x:Name="MainBorder">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<ComboBox
			Grid.Column="0"
			ItemsSource="{Binding Types}"
			SelectedValue="{Binding CurrentType}">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<icons:IconView Icon="{Binding Icon}" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<wpfUtils:SwitchSelector
			Grid.Column="1"
			HorizontalContentAlignment="Center"
			ItemsSource="{Binding CurrentType.Objects}"
			SelectedItem="{Binding CurrentType.Selection}">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Name}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</wpfUtils:SwitchSelector>

		<ToggleButton
			x:Name="AddButton"
			Grid.Column="2"
			Width="32"
			Content="{DynamicResource ICON_AddObject}"
			Style="{DynamicResource WpfUtilsIconToggleButton}" />

		<librarySelector:LibrarySelector
			HorizontalAlignment="Center"
			IsOpen="{Binding ElementName=AddButton, Path=IsChecked}"
			PlacementTarget="{Binding ElementName=AddButton}"
			StaysOpen="False"
			Favorites="True"
			Header="Create an Object"
			CloseOnSelection="True"
			SelectedItem="{Binding SelectedAdd}">

			<librarySelector:LibrarySelector.Footer>
				<Border Margin="2" Style="{DynamicResource WpfUtilsControlBorder}">
					<UniformGrid Columns="3">
						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_Character}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Character" />
							</Grid>
						</Button>

						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_Camera}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Camera" />
							</Grid>
						</Button>

						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_Light}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Light" />
							</Grid>
						</Button>

						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_StageMark}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Marker" />
							</Grid>
						</Button>

						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_Effect}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Effect" />
							</Grid>
						</Button>

						<Button Height="48">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<icons:IconView Grid.Row="0" Icon="{DynamicResource ICON_Type_Furnature}" />
								<TextBlock
									Grid.Row="1"
									HorizontalAlignment="Center"
									Text="Furniture" />
							</Grid>
						</Button>
					</UniformGrid>
				</Border>
			</librarySelector:LibrarySelector.Footer>
		</librarySelector:LibrarySelector>

	</Grid>
</windows:Panel>
