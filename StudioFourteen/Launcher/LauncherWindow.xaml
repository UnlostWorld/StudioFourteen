<panels:PanelWindow
	x:Class="StudioFourteen.Launcher.LauncherWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Launcher"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	Width="64"
	Height="512"
	MinWidth="48"
	RememberState="True"
	DefaultPosition="0, 0"
	SizeToContent="Manual"
	mc:Ignorable="d">
	<panels:PanelWindow.Template>
		<ControlTemplate TargetType="{x:Type local:LauncherWindow}">
			<AdornerDecorator
				x:Name="MainGrid"
				HorizontalAlignment="Center"
				VerticalAlignment="Top">
				<Grid>
					<local:TaskBarControl Padding="0,56,0,0" />

					<Grid
						Width="24"
						Height="12"
						Margin="0,52,0,0"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Background="Transparent"
						MouseDown="OnTitleMouseDown"
						SnapsToDevicePixels="True"
						UseLayoutRounding="True"
						Visibility="{Binding Services.Studio.IsOpen, Converter={StaticResource B2V}}">

						<UniformGrid
							Columns="4"
							Opacity="0.25"
							Rows="2">
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
							<Rectangle Margin="1" Fill="{DynamicResource ForegroundLightBrush}" />
						</UniformGrid>
					</Grid>

					<Button
						x:Name="LaunchButton"
						VerticalAlignment="Top"
						Click="OnLaunchClicked"
						Style="{DynamicResource LauncherButton}" />

					<Popup
						HorizontalOffset="50"
						IsOpen="{Binding IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
						Placement="RelativePoint"
						PlacementTarget="{Binding ElementName=LaunchButton}"
						StaysOpen="False"
						VerticalOffset="0">

						<local:LauncherMenu IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />

					</Popup>

				</Grid>
			</AdornerDecorator>
		</ControlTemplate>
	</panels:PanelWindow.Template>
</panels:PanelWindow>
