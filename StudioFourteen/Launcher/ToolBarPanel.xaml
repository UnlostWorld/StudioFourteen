<windows:Panel
	x:Class="StudioFourteen.Launcher.ToolBarPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:gizmos="clr-namespace:StudioFourteen.Rendering.Draw.Gizmos"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:windows="clr-namespace:StudioFourteen.Panels"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	Width="600"
	HorizontalAlignment="Right"
	Height="58"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="1,0"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	mc:Ignorable="d">

	<Grid x:Name="MainBorder">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<ItemsControl ItemsSource="{Binding Gizmos}">

			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<s14:SwitchSelector Grid.Column="0" ItemsSource="{Binding Gizmos}"
						SelectedValue="{Binding Current}"
						Visibility="{Binding IsVisible, Converter={StaticResource B2V}}">
						<s14:SwitchSelector.ItemTemplate>
							<DataTemplate>
								<icons:IconView Icon="{Binding Icon}" Width="24" ToolTip="{Binding Name}"/>
							</DataTemplate>
						</s14:SwitchSelector.ItemTemplate>
					</s14:SwitchSelector>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border Grid.Column="1" Style="{DynamicResource ControlBorder}">
			<StackPanel Orientation="Horizontal">
				<ToggleButton
					Width="32"
					Content="{DynamicResource ICON_MouseInput}"
					IsChecked="{Binding AllowMouseCapture}"
					Style="{DynamicResource IconToggleButton}"
					ToolTip="{DynamicResource LOC_Settings_Input_Mouse}" />

				<ToggleButton
					x:Name="GizmoToggle"
					Width="32"
					Content="{DynamicResource ICON_Gizmos}"
					IsChecked="{Binding Services.Gizmos.GizmoControlPanelOpen}"
					Style="{DynamicResource IconToggleButton}"
					ToolTip="{DynamicResource LOC_Gizmos}" />

				<s14:PopOut
					IsOpen="{Binding IsChecked, ElementName=GizmoToggle}"
					PlacementTarget="{Binding ElementName=GizmoToggle}"
					StaysOpen="False"
					Style="{DynamicResource PopOut}">

					<s14:PopOut.Header>
						<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{DynamicResource LOC_GizmosHeader}" />
					</s14:PopOut.Header>

					<gizmos:GizmoControlPanel />
				</s14:PopOut>

				<!--<Button
					Width="32"
					Content="{DynamicResource ICON_Undo}" />

				<Button
					Width="32"
					Content="{DynamicResource ICON_Redo}" />-->

			</StackPanel>
		</Border>

	</Grid>
</windows:Panel>
