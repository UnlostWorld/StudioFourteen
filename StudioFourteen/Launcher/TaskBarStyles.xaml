<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:local="clr-namespace:StudioFourteen.Launcher">

	<ControlTemplate
		x:Key="TaskBarButtonTemplate"
		TargetType="{x:Type local:TaskBarButtonControl}">
		<Grid TextBlock.Foreground="{DynamicResource ForegroundLightBrush}">

			<Border
				x:Name="BackgroundBorder"
				Background="{TemplateBinding Background}"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<Border
				x:Name="HoverBorder"
				Opacity="0"
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
				Style="{DynamicResource WpfUtilsControlHoverBorder}" />

			<Grid
				x:Name="ContentArea"
				Margin="4,0,0,0">

				<controls:IconControl
					Margin="{TemplateBinding Padding}"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Icon="{TemplateBinding Icon}" />
			</Grid>

			<Border
				x:Name="OpenIndicator"
				Width="2"
				Margin="2,6"
				HorizontalAlignment="Left"
				Background="{DynamicResource TrimBrush}"
				CornerRadius="1"
				Opacity="1" />

		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMinimized" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimationUsingKeyFrames
								Storyboard.TargetName="ContentArea"
								Storyboard.TargetProperty="Margin">

								<EasingThicknessKeyFrame
									KeyTime="0:00:00.000"
									Value="4,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame
									KeyTime="0:00:00.050"
									Value="-12,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame
									KeyTime="0:00:00.250"
									Value="0,0,0,0" />
							</ThicknessAnimationUsingKeyFrames>
							<DoubleAnimation
								Storyboard.TargetName="OpenIndicator"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="00:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimationUsingKeyFrames
								Storyboard.TargetName="ContentArea"
								Storyboard.TargetProperty="Margin">

								<EasingThicknessKeyFrame
									KeyTime="0:00:00.000"
									Value="4,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame
									KeyTime="0:00:00.100"
									Value="12,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame
									KeyTime="0:00:00.250"
									Value="4,0,0,0" />
							</ThicknessAnimationUsingKeyFrames>
							<DoubleAnimation
								Storyboard.TargetName="OpenIndicator"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="00:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>

			</Trigger>

			<Trigger Property="IsMouseOver" Value="true">

				<Setter Property="Foreground" Value="{DynamicResource ControlForegroundHighlightBrush}" />

				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverBorder"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="00:00:00.1" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverBorder"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="00:00:00.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>

			</Trigger>



		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="{x:Type local:TaskBarButtonControl}">
		<Setter Property="Template" Value="{StaticResource TaskBarButtonTemplate}" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="Margin" Value="1" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="FocusVisualStyle" Value="{DynamicResource WpfUtilsFocusVisualStyle}" />
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
	</Style>

	<ControlTemplate
		x:Key="TaskBarTemplate"
		TargetType="{x:Type local:TaskBarControl}">

		<Grid Margin="12">

			<Border
				x:Name="WindowShadow"
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect
						ShadowDepth="0"
						Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBackground"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Border
				x:Name="WindowBorder"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Grid Margin="{TemplateBinding Padding}">

				<Border
					Margin="3"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<StackPanel Orientation="Vertical">

						<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Entries}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel
										IsItemsHost="True"
										Orientation="Vertical" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:TaskBarEntry}">
									<local:TaskBarButtonControl
										Margin="1,0"
										Icon="{Binding Icon}"
										ToolTip="{Binding ToolTip}" />
								</DataTemplate>

							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type local:TaskBarControl}">
		<Setter Property="Template" Value="{StaticResource TaskBarTemplate}" />
	</Style>

</ResourceDictionary>