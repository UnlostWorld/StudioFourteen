<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:gizmos="clr-namespace:StudioFourteen.Rendering.Gizmos"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Launcher">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Icons/IconStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="B2V" />

	<ControlTemplate x:Key="TaskBarButtonTemplate" TargetType="{x:Type local:TaskBarButtonControl}">
		<Grid x:Name="OuterGrid" Height="32">
			<Grid
				x:Name="MainGrid"
				Height="32"
				TextBlock.Foreground="{DynamicResource ForegroundLightBrush}">

				<Border
					x:Name="BackgroundBorder"
					Background="{TemplateBinding Background}"
					Style="{DynamicResource WpfUtilsControlBorder}" />

				<Border
					x:Name="HoverBorder"
					Opacity="0"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
					Style="{DynamicResource WpfUtilsControlHoverBorder}" />

				<Grid x:Name="ContentArea" Margin="4,0,0,0">

					<icons:IconView
						Margin="{TemplateBinding Padding}"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{TemplateBinding Icon}" />
				</Grid>

				<Grid
					x:Name="OpenIndicator"
					Width="2"
					Margin="2,6"
					HorizontalAlignment="Left"
					Opacity="1">

					<Border Background="{DynamicResource ForegroundLightBrush}" CornerRadius="1" />

					<Border
						x:Name="ActiveIndicator"
						Background="{DynamicResource TrimBrush}"
						CornerRadius="1"
						Opacity="0" />
				</Grid>
			</Grid>
		</Grid>

		<ControlTemplate.Triggers>

			<Trigger Property="IsActive" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ActiveIndicator"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="00:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ActiveIndicator"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="00:00:00.250">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>

			<Trigger Property="IsTaskVisible" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="OuterGrid"
								Storyboard.TargetProperty="Height"
								From="0"
								To="32"
								Duration="00:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="00:00:00.150" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="OuterGrid"
								Storyboard.TargetProperty="Height"
								From="32"
								To="0"
								Duration="00:00:00.250">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseIn" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
							<DoubleAnimation
								Storyboard.TargetName="MainGrid"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="00:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>

			<Trigger Property="IsMinimized" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ContentArea" Storyboard.TargetProperty="Margin">

								<EasingThicknessKeyFrame KeyTime="0:00:00.000" Value="4,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame KeyTime="0:00:00.050" Value="-12,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame KeyTime="0:00:00.250" Value="0,0,0,0" />
							</ThicknessAnimationUsingKeyFrames>
							<DoubleAnimation
								Storyboard.TargetName="OpenIndicator"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="00:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ContentArea" Storyboard.TargetProperty="Margin">

								<EasingThicknessKeyFrame KeyTime="0:00:00.000" Value="4,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame KeyTime="0:00:00.100" Value="10,0,0,0">
									<EasingThicknessKeyFrame.EasingFunction>
										<ExponentialEase EasingMode="EaseOut" />
									</EasingThicknessKeyFrame.EasingFunction>
								</EasingThicknessKeyFrame>
								<EasingThicknessKeyFrame KeyTime="0:00:00.250" Value="4,0,0,0" />
							</ThicknessAnimationUsingKeyFrames>
							<DoubleAnimation
								Storyboard.TargetName="OpenIndicator"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="00:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>

			</Trigger>

			<Trigger Property="IsMouseOver" Value="true">

				<Setter Property="Foreground" Value="{DynamicResource ControlForegroundHighlightBrush}" />

				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverBorder"
								Storyboard.TargetProperty="Opacity"
								From="0"
								To="1"
								Duration="00:00:00.1" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="HoverBorder"
								Storyboard.TargetProperty="Opacity"
								From="1"
								To="0"
								Duration="00:00:00.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>

			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="{x:Type local:TaskBarButtonControl}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource TrimBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{DynamicResource WpfUtilsFocusVisualStyle}" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Margin" Value="1" />
		<Setter Property="Padding" Value="4,6" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template" Value="{StaticResource TaskBarButtonTemplate}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<ControlTemplate x:Key="TaskBarTemplate" TargetType="{x:Type local:TaskBarControl}">

		<Grid x:Name="MainGrid" Margin="12">

			<Border
				x:Name="WindowShadow"
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect ShadowDepth="0" Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBackground"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Border
				x:Name="WindowBorder"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Grid x:Name="ContentArea" Margin="{TemplateBinding Padding}">

				<Grid.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="White" />
						<GradientStop x:Name="WipeA" Offset="1" Color="White" />
						<GradientStop x:Name="WipeB" Offset="1.1" Color="Transparent" />
					</LinearGradientBrush>
				</Grid.OpacityMask>

				<StackPanel>
					<!--  Toggles  -->
					<Border Margin="3,3,3,1" Style="{DynamicResource WpfUtilsControlBorder}">

						<StackPanel Orientation="Vertical">

							<ToggleButton
								Width="32"
								Height="32"
								Padding="8"
								Content="{DynamicResource ICON_GroupPose}"
								IsChecked="{Binding Path=IsInGPose, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarControl}}}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_ToggleGPose}" />

							<ToggleButton
								Width="32"
								Height="32"
								Padding="8"
								Content="{DynamicResource ICON_GroupPoseSettings}"
								IsChecked="{Binding Path=IsGPoseSettingsOpen, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarControl}}, Mode=TwoWay}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_GPoseSettings}"
								Visibility="{Binding Path=IsInGPose, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarControl}}, Converter={StaticResource B2V}}" />

							<ToggleButton
								Width="32"
								Height="32"
								Padding="8"
								Content="{DynamicResource ICON_MouseInput}"
								IsChecked="{Binding AllowMouseCapture, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarControl}}, Mode=TwoWay}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_Settings_Input_Mouse}"
								Visibility="{Binding Path=IsInGPose, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarControl}}, Converter={StaticResource B2V}}" />

							<ToggleButton
								Width="32"
								Height="32"
								Padding="8"
								x:Name="GizmoToggle"
								Content="{DynamicResource ICON_Gizmos}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_Gizmos}"/>

							<wpfUtils:PopOut
								Style="{DynamicResource WpfUtilsPopOut}"
								IsOpen="{Binding IsChecked, ElementName=GizmoToggle}"
								PlacementTarget="{Binding ElementName=GizmoToggle}"
								StaysOpen="False">
								<gizmos:GizmoControlPanel />
							</wpfUtils:PopOut>

						</StackPanel>
					</Border>

					<!--  Panels  -->
					<Border Margin="3,1,3,3" Style="{DynamicResource WpfUtilsControlBorder}">
						<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Entries}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel IsItemsHost="True" Orientation="Vertical" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:TaskBarEntry}">
									<local:TaskBarButtonControl
										Margin="1,0"
										Context="{Binding Context}"
										Icon="{Binding Icon}"
										IsActive="{Binding IsActive}"
										IsMinimized="{Binding IsMinimized}"
										IsTaskVisible="{Binding IsVisible}"
										PanelType="{Binding Type}"
										ToolTip="{Binding Title}" />
								</DataTemplate>

							</ItemsControl.ItemTemplate>
						</ItemsControl>

					</Border>
				</StackPanel>
			</Grid>
		</Grid>

		<ControlTemplate.Triggers>

			<Trigger Property="HideBackground" Value="True">
				<Setter TargetName="MainGrid" Property="Margin" Value="0" />
				<Setter TargetName="WindowBackground" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="WindowBorder" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="WindowShadow" Property="Visibility" Value="Collapsed" />
			</Trigger>

			<Trigger Property="IsOpen" Value="False">

				<Trigger.ExitActions>
					<StopStoryboard BeginStoryboardName="CloseStoryboard" />
					<BeginStoryboard Name="OpenStoryboard">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ContentArea"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.050" />

							<DoubleAnimation
								Storyboard.TargetName="WipeA"
								Storyboard.TargetProperty="Offset"
								From="0"
								To="1"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WipeB"
								Storyboard.TargetProperty="Offset"
								From="0.1"
								To="1.1"
								Duration="0:00:00.350">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="WindowBorder"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.250" />

							<DoubleAnimation
								Storyboard.TargetName="WindowBackground"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.250" />

							<DoubleAnimation
								BeginTime="0:00:00.200"
								Storyboard.TargetName="WindowShadow"
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:00:00.100" />


						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>

				<Trigger.EnterActions>
					<StopStoryboard BeginStoryboardName="OpenStoryboard" />
					<BeginStoryboard Name="CloseStoryboard">
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="ContentArea"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.250" />

							<DoubleAnimation
								Storyboard.TargetName="WindowBorder"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.250" />

							<DoubleAnimation
								Storyboard.TargetName="WindowBackground"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.250" />

							<DoubleAnimation
								Storyboard.TargetName="WindowShadow"
								Storyboard.TargetProperty="Opacity"
								To="0"
								Duration="0:00:00.250" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>

			</Trigger>
		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style TargetType="{x:Type local:TaskBarControl}">
		<Setter Property="Template" Value="{StaticResource TaskBarTemplate}" />
	</Style>

</ResourceDictionary>
