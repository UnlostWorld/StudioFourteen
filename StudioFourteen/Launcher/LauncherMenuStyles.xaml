<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Launcher"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<ControlTemplate x:Key="LauncherMenuTemplate" TargetType="{x:Type local:LauncherMenu}">
		<Grid Margin="12">

			<Border
				x:Name="WindowShadow"
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect ShadowDepth="0" Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBackground"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Border
				x:Name="WindowBorder"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Grid Margin="{TemplateBinding Padding}">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<wpfUtils:SwitchSelector
						Grid.Column="0"
						Height="42"
						Margin="10"
						Padding="6">

						<ListBoxItem HorizontalContentAlignment="Stretch" IsSelected="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource !B}}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<controls:XivIconImage
									Grid.RowSpan="2"
									Grid.Column="0"
									Id="061396" />

								<TextBlock
									Grid.Row="0"
									Grid.Column="1"
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									FontSize="14"
									Text="Gameplay Mode" />
							</Grid>
						</ListBoxItem>

						<ListBoxItem HorizontalContentAlignment="Stretch" IsSelected="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>


								<Image
									Grid.RowSpan="2"
									Grid.Column="0"
									Source="{DynamicResource LauncherButtonBackground}" />

								<TextBlock
									Grid.Row="0"
									Grid.Column="1"
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									FontSize="14"
									Text="Studio Mode" />
							</Grid>
						</ListBoxItem>
					</wpfUtils:SwitchSelector>

					<Border
						IsEnabled="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen}"
						Grid.Column="1"
						Margin="0,10,10,10"
						Style="{DynamicResource WpfUtilsControlBorder}">
						<StackPanel Orientation="Horizontal">
							<ToggleButton
								Width="42"
								Height="42"
								Padding="12"
								Background="Transparent"
								Content="{DynamicResource ICON_GroupPose}"
								IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsInGPose}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_ToggleGPose}" />

							<ToggleButton
								Width="42"
								Height="42"
								Padding="12"
								Background="Transparent"
								Content="{DynamicResource ICON_GroupPoseSettings}"
								IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsGPoseSettingsOpen}"
								Style="{DynamicResource WpfUtilsIconToggleButton}"
								ToolTip="{DynamicResource LOC_GPoseSettings}" />
						</StackPanel>
					</Border>

				</Grid>

				<Grid Grid.Row="1" Margin="2,2,2,0">
					<TextBox
						x:Name="PART_SearchBox"
						Grid.Row="1"
						Padding="25,0,3,0" />

					<icons:IconView
						Grid.Row="1"
						Height="14"
						Margin="10,0,0,0"
						HorizontalAlignment="Left"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{DynamicResource ICON_Search}"
						IsHitTestVisible="False" />
				</Grid>

				<Border
					Grid.Row="2"
					Margin="3"
					Style="{DynamicResource WpfUtilsControlBorder}"
					IsEnabled="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen}">

					<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Entries}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="3" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:LauncherEntry}">
								<ToggleButton
									Height="Auto"
									HorizontalContentAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									IsChecked="{Binding IsOpen}"
									IsEnabled="{Binding IsEnabled}"
									Style="{DynamicResource WpfUtilsIconToggleButtonNoChecked}">
									<Grid Margin="3,6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>

										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition />
										</Grid.RowDefinitions>

										<Border
											Grid.RowSpan="2"
											Width="2"
											Margin="2"
											HorizontalAlignment="Left"
											Background="{DynamicResource TrimBrush}"
											CornerRadius="1"
											Opacity="1"
											Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource B2V}}" />

										<ContentPresenter
											Grid.Row="0"
											Grid.Column="1"
											Width="18"
											Height="18"
											Margin="6,2,0,0"
											Content="{Binding Icon}" />
										<TextBlock
											Grid.Row="0"
											Grid.Column="2"
											Margin="10,0,0,0"
											VerticalAlignment="Center"
											Text="{Binding DisplayName}" />

										<TextBlock
											Grid.Row="1"
											Grid.Column="1"
											Grid.ColumnSpan="2"
											Margin="6,3,0,0"
											Style="{DynamicResource Subscript}"
											Text="{Binding Description}"
											TextWrapping="Wrap" />
									</Grid>
								</ToggleButton>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</Grid>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LauncherMenu}">
		<Setter Property="Template" Value="{StaticResource LauncherMenuTemplate}" />
		<Setter Property="Width" Value="600" />
	</Style>


</ResourceDictionary>
