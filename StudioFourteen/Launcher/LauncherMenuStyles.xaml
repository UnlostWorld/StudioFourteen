<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:local="clr-namespace:StudioFourteen.Launcher"
	xmlns:icons="clr-namespace:StudioFourteen.Icons">

	<BooleanToVisibilityConverter x:Key="B2V" />

	<ControlTemplate x:Key="LauncherMenuTemplate" TargetType="{x:Type local:LauncherMenu}">
		<Grid Margin="12">

			<Border
				x:Name="WindowShadow"
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect ShadowDepth="0" Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBackground"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Border
				x:Name="WindowBorder"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Grid Margin="{TemplateBinding Padding}">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>


				<Grid Grid.Row="0" Margin="2,2,2,0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid Grid.Column="1">
						<TextBox
							x:Name="PART_SearchBox"
							Grid.Row="1"
							Padding="25,0,3,0" />

						<controls:IconControl
							Grid.Row="1"
							Margin="10,0,0,0"
							HorizontalAlignment="Left"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="fa-Search"
							IsHitTestVisible="False" />
					</Grid>

					<Button
						x:Name="PART_UserButton"
						Grid.Column="2"
						Height="26"
						HorizontalAlignment="Left"
						HorizontalContentAlignment="Stretch">
						<Grid>
							<Ellipse
								Width="20"
								Height="20"
								HorizontalAlignment="Left"
								Fill="{DynamicResource ControlBackgroundBrush}"
								Stroke="{DynamicResource ForegroundLightBrush}"
								StrokeThickness="1" />

							<TextBlock
								Margin="28,0,0,0"
								VerticalAlignment="Center"
								Text="User Name" />
						</Grid>
					</Button>

					<Button
						x:Name="PART_PowerButton"
						Grid.Column="3"
						Width="32"
						Height="26"
						HorizontalAlignment="Right">
						<controls:IconControl Grid.Row="0" Icon="fa-PowerOff" />
					</Button>
				</Grid>

				<Border
					Grid.Row="1"
					Margin="3"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Entries}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="3" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type local:LauncherEntry}">
								<ToggleButton
									Height="Auto"
									HorizontalContentAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									IsChecked="{Binding IsOpen}"
									IsEnabled="{Binding IsEnabled}"
									Style="{DynamicResource WpfUtilsIconToggleButtonNoChecked}">
									<Grid Margin="3,6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>

										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition />
										</Grid.RowDefinitions>

										<Border
											Grid.RowSpan="2"
											Width="2"
											Margin="2"
											HorizontalAlignment="Left"
											Background="{DynamicResource TrimBrush}"
											CornerRadius="1"
											Opacity="1"
											Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource B2V}}" />

										<ContentPresenter
											Grid.Row="0"
											Grid.Column="1"
											Width="18"
											Height="18"
											Margin="6,2,0,0"
											Content="{Binding Icon}" />
										<TextBlock
											Grid.Row="0"
											Grid.Column="2"
											Margin="10,0,0,0"
											VerticalAlignment="Center"
											Text="{Binding DisplayName}" />

										<TextBlock
											Grid.Row="1"
											Grid.Column="1"
											Grid.ColumnSpan="2"
											Margin="6,3,0,0"
											Style="{DynamicResource Subscript}"
											Text="{Binding Description}"
											TextWrapping="Wrap" />
									</Grid>
								</ToggleButton>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</Grid>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LauncherMenu}">
		<Setter Property="Template" Value="{StaticResource LauncherMenuTemplate}" />
		<Setter Property="Width" Value="600" />
	</Style>


</ResourceDictionary>
