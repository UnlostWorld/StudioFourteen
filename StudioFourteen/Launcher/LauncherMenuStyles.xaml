<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Launcher"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:marketplace="clr-namespace:StudioFourteen.Marketplace"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:selection="clr-namespace:StudioFourteen.Selection"
	xmlns:panels="clr-namespace:StudioFourteen.Panel"
	xmlns:settings="clr-namespace:StudioFourteen.Settings"
	xmlns:history="clr-namespace:StudioFourteen.History"
	xmlns:photos="clr-namespace:StudioFourteen.Photos"
	xmlns:animation="clr-namespace:StudioFourteen.Animation"
	xmlns:posing="clr-namespace:StudioFourteen.Posing"
	xmlns:environment="clr-namespace:StudioFourteen.Environment">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<ControlTemplate TargetType="{x:Type local:LauncherEntry}" x:Key="LauncherEntryTemplate">
		<Button
			Height="Auto"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch"
			Command="{Binding OpenPanel, RelativeSource={RelativeSource Mode=TemplatedParent}}">
			<Grid Margin="3,6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Border
					Grid.RowSpan="2"
					Width="2"
					Margin="2"
					HorizontalAlignment="Left"
					Background="{DynamicResource TrimBrush}"
					CornerRadius="1"
					Opacity="1"
					Visibility="{Binding IsPanelOpen, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource B2V}}" />

				<ContentPresenter
					Grid.Row="0"
					Grid.Column="1"
					Width="18"
					Height="18"
					Margin="6,2,0,0"
					Content="{TemplateBinding Icon}" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					Text="{TemplateBinding DisplayName}" />

				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Margin="6,3,0,0"
					Style="{DynamicResource Subscript}"
					Text="{TemplateBinding Description}"
					TextWrapping="Wrap" />
			</Grid>
		</Button>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LauncherEntry}">
		<Setter Property="Template" Value="{DynamicResource LauncherEntryTemplate}" />
	</Style>

	<ControlTemplate TargetType="{x:Type local:LauncherEntry}" x:Key="IconLauncherEntryTemplate">
		<Button
			Height="Auto"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch"
			Command="{Binding OpenPanel, RelativeSource={RelativeSource Mode=TemplatedParent}}"
			Style="{DynamicResource WpfUtilsIconButton}"
			ToolTip="{TemplateBinding Description}"
			Content="{TemplateBinding Icon}" />
	</ControlTemplate>

	<Style TargetType="{x:Type local:LauncherEntry}" x:Key="IconLauncher">
		<Setter Property="Template" Value="{DynamicResource IconLauncherEntryTemplate}" />
	</Style>

	<ControlTemplate x:Key="LauncherMenuTemplate" TargetType="{x:Type local:LauncherMenu}">
		<Grid Margin="12">

			<Border
				x:Name="WindowShadow"
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.25">
				<Border.BitmapEffect>
					<DropShadowBitmapEffect ShadowDepth="0" Softness="0.75" />
				</Border.BitmapEffect>
			</Border>

			<Border
				x:Name="WindowBackground"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Border
				x:Name="WindowBorder"
				BorderBrush="{DynamicResource BackgroundBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}" />

			<Grid
				Margin="{TemplateBinding Padding}"
				Width="450">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="3,3,3,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="128" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<ToggleButton
						Height="42"
						Grid.Column="0"
						Style="{DynamicResource WpfUtilsIconToggleButton}"
						IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen}"
						HorizontalContentAlignment="Stretch"
						Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource !B2V}}">
						<ToggleButton.Content>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>

								<icons:IconView
									Margin="-3,-3,8,0"
									Icon="{DynamicResource ICON_Launcher_Start}"
									Grid.RowSpan="2"
									Grid.Column="0" />

								<TextBlock
									Margin="0"
									Grid.Row="0"
									Grid.Column="1"
									Text="{DynamicResource LOC_Launcher_Start}" />

								<TextBlock
									Margin="0"
									Grid.Row="1"
									Grid.Column="1"
									Style="{DynamicResource Subscript}"
									Text="{DynamicResource LOC_Launcher_StartSubtitle}" />

							</Grid>
						</ToggleButton.Content>
					</ToggleButton>

					<ToggleButton
						Height="42"
						Grid.Column="0"
						Style="{DynamicResource WpfUtilsIconToggleButton}"
						IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource !B}}"
						HorizontalContentAlignment="Stretch"
						Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource B2V}}">
						<ToggleButton.Content>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>

								<icons:IconView
									Margin="-3,-3,8,0"
									Icon="{DynamicResource ICON_Launcher_Start}"
									Grid.RowSpan="2"
									Grid.Column="0" />

								<TextBlock
									Margin="0"
									Grid.Row="0"
									Grid.Column="1"
									Text="{DynamicResource LOC_Launcher_Stop}" />

								<TextBlock
									Margin="0"
									Grid.Row="1"
									Grid.Column="1"
									Style="{DynamicResource Subscript}"
									Text="{DynamicResource LOC_Launcher_StopSubtitle}" />

							</Grid>
						</ToggleButton.Content>
					</ToggleButton>

					<ToggleButton
						Height="42"
						Grid.Column="1"
						Style="{DynamicResource WpfUtilsIconToggleButton}"
						HorizontalContentAlignment="Stretch"
						IsEnabled="False"
						ToolTip="Remember our promise">
						<ToggleButton.Content>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<Ellipse
									Width="28"
									Height="28"
									Margin="0,0,6,0"
									Fill="{DynamicResource ForegroundLightBrush}"
									Grid.RowSpan="2"
									Grid.Column="0" />

								<TextBlock
									Margin="0"
									Grid.Row="0"
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="Some User" />
							</Grid>
						</ToggleButton.Content>
					</ToggleButton>

					<local:LauncherEntry
						Grid.Column="2"
						Width="42"
						Height="42"
						Style="{DynamicResource IconLauncher}"
						Context="{Binding Context}"
						PanelType="{x:Type settings:SettingsPanel}" />
				</Grid>

				<Grid Grid.Row="1" Margin="2,2,2,0"
					Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource B2V}}"
					IsEnabled="False">
					<TextBox
						x:Name="PART_SearchBox"
						Grid.Row="1"
						Padding="25,0,3,0" />

					<icons:IconView
						Grid.Row="1"
						Height="14"
						Margin="10,0,0,0"
						HorizontalAlignment="Left"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{DynamicResource ICON_Search}"
						IsHitTestVisible="False" />
				</Grid>

				<Border
					Grid.Row="2"
					Margin="3"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<StackPanel>
						<UniformGrid
							Columns="2">
							<local:LauncherEntry
								Context="{Binding Context}"
								PanelType="{x:Type marketplace:MarketplacePanel}" />

							<local:LauncherEntry
								Context="{Binding Context}"
								PanelType="{x:Type library:LibraryPanel}" />

						</UniformGrid>

						<StackPanel
							Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsStudioOpen, Converter={StaticResource B2V}}">

							<UniformGrid
								Columns="2"
								Visibility="{Binding Configuration.EnableInspector, Converter={StaticResource B2V}}">
								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type selection:InspectorPanel}" />

							</UniformGrid>

							<UniformGrid
								Columns="2"
								Visibility="{Binding Configuration.EnableDedicatedInspectors, Converter={StaticResource B2V}}">

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type selection:CameraPanel}" />

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type selection:CharacterPanel}" />

							</UniformGrid>

							<UniformGrid
								Columns="2">

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type environment:EnvironmentPanel}" />

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type posing:PosePanel}" />

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type animation:AnimationPanel}" />

								<local:LauncherEntry
									Context="{Binding Context}"
									PanelType="{x:Type photos:PhotoPanel}" />

							</UniformGrid>
						</StackPanel>
					</StackPanel>
				</Border>

				<Border
					Grid.Row="3"
					Style="{DynamicResource WpfUtilsControlBorder}"
					Visibility="{Binding
						RelativeSource={RelativeSource
							Mode=TemplatedParent
						},
						Path=IsStudioOpen,
						Converter={StaticResource B2V}
					}">

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Button
							Grid.Column="0"
							Height="42"
							Padding="6"
							Command="{Binding
								RelativeSource={RelativeSource
									Mode=TemplatedParent
								},
								Path=OpenAioCommand
							}"
							Visibility="{Binding
								RelativeSource={RelativeSource
									Mode=TemplatedParent
								},
								Path=ShowAioButton,
								Converter={StaticResource B2V}
							}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<icons:IconView
									Grid.Column="0"
									Icon="{DynamicResource ICON_Title_AIO}" />

								<TextBlock
									Grid.Column="1"
									Grid.Row="0"
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									Text="{DynamicResource LOC_AIO}" />
							</Grid>
						</Button>


						<ToggleButton
							Grid.Column="2"
							Width="42"
							Height="42"
							Padding="12"
							Background="Transparent"
							Content="{DynamicResource ICON_GroupPose}"
							IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsInGPose}"
							Style="{DynamicResource WpfUtilsIconToggleButton}"
							ToolTip="{DynamicResource LOC_ToggleGPose}" />

						<ToggleButton
							Grid.Column="3"
							Width="42"
							Height="42"
							Padding="12"
							Background="Transparent"
							IsEnabled="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsInGPose}"
							Content="{DynamicResource ICON_GroupPoseSettings}"
							IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsGPoseSettingsOpen}"
							Style="{DynamicResource WpfUtilsIconToggleButton}"
							ToolTip="{DynamicResource LOC_GPoseSettings}" />

					</Grid>
				</Border>
			</Grid>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LauncherMenu}">
		<Setter Property="Template" Value="{StaticResource LauncherMenuTemplate}" />
	</Style>


</ResourceDictionary>
