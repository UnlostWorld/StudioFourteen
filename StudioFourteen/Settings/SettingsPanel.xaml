<panels:Panel
	x:Class="StudioFourteen.Settings.SettingsPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:input="clr-namespace:StudioFourteen.Input"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:settings="clr-namespace:StudioFourteen.Settings"
	Title="{DynamicResource LOC_Settings}"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Gears"
	mc:Ignorable="d">

	<TabControl>

		<TabItem Header="{DynamicResource LOC_Settings_Interface}">
			<StackPanel>
				<ToggleButton
					Grid.Row="0"
					Margin="1"
					Content="{DynamicResource LOC_Settings_Interface_IsSpa}"
					IsChecked="{Binding Settings.IsSpa}" />
			</StackPanel>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Files}">
			<StackPanel>
				<GroupBox Header="{DynamicResource LOC_Settings_Files_DefaultMetadata}">
					<StackPanel>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultAuthor}" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Text="{Binding Settings.DefaultAuthor}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultVersion}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Text="{Binding Settings.DefaultVersion}" />
					</StackPanel>
				</GroupBox>

			</StackPanel>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Input}">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<ToggleButton
					Grid.Row="0"
					Margin="1"
					Content="{DynamicResource LOC_Settings_Input_EnableKeyBinds}"
					IsChecked="{Binding Settings.EnableKeyBinds}" />

				<ScrollViewer
					Grid.Row="1"
					Margin="0,2,0,0">
					<ItemsControl ItemsSource="{Binding Keys}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,1">
									<Grid.Resources>
										<settings:KeyBindEventsToStringConverter x:Key="EventToString" />
									</Grid.Resources>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<settings:KeyBindEditor
										Grid.Column="0"
										HorizontalContentAlignment="Center"
										KeyBind="{Binding Value}"
										KeyBindChanged="OnKeyBindChanged"
										Style="{DynamicResource WpfUtilsTextBox}"
										Tag="{Binding Key}" />

									<TextBlock
										Grid.Column="1"
										Margin="6,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Foreground="{DynamicResource ForegroundLightBrush}"
										Text="{Binding Key, Converter={StaticResource EventToString}}" />

								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

			</Grid>
		</TabItem>

	</TabControl>
</panels:Panel>
