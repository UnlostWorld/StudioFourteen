<panels:Panel
	x:Class="ScreenshotStudio.Settings.SettingsPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:input="clr-namespace:ScreenshotStudio.Input"
	xmlns:local="clr-namespace:ScreenshotStudio.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:ScreenshotStudio.Panels"
	xmlns:settings="clr-namespace:ScreenshotStudio.Settings"
	Title="{DynamicResource LOC_Settings}"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Gears"
	mc:Ignorable="d">
	<TabControl>

		<TabItem Header="{DynamicResource LOC_Settings_Interface}">
			<StackPanel>
				<CheckBox
					Grid.Row="0"
					Margin="1"
					Content="{DynamicResource LOC_Settings_Interface_IsSpa}"
					IsChecked="{Binding Settings.IsSpa}" />
			</StackPanel>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Files}">
			<StackPanel>
				<GroupBox Header="{DynamicResource LOC_Settings_Files_DefaultMetadata}">
					<StackPanel>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultAuthor}" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Text="{Binding Settings.DefaultAuthor}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultVersion}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Text="{Binding Settings.DefaultVersion}" />
					</StackPanel>
				</GroupBox>

			</StackPanel>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Input}">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<CheckBox
					Grid.Row="0"
					Margin="1"
					Content="{DynamicResource LOC_Settings_Input_EnableKeyBinds}"
					IsChecked="{Binding Settings.EnableKeyBinds}" />

				<ItemsControl
					Grid.Row="1"
					ItemsSource="{Binding Settings.KeyBinds}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="1">
								<Grid.Resources>
									<settings:KeyBindEventsToStringConverter x:Key="EventToString" />
								</Grid.Resources>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="150" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<TextBlock
									Grid.Column="0"
									Margin="0,0,6,0"
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Text="{Binding Key, Converter={StaticResource EventToString}}" />

								<settings:KeyBindEditor
									Grid.Column="1"
									HorizontalContentAlignment="Center"
									KeyBind="{Binding Value}"
									Style="{DynamicResource WpfUtilsTextBox}" />

							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</Grid>
		</TabItem>

	</TabControl>
</panels:Panel>
