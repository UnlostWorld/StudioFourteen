<panels:Panel
	x:Class="StudioFourteen.Settings.SettingsPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:input="clr-namespace:StudioFourteen.Input"
	xmlns:local="clr-namespace:StudioFourteen.Studio"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:services="clr-namespace:StudioFourteen.Services"
	xmlns:settings="clr-namespace:StudioFourteen.Settings"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<TabControl>

		<TabItem Header="{DynamicResource LOC_Settings_Interface}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Border Style="{DynamicResource WpfUtilsControlBorder}">
					<controls:OrderableItemsControl ItemsSource="{Binding ResourcePacks, Mode=TwoWay}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<CheckBox Height="Auto">

									<Grid Margin="3">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>

										<Grid.RowDefinitions>
											<RowDefinition />
											<RowDefinition />
										</Grid.RowDefinitions>

										<Image
											Grid.RowSpan="2"
											Grid.Column="0"
											Width="48"
											Height="32"
											Margin="0,0,12,0"
											Source="{Binding IconPath}" />

										<TextBlock
											Grid.Row="0"
											Grid.Column="1"
											Text="{Binding Name}" />
										<TextBlock
											Grid.Row="1"
											Grid.Column="1"
											Style="{DynamicResource Subscript}"
											Text="{Binding Author}" />
									</Grid>

								</CheckBox>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</controls:OrderableItemsControl>
				</Border>

				<StackPanel Grid.Row="1" Margin="0,6,0,0">

					<ToggleButton
						Margin="1"
						Content="{DynamicResource LOC_Settings_Interface_HideLauncherButton}"
						IsChecked="{Binding Settings.HideLauncherButton}"
						ToolTip="{DynamicResource LOC_Settings_Interface_HideLauncherButton_ToolTip}" />

					<ToggleButton
						Margin="1"
						Content="{DynamicResource LOC_Settings_Interface_OpenGroupPose}"
						IsChecked="{Binding Settings.OpenGroupPose}" />

					<ToggleButton
						Margin="1"
						Content="{DynamicResource LOC_Settings_Interface_HideGenitals}"
						IsChecked="{Binding Settings.HideGenitals}" />

					<TextBlock Style="{DynamicResource LeftLabel}" Text="Library preview mode" />
					<ComboBox SelectedIndex="{Binding Settings.LibraryPreviewMode, Converter={StaticResource EnumToIndex}}">

						<wpfUtils:PopOut.Header>
							<TextBlock Margin="12" Text="{DynamicResource LOC_Settings_Interface_LibraryPreviewMode_Description}" />
						</wpfUtils:PopOut.Header>

						<ComboBoxItem Content="{DynamicResource LOC_Settings_Interface_LibraryPreviewMode_Temporary}" />
						<ComboBoxItem Content="{DynamicResource LOC_Settings_Interface_LibraryPreviewMode_Permanent}" />
						<ComboBoxItem Content="{DynamicResource LOC_Settings_Interface_LibraryPreviewMode_Disabled}" />
					</ComboBox>


					<ToggleButton
						Margin="1"
						Content="Use system cursors"
						IsChecked="{Binding Settings.UseSystemCursors}" />

				</StackPanel>
			</Grid>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Files}">
			<StackPanel>
				<GroupBox Header="{DynamicResource LOC_Settings_Files_DefaultMetadata}">
					<StackPanel>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultAuthor}" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Text="{Binding Settings.DefaultAuthor}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{DynamicResource LeftLabel}"
							Text="{DynamicResource LOC_Settings_Files_DefaultVersion}" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Text="{Binding Settings.DefaultVersion}" />
					</StackPanel>
				</GroupBox>

			</StackPanel>
		</TabItem>

		<TabItem Header="{DynamicResource LOC_Settings_Input}">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<ToggleButton
					Grid.Row="0"
					Margin="1"
					Content="{DynamicResource LOC_Settings_Input_EnableKeyBinds}"
					IsChecked="{Binding Settings.EnableBinds}" />

				<!--<ScrollViewer
					Grid.Row="1"
					Margin="0,2,0,0">
					<ItemsControl ItemsSource="{Binding Keys}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,1">
									<Grid.Resources>
										<settings:KeyBindEventsToStringConverter x:Key="EventToString" />
									</Grid.Resources>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<settings:KeyBindEditor
										Grid.Column="0"
										HorizontalContentAlignment="Center"
										KeyBind="{Binding Value}"
										KeyBindChanged="OnKeyBindChanged"
										Style="{DynamicResource WpfUtilsTextBox}"
										Tag="{Binding Key}" />

									<TextBlock
										Grid.Column="1"
										Margin="6,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Foreground="{DynamicResource ForegroundLightBrush}"
										Text="{Binding Key, Converter={StaticResource EventToString}}" />

								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>-->

			</Grid>
		</TabItem>

		<TabItem x:Name="PhotosSection" Header="{DynamicResource LOC_Settings_Photos}">
			<StackPanel>

				<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Settings_Photos_Directory}" />

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBox Grid.Column="0" Text="{Binding Settings.PhotoDirectory}" />

					<Button
						Grid.Column="1"
						Click="OnBrosePhotoDirectoryClicked"
						Content="..." />
				</Grid>


				<TextBlock Style="{DynamicResource LeftLabel}" Text="{DynamicResource LOC_Settings_Photos_Format}" />
				<ComboBox SelectedIndex="{Binding Settings.PhotoFormat, Converter={StaticResource EnumToIndex}}">
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_JPG}" />
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_BMP}" />
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_PNG}" />
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_TGA}" />
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_TIFF}" />
					<ComboBoxItem Content="{DynamicResource LOC_Settings_Photos_Format_WEBP}" />
				</ComboBox>

				<ToggleButton Content="{DynamicResource LOC_Settings_Photos_IncludeMetadata}" IsChecked="{Binding Settings.PhotoIncludeMetaData}" />

				<ToggleButton Content="{DynamicResource LOC_Settings_Photos_CaptureDepth}" IsChecked="{Binding Settings.PhotoCaptureDepth}" />

				<GroupBox Header="{DynamicResource LOC_Settings_Photos_Animations}">
					<StackPanel>
						<ToggleButton Content="{DynamicResource LOC_Settings_Photos_Flash}" IsChecked="{Binding Settings.PhotoAnimationFlash}" />

						<ToggleButton Content="{DynamicResource LOC_Settings_Photos_Review}" IsChecked="{Binding Settings.PhotoAnimationPreview}" />
					</StackPanel>
				</GroupBox>

			</StackPanel>
		</TabItem>

		<TabItem x:Name="AnalyticsSection" Header="{DynamicResource LOC_Settings_Analytics}">
			<StackPanel>
				<ToggleButton
					Content="{DynamicResource LOC_Analytics_Errors}"
					IsChecked="{Binding Settings.SendErrorReports}"
					ToolTip="{DynamicResource LOC_Analytics_ErrorsDesc}" />

				<ToggleButton
					Content="{DynamicResource LOC_Analytics_Optional}"
					IsChecked="{Binding Settings.SendOptionalAnalytics}"
					ToolTip="{DynamicResource LOC_Analytics_OptionalDesc}" />

				<TextBlock
					Margin="12,3,12,12"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Opacity="0.5"
					Style="{DynamicResource Subscript}"
					Text="{DynamicResource LOC_Analytics_OptPrivacy}"
					TextAlignment="Center" />
			</StackPanel>
		</TabItem>

	</TabControl>
</panels:Panel>
