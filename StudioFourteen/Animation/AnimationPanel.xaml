<panels:CharacterPanelBase
	x:Class="StudioFourteen.Animation.AnimationPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:animation="clr-namespace:StudioFourteen.Animation"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<StackPanel Margin="3">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<librarySelector:LibrarySelectorButton
				Grid.Column="0"
				Type="{x:Type animation:ITimelineAnimation}"
				Value="{Binding Animation}"
				SearchTags="{Binding DefaultTags}"/>

			<Button
				Visibility="{Binding Controller.IsPlayingAnimation, Converter={StaticResource !B2V}}"
				IsEnabled="{Binding Animation, Converter={StaticResource NotNullToBoolConverter}}"
				HorizontalAlignment="Stretch"
				Height="48"
				Click="OnPlayClicked"
				Padding="12"
				Content="{DynamicResource ICON_Animation_Play}"
				Grid.Column="1" />

			<Button
				Visibility="{Binding Controller.IsPlayingAnimation, Converter={StaticResource B2V}}"
				IsEnabled="{Binding Animation, Converter={StaticResource NotNullToBoolConverter}}"
				HorizontalAlignment="Stretch"
				Height="48"
				Click="OnStopClicked"
				Padding="12"
				Content="{DynamicResource ICON_Animation_Stop}"
				Grid.Column="1" />
		</Grid>

		<ToggleButton
			IsChecked="{Binding Controller.EnableLoop}"
			Content="Enable animation loop" />

		<TextBlock
			Margin="0,12,0,0"
			Text="{Binding Controller.CurrentBaseTimelineKey}"
			Foreground="{DynamicResource ForegroundLightBrush}"/>
		<ProgressBar
			Maximum="{Binding Controller.Duration}"
			Minimum="0"
			Value="{Binding Controller.CurrentTime}"
			Margin="4"/>

		<TextBlock Text="Speed" Style="{DynamicResource LeftLabel}"/>
		<s14:NumberBox
			Change="0.01"
			Maximum="2"
			Minimum="0"
			Value="{Binding Controller.Speed}" />

	</StackPanel>

</panels:CharacterPanelBase>