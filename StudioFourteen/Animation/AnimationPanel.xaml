<panels:Panel
	x:Class="StudioFourteen.Animation.AnimationPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:animation="clr-namespace:StudioFourteen.Animation"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Animation}"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="{DynamicResource ICON_Title_Animation}"
	mc:Ignorable="d">

	<StackPanel Margin="3">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<librarySelector:LibrarySelectorButton
				Grid.Column="0"
				Type="{x:Type animation:ITimelineAnimation}"
				Value="{Binding Animation}" />

			<Button
				IsEnabled="{Binding Animation, Converter={StaticResource NotNullToBoolConverter}}"
				HorizontalAlignment="Stretch"
				Height="48"
				Click="OnPlayClicked"
				Padding="12"
				Content="{DynamicResource ICON_Animation_Play}"
				Grid.Column="1" />
		</Grid>

		<ToggleButton
			IsChecked="{Binding Controller.EnableLoop}"
			Content="Enable animation loop" />

		<TextBlock Text="Speed" />

		<controls:NumberSlider
			Change="0.01"
			Maximum="2"
			Minimum="0"
			Value="{Binding Controller.Speed}" />

		<ProgressBar
			Maximum="{Binding Controller.Duration}"
			Minimum="0"
			Value="{Binding Controller.CurrentTime}" />

	</StackPanel>

</panels:Panel>