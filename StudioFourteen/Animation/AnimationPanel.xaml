<panels:Panel
	x:Class="StudioFourteen.Animation.AnimationPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Animation}"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="{DynamicResource ICON_Title_Animation}"
	mc:Ignorable="d" >

	<StackPanel>
		<Button Click="OnTestClicked" Content="Test"/>

		<controls:NumberSlider Value="{Binding Services.Animations.Speed}" Minimum="-1" Maximum="1" Change="0.01"/>
	</StackPanel>

</panels:Panel>
