<panels:Panel
	x:Class="StudioFourteen.Animation.AnimationPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Animation}"
	Width="300"
	Height="450"
	MinWidth="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="{DynamicResource ICON_Title_Animation}"
	mc:Ignorable="d">

	<StackPanel>
		<TextBlock Text="{Binding Controller}" />

		<Button Click="OnTestClicked" Content="Test" />

		<controls:NumberSlider
			Change="0.01"
			Maximum="2"
			Minimum="0"
			Value="{Binding Controller.Speed}" />

		<controls:NumberSlider
			Change="0.1"
			Style="{DynamicResource NumberPointSlider}"
			Maximum="{Binding Controller.Duration}"
			Minimum="0"
			Value="{Binding Controller.CurrentTime}" />

	</StackPanel>

</panels:Panel>
