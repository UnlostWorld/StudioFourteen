<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:StudioFourteen.Themes">

	<SolidColorBrush x:Key="ForegroundBrush" Color="#ECECEC" />
	<SolidColorBrush x:Key="ForegroundLightBrush" Color="#838383" />
	<SolidColorBrush x:Key="BackgroundBrush" Color="#222222" />
	<SolidColorBrush x:Key="BackgroundLightBrush" Color="#333333" />
	<SolidColorBrush x:Key="TrimBrush" Color="#FF1493" />
	<SolidColorBrush x:Key="ControlBackgroundBrush" Color="#171717" />
	<SolidColorBrush x:Key="ControlHighlightBrush" Color="#343434" />
	<SolidColorBrush x:Key="ControlForegroundHighlightBrush" Color="#ECECEC" />
	<SolidColorBrush x:Key="ControlBackgroundSelectedBrush" Color="#222222" />

	<themes:ThemeOptionsSet Name="Trim Color" x:Key="ThemeOptions" Key="TrimBrush">
		<themes:ThemeOption Name="Pink">
			<SolidColorBrush Color="#FF1493" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Blue">
			<SolidColorBrush Color="#1484FF" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Teal">
			<SolidColorBrush Color="#14FFB3" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Green">
			<SolidColorBrush Color="#5CFF14" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Yellow">
			<SolidColorBrush Color="#FBFF14" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Orange">
			<SolidColorBrush Color="#FF7C14" />
		</themes:ThemeOption>

		<themes:ThemeOption Name="Red">
			<SolidColorBrush Color="#FF1414" />
		</themes:ThemeOption>
	</themes:ThemeOptionsSet>

</ResourceDictionary>
