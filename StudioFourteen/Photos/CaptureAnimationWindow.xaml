<panels:PanelWindow
	x:Class="StudioFourteen.Photos.CaptureAnimationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="1080"
	d:DesignWidth="1920"
	AllowsTransparency="True"
	Background="Transparent"
	ResizeMode="NoResize"
	SnapsToDevicePixels="True"
	UseLayoutRounding="True"
	WindowStyle="None"
	mc:Ignorable="d">

	<panels:PanelWindow.Template>
		<ControlTemplate TargetType="{x:Type panels:PanelWindow}">
			<AdornerDecorator>
				<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
			</AdornerDecorator>
		</ControlTemplate>
	</panels:PanelWindow.Template>

	<Grid ClipToBounds="True">
		<Rectangle>
			<Rectangle.Fill>
				<SolidColorBrush Color="{Binding FillColor}" />
			</Rectangle.Fill>
		</Rectangle>

		<Grid Opacity="{Binding PhotoOpacity}" RenderTransformOrigin="0.5, 0.5">

			<Grid.RenderTransform>
				<TransformGroup>
					<ScaleTransform ScaleX="{Binding PhotoScale}" ScaleY="{Binding PhotoScale}" />
					<RotateTransform Angle="{Binding PhotoAngle}" />
					<TranslateTransform Y="{Binding PhotoOffset}" />
				</TransformGroup>
			</Grid.RenderTransform>

			<Grid Margin="0" HorizontalAlignment="Center">
				<Grid.Effect>
					<DropShadowEffect
						BlurRadius="20"
						Direction="0"
						ShadowDepth="2" />
				</Grid.Effect>

				<Rectangle Fill="White" />

				<Image Margin="10,10,10,32" Source="{Binding LastImage}" />

				<TextBlock
					Margin="6"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					FontSize="14"
					Text="{Binding Services.Photos.LastSavedImagePath}" />
			</Grid>
		</Grid>

		<Grid
			Margin="0,50,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			Opacity="{Binding SpinnerOpacity}">

			<Border
				Margin="32,0,0,0"
				VerticalAlignment="Center"
				Background="{DynamicResource BackgroundBrush}"
				CornerRadius="6">

				<StackPanel Orientation="Vertical">
					<ProgressBar Grid.Row="0" Style="{DynamicResource Spinner}" />

					<TextBlock
						Grid.Row="1"
						Margin="6,4,6,4"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundBrush}"
						Text="Waiting for ReShade..." />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</panels:PanelWindow>
