<mvm:View
	x:Class="StudioFourteen.Photos.PhotoGuides"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Photos"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	IsHitTestVisible="False"
	mc:Ignorable="d">

	<Grid ClipToBounds="True">
		<Grid>
			<Grid Opacity="{Binding PhotoOpacity}" RenderTransformOrigin="0.5, 0.5">
				<Grid.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="{Binding PhotoScale}" ScaleY="{Binding PhotoScale}" />
						<RotateTransform Angle="{Binding PhotoAngle}" />
						<TranslateTransform Y="{Binding PhotoOffset}" />
					</TransformGroup>
				</Grid.RenderTransform>

				<Grid Margin="0">
					<Grid.Effect>
						<DropShadowEffect
							BlurRadius="20"
							Direction="0"
							ShadowDepth="2" />
					</Grid.Effect>

					<Rectangle Fill="White" />

					<Image Margin="10,10,10,28" Source="{Binding LastSavedImage}" />

					<TextBlock
						Margin="6"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Text="{Binding Services.Photos.LastSavedImagePath}" />
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</mvm:View>
