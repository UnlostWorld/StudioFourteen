<mvm:View
	x:Class="StudioFourteen.Photos.PhotoGuides"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Photos"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	IsHitTestVisible="False"
	mc:Ignorable="d">

	<Grid ClipToBounds="True">

		<Rectangle
			Width="{Binding BorderHalfWidth}"
			HorizontalAlignment="Left"
			Fill="Black" />

		<Rectangle
			Width="{Binding BorderHalfWidth}"
			HorizontalAlignment="Right"
			Fill="Black" />

		<Rectangle
			Height="{Binding BorderHalfHeight}"
			VerticalAlignment="Top"
			Fill="Black" />

		<Rectangle
			Height="{Binding BorderHalfHeight}"
			VerticalAlignment="Bottom"
			Fill="Black" />

		<Grid
			Width="{Binding AspectBoxWidth}"
			Height="{Binding AspectBoxHeight}"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">

			<!--  Thirds  -->
			<Grid Visibility="{Binding Services.Photos.Guide, Converter={StaticResource EnumToVisibility}, ConverterParameter=Thirds}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Line
					Grid.Row="1"
					Grid.ColumnSpan="3"
					VerticalAlignment="Bottom"
					Stretch="Fill"
					Stroke="Black"
					StrokeThickness="{Binding Services.Photos.GuideThickness}"
					X1="0"
					X2="1" />

				<Line
					Grid.Row="1"
					Grid.ColumnSpan="3"
					VerticalAlignment="Top"
					Stretch="Fill"
					Stroke="Black"
					StrokeThickness="{Binding Services.Photos.GuideThickness}"
					X1="0"
					X2="1" />

				<Line
					Grid.RowSpan="3"
					Grid.Column="1"
					HorizontalAlignment="Left"
					Stretch="Fill"
					Stroke="Black"
					StrokeThickness="{Binding Services.Photos.GuideThickness}"
					Y1="0"
					Y2="1" />

				<Line
					Grid.RowSpan="3"
					Grid.Column="1"
					HorizontalAlignment="Right"
					Stretch="Fill"
					Stroke="Black"
					StrokeThickness="{Binding Services.Photos.GuideThickness}"
					Y1="0"
					Y2="1" />
			</Grid>

			<!--  Circle  -->
			<Grid Visibility="{Binding Services.Photos.Guide, Converter={StaticResource EnumToVisibility}, ConverterParameter=Circle}">
				<Ellipse
					Stretch="Fill"
					Stroke="Black"
					StrokeThickness="{Binding Services.Photos.GuideThickness}" />
			</Grid>
		</Grid>
	</Grid>
</mvm:View>
