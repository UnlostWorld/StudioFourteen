<local:Panel
	x:Class="StudioFourteen.Photos.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vectors="http://sharpvectors.codeplex.com/svgc/"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Photo}"
	Width="550"
	Height="58"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,1"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	TitleIcon="Image"
	VisibilityMode="PhotoMode"
	mc:Ignorable="d">

	<Border
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom"
		Style="{DynamicResource WpfUtilsControlBorder}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Grid
					Background="Transparent"
					ToolTip="{DynamicResource LOC_Photo_GroupPoseWarn}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource !B2V}}">
					<wpfUtils:IconBlock
						Grid.Column="0"
						Icon="InfoCircle"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Opacity="0.5"
						Margin="6,2"/>
				</Grid>

				<ComboBox
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}"
					Grid.Column="0"
					Width="175"
					ItemsSource="{Binding Services.Photos.AspectRatios}"
					SelectedItem="{Binding SelectedAspectRatio}"
					ToolTip="{DynamicResource LOC_Photo_AspectToolTip}">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="12"
							Text="{DynamicResource LOC_Photo_AspectPopOut}"/>
					</wpfUtils:PopOut.Header>

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<ComboBox
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}"
					Grid.Column="1"
					Width="100"
					SelectedIndex="{Binding GuideIndex}"
					ToolTip="{DynamicResource LOC_Photo_GuidesToolTip}">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="12"
							Text="{DynamicResource LOC_Photo_GuidesPopOut}"/>
					</wpfUtils:PopOut.Header>

					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_None}"/>
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Thirds}"/>
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Circle}"/>
				</ComboBox>

				<Button
					Grid.Column="2"
					Width="64"
					Margin="2,0"
					Background="Transparent"
					Click="OnSaveClicked"
					ToolTip="{DynamicResource LOC_Photo_CaptureToolTip}">
					<wpfUtils:IconBlock
						Icon="Camera"/>
				</Button>

				<ToggleButton
					Grid.Column="3"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding HideUI}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleUIToolTip}">
					<Grid>
						<vectors:SvgIcon
							Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-show-ui.svg"
							Visibility="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource !B2V}}"/>

						<vectors:SvgIcon
							Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-hide-ui.svg"
							Visibility="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource B2V}}"/>
					</Grid>
				</ToggleButton>

				<ToggleButton
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}"
					Grid.Column="4"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding Services.Photos.ShowDepth}"
					IsEnabled="{Binding Services.Reshade.IsReshade}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleDepth}">
					<TextBlock Text="D"/>
				</ToggleButton>

				<ToggleButton
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}"
					Grid.Column="5"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding IsPortrait}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_TogglePortrait}">
					<vectors:SvgIcon
						Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						UriSource="pack://application:,,,/StudioFourteen;component/Assets/icon-portrait-preview.svg"/>
				</ToggleButton>

				<Button
					Grid.Column="6"
					Width="28"
					Margin="0"
					Click="OnSettingsClicked"
					ToolTip="{DynamicResource LOC_Photo_Settings}">
					<wpfUtils:IconBlock Icon="Gears"/>
				</Button>

				<Button
					Grid.Column="7"
					Width="28"
					Margin="0"
					Click="OnCloseClicked"
					ToolTip="{DynamicResource LOC_ClosePanelTooltip}">
					<wpfUtils:IconBlock Icon="Times"/>
				</Button>


			</Grid>
		</Grid>
	</Border>
</local:Panel>
