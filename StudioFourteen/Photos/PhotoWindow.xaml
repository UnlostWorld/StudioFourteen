<local:Panel
	x:Class="StudioFourteen.Photos.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Photo}"
	Width="512"
	Height="58"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,1"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	TitleIcon="Image"
	VisibilityMode="PhotoMode"
	mc:Ignorable="d">

	<Border
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom"
		Style="{DynamicResource WpfUtilsControlBorder}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ComboBox
					Grid.Column="0"
					Width="175"
					ItemsSource="{Binding Services.Photos.AspectRatios}"
					SelectedItem="{Binding SelectedAspectRatio}"
					ToolTip="{DynamicResource LOC_Photo_AspectToolTip}">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="12"
							Text="{DynamicResource LOC_Photo_AspectPopOut}" />
					</wpfUtils:PopOut.Header>

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<ComboBox
					Grid.Column="1"
					Width="100"
					SelectedIndex="{Binding GuideIndex}"
					ToolTip="{DynamicResource LOC_Photo_GuidesToolTip}">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="12"
							Text="{DynamicResource LOC_Photo_GuidesPopOut}" />
					</wpfUtils:PopOut.Header>

					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_None}" />
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Thirds}" />
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Circle}" />
				</ComboBox>

				<Button
					Grid.Column="2"
					Width="64"
					Margin="2,0"
					Background="Transparent"
					Click="OnSaveClicked"
					ToolTip="{DynamicResource LOC_Photo_CaptureToolTip}">
					<wpfUtils:IconBlock
						FontSize="16"
						Icon="Camera" />
				</Button>

				<Button
					Grid.Column="4"
					Width="28"
					Margin="0"
					Click="OnCloseClicked"
					ToolTip="{DynamicResource LOC_ClosePanelTooltip}">
					<wpfUtils:IconBlock Icon="Times" />
				</Button>

				<ToggleButton
					Grid.Column="3"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding HideUI}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleUIToolTip}">
					<wpfUtils:IconBlock Icon="ObjectGroup" />
				</ToggleButton>
			</Grid>
		</Grid>
	</Border>
</local:Panel>
