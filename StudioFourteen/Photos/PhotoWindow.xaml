<panels:Panel
	x:Class="StudioFourteen.Photos.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Photos"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Photo}"
	Width="800"
	Height="58"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,1"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	ResizeMode="NoResize"
	TitleIcon="{DynamicResource ICON_Title_Photo}"
	VisibilityMode="PhotoMode"
	mc:Ignorable="d">

	<Border
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom"
		Style="{DynamicResource WpfUtilsControlBorder}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal">

				<Grid
					Background="Transparent"
					ToolTip="{DynamicResource LOC_Photo_GroupPoseWarn}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource !B2V}}">
					<icons:IconView
						Grid.Column="0"
						Margin="6,2"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{DynamicResource ICON_Info}"
						Opacity="0.5" />
				</Grid>

				<ToggleButton
					x:Name="ResolutionToggle"
					Grid.Column="0"
					Width="250"
					Style="{DynamicResource WpfUtilsComboBoxButton}"
					ToolTip="{DynamicResource LOC_Photo_AspectToolTip}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}">
					<Grid Margin="2">
						<TextBlock TextTrimming="CharacterEllipsis">
							<Run Text="{Binding SelectedAspectRatio.GroupName}" />
							<Run Text=" - " />
							<Run Text="{Binding SelectedAspectRatio.Name}" />
						</TextBlock>
					</Grid>
				</ToggleButton>

				<wpfUtils:PopOut
					Width="250"
					Height="350"
					IsOpen="{Binding ElementName=ResolutionToggle, Path=IsChecked}"
					PlacementTarget="{Binding ElementName=ResolutionToggle}"
					StaysOpen="False">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="6"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{DynamicResource LOC_Photo_AspectPopOut}"
							TextWrapping="Wrap" />
					</wpfUtils:PopOut.Header>

					<wpfUtils:PopOut.Resources>
						<CollectionViewSource x:Key="ListBoxItems"
							Source="{Binding Services.Photos.AspectRatios}">
							<CollectionViewSource.GroupDescriptions>
								<PropertyGroupDescription PropertyName="GroupName" />
							</CollectionViewSource.GroupDescriptions>
						</CollectionViewSource>
					</wpfUtils:PopOut.Resources>

					<ListBox
						x:Name="AspectsList"
						ItemsSource="{Binding Source={StaticResource ListBoxItems}}"
						SelectedItem="{Binding SelectedAspectRatio}">
						<ListBox.GroupStyle>
							<GroupStyle>
								<GroupStyle.Panel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel Orientation="Vertical" />
									</ItemsPanelTemplate>
								</GroupStyle.Panel>
								<GroupStyle.ContainerStyle>
									<Style TargetType="{x:Type GroupItem}">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate>
													<Expander Expanded="OnAspectsExpanderExpanded"
														Style="{DynamicResource WpfUtilsClickableExpander}">
														<Expander.Header>
															<TextBlock
																Foreground="{DynamicResource ForegroundLightBrush}"
																Text="{Binding Items[0].GroupName}" />
														</Expander.Header>
														<ItemsPresenter />
													</Expander>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</GroupStyle.ContainerStyle>
							</GroupStyle>
						</ListBox.GroupStyle>

						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type local:AspectRatioEntry}">
								<Grid Margin="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock Text="{Binding Name}" />

									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Right"
										Foreground="{DynamicResource ForegroundLightBrush}"
										Visibility="{Binding Height, Converter={StaticResource NotZeroToVisibility}}">
										<Run Text="{Binding Width}" />
										<Run Text="x" />
										<Run Text="{Binding Height}" />
									</TextBlock>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>
				</wpfUtils:PopOut>

				<ComboBox
					Grid.Column="1"
					Width="100"
					SelectedIndex="{Binding GuideIndex}"
					ToolTip="{DynamicResource LOC_Photo_GuidesToolTip}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}">

					<wpfUtils:PopOut.Header>
						<TextBlock Margin="12" Text="{DynamicResource LOC_Photo_GuidesPopOut}" />
					</wpfUtils:PopOut.Header>

					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_None}" />
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Thirds}" />
					<ComboBoxItem Content="{DynamicResource LOC_Photo_Guides_Circle}" />
				</ComboBox>

				<Button
					Grid.Column="2"
					Width="64"
					Margin="2,0"
					Background="Transparent"
					Click="OnSaveClicked"
					ToolTip="{DynamicResource LOC_Photo_CaptureToolTip}">
					<icons:IconView Icon="{DynamicResource ICON_CaptureImage}" />
				</Button>

				<ToggleButton
					Grid.Column="3"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding HideUI}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleUIToolTip}">
					<Grid>
						<icons:IconView
							Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							Icon="{DynamicResource ICON_ShowUi}"
							Visibility="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource !B2V}}" />

						<icons:IconView
							Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							Icon="{DynamicResource ICON_HideUi}"
							Visibility="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource B2V}}" />
					</Grid>
				</ToggleButton>

				<ToggleButton
					Grid.Column="4"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding Services.Photos.ShowDepth}"
					IsEnabled="{Binding Services.Reshade.IsReshade}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleDepth}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}">
					<TextBlock Text="D" />
				</ToggleButton>

				<ToggleButton
					Grid.Column="4"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding Services.Reshade.IsReshadeEnabled}"
					IsEnabled="{Binding Services.Reshade.IsReshade}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_ToggleReshade}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}">
					<TextBlock Text="R" />
				</ToggleButton>

				<ToggleButton
					Grid.Column="5"
					Width="28"
					Margin="0"
					Padding="6,0"
					IsChecked="{Binding IsPortrait}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					ToolTip="{DynamicResource LOC_Photo_TogglePortrait}"
					Visibility="{Binding Services.Studio.IsOpenAndInGPose, Converter={StaticResource B2V}}">
					<icons:IconView Icon="{DynamicResource ICON_Photo_Portrait}" />
				</ToggleButton>

				<Button
					Grid.Column="6"
					Width="28"
					Margin="0"
					Click="OnSettingsClicked"
					ToolTip="{DynamicResource LOC_Photo_Settings}">
					<icons:IconView Icon="{DynamicResource ICON_Title_Settings}" />
				</Button>

				<Button
					Grid.Column="7"
					Width="28"
					Margin="0"
					Click="OnCloseClicked"
					ToolTip="{DynamicResource LOC_ClosePanelTooltip}">
					<icons:IconView Icon="{DynamicResource ICON_Close}" />
				</Button>

				<!--
				<Slider Minimum="0" Maximum="1" Value="{Binding Services.GameCapture.Min}" Width="128"/>
				<Slider Minimum="0" Maximum="1" Value="{Binding Services.GameCapture.Max}" Width="128"/>
				-->

			</StackPanel>
		</Grid>
	</Border>
</panels:Panel>