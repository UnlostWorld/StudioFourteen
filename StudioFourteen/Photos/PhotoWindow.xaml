<local:Panel
	x:Class="StudioFourteen.Photos.PhotoWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Photo}"
	Width="380"
	Height="75"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	DefaultPosition="0.5,1"
	HostStyle="{DynamicResource PanelToolbarStyle}"
	RememberWindowState="False"
	ResizeMode="NoResize"
	TitleIcon="Image"
	VisibilityMode="PhotoMode"
	mc:Ignorable="d">

	<Border
		HorizontalAlignment="Center"
		VerticalAlignment="Bottom"
		Style="{DynamicResource WpfUtilsControlBorder}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					FontSize="10"
					Style="{DynamicResource LeftLabel}"
					Text="Aspect Ratio:" />

				<ComboBox
					Grid.Row="1"
					Grid.Column="0"
					Width="120"
					SelectedIndex="0">
					<ComboBoxItem Content="Any" />
					<ComboBoxItem Content="1:1" />
					<ComboBoxItem Content="4:3" />
					<ComboBoxItem Content="16:9" />
					<ComboBoxItem Content="16:10" />
					<ComboBoxItem Content="21:9" />
					<ComboBoxItem Content="32:9" />
				</ComboBox>

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					FontSize="10"
					Style="{DynamicResource LeftLabel}"
					Text="Guides:" />

				<ComboBox
					Grid.Row="1"
					Grid.Column="1"
					Width="120"
					SelectedIndex="0">
					<ComboBoxItem Content="None" />
					<ComboBoxItem Content="Golden Ratio" />
				</ComboBox>

				<Button
					Grid.RowSpan="2"
					Grid.Column="2"
					Width="41"
					Height="41"
					Margin="6,0"
					Background="Transparent"
					Click="OnSaveClicked">
					<wpfUtils:IconBlock
						FontSize="22"
						Icon="Camera" />
				</Button>

				<ToggleButton
					Grid.Row="1"
					Grid.Column="3"
					Padding="6,0"
					IsChecked="{Binding HideUI}"
					Style="{DynamicResource WpfUtilsIconToggleButton}">
					<wpfUtils:IconBlock Icon="ObjectGroup" />
				</ToggleButton>

				<ToggleButton
					Grid.Row="1"
					Grid.Column="4"
					Padding="6,0"
					Style="{DynamicResource WpfUtilsIconToggleButton}">
					<wpfUtils:IconBlock Icon="Eye" />
				</ToggleButton>
			</Grid>
		</Grid>
	</Border>
</local:Panel>
