<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:excel="clr-namespace:StudioFourteen.GameData.Excel"
	xmlns:files="clr-namespace:StudioFourteen.Files"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:WpfUtils.Markup;assembly=WpfUtils"
	xmlns:services="clr-namespace:StudioFourteen.Services"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:ss="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<DataTemplate
		x:Key="AppearanceIcon"
		DataType="{x:Type appearance:ICharacterAppearance}">
		<Viewbox>
			<Grid>
				<Image
					x:Name="Icon"
					Source="{Binding Icon.Source}" />

				<Grid
					x:Name="FallbackIcon"
					Visibility="Collapsed">
					<wpfUtils:IconBlock
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontSize="72"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="UserShield"
						IconFont="Solid" />
				</Grid>
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="SimpleIconTemplate">
		<Viewbox>
			<Grid
				Width="48"
				Height="48">

				<controls:XivTexImage
					x:Name="IconBack"
					Margin="0,-1,0,1"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 192, 96, 96"
					SnapsToDevicePixels="True"
					Visibility="Collapsed" />

				<Image
					Margin="4,3,3.5,3"
					SnapsToDevicePixels="True"
					Source="{Binding Icon.Source}" />

				<controls:XivTexImage
					x:Name="IconShine"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 0, 96, 96"
					SnapsToDevicePixels="True" />
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_DataSheetLibrarySource"
		DataType="{x:Type gameData:DataSheetLibrarySource}">

		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<Grid>
					<wpfUtils:IconBlock
						Margin="11,12,9,8"
						FontSize="72"
						Foreground="#E3A626"
						Icon="Folder"
						IconFont="Solid"
						Opacity="0.5" />

					<wpfUtils:IconBlock
						Margin="10"
						FontSize="72"
						Foreground="#FFD45E"
						Icon="Folder"
						IconFont="Solid" />

				</Grid>

				<Image
					Width="32"
					Height="32"
					Margin="16,0,0,22"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Opacity="0.5"
					Source="pack://application:,,,/StudioFourteen;component/Assets/ffxiv-logo-dark.png" />

			</Grid>
		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_GroupPoseCharactersLibrarySource"
		DataType="{x:Type appearance:GroupPoseCharactersLibrarySource}">
		<controls:XivIconImage Id="061546" />
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_Territory"
		DataType="{x:Type excel:Territory}">
		<controls:XivIconImage Id="060430" />
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_Weather"
		DataType="{x:Type excel:Weather}">
		<Image
			SnapsToDevicePixels="True"
			Source="{Binding Icon.Source}" />
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryIcon_AppearanceFileTypeInfo"
		DataType="{x:Type files:AppearanceFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="#ADADAD"
					Icon="UserShield"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryIcon_PoseFileTypeInfo"
		DataType="{x:Type files:PoseFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="40"
					Foreground="#ADADAD"
					Icon="Running"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_SceneFileTypeInfo"
		DataType="{x:Type files:SceneFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="#ADADAD"
					Icon="UsersViewfinder"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_FileEntry"
		DataType="{x:Type sources:FileEntry}">

		<Grid>
			<ContentPresenter
				x:Name="FallbackIcon"
				Content="{Binding TypeInfo}"
				Visibility="Collapsed" />

			<Grid
				x:Name="Thumbnail"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

				<Border
					Margin="1,2,-1,-2"
					Background="Black"
					CornerRadius="4"
					Opacity="0.1" />

				<Image Source="{Binding IconPath}" />
			</Grid>
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding IconPath}"
				Value="{x:Null}">
				<Setter TargetName="Thumbnail" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>



	<DataTemplate
		x:Key="LibraryIcon_DirectoryEntry"
		DataType="{x:Type sources:DirectoryEntry}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="11,12,9,8"
					FontSize="72"
					Foreground="#E3A626"
					Icon="Folder"
					IconFont="Solid"
					Opacity="0.5" />

				<wpfUtils:IconBlock
					Margin="10"
					FontSize="72"
					Foreground="#FFD45E"
					Icon="Folder"
					IconFont="Solid" />
			</Grid>
		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_FileSource"
		DataType="{x:Type sources:FileSource}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="11,12,9,8"
					FontSize="72"
					Foreground="#E3A626"
					Icon="Folder"
					IconFont="Solid"
					Opacity="0.5" />

				<wpfUtils:IconBlock
					Margin="10"
					FontSize="72"
					Foreground="#FFD45E"
					Icon="Folder"
					IconFont="Solid" />

			</Grid>
		</Viewbox>
	</DataTemplate>


	<markup:TemplateSelector x:Key="LibraryIconTemplateSelector">

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:DataSheetLibrarySource}"
			Template="{StaticResource LibraryIcon_DataSheetLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type appearance:GroupPoseCharactersLibrarySource}"
			Template="{StaticResource LibraryIcon_GroupPoseCharactersLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:ResidentNpc}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:EventNpc}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:BattleNpc}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type appearance:CharacterBackupAppearance}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Item}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Stain}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Glasses}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Ornament}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Weather}"
			Template="{StaticResource LibraryIcon_Weather}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Companion}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Mount}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Perform}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:AppearanceFileTypeInfo}"
			Template="{StaticResource LibraryIcon_AppearanceFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:PoseFileTypeInfo}"
			Template="{StaticResource LibraryIcon_PoseFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:SceneFileTypeInfo}"
			Template="{StaticResource LibraryIcon_SceneFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileEntry}"
			Template="{StaticResource LibraryIcon_FileEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:DirectoryEntry}"
			Template="{StaticResource LibraryIcon_DirectoryEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileSource}"
			Template="{StaticResource LibraryIcon_FileSource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:Territory}"
			Template="{StaticResource LibraryIcon_Territory}" />

	</markup:TemplateSelector>

	<Style
		x:Key="LibraryIcon"
		TargetType="{x:Type ContentPresenter}">
		<Setter Property="ContentTemplateSelector" Value="{StaticResource LibraryIconTemplateSelector}" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

</ResourceDictionary>