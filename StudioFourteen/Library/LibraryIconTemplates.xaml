<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:Scripting="clr-namespace:StudioFourteen.Scripting"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:files="clr-namespace:StudioFourteen.Files"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:WpfUtils.Markup;assembly=WpfUtils"
	xmlns:scripting="clr-namespace:StudioFourteen.Scripting"
	xmlns:services="clr-namespace:StudioFourteen.Services"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:ss="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

	<DataTemplate
		x:Key="AppearanceIcon"
		DataType="{x:Type appearance:ICharacterAppearance}">
		<Viewbox>
			<Grid>
				<Image
					x:Name="Icon"
					Source="{Binding Icon.Source}" />

				<Grid
					x:Name="FallbackIcon"
					Visibility="Collapsed">
					<wpfUtils:IconBlock
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontSize="72"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="UserShield"
						IconFont="Solid" />
				</Grid>
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="SimpleIconTemplate">
		<Viewbox>
			<Grid
				Width="48"
				Height="48">

				<controls:XivTexImage
					x:Name="IconBack"
					Margin="0,0,0,0"
					Opacity="0.5"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 192, 96, 96"
					Visibility="Collapsed" />

				<Image
					Margin="4,3,3,5"
					Source="{Binding Icon.Source}" />

				<controls:XivTexImage
					x:Name="IconShine"
					Path="ui/uld/icona_frame_hr1.tex"
					Rect="0, 0, 96, 96"
					Visibility="{Binding Icon.Source, Converter={StaticResource NotNullToVisibilityConverter}}" />
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding Icon}"
				Value="{x:Null}">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger
				Binding="{Binding RowId}"
				Value="0">
				<Setter TargetName="IconShine" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="IconBack" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_DataSheetLibrarySource"
		DataType="{x:Type gameData:ExcelSheetLibrarySource}">

		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<Grid>
					<wpfUtils:IconBlock
						Margin="11,12,9,8"
						FontSize="72"
						Foreground="#E3A626"
						Icon="Folder"
						IconFont="Solid"
						Opacity="0.5" />

					<wpfUtils:IconBlock
						Margin="10"
						FontSize="72"
						Foreground="#FFD45E"
						Icon="Folder"
						IconFont="Solid" />

				</Grid>

				<controls:XivIconImage
					Width="48"
					Height="48"
					Margin="-5,0,0,2"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Id="061396"
					SnapsToDevicePixels="True" />

			</Grid>
		</Viewbox>
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryIcon_GroupPoseCharactersLibrarySource"
		DataType="{x:Type appearance:GroupPoseCharactersLibrarySource}">
		<controls:XivIconImage Id="061546" />
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_Territory"
		DataType="{x:Type gameData:TerritoryTypeLibraryEntry}">


		<Viewbox>
			<Grid
				Width="48"
				Height="48">

				<Ellipse
					x:Name="Icon"
					Margin="6">
					<Ellipse.Fill>
						<ImageBrush
							ImageSource="{Binding ThumbnailPath}"
							Stretch="UniformToFill">
							<ImageBrush.RelativeTransform>
								<ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.5" ScaleY="1.5" />
							</ImageBrush.RelativeTransform>
						</ImageBrush>
					</Ellipse.Fill>
				</Ellipse>

				<controls:XivIconImage
					x:Name="FallbackIcon"
					Id="060430"
					Visibility="Collapsed" />
			</Grid>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding ThumbnailPath}"
				Value="{x:Null}">
				<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_Weather"
		DataType="{x:Type gameData:WeatherLibraryEntry}">
		<Image
			SnapsToDevicePixels="True"
			Source="{Binding Icon.Source}" />
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryIcon_AppearanceFileTypeInfo"
		DataType="{x:Type files:AppearanceFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="#ADADAD"
					Icon="UserShield"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryIcon_PoseFileTypeInfo"
		DataType="{x:Type files:PoseFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="40"
					Foreground="#ADADAD"
					Icon="Running"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_SceneFileTypeInfo"
		DataType="{x:Type files:SceneFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="#ADADAD"
					Icon="UsersViewfinder"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_ScriptFileTypeInfo"
		DataType="{x:Type scripting:ScriptFileTypeInfo}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="1,2,-1,-2"
					FontSize="72"
					Foreground="#ADADAD"
					Icon="File"
					IconFont="Solid"
					Opacity="0.25" />

				<wpfUtils:IconBlock
					FontSize="72"
					Foreground="#FDFDFD"
					Icon="File"
					IconFont="Solid" />

				<wpfUtils:IconBlock
					Margin="5,0,0,-25"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="32"
					Foreground="#ADADAD"
					Icon="Robot"
					IconFont="Solid" />
			</Grid>

		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_FileEntry"
		DataType="{x:Type sources:FileEntry}">

		<Grid>
			<ContentPresenter
				x:Name="FallbackIcon"
				Content="{Binding TypeInfo}"
				Style="{DynamicResource LibraryIcon}"
				Visibility="Collapsed" />

			<Grid
				x:Name="Thumbnail"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

				<Border
					Margin="1,2,-1,-2"
					Background="Black"
					CornerRadius="4"
					Opacity="0.1" />

				<Image Source="{Binding IconPath}" />
			</Grid>
		</Grid>

		<DataTemplate.Triggers>
			<DataTrigger
				Binding="{Binding IconPath}"
				Value="{x:Null}">
				<Setter TargetName="Thumbnail" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>



	<DataTemplate
		x:Key="LibraryIcon_DirectoryEntry"
		DataType="{x:Type sources:DirectoryEntry}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="11,12,9,8"
					FontSize="72"
					Foreground="#E3A626"
					Icon="Folder"
					IconFont="Solid"
					Opacity="0.5" />

				<wpfUtils:IconBlock
					Margin="10"
					FontSize="72"
					Foreground="#FFD45E"
					Icon="Folder"
					IconFont="Solid" />
			</Grid>
		</Viewbox>
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryIcon_FileSource"
		DataType="{x:Type sources:FileSource}">
		<Viewbox CacheMode="BitmapCache">
			<Grid>
				<wpfUtils:IconBlock
					Margin="11,12,9,8"
					FontSize="72"
					Foreground="#E3A626"
					Icon="Folder"
					IconFont="Solid"
					Opacity="0.5" />

				<wpfUtils:IconBlock
					Margin="10"
					FontSize="72"
					Foreground="#FFD45E"
					Icon="Folder"
					IconFont="Solid" />

			</Grid>
		</Viewbox>
	</DataTemplate>


	<markup:TemplateSelector x:Key="LibraryIconTemplateSelector">

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:ExcelSheetLibrarySource}"
			Template="{StaticResource LibraryIcon_DataSheetLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:CharaMakeCustomizeLibrarySource}"
			Template="{StaticResource LibraryIcon_DataSheetLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type appearance:GroupPoseCharactersLibrarySource}"
			Template="{StaticResource LibraryIcon_GroupPoseCharactersLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:GlamourerSource}"
			Template="{StaticResource LibraryIcon_FileSource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:ItemLibraryEntry}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:CharaMakeCustomizeLibraryEntry}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:BNpcBaseLibraryEntry}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:ENpcResidentLibraryEntry}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type appearance:CharacterBackupAppearance}"
			Template="{StaticResource AppearanceIcon}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:StainLibraryEntry}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:GlassesLibraryEntry}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:OrnamentLibraryEntry}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:WeatherLibraryEntry}"
			Template="{StaticResource LibraryIcon_Weather}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:TerritoryTypeLibraryEntry}"
			Template="{StaticResource LibraryIcon_Territory}" />

		<!--
		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:Companion}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:Mount}"
			Template="{StaticResource SimpleIconTemplate}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:Perform}"
			Template="{StaticResource SimpleIconTemplate}" />
		-->

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:GlamourerEntry}"
			Template="{StaticResource LibraryIcon_AppearanceFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:MareFileTypeInfo}"
			Template="{StaticResource LibraryIcon_AppearanceFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:AppearanceFileTypeInfo}"
			Template="{StaticResource LibraryIcon_AppearanceFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:PoseFileTypeInfo}"
			Template="{StaticResource LibraryIcon_PoseFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:SceneFileTypeInfo}"
			Template="{StaticResource LibraryIcon_SceneFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type Scripting:ScriptFileTypeInfo}"
			Template="{StaticResource LibraryIcon_ScriptFileTypeInfo}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileEntry}"
			Template="{StaticResource LibraryIcon_FileEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:DirectoryEntry}"
			Template="{StaticResource LibraryIcon_DirectoryEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileSource}"
			Template="{StaticResource LibraryIcon_FileSource}" />



	</markup:TemplateSelector>

	<Style
		x:Key="LibraryIcon"
		TargetType="{x:Type ContentPresenter}">
		<Setter Property="ContentTemplateSelector" Value="{StaticResource LibraryIconTemplateSelector}" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

</ResourceDictionary>