<mvm:View
	x:Class="StudioFourteen.Library.MiniLibraryPopOut"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="250"
	Height="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="3"
			Margin="-4,0,-4,-4"
			Background="{DynamicResource ControlBackgroundBrush}"
			CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadiusBottom}" />

		<TextBlock
			Grid.Row="0"
			Margin="10,0,40,10"
			Foreground="{DynamicResource ForegroundLightBrush}"
			Text="{Binding SearchTitle}" />

		<Button
			Grid.Row="0"
			Width="32"
			Height="32"
			Margin="0,-10,0,0"
			HorizontalAlignment="Right"
			Background="Transparent"
			Click="OnConfirmClicked">
			<wpfUtils:IconBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Icon="Times" />
		</Button>

		<tags:TagSelector2
			Grid.Row="1"
			SelectedTags="{Binding TagFilter.Tags}"
			Tags="{Binding AvailableTags}" />

		<TextBox
			x:Name="SearchBox"
			Grid.Row="2"
			Margin="0,0,0,2"
			Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

		<ListBox
			x:Name="ResultsList"
			Grid.Row="3"
			Margin="-2,0,-2,-2"
			Padding="0"
			Background="Transparent"
			ItemsSource="{Binding Results}"
			KeyDown="OnResultsListKeyDown"
			MouseDoubleClick="ResultsListDoubleClicked"
			PreviewMouseDown="OnResultsListPreviewMouseDown"
			ScrollViewer.VerticalScrollBarVisibility="Visible"
			SelectedItem="{Binding SelectedResult}">

			<ListBox.ItemTemplate>
				<DataTemplate DataType="{x:Type results:Result}">
					<Grid
						x:Name="Content"
						Grid.Column="1"
						Background="Transparent">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<ContentPresenter
							Width="48"
							Height="48"
							Margin="3"
							VerticalAlignment="Center"
							Content="{Binding Entry}"
							Style="{StaticResource LibraryIcon}"
							TextBlock.Foreground="{DynamicResource ForegroundBrush}" />

						<Grid
							Grid.Column="1"
							VerticalAlignment="Center">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								VerticalAlignment="Center"
								Text="{Binding Entry.Name}"
								Visibility="{Binding Entry.Name, Converter={StaticResource StringHasContentToVisibility}}" />

							<TextBlock
								Grid.Row="1"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding Entry.SubTitle}"
								Visibility="{Binding Entry.SubTitle, Converter={StaticResource StringHasContentToVisibility}}" />
						</Grid>

						<Grid
							Margin="0,5,5,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
							<wpfUtils:IconBlock
								Margin="-2,2,2,-2"
								FontSize="18"
								Foreground="{DynamicResource BackgroundBrush}"
								Icon="Heart"
								IconFont="Solid" />
							<wpfUtils:IconBlock
								FontSize="18"
								Foreground="{DynamicResource TrimBrush}"
								Icon="Heart"
								IconFont="Solid" />

						</Grid>

					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>
	</Grid>

</mvm:View>
