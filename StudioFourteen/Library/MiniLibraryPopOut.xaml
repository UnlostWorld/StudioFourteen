<mvm:View
	x:Class="StudioFourteen.Library.MiniLibraryPopOut"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:WpfUtils.Behaviours;assembly=wpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Height="450"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="300"
	mc:Ignorable="d">

	<Grid>
		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />

			<ControlTemplate
				x:Key="ListBoxItemTemplate"
				TargetType="{x:Type ListBoxItem}">

				<Border
					Margin="{TemplateBinding Margin}"
					Background="Transparent"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="{TemplateBinding BorderThickness}"
					ClipToBounds="{TemplateBinding ClipToBounds}"
					ToolTip="{Binding Entry}">

					<Grid Background="Transparent">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Border
							x:Name="SelectionBorder"
							Grid.ColumnSpan="2"
							Opacity="0"
							Style="{DynamicResource WpfUtilsSelectedBorder}" />

						<Border
							x:Name="HoverBorder"
							Grid.Column="1"
							Margin="2"
							Background="{DynamicResource BackgroundLightBrush}"
							BorderBrush="{DynamicResource BackgroundLightBrush}"
							BorderThickness="1"
							CornerRadius="3"
							Opacity="0" />

						<Grid
							x:Name="Content"
							Grid.Column="1"
							Background="Transparent">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<ContentPresenter
								Width="48"
								Height="48"
								Margin="3"
								VerticalAlignment="Center"
								Content="{Binding Entry}"
								TextBlock.Foreground="{DynamicResource ForegroundBrush}">
								<ContentPresenter.Resources>
									<ResourceDictionary Source="./LibraryIconTemplates.xaml" />
								</ContentPresenter.Resources>
							</ContentPresenter>

							<ContentPresenter
								Grid.Column="1"
								VerticalAlignment="Center"
								Content="{Binding Entry}"
								TextBlock.Foreground="{DynamicResource ForegroundBrush}">
								<ContentPresenter.Resources>
									<ResourceDictionary Source="./LibraryInfoTemplates.xaml" />
								</ContentPresenter.Resources>
							</ContentPresenter>
						</Grid>

						<ToggleButton
							Height="Auto"
							Margin="2,1,2,1"
							VerticalAlignment="Stretch"
							Background="Transparent"
							Style="{DynamicResource WpfUtilsIconToggleButton}">
							<Grid>
								<wpfUtils:IconBlock
									Margin="10"
									Foreground="{DynamicResource ForegroundLightBrush}"
									Icon="Heart" />
							</Grid>

						</ToggleButton>
					</Grid>
				</Border>

				<ControlTemplate.Triggers>
					<Trigger Property="IsEnabled" Value="False">
						<Setter Property="Opacity" Value="0.5" />
					</Trigger>

					<DataTrigger
						Binding="{Binding IsMouseOver, ElementName=Content}"
						Value="True">
						<DataTrigger.EnterActions>
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
										Storyboard.TargetName="HoverBorder"
										Storyboard.TargetProperty="Opacity"
										To="1"
										Duration="0:0:0.100" />
								</Storyboard>
							</BeginStoryboard>
						</DataTrigger.EnterActions>

						<DataTrigger.ExitActions>
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
										Storyboard.TargetName="HoverBorder"
										Storyboard.TargetProperty="Opacity"
										From="1"
										To="0"
										Duration="0:0:0.250" />
								</Storyboard>
							</BeginStoryboard>
						</DataTrigger.ExitActions>
					</DataTrigger>

					<Trigger Property="IsSelected" Value="True">
						<Trigger.EnterActions>
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
										Storyboard.TargetName="SelectionBorder"
										Storyboard.TargetProperty="Opacity"
										To="1"
										Duration="0:0:0.100" />
								</Storyboard>
							</BeginStoryboard>
						</Trigger.EnterActions>

						<Trigger.ExitActions>
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
										Storyboard.TargetName="SelectionBorder"
										Storyboard.TargetProperty="Opacity"
										To="0"
										Duration="0:0:0.250" />
								</Storyboard>
							</BeginStoryboard>
						</Trigger.ExitActions>
					</Trigger>


				</ControlTemplate.Triggers>

			</ControlTemplate>
		</Grid.Resources>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="2"
			Margin="-4,0,-4,-4"
			Background="{DynamicResource ControlBackgroundBrush}"
			CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadiusBottom}" />

		<TextBlock
			Grid.Row="0"
			Margin="10,0,40,10"
			Foreground="{DynamicResource ForegroundLightBrush}"
			Text="{Binding SearchTitle}" />

		<Button
			Grid.Row="0"
			Width="32"
			Height="32"
			Margin="0,-10,0,0"
			HorizontalAlignment="Right"
			Background="Transparent"
			Click="OnConfirmClicked">
			<wpfUtils:IconBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Icon="Times" />
		</Button>

		<tags:TagSelector
			x:Name="TagSelector"
			Grid.Row="1"
			Margin="0,0,0,2"
			AllTags="{Binding AvailableTags}"
			Search="{Binding Search, Mode=TwoWay}"
			Tags="{Binding TagFilter.Tags}" />

		<ListBox
			x:Name="ResultsList"
			Grid.Row="2"
			Margin="-2,0,-2,-2"
			Padding="0"
			Background="Transparent"
			ItemsSource="{Binding Results}"
			KeyDown="OnResultsListKeyDown"
			MouseDoubleClick="ResultsListDoubleClicked"
			ScrollViewer.VerticalScrollBarVisibility="Visible"
			SelectedItem="{Binding SelectedResult}">
			<ListBox.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource WpfUtilsListBoxItem}"
					TargetType="{x:Type ListBoxItem}">
					<Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}" />
				</Style>
			</ListBox.ItemContainerStyle>
		</ListBox>
	</Grid>

</mvm:View>
