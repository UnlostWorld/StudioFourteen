<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:ex="clr-namespace:StudioFourteen.MarkupExtensions"
	xmlns:excel="clr-namespace:StudioFourteen.GameData.Excel"
	xmlns:files="clr-namespace:StudioFourteen.Files"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:ss="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />

	<DataTemplate DataType="{x:Type library:LibraryEntryBase}">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<!--  TODO: custom toggle button template for better heart animations  -->
				<ToggleButton
					Grid.Column="1"
					Width="28"
					HorizontalAlignment="Left"
					IsChecked="{Binding IsLiveExecute}"
					IsEnabled="False"
					ToolTip="{DynamicResource LOC_Library_LivePreview}">
					<Grid>
						<wpfUtils:IconBlock
							Icon="Heart"
							IconFont="Auto"
							Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Path=IsChecked, Converter={StaticResource !B2V}}" />
						<wpfUtils:IconBlock
							Icon="Heart"
							IconFont="Solid"
							Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Path=IsChecked, Converter={StaticResource B2V}}" />
					</Grid>
				</ToggleButton>
			</Grid>
		</Border>
	</DataTemplate>



	<DataTemplate
		x:Key="CharacterAppearance"
		DataType="{x:Type appearance:ICharacterAppearance}">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button
					Grid.Column="0"
					Command="{Binding RevertCommand}">
					<Button.Content>
						<wpfUtils:IconBlock Icon="Undo" />
					</Button.Content>
				</Button>

				<Button
					Grid.Column="1"
					Command="{Binding ApplyCommand}">
					<Button.Content>
						<TextBlock>
							<Run Text="Apply to " />
							<Run Text="{Binding Source={ex:Services}, Path=Target.CharacterName, Mode=OneWay}" />
						</TextBlock>
					</Button.Content>
				</Button>
			</Grid>
		</Border>
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type files:PoseFile}">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button
					Grid.Column="0"
					Command="{Binding RevertCommand}">
					<Button.Content>
						<wpfUtils:IconBlock Icon="Undo" />
					</Button.Content>
				</Button>

				<Button
					Grid.Column="1"
					Command="{Binding ApplyCommand}">
					<Button.Content>
						<TextBlock>
							<Run Text="Apply to " />
							<Run Text="{Binding Source={ex:Services}, Path=Target.CharacterName, Mode=OneWay}" />
						</TextBlock>
					</Button.Content>
				</Button>
			</Grid>
		</Border>
	</DataTemplate>



	<DataTemplate DataType="{x:Type files:SceneFile}">
		<StackPanel>

			<TextBlock Style="{DynamicResource LeftLabel}">
				<Run Text="Quick apply to " />
				<Run Text="{Binding Source={ex:Services}, Path=Target.CharacterName, Mode=OneWay}" />
			</TextBlock>

			<ItemsControl
				Margin="0,2"
				ItemsSource="{Binding Actors}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Style="{DynamicResource WpfUtilsControlBorder}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Button Command="{Binding ApplyCommand}">
									<TextBlock
										Grid.Column="0"
										Margin="6,2"
										VerticalAlignment="Center"
										Style="{DynamicResource LeftLabel}"
										Text="{Binding Role}" />
								</Button>


								<Button
									Grid.Column="1"
									Width="28"
									Background="Transparent"
									Command="{Binding ApplyAppearanceCommand}"
									IsEnabled="{Binding ApplyAppearanceCommand, Converter={StaticResource NotNullToBoolConverter}}">
									<wpfUtils:IconBlock Icon="UserShield" />
								</Button>

								<Button
									Grid.Column="2"
									Width="28"
									Background="Transparent"
									Command="{Binding ApplyPoseCommand}"
									IsEnabled="{Binding ApplyPoseCommand, Converter={StaticResource NotNullToBoolConverter}}">
									<wpfUtils:IconBlock Icon="Running" />
								</Button>

							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Border Style="{DynamicResource WpfUtilsControlBorder}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<Button
						Grid.Column="0"
						Command="{Binding RevertCommand}">
						<Button.Content>
							<wpfUtils:IconBlock Icon="Undo" />
						</Button.Content>
					</Button>

					<Button
						Grid.Column="1"
						Command="{Binding ApplyCommand}">
						<Button.Content>
							<TextBlock>
								<Run Text="Open..." />
							</TextBlock>
						</Button.Content>
					</Button>
				</Grid>
			</Border>
		</StackPanel>
	</DataTemplate>



	<DataTemplate DataType="{x:Type sources:FileEntry}">
		<ContentPresenter Content="{Binding File}" />
	</DataTemplate>

</ResourceDictionary>