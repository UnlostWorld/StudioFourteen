<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:ex="clr-namespace:StudioFourteen.MarkupExtensions"
	xmlns:excel="clr-namespace:Lumina.Excel.Sheets"
	xmlns:files="clr-namespace:StudioFourteen.Files"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:WpfUtils.Markup;assembly=WpfUtils"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:ss="clr-namespace:StudioFourteen"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />

	<DataTemplate
		x:Key="LibraryActions_CharacterAppearance"
		DataType="{x:Type appearance:ICharacterAppearance}">
		<StackPanel>

			<Button Command="{Binding SpawnCommand}">
				<TextBlock Text="Create new character" />
			</Button>

			<Border
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<Button
						Grid.Column="0"
						Background="Transparent"
						Command="{Binding RevertCommand}">
						<Button.Content>
							<wpfUtils:IconBlock Icon="Undo" />
						</Button.Content>
					</Button>

					<Button
						Grid.Column="1"
						Background="Transparent"
						Command="{Binding ApplyCommand}">
						<Button.Content>
							<TextBlock>
								<Run Text="Apply to " />
								<Run Text="{Binding ApplyCommand.TargetName, Mode=OneWay}" />
							</TextBlock>
						</Button.Content>
					</Button>
				</Grid>
			</Border>
		</StackPanel>
	</DataTemplate>



	<DataTemplate
		x:Key="LibraryActions_PoseFile"
		DataType="{x:Type files:PoseFile}">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button
					Grid.Column="0"
					Command="{Binding RevertCommand}">
					<Button.Content>
						<wpfUtils:IconBlock Icon="Undo" />
					</Button.Content>
				</Button>

				<Button
					Grid.Column="1"
					Command="{Binding ApplyCommand}">
					<Button.Content>
						<TextBlock>
							<Run Text="Apply to " />
							<Run Text="{Binding Source={ex:Services}, Path=Target.CharacterName, Mode=OneWay}" />
						</TextBlock>
					</Button.Content>
				</Button>
			</Grid>
		</Border>
	</DataTemplate>



	<DataTemplate
		x:Key="LibraryActions_SceneFile"
		DataType="{x:Type files:SceneFile}">
		<StackPanel>

			<TextBlock Style="{DynamicResource LeftLabel}">
				<Run Text="Quick apply to " />
				<Run Text="{Binding Source={ex:Services}, Path=Target.CharacterName, Mode=OneWay}" />
			</TextBlock>

			<ItemsControl
				Margin="0,2"
				ItemsSource="{Binding Actors}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Style="{DynamicResource WpfUtilsControlBorder}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<Button Command="{Binding ApplyCommand}">
									<TextBlock
										Grid.Column="0"
										Margin="6,2"
										VerticalAlignment="Center"
										Style="{DynamicResource LeftLabel}"
										Text="{Binding Role}" />
								</Button>


								<Button
									Grid.Column="1"
									Width="28"
									Background="Transparent"
									Command="{Binding ApplyAppearanceCommand}"
									IsEnabled="{Binding ApplyAppearanceCommand, Converter={StaticResource NotNullToBoolConverter}}">
									<wpfUtils:IconBlock Icon="UserShield" />
								</Button>

								<Button
									Grid.Column="2"
									Width="28"
									Background="Transparent"
									Command="{Binding ApplyPoseCommand}"
									IsEnabled="{Binding ApplyPoseCommand, Converter={StaticResource NotNullToBoolConverter}}">
									<wpfUtils:IconBlock Icon="Running" />
								</Button>

							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Border Style="{DynamicResource WpfUtilsControlBorder}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<Button
						Grid.Column="0"
						Command="{Binding RevertCommand}">
						<Button.Content>
							<wpfUtils:IconBlock Icon="Undo" />
						</Button.Content>
					</Button>

					<Button
						Grid.Column="1"
						Command="{Binding ApplyCommand}">
						<Button.Content>
							<TextBlock>
								<Run Text="Open..." />
							</TextBlock>
						</Button.Content>
					</Button>
				</Grid>
			</Border>
		</StackPanel>
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryActions_FileEntry"
		DataType="{x:Type sources:FileEntry}">
		<ContentPresenter
			Content="{Binding File}"
			Style="{DynamicResource LibraryActions}" />
	</DataTemplate>

	<DataTemplate
		x:Key="LibraryActions_DirectoryEntry"
		DataType="{x:Type sources:DirectoryEntry}" />


	<markup:TemplateSelector x:Key="LibraryActionsTemplateSelector">

		<!--<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:ENpcResident}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:BattleNpc}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:EventNpc}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />-->

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:PoseFile}"
			Template="{StaticResource LibraryActions_PoseFile}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:SceneFile}"
			Template="{StaticResource LibraryActions_SceneFile}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:AppearanceFile}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileEntry}"
			Template="{StaticResource LibraryActions_FileEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:DirectoryEntry}"
			Template="{StaticResource LibraryActions_DirectoryEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:GlamourerEntry}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type files:MareFile}"
			Template="{StaticResource LibraryActions_CharacterAppearance}" />

	</markup:TemplateSelector>

	<Style
		x:Key="LibraryActions"
		TargetType="{x:Type ContentPresenter}">
		<Setter Property="ContentTemplateSelector" Value="{StaticResource LibraryActionsTemplateSelector}" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
	</Style>

</ResourceDictionary>