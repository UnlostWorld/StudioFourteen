<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:excel="clr-namespace:StudioFourteen.GameData.Excel"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

	<DataTemplate DataType="{x:Type library:LibraryEntryBase}" />
	<DataTemplate DataType="{x:Type excel:LibraryExcelRow}" />



	<DataTemplate x:Key="CharacterAppearance">
		<Grid />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<ContentPresenter
			Content="{Binding .}"
			ContentTemplate="{StaticResource CharacterAppearance}" />
	</DataTemplate>



	<DataTemplate DataType="{x:Type excel:Item}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding ClassJobs.Name}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}">
					<Run Text="Lv." />
					<Run Text="{Binding EquipLevel, Mode=OneWay}" />
				</TextBlock>

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding UICategory.Name}" />
			</StackPanel>
		</Grid>
	</DataTemplate>



	<DataTemplate DataType="{x:Type sources:FileEntry}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<StackPanel
				Grid.Row="0"
				Margin="3,0,3,6">
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Author}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Visibility="{Binding Version, Converter={StaticResource NotNullToVisibilityConverter}}">
					<Run Text="Ver: " />
					<Run Text="{Binding Version, Mode=OneWay}" />
				</TextBlock>
			</StackPanel>

			<Grid
				Grid.Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Top">

				<Border
					Name="Mask"
					Margin="1"
					Background="Black"
					CornerRadius="4" />

				<Image Source="{Binding Image}">
					<Image.OpacityMask>
						<VisualBrush Visual="{Binding ElementName=Mask}" />
					</Image.OpacityMask>
				</Image>
			</Grid>
		</Grid>
	</DataTemplate>

</ResourceDictionary>