<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:WpfUtils.Markup;assembly=WpfUtils"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	<converters:GreaterThanToVisibilityConverter x:Key="GreaterThanToVisibility" />

	<DataTemplate x:Key="LibrarySidebar_CharacterAppearance">
		<Grid />
	</DataTemplate>


	<DataTemplate
		x:Key="LibrarySidebar_Item"
		DataType="{x:Type gameData:ItemLibraryEntry}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Description, Converter={StaticResource NotNullToVisibilityConverter}}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding ClassJobsName}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Visibility="{Binding EquipLevel, Converter={StaticResource GreaterThanToVisibility}, ConverterParameter=1}">
					<Run Text="Lv." />
					<Run Text="{Binding EquipLevel, Mode=OneWay}" />
				</TextBlock>

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding UICategoryName}" />

			</StackPanel>
		</Grid>
	</DataTemplate>



	<DataTemplate
		x:Key="LibrarySidebar_FileEntry"
		DataType="{x:Type sources:FileEntry}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<StackPanel
				Grid.Row="0"
				Margin="3,0,3,6">
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Author}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Visibility="{Binding Version, Converter={StaticResource NotNullToVisibilityConverter}}">
					<Run Text="Ver: " />
					<Run Text="{Binding Version, Mode=OneWay}" />
				</TextBlock>
			</StackPanel>

			<Grid
				Grid.Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Top">

				<Border
					Name="Mask"
					Margin="1"
					Background="Black"
					CornerRadius="4" />

				<Image Source="{Binding Image}">
					<Image.OpacityMask>
						<VisualBrush Visual="{Binding ElementName=Mask}" />
					</Image.OpacityMask>
				</Image>
			</Grid>
		</Grid>
	</DataTemplate>

	<DataTemplate
		x:Key="LibrarySidebar_Territory"
		DataType="{x:Type gameData:TerritoryTypeLibraryEntry}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Zone}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Region}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Place}" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<markup:TemplateSelector x:Key="LibrarySidebarTemplateSelector">

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:ENpcResidentLibraryEntry}"
			Template="{StaticResource LibrarySidebar_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:BNpcBaseLibraryEntry}"
			Template="{StaticResource LibrarySidebar_CharacterAppearance}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:ItemLibraryEntry}"
			Template="{StaticResource LibrarySidebar_Item}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:TerritoryTypeLibraryEntry}"
			Template="{StaticResource LibrarySidebar_Territory}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileEntry}"
			Template="{StaticResource LibrarySidebar_FileEntry}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type sources:FileEntry}"
			Template="{StaticResource LibrarySidebar_FileEntry}" />

	</markup:TemplateSelector>

	<Style
		x:Key="LibrarySidebar"
		TargetType="{x:Type ContentPresenter}">
		<Setter Property="ContentTemplateSelector" Value="{StaticResource LibrarySidebarTemplateSelector}" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

</ResourceDictionary>