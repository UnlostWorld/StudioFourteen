<ResourceDictionary
	x:Class="StudioFourteen.Library.Selector.LibrarySelectorStyles"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:selector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:wpfUtils="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Controls/PopOutStyles.xaml" />
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles/TextBlockStyles.xaml" />
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles/ListBoxStyles.xaml" />
		<ResourceDictionary Source="../LibraryMenu/LibraryContextMenuStyles.xaml" />
		<ResourceDictionary Source="../LibraryIconTemplates.xaml" />
		<ResourceDictionary Source="../LibraryBodyTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<DataTemplate
		x:Key="LibrarySelectorResultTemplate"
		DataType="{x:Type results:Result}">
		<Grid
			x:Name="Content"
			Grid.Column="1"
			Margin="-2"
			Background="Transparent"
			PreviewMouseRightButtonDown="OnResultPreviewMouseRightButtonDown"
			PreviewMouseRightButtonUp="OnResultPreviewMouseRightButtonUp"
			Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}}"
			ToolTip="!"
			ToolTipOpening="OnResultToolTipOpening">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<ContentPresenter
				Width="38"
				Height="38"
				Margin="3"
				VerticalAlignment="Center"
				Content="{Binding Entry}"
				Style="{StaticResource LibraryIcon}"
				TextBlock.Foreground="{DynamicResource ForegroundBrush}" />

			<Grid
				Grid.Column="1"
				VerticalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					VerticalAlignment="Center"
					Text="{Binding Entry.Name}"
					Visibility="{Binding Entry.Name, Converter={StaticResource StringHasContentToVisibility}}" />

				<TextBlock
					Grid.Row="1"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Entry.SubTitle}"
					Visibility="{Binding Entry.SubTitle, Converter={StaticResource StringHasContentToVisibility}}" />
			</Grid>

			<Grid
				Margin="0,5,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
				<wpfUtils:IconBlock
					Margin="-2,2,2,-2"
					FontSize="18"
					Foreground="{DynamicResource BackgroundBrush}"
					Icon="Heart"
					IconFont="Solid" />
				<wpfUtils:IconBlock
					FontSize="18"
					Foreground="{DynamicResource TrimBrush}"
					Icon="Heart"
					IconFont="Solid" />

			</Grid>

		</Grid>
	</DataTemplate>

	<ControlTemplate
		x:Key="LibrarySelectorTemplate"
		TargetType="{x:Type ContentControl}">

		<Grid Margin="12">
			<Grid>
				<Grid.Effect>
					<DropShadowEffect
						Direction="270"
						ShadowDepth="0" />
				</Grid.Effect>

				<Border
					Background="{TemplateBinding Background}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<Polygon
					Margin="-11"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Fill="{DynamicResource BackgroundBrush}"
					Points="0,12 16,0, 32,12" />
			</Grid>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<ContentPresenter
						Grid.RowSpan="3"
						Grid.ColumnSpan="3"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=BackgroundDetail}" />

					<Button
						x:Name="PART_CloseButton"
						Grid.Row="0"
						Grid.Column="2"
						Width="32"
						Height="32"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Background="Transparent">
						<wpfUtils:IconBlock
							Foreground="{DynamicResource ForegroundLightBrush}"
							Icon="Times" />
					</Button>

					<ContentPresenter
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Margin="{TemplateBinding Padding}"
						Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:PopOut}}, Path=Header}"
						ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:PopOut}}, Path=HeaderTemplate}">
						<ContentPresenter.Resources>
							<Style
								BasedOn="{StaticResource WpfUtilsTextBlock}"
								TargetType="{x:Type TextBlock}">
								<Setter Property="TextWrapping" Value="Wrap" />
								<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
							</Style>
						</ContentPresenter.Resources>
					</ContentPresenter>

					<tags:TagSelector
						Grid.Row="1"
						Grid.ColumnSpan="3"
						Margin="3,1"
						SelectedTags="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Tags}"
						Tags="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=AvailableTags}" />

					<controls:SwitchSelector
						Grid.Row="2"
						Grid.Column="0"
						Width="64"
						Height="28"
						Margin="3,0,1,1">
						<ListBoxItem
							IsSelected="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Favorites, Converter={StaticResource !B}}"
							Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
							ToolTip="{DynamicResource LOC_LibrarySelector_All}">
							<wpfUtils:IconBlock
								Icon="FileAlt"
								IconFont="Solid" />
						</ListBoxItem>
						<ListBoxItem
							IsSelected="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Favorites}"
							Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
							ToolTip="{DynamicResource LOC_LibrarySelector_Favorites}">
							<wpfUtils:IconBlock
								Icon="Heart"
								IconFont="Solid" />
						</ListBoxItem>
					</controls:SwitchSelector>

					<TextBox
						x:Name="PART_SearchBox"
						Grid.Row="2"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Height="28"
						Margin="1,1,3,2"
						Padding="28,0,0,0"
						Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Search, UpdateSourceTrigger=PropertyChanged}" />

					<wpfUtils:IconBlock
						Grid.Row="2"
						Grid.Column="1"
						Margin="10,2,0,2"
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="Search" />

				</Grid>


				<ListBox
					x:Name="PART_ResultsBox"
					Grid.Row="1"
					Margin="3,3,3,0"
					ItemTemplate="{DynamicResource LibrarySelectorResultTemplate}"
					ScrollViewer.VerticalScrollBarVisibility="Visible" />

				<ContentPresenter
					Grid.Row="2"
					Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Footer}"
					ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=FooterTemplate}" />
			</Grid>

			<menu:LibraryContextMenu
				x:Name="PART_ContextMenu"
				Style="{DynamicResource LibraryContextMenuStyle}" />

		</Grid>
	</ControlTemplate>


	<Style
		x:Key="LibrarySelector"
		BasedOn="{StaticResource WpfUtilsPopOut}"
		TargetType="{x:Type selector:LibrarySelector}">
		<Setter Property="Template" Value="{DynamicResource LibrarySelectorTemplate}" />
		<Setter Property="Width" Value="300" />
		<Setter Property="Height" Value="500" />
		<Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
	</Style>

	<Style
		BasedOn="{StaticResource LibrarySelector}"
		TargetType="{x:Type selector:LibrarySelector}" />

</ResourceDictionary>