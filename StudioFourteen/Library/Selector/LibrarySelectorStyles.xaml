<ResourceDictionary
	x:Class="StudioFourteen.Library.Selector.LibrarySelectorStyles"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:StudioFourteen.Converters"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:selector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:tags="clr-namespace:StudioFourteen.Tags">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="pack://application:,,,/StudioFourteen;component/Controls/PopOutStyles.xaml" />
		<ResourceDictionary
			Source="pack://application:,,,/StudioFourteen;component/Styles/TextBlockStyles.xaml" />
		<ResourceDictionary
			Source="pack://application:,,,/StudioFourteen;component/Styles/ListBoxStyles.xaml" />
		<ResourceDictionary Source="../LibraryMenu/LibraryContextMenuStyles.xaml" />
		<ResourceDictionary Source="../LibraryBodyTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
	<converters:BoolInversionConverter x:Key="!B" />

	<DataTemplate x:Key="LibrarySelectorResultTemplate" DataType="{x:Type results:Result}">
		<Grid
			x:Name="Content"
			Grid.Column="1"
			Margin="-2"
			Background="Transparent"
			PreviewMouseRightButtonDown="OnResultPreviewMouseRightButtonDown"
			PreviewMouseRightButtonUp="OnResultPreviewMouseRightButtonUp"
			Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}}"
			ToolTip="!"
			ToolTipOpening="OnResultToolTipOpening">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<ContentPresenter
				Width="38"
				Height="38"
				Margin="3"
				VerticalAlignment="Center"
				Content="{Binding Entry.Icon}"
				TextBlock.Foreground="{DynamicResource ForegroundBrush}" />

			<Grid Grid.Column="1" VerticalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					VerticalAlignment="Center"
					Text="{Binding Entry.Name}"
					Visibility="{Binding Entry.Name, Converter={StaticResource StringHasContentToVisibility}}" />

				<TextBlock
					Grid.Row="1"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Entry.SubTitle}"
					Visibility="{Binding Entry.SubTitle, Converter={StaticResource StringHasContentToVisibility}}" />
			</Grid>

			<Grid
				Margin="0,5,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
				<icons:IconView
					Height="18"
					Margin="-2,2,2,-2"
					Foreground="{DynamicResource BackgroundBrush}"
					Icon="{DynamicResource ICON_FavoriteOn}" />
				<icons:IconView
					Height="18"
					Foreground="{DynamicResource TrimBrush}"
					Icon="{DynamicResource ICON_FavoriteOn}" />

			</Grid>

		</Grid>
	</DataTemplate>

	<ControlTemplate x:Key="LibrarySelectorTemplate" TargetType="{x:Type ContentControl}">

		<Grid Margin="12">
			<Grid>
				<Grid.Effect>
					<DropShadowEffect Direction="270" ShadowDepth="0" />
				</Grid.Effect>

				<Border
					Background="{TemplateBinding Background}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<Polygon
					Margin="-11"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Fill="{DynamicResource BackgroundBrush}"
					Points="0,12 16,0, 32,12" />
			</Grid>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<ContentPresenter
						Grid.RowSpan="3"
						Grid.ColumnSpan="3"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=BackgroundDetail}" />

					<Button
						x:Name="PART_CloseButton"
						Grid.Row="0"
						Grid.Column="2"
						Width="24"
						Height="24"
						Padding="6"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Background="Transparent"
						Content="{DynamicResource ICON_Close}"/>

					<ContentPresenter
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Margin="{TemplateBinding Padding}"
						Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:PopOut}}, Path=Header}"
						ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:PopOut}}, Path=HeaderTemplate}">
						<ContentPresenter.Resources>
							<Style BasedOn="{StaticResource WpfUtilsTextBlock}" TargetType="{x:Type TextBlock}">
								<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
								<Setter Property="TextWrapping" Value="Wrap" />
							</Style>
						</ContentPresenter.Resources>
					</ContentPresenter>

					<tags:TagSelector
						Grid.Row="1"
						Grid.ColumnSpan="3"
						Margin="3,1"
						SelectedTags="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=CurrentTags}"
						Tags="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=AvailableTags}" />

					<TextBox
						x:Name="PART_SearchBox"
						Grid.Row="2"
						Grid.ColumnSpan="3"
						Height="28"
						Margin="1,1,3,2"
						Padding="28,0,0,0"
						Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Search, UpdateSourceTrigger=PropertyChanged}" />

					<icons:IconView
						Grid.Row="2"
						Grid.Column="1"
						Margin="10,2,0,2"
						Width="14"
						Height="14"
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{DynamicResource ICON_Search}" />

				</Grid>


				<ListBox
					x:Name="PART_ResultsBox"
					Grid.Row="1"
					Margin="3,3,3,0"
					ItemTemplate="{DynamicResource LibrarySelectorResultTemplate}"
					ScrollViewer.VerticalScrollBarVisibility="Visible" />

				<ContentPresenter
					Grid.Row="2"
					Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=Footer}"
					ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type selector:LibrarySelector}}, Path=FooterTemplate}" />
			</Grid>

			<menu:LibraryContextMenu x:Name="PART_ContextMenu" Style="{DynamicResource LibraryContextMenuStyle}" />

		</Grid>
	</ControlTemplate>


	<Style
		x:Key="LibrarySelector"
		BasedOn="{StaticResource WpfUtilsPopOut}"
		TargetType="{x:Type selector:LibrarySelector}">
		<Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
		<Setter Property="Height" Value="500" />
		<Setter Property="Template" Value="{DynamicResource LibrarySelectorTemplate}" />
		<Setter Property="Width" Value="300" />
	</Style>

	<Style BasedOn="{StaticResource LibrarySelector}" TargetType="{x:Type selector:LibrarySelector}" />

</ResourceDictionary>
