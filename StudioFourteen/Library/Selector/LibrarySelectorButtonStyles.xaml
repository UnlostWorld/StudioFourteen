<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />
	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

	<ControlTemplate x:Key="LibrarySelectorButtonTemplate" TargetType="{x:Type librarySelector:LibrarySelectorButton}">
		<Grid>
			<ToggleButton
				x:Name="PART_Button"
				Height="Auto"
				HorizontalContentAlignment="Stretch"
				Background="{TemplateBinding Background}"
				Style="{DynamicResource WpfUtilsIconToggleButton}"
				ToolTip="!">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<Grid Grid.RowSpan="2" Margin="3,3,3,2">

						<ContentPresenter Content="{TemplateBinding IconBackground}" Visibility="{TemplateBinding IconBackground, Converter={StaticResource NotNullToVisibilityConverter}}" />

						<ContentPresenter Content="{TemplateBinding Value}" Style="{DynamicResource LibraryIcon}" />
					</Grid>

					<Grid
						Grid.Column="1"
						VerticalAlignment="Center"
						DataContext="{TemplateBinding Value}">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Grid.Row="0"
							VerticalAlignment="Center"
							Text="{Binding Name}"
							TextTrimming="CharacterEllipsis"
							Visibility="{Binding Name, Converter={StaticResource StringHasContentToVisibility}}" />

						<TextBlock
							Grid.Row="1"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding SubTitle}"
							TextTrimming="CharacterEllipsis"
							Visibility="{Binding SubTitle, Converter={StaticResource StringHasContentToVisibility}}" />
					</Grid>
				</Grid>
			</ToggleButton>

			<menu:LibraryContextMenu
				x:Name="PART_Menu"
				BackgroundDetail="{TemplateBinding PopOutBackgroundDetail}"
				CollectingMenus="{TemplateBinding CollectingMenus}"
				SourceHeader="{TemplateBinding ToolTipHeader}"
				SourceHeaderTemplate="{TemplateBinding ToolTipHeaderTemplate}"
				Style="{DynamicResource LibraryContextMenuStyle}" />

			<librarySelector:LibrarySelector
				x:Name="PART_Selector"
				BackgroundDetail="{TemplateBinding PopOutBackgroundDetail}"
				Footer="{TemplateBinding PopOutFooter}"
				FooterTemplate="{TemplateBinding PopOutFooterTemplate}"
				Header="{TemplateBinding PopOutHeader}"
				HeaderTemplate="{TemplateBinding PopOutHeaderTemplate}"
				IsOpen="{Binding ElementName=PART_Button, Path=IsChecked}"
				PlacementTarget="{Binding ElementName=PART_Button}"
				SelectedItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type librarySelector:LibrarySelectorButton}}, Path=Value}"
				StaysOpen="True"
				Style="{DynamicResource LibrarySelector}"
				Tags="{TemplateBinding SearchTags}"
				Type="{TemplateBinding Type}" />

		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type librarySelector:LibrarySelectorButton}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="Height" Value="48" />
		<Setter Property="Template" Value="{StaticResource LibrarySelectorButtonTemplate}" />
	</Style>

	<ControlTemplate x:Key="LibrarySelectorButtonIconOnlyTemplate" TargetType="{x:Type librarySelector:LibrarySelectorButton}">
		<Grid>

			<ToggleButton
				x:Name="PART_Button"
				Height="Auto"
				HorizontalContentAlignment="Stretch"
				Background="{TemplateBinding Background}"
				Style="{DynamicResource WpfUtilsIconToggleButton}"
				ToolTip="!">

				<Grid Margin="3">
					<ContentPresenter Content="{TemplateBinding IconBackground}" Visibility="{TemplateBinding IconBackground, Converter={StaticResource NotNullToVisibilityConverter}}" />
					<ContentPresenter
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Content="{TemplateBinding Value}"
						Style="{DynamicResource LibraryIcon}" />
				</Grid>
			</ToggleButton>

			<menu:LibraryContextMenu
				x:Name="PART_Menu"
				BackgroundDetail="{TemplateBinding PopOutBackgroundDetail}"
				CollectingMenus="{TemplateBinding CollectingMenus}"
				SourceHeader="{TemplateBinding ToolTipHeader}"
				SourceHeaderTemplate="{TemplateBinding ToolTipHeaderTemplate}"
				Style="{DynamicResource LibraryContextMenuStyle}" />

			<librarySelector:LibrarySelector
				x:Name="PART_Selector"
				BackgroundDetail="{TemplateBinding PopOutBackgroundDetail}"
				Footer="{TemplateBinding PopOutFooter}"
				FooterTemplate="{TemplateBinding PopOutFooterTemplate}"
				Header="{TemplateBinding PopOutHeader}"
				HeaderTemplate="{TemplateBinding PopOutHeaderTemplate}"
				IsOpen="{Binding ElementName=PART_Button, Path=IsChecked}"
				PlacementTarget="{Binding ElementName=PART_Button}"
				SelectedItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type librarySelector:LibrarySelectorButton}}, Path=Value}"
				StaysOpen="True"
				Style="{DynamicResource LibrarySelector}"
				Tags="{TemplateBinding SearchTags}"
				Type="{TemplateBinding Type}" />
		</Grid>
	</ControlTemplate>

	<Style x:Key="LibrarySelectorIconOnly" TargetType="{x:Type librarySelector:LibrarySelectorButton}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="Height" Value="48" />
		<Setter Property="Template" Value="{StaticResource LibrarySelectorButtonIconOnlyTemplate}" />
		<Setter Property="Width" Value="48" />
	</Style>

</ResourceDictionary>
