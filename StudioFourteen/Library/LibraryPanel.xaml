<panels:Panel
	x:Class="StudioFourteen.Library.LibraryPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="clr-namespace:StudioFourteen.Behaviors"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:input="clr-namespace:StudioFourteen.Input"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:structs="clr-namespace:StudioFourteen.Structs"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	Width="800"
	Height="600"
	MinWidth="280"
	MinHeight="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CurrentTab.Name}"
	mc:Ignorable="d">

	<Grid>
		<Grid x:Name="ContentArea">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<!--  Toolbar  -->
			<Grid Grid.Row="0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal">

					<Border Margin="1" Style="{DynamicResource ControlBorder}">
						<StackPanel Orientation="Horizontal">
							<Button
								Width="28"
								Height="Auto"
								Background="Transparent"
								Click="OnBackClicked"
								IsEnabled="{Binding CurrentGroup.Parent, Converter={StaticResource NotNullToBoolConverter}}"
								ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
								<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_Back}" />
							</Button>

							<Button
								Width="28"
								Height="Auto"
								Background="Transparent"
								Click="OnBackClicked"
								IsEnabled="False"
								ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
								<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_Forward}" />
							</Button>
						</StackPanel>

					</Border>

					<Border Margin="1" Style="{DynamicResource ControlBorder}">
						<Button
							Width="28"
							Height="Auto"
							Background="Transparent"
							Click="OnUpClicked"
							IsEnabled="{Binding CurrentGroup.Parent, Converter={StaticResource NotNullToBoolConverter}}"
							ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
							<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_Up}" />
						</Button>
					</Border>


					<StackPanel.Style>
						<Style TargetType="{x:Type StackPanel}">

							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>

				</StackPanel>

				<Border Margin="1">
					<Border.Style>
						<Style BasedOn="{StaticResource ControlBorder}" TargetType="{x:Type Border}">

							<Setter Property="Grid.Column" Value="1" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.Column" Value="0" />
									<Setter Property="Grid.ColumnSpan" Value="5" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>

					<ItemsControl
						Margin="1"
						Focusable="False"
						ItemsSource="{Binding Path}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									Margin="2,0"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid>
									<StackPanel Orientation="Horizontal">
										<Button
											Margin="-2,0"
											Padding="4,0,6,0"
											Background="Transparent"
											Click="OnDirectorySelected">

											<StackPanel Orientation="Horizontal">
												<ContentPresenter
													x:Name="Icon"
													MaxWidth="22"
													Margin="4,6"
													Content="{Binding Icon}" />

												<TextBlock
													x:Name="Name"
													Margin="0,2"
													VerticalAlignment="Center"
													Text="{Binding Name}" />
											</StackPanel>
										</Button>

										<ToggleButton
											x:Name="SubDirButton"
											Margin="0"
											Padding="6,0"
											Background="Transparent"
											Style="{DynamicResource IconToggleButton}"
											Visibility="{Binding HasSubGroups, Converter={StaticResource B2V}}">
											<Path
												Grid.Column="1"
												Margin="0,2"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Data="M 0,0 5,3 0,6"
												Stroke="{Binding ElementName=SubDirButton, Path=Foreground}"
												StrokeThickness="1" />
										</ToggleButton>
									</StackPanel>

									<s14:PopOut
										MinWidth="150"
										MaxHeight="400"
										Padding="0"
										Background="{DynamicResource ControlBackgroundBrush}"
										IsOpen="{Binding ElementName=SubDirButton, Path=IsChecked}"
										PlacementTarget="{Binding ElementName=SubDirButton}"
										StaysOpen="False"
										Style="{DynamicResource PopOut}">

										<s14:PopOut.Header>
											<TextBlock Margin="10" Foreground="{DynamicResource ForegroundLightBrush}">
												<Run Text="{Binding Name, Mode=OneTime}" />
												<Run Text="/" />
											</TextBlock>
										</s14:PopOut.Header>

										<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled">
											<ItemsControl ItemsSource="{Binding GroupEntries}">
												<ItemsControl.ItemTemplate>
													<DataTemplate DataType="{x:Type local:GroupEntryBase}">
														<Button
															HorizontalContentAlignment="Left"
															Background="Transparent"
															Click="OnDirectorySwapClicked">
															<TextBlock Margin="6,4" Text="{Binding Name}" />
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</s14:PopOut>


								</Grid>

								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
										<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>
				</Border>


				<s14:SwitchSelector
					x:Name="ViewModeArea"
					Width="64"
					Height="28"
					Margin="1">
					<ListBoxItem
						IsSelected="{Binding ViewList, Converter={StaticResource !B}}"
						Style="{DynamicResource SwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_IconViewTooltip}">
						<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_ViewIcons}" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding ViewList}"
						Style="{DynamicResource SwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_ListViewTooltip}">
						<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_ViewList}" />
					</ListBoxItem>

					<s14:SwitchSelector.Style>
						<Style BasedOn="{StaticResource SwitchSelector}"
							TargetType="{x:Type s14:SwitchSelector}">

							<Setter Property="Grid.Column" Value="2" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.Column" Value="2" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</s14:SwitchSelector.Style>
				</s14:SwitchSelector>


				<s14:SwitchSelector
					x:Name="FlattenModeArea"
					Width="64"
					Height="28"
					Margin="1">
					<ListBoxItem
						IsSelected="{Binding Flatten, Converter={StaticResource !B}}"
						Style="{DynamicResource SwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_DirectoryViewTooltip}">
						<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_FlattenOff}" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding Flatten}"
						Style="{DynamicResource SwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_FlattenViewTooltip}">
						<icons:IconView Height="14" Icon="{DynamicResource ICON_Library_FlattenOn}" />
					</ListBoxItem>

					<s14:SwitchSelector.Style>
						<Style BasedOn="{StaticResource SwitchSelector}"
							TargetType="{x:Type s14:SwitchSelector}">

							<Setter Property="Grid.Column" Value="3" />

							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.Column" Value="3" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</s14:SwitchSelector.Style>
				</s14:SwitchSelector>

				<Button
					x:Name="BrowseArea"
					Height="28"
					Margin="1"
					Click="OnBrowseClicked">

					<Button.Style>
						<Style BasedOn="{StaticResource Button}" TargetType="{x:Type Button}">
							<Setter Property="Content">
								<Setter.Value>
									<StackPanel Orientation="Horizontal">
										<icons:IconView Height="14" Margin="0,0,3,0" Icon="{DynamicResource ICON_OpnFile}" />
										<TextBlock Text="{DynamicResource LOC_Library_OpenFile}" />
									</StackPanel>
								</Setter.Value>
							</Setter>

							<Setter Property="Grid.Column" Value="4" />

							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Content" Value="..." />
									<Setter Property="Grid.Column" Value="4" />
									<Setter Property="Grid.Row" Value="1" />
									<Setter Property="Width" Value="28" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</Grid>

			<!--  Filter Bar  -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="0.5*" MinWidth="75" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<tags:TagSelector
					Grid.Column="0"
					SelectedTags="{Binding TagFilter.Tags}"
					Tags="{Binding AvailableTags}">
					<tags:TagSelector.Style>
						<Style BasedOn="{StaticResource TagSelectorStyle}" TargetType="{x:Type tags:TagSelector}">

							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.ColumnSpan" Value="2" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</tags:TagSelector.Style>
				</tags:TagSelector>

				<Grid>
					<TextBox Padding="25,0,3,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

					<icons:IconView
						Height="14"
						Margin="8,0,0,0"
						HorizontalAlignment="Left"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="{DynamicResource ICON_Search}" />

					<Grid.Style>
						<Style TargetType="{x:Type Grid}">
							<Setter Property="Grid.Column" Value="2" />

							<Style.Triggers>
								<DataTrigger Binding="{Binding NarrowMode}" Value="True">
									<Setter Property="Grid.Column" Value="0" />
									<Setter Property="Grid.ColumnSpan" Value="3" />
									<Setter Property="Grid.Row" Value="2" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
				</Grid>
			</Grid>


			<Border
				Grid.Row="2"
				Margin="1"
				Style="{DynamicResource ControlBorder}">

				<Grid>

					<Grid.Resources>
						<ControlTemplate x:Key="ListTemplate" TargetType="{x:Type ListBox}">
							<ScrollViewer
								Padding="{TemplateBinding Padding}"
								Background="{DynamicResource BackgroundBrush}"
								Focusable="false"
								Opacity="1"
								RenderTransformOrigin="0.5, 0.5">

								<ScrollViewer.RenderTransform>
									<TransformGroup>
										<ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" />
										<TranslateTransform x:Name="Translate" X="0" Y="0" />
									</TransformGroup>
								</ScrollViewer.RenderTransform>

								<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

								<!--<ScrollViewer.Triggers>
									<triggers:StoryboardEnumTrigger Binding="{Binding NavigationAnimation, Mode=TwoWay}" Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
										<triggers:StoryboardEnumTrigger.Storyboards>

											<Storyboard x:Name="OpenDir_Out">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1"
													To="1.05"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="1"
													To="0"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="OpenDir_In">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="0.95"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="0"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="Back_Out">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1"
													To="0.95"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="1"
													To="0"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="Back_In">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1.05"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="0"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</triggers:StoryboardEnumTrigger.Storyboards>

									</triggers:StoryboardEnumTrigger>

								</ScrollViewer.Triggers>-->
							</ScrollViewer>


						</ControlTemplate>
					</Grid.Resources>


					<!--  Icon Grid  -->
					<s14:ListBoxEx
						x:Name="ResultsGrid"
						Grid.Row="2"
						Margin="3"
						input:Navigation.Back="OnListBack"
						input:Navigation.Enter="OnListEnter"
						Background="Transparent"
						ClipToBounds="True"
						ItemsSource="{Binding Results, IsAsync=True}"
						SelectedItem="{Binding SelectedResult}"
						SelectionMode="Extended"
						Template="{StaticResource ListTemplate}"
						VirtualizingPanel.ScrollUnit="Pixel"
						VirtualizingPanel.VirtualizationMode="Recycling"
						Visibility="{Binding ViewList, Converter={StaticResource !B2V}}">

						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<s14:SmoothScrollingVirtualizingWrapPanel
									IsItemsHost="True"
									VirtualizingPanel.ScrollUnit="Item"
									VirtualizingPanel.VirtualizationMode="Recycling" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>

						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type results:Result}">

								<Grid
									Width="92"
									Height="128"
									Background="Transparent"
									MouseLeftButtonUp="OnResultMouseLeft"
									MouseRightButtonUp="OnResultMouseRight"
									MouseMove="OnResultMouseMove"
									ToolTip=""
									ToolTipClosing="OnResultToolTipClosing"
									ToolTipOpening="OnResultToolTipOpening">

									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="32" />
									</Grid.RowDefinitions>

									<ContentPresenter
										Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
										Margin="3"
										Content="{Binding Icon}" />

									<Grid
										Margin="0,5,5,0"
										HorizontalAlignment="Right"
										VerticalAlignment="Top"
										Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
										<icons:IconView
											Height="28"
											Margin="-2,2,2,-2"
											Foreground="{DynamicResource TrimBrush}"
											Icon="{DynamicResource ICON_FavoriteOn}" />
									</Grid>

									<TextBlock
										x:Name="NameBlock"
										Grid.Row="1"
										VerticalAlignment="Top"
										Text="{Binding Entry.Name}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</Grid>


								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding Entry.Name}" Value="{x:Null}">
										<Setter TargetName="NameBlock" Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
										<Setter TargetName="NameBlock" Property="Text" Value="{Binding EntryId}" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ListBox.ItemTemplate>

					</s14:ListBoxEx>

					<!--  List  -->
					<ListBox
						Grid.Row="2"
						Margin="6"
						Background="Transparent"
						ItemsSource="{Binding Results, IsAsync=True}"
						SelectedItem="{Binding SelectedResult}"
						Template="{StaticResource ListTemplate}"
						VirtualizingPanel.ScrollUnit="Pixel"
						VirtualizingPanel.VirtualizationMode="Recycling"
						Visibility="{Binding ViewList, Converter={StaticResource B2V}}">

						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type results:Result}">
								<Grid
									MouseLeftButtonUp="OnResultMouseLeft"
									MouseRightButtonUp="OnResultMouseRight"
									ToolTip="!"
									ToolTipOpening="OnResultToolTipOpening">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<ContentPresenter
										Grid.Column="0"
										Width="32"
										Height="32"
										Margin="3"
										Content="{Binding Entry}"
										Style="{DynamicResource LibraryIcon}" />

									<TextBlock
										Grid.Column="1"
										Margin="6,0,0,0"
										VerticalAlignment="Center"
										Text="{Binding Entry.Name}"
										TextTrimming="CharacterEllipsis" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>
		</Grid>

		<menu:LibraryContextMenu x:Name="LibraryContextMenu" Closed="OnContextMenuClosed" />

	</Grid>
</panels:Panel>
