<panels:Panel
	x:Class="StudioFourteen.Library.QuickSearch"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:WpfUtils.Behaviours;assembly=wpfUtils"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="450"
	Height="500"
	SizeToContent="Manual"
	mc:Ignorable="d">

	<Grid
		Height="500"
		HorizontalAlignment="Center">

		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="..\Studio\StudioButtonStyle.xaml" />
				</ResourceDictionary.MergedDictionaries>

				<BooleanToVisibilityConverter x:Key="B2V" />
				<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />


				<ControlTemplate
					x:Key="ListBoxItemTemplate"
					TargetType="{x:Type ListBoxItem}">

					<Border
						x:Name="Content"
						Margin="{TemplateBinding Margin}"
						Background="Transparent"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						ClipToBounds="{TemplateBinding ClipToBounds}"
						ToolTip="{TemplateBinding Content}">
						<Grid Background="Transparent">

							<Border
								x:Name="HoverBorder"
								Margin="1"
								Background="{DynamicResource BackgroundLightBrush}"
								BorderBrush="{DynamicResource BackgroundLightBrush}"
								BorderThickness="1"
								CornerRadius="3"
								Opacity="0" />

							<Border
								x:Name="SelectionBorder"
								Opacity="0"
								Style="{DynamicResource WpfUtilsSelectedBorder}" />

							<TextBlock
								Margin="12,3,6,3"
								Text="{Binding Entry.Name}" />


						</Grid>
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="HoverBorder"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.100" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>

							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="HoverBorder"
											Storyboard.TargetProperty="Opacity"
											From="1"
											To="0"
											Duration="0:0:0.250" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>

						<Trigger Property="IsSelected" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="SelectionBorder"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.100" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>

							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="SelectionBorder"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.250" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</ResourceDictionary>
		</Grid.Resources>

		<ContentPresenter
			x:Name="SearchBar"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Content="{Binding .}">

			<ContentPresenter.ContentTemplate>
				<DataTemplate DataType="{x:Type local:QuickSearch}">
					<Grid>
						<Border
							x:Name="InputBorder"
							Width="300"
							Margin="26,18,0,0"
							VerticalAlignment="Center"
							Background="{DynamicResource BackgroundBrush}"
							Style="{DynamicResource WpfUtilsControlBorder}">

							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition />
								</Grid.RowDefinitions>

								<tags:TagSelector
									x:Name="SearchBox"
									Grid.Row="0"
									Margin="34,2,2,2"
									AllTags="{Binding AvailableTags}"
									OnDone="OnSearchDone"
									Search="{Binding Search, Mode=TwoWay}"
									Tags="{Binding TagFilter.Tags}" />

								<Grid
									x:Name="ResultsArea"
									Grid.Row="1"
									Height="200">
									<ListBox
										Margin="3"
										behaviours:SelectionVisibleBehaviour.SelectionVisible="True"
										ItemsSource="{Binding Results}"
										KeyDown="OnResultsListKeyDown"
										MouseDoubleClick="ResultsListDoubleClicked"
										ScrollViewer.VerticalScrollBarVisibility="Visible"
										SelectedItem="{Binding SelectedResult}"
										VirtualizingPanel.VirtualizationMode="Recycling">
										<ListBox.ItemContainerStyle>
											<Style
												BasedOn="{StaticResource WpfUtilsListBoxItem}"
												TargetType="{x:Type ListBoxItem}">
												<Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}" />
											</Style>
										</ListBox.ItemContainerStyle>
									</ListBox>
								</Grid>

								<Grid
									x:Name="Selection"
									Grid.Row="2"
									Margin="3"
									Visibility="{Binding SelectedResult, Converter={StaticResource NotNullToVisibilityConverter}}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<ContentPresenter
										Grid.Row="0"
										Width="48"
										Height="48"
										Margin="3"
										VerticalAlignment="Center"
										Content="{Binding SelectedResult.Entry}"
										TextBlock.Foreground="{DynamicResource ForegroundBrush}">
										<ContentPresenter.Resources>
											<ResourceDictionary Source="./LibraryIconTemplates.xaml" />
										</ContentPresenter.Resources>
									</ContentPresenter>

									<ContentPresenter
										Grid.Row="0"
										Grid.Column="1"
										VerticalAlignment="Center"
										Content="{Binding SelectedResult.Entry}"
										TextBlock.Foreground="{DynamicResource ForegroundBrush}">
										<ContentPresenter.Resources>
											<ResourceDictionary Source="./LibraryInfoTemplates.xaml" />
										</ContentPresenter.Resources>
									</ContentPresenter>

									<ContentPresenter
										Grid.Row="2"
										Grid.ColumnSpan="2"
										Content="{Binding SelectedResult.Entry}"
										TextBlock.Foreground="{DynamicResource ForegroundBrush}">
										<ContentPresenter.Resources>
											<ResourceDictionary Source="./LibrarySidebarTemplates.xaml" />
										</ContentPresenter.Resources>
									</ContentPresenter>
								</Grid>
							</Grid>
						</Border>

						<Button
							Name="StudioButton"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							IsHitTestVisible="False"
							Style="{StaticResource StudioButton}" />
					</Grid>

					<DataTemplate.Triggers>
						<DataTrigger
							Binding="{Binding IsQuickSearchOpen}"
							Value="False">
							<Setter Property="Opacity" Value="0" />
							<Setter Property="IsEnabled" Value="False" />
							<Setter Property="IsHitTestVisible" Value="False" />
							<Setter TargetName="SearchBox" Property="IsEnabled" Value="False" />
						</DataTrigger>
						<DataTrigger
							Binding="{Binding IsQuickSearchOpen}"
							Value="True">

							<Setter Property="IsEnabled" Value="True" />
							<Setter Property="IsHitTestVisible" Value="True" />
							<Setter TargetName="SearchBox" Property="IsEnabled" Value="True" />

							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											From="0"
											To="1"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<DoubleAnimation
											Storyboard.TargetName="InputBorder"
											Storyboard.TargetProperty="Width"
											From="0"
											To="300"
											Duration="0:00:00.200">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											From="1"
											To="0"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseIn" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>

						<DataTrigger
							Binding="{Binding Results.Count}"
							Value="0">
							<Setter TargetName="ResultsArea" Property="Height" Value="0" />
						</DataTrigger>

						<DataTrigger
							Binding="{Binding Results.Count, Converter={StaticResource NotZeroToBool}}"
							Value="True">

							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="ResultsArea"
											Storyboard.TargetProperty="Height"
											To="200"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseIn" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="ResultsArea"
											Storyboard.TargetProperty="Height"
											To="0"
											Duration="0:00:00.250">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseIn" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>

					</DataTemplate.Triggers>

				</DataTemplate>
			</ContentPresenter.ContentTemplate>
		</ContentPresenter>
	</Grid>
</panels:Panel>
