<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Controls/PopOutStyles.xaml" />
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles/MenuStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:IsEmptyToVisibilityConverter x:Key="IsEmptyToVisibility" />
	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />

	<ControlTemplate x:Key="LibraryContextMenuTemplate" TargetType="{x:Type ContentControl}">

		<Grid Margin="12" VerticalAlignment="Top">

			<Grid>
				<Grid.Effect>
					<DropShadowEffect Direction="270" ShadowDepth="0" />
				</Grid.Effect>

				<Border
					Background="{TemplateBinding Background}"
					BorderBrush="{DynamicResource BackgroundBrush}"
					BorderThickness="1"
					CornerRadius="6" />

				<Polygon
					Margin="-11"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Fill="{DynamicResource BackgroundBrush}"
					Points="0,12 16,0, 32,12" />
			</Grid>

			<ContentPresenter
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Content="{Binding BackgroundDetail, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}" />

			<StackPanel>
				<ContentPresenter Content="{Binding SourceHeader, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}" ContentTemplate="{Binding SourceHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}" />

				<StackPanel
					Margin="6"
					DataContext="{Binding Entry, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}"
					Visibility="{Binding MultiSelectLabel, Converter={StaticResource IsEmptyToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}">

					<Grid
						x:Name="ResultMenuHeader"
						Grid.Row="0"
						Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<icons:IconView
							Grid.RowSpan="2"
							Width="48"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Height="48"
							Margin="-2,-1,0,0"
							Content="{Binding Icon}"/>

						<Grid Grid.Column="1" VerticalAlignment="Center">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								Margin="3,0,0,0"
								Foreground="{DynamicResource ForegroundBrush}"
								Text="{Binding Name}"
								TextWrapping="Wrap" />

							<TextBlock
								Grid.Row="1"
								Margin="3,0,0,0"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding SubTitle}"
								TextWrapping="Wrap" />
						</Grid>

					</Grid>

					<ScrollViewer
						x:Name="TagsArea"
						MaxHeight="28"
						Margin="1,0,0,4"
						HorizontalScrollBarVisibility="Disabled"
						IsEnabled="False"
						VerticalScrollBarVisibility="Disabled">

						<tags:TagsControl Tags="{Binding Tags}" />
					</ScrollViewer>

					<Border>
						<ContentPresenter Content="{Binding .}" Style="{DynamicResource LibrarySidebar}" />
					</Border>
				</StackPanel>

				<TextBlock
					Margin="6"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding MultiSelectLabel, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}" />

				<Border x:Name="MenuArea" Style="{DynamicResource WpfUtilsControlBorder}">

					<Border.LayoutTransform>
						<ScaleTransform x:Name="MenuAreaScale" ScaleY="0" />
					</Border.LayoutTransform>

					<StackPanel>
						<UniformGrid Rows="1">
							<ToggleButton
								x:Name="FavoritesToggle"
								Margin="0"
								Background="Transparent"
								IsChecked="{Binding Entry.IsFavorite, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}"
								Style="{DynamicResource WpfUtilsIconToggleButton}">

								<Grid>
									<controls:IconControl Icon="fa-Heart" Visibility="{Binding ElementName=FavoritesToggle, Path=IsChecked, Converter={StaticResource B2V}}" />
									<controls:IconControl Icon="fa-line-Heart" Visibility="{Binding ElementName=FavoritesToggle, Path=IsChecked, Converter={StaticResource !B2V}}" />
								</Grid>
							</ToggleButton>

							<Button
								Margin="0"
								Command="{Binding Icon.ExportCommand, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}"
								IsEnabled="{Binding Icon.CanExport, FallbackValue=False, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}"
								ToolTip="{DynamicResource LOC_Library_ExportIcon}">
								<wpfUtils:IconBlock Icon="FileImage" IconFont="Solid" />
							</Button>
						</UniformGrid>

						<Menu ItemsSource="{Binding Menus, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}">

							<Menu.ItemTemplate>
								<HierarchicalDataTemplate DataType="{x:Type menu:MenuEntry}" ItemsSource="{Binding Path=Children}" />
							</Menu.ItemTemplate>

							<Menu.ItemContainerStyle>
								<Style BasedOn="{StaticResource WpfUtilsMenuItem}" TargetType="{x:Type MenuItem}">
									<Setter Property="MenuItem.Command" Value="{Binding OnClicked}" />
									<Setter Property="MenuItem.Header" Value="{Binding Label}" />
									<Setter Property="MenuItem.Icon" Value="{Binding Icon}" />
									<Setter Property="MenuItem.IsEnabled" Value="{Binding IsEnabled}" />
									<Setter Property="MenuItem.ItemsSource" Value="{Binding Children}" />
								</Style>
							</Menu.ItemContainerStyle>
						</Menu>
					</StackPanel>
				</Border>
			</StackPanel>
		</Grid>

		<ControlTemplate.Triggers>
			<DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type menu:LibraryContextMenu}}}" Value="True">
				<Setter TargetName="TagsArea" Property="IsEnabled" Value="True" />

				<Setter TargetName="TagsArea" Property="VerticalScrollBarVisibility" Value="Auto" />

				<DataTrigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="MenuAreaScale"
								Storyboard.TargetProperty="ScaleY"
								From="0"
								To="1"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>

							<DoubleAnimation
								Storyboard.TargetName="TagsArea"
								Storyboard.TargetProperty="MaxHeight"
								To="128"
								Duration="0:00:00.150">
								<DoubleAnimation.EasingFunction>
									<SineEase EasingMode="EaseOut" />
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>

				<DataTrigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetName="MenuAreaScale"
								Storyboard.TargetProperty="ScaleY"
								To="0"
								Duration="0:00:00.050" />

							<DoubleAnimation
								Storyboard.TargetName="TagsArea"
								Storyboard.TargetProperty="MaxHeight"
								To="28"
								Duration="0:00:00.050" />

						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>
		</ControlTemplate.Triggers>

	</ControlTemplate>

	<Style
		x:Key="LibraryContextMenuStyle"
		BasedOn="{StaticResource WpfUtilsPopOut}"
		TargetType="{x:Type menu:LibraryContextMenu}">
		<Setter Property="Height" Value="600" />
		<Setter Property="Template" Value="{StaticResource LibraryContextMenuTemplate}" />
		<Setter Property="Width" Value="250" />
	</Style>

	<Style BasedOn="{StaticResource LibraryContextMenuStyle}" TargetType="{x:Type menu:LibraryContextMenu}" />


</ResourceDictionary>
