<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:excel="clr-namespace:StudioFourteen.GameData.Excel"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:services="clr-namespace:StudioFourteen.Services"
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="./LibraryIconTemplates.xaml" />
		<ResourceDictionary Source="./LibraryInfoTemplates.xaml" />
		<ResourceDictionary Source="./LibrarySidebarTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>


	<DataTemplate x:Key="LibraryTooltipTemplate">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Border
				Grid.Row="0"
				Margin="-6,-6,-6,0"
				Background="{DynamicResource BackgroundLightBrush}"
				CornerRadius="6,6,0,0" />

			<Grid Grid.Row="0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<ContentPresenter
					Width="48"
					Height="48"
					Margin="-3,-3,0,0"
					Content="{Binding .}"
					Style="{StaticResource LibraryIcon}" />

				<ContentPresenter
					Grid.Column="1"
					Margin="0,-6,6,0"
					Content="{Binding .}"
					Style="{StaticResource LibraryInfo}" />

			</Grid>


			<ContentPresenter
				Grid.Row="2"
				Margin="3"
				Content="{Binding .}"
				Style="{StaticResource LibrarySidebar}" />

		</Grid>
	</DataTemplate>


	<DataTemplate DataType="{x:Type excel:ResidentNpc}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:BattleNpc}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:EventNpc}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Item}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Stain}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Glasses}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Ornament}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Mount}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Territory}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Companion}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type excel:Weather}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type gameData:ExcelSheetLibrarySource}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type sources:FileSource}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type sources:GlamourerSource}">
		<ContentPresenter ContentTemplate="{StaticResource LibraryTooltipTemplate}" />
	</DataTemplate>

</ResourceDictionary>