<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<ControlTemplate
		x:Key="LibrarySelectorButtonTemplate"
		TargetType="{x:Type local:LibrarySelectorButton}">
		<Button
			x:Name="PART_Button"
			Height="Auto"
			HorizontalContentAlignment="Stretch">
			<Button.Content>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<ContentPresenter
						Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=Self}}"
						Margin="0,0,3,0"
						VerticalAlignment="Stretch"
						Content="{TemplateBinding Value}"
						Style="{DynamicResource LibraryIcon}" />

					<ContentPresenter
						Grid.Row="0"
						Grid.Column="1"
						VerticalAlignment="Center"
						Content="{TemplateBinding Value}"
						Style="{DynamicResource LibraryInfo}" />

				</Grid>
			</Button.Content>
		</Button>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LibrarySelectorButton}">
		<Setter Property="Height" Value="48" />
		<Setter Property="Template" Value="{StaticResource LibrarySelectorButtonTemplate}" />
	</Style>

</ResourceDictionary>