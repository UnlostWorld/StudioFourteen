<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">

	<converters:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />

	<ControlTemplate
		x:Key="LibrarySelectorButtonTemplate"
		TargetType="{x:Type local:LibrarySelectorButton}">
		<Button
			x:Name="PART_Button"
			Height="Auto"
			HorizontalContentAlignment="Stretch">
			<Button.Content>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<ContentPresenter
						Grid.RowSpan="2"
						Margin="-3,3,3,2"
						VerticalAlignment="Stretch"
						Content="{TemplateBinding Value}"
						Style="{DynamicResource LibraryIcon}" />

					<Grid
						Grid.Column="1"
						VerticalAlignment="Center">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Grid.Row="0"
							VerticalAlignment="Center"
							Text="{Binding Value.Name, RelativeSource={RelativeSource AncestorType={x:Type local:LibrarySelectorButton}}}"
							Visibility="{Binding Value.Name, RelativeSource={RelativeSource AncestorType={x:Type local:LibrarySelectorButton}}, Converter={StaticResource StringHasContentToVisibility}}" />

						<TextBlock
							Grid.Row="1"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding Value.SubTitle, RelativeSource={RelativeSource AncestorType={x:Type local:LibrarySelectorButton}}}"
							Visibility="{Binding Value.SubTitle, RelativeSource={RelativeSource AncestorType={x:Type local:LibrarySelectorButton}}, Converter={StaticResource StringHasContentToVisibility}}" />
					</Grid>

				</Grid>
			</Button.Content>
		</Button>
	</ControlTemplate>

	<Style TargetType="{x:Type local:LibrarySelectorButton}">
		<Setter Property="Height" Value="48" />
		<Setter Property="Template" Value="{StaticResource LibrarySelectorButtonTemplate}" />
	</Style>

</ResourceDictionary>