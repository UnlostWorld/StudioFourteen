<panels:Panel
	x:Class="StudioFourteen.Library.LibraryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:WpfUtils.Behaviours;assembly=WpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:structs="clr-namespace:StudioFourteen.Structs"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Library}"
	Width="1000"
	Height="650"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Book"
	mc:Ignorable="d">

	<Grid>

		<Grid x:Name="ContentArea">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="256" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<!--  Sidebar  -->
			<Grid
				Grid.Row="1"
				Grid.Column="1"
				Margin="3,0,0,0"
				Visibility="{Binding SelectedResult, Converter={StaticResource NotNullToVisibilityConverter}}">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ContentPresenter
					Grid.Row="0"
					Width="48"
					Height="48"
					Margin="3,6,3,3"
					VerticalAlignment="Center"
					Content="{Binding SelectedResult.Entry}"
					Style="{StaticResource LibraryIcon}" />

				<ContentPresenter
					Grid.Row="0"
					Grid.Column="1"
					VerticalAlignment="Center"
					Content="{Binding SelectedResult.Entry}"
					Style="{StaticResource LibraryInfo}" />

				<Border
					Grid.Row="1"
					Grid.ColumnSpan="2"
					Style="{DynamicResource WpfUtilsControlBorder}">
					<UniformGrid Rows="1">
						<ToggleButton
							Background="Transparent"
							IsChecked="{Binding SelectedResult.Entry.IsFavorite}">

							<wpfUtils:IconBlock Icon="Heart">
								<wpfUtils:IconBlock.Style>
									<Style TargetType="{x:Type wpfUtils:IconBlock}">
										<Setter Property="IconFont" Value="Auto" />

										<Style.Triggers>
											<DataTrigger
												Binding="{Binding SelectedResult.Entry.IsFavorite}"
												Value="True">
												<Setter Property="IconFont" Value="Solid" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</wpfUtils:IconBlock.Style>
							</wpfUtils:IconBlock>

							<ToggleButton.Style>
								<Style
									BasedOn="{StaticResource WpfUtilsIconToggleButton}"
									TargetType="{x:Type ToggleButton}">
									<Setter Property="ToolTip" Value="{DynamicResource LOC_Library_AddToFavorites}" />

									<Style.Triggers>
										<Trigger Property="IsChecked" Value="True">
											<Setter Property="ToolTip" Value="{DynamicResource LOC_Library_RemoveFromFavorites}" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</ToggleButton.Style>
						</ToggleButton>

						<Button
							Command="{Binding SelectedResult.Entry.Icon.ExportCommand}"
							IsEnabled="{Binding SelectedResult.Entry.Icon.CanExport, FallbackValue=False}"
							ToolTip="{DynamicResource LOC_Library_ExportIcon}">
							<wpfUtils:IconBlock
								Icon="FileImage"
								IconFont="Solid" />
						</Button>

					</UniformGrid>
				</Border>

				<ScrollViewer
					Grid.Row="2"
					Grid.ColumnSpan="2"
					MaxHeight="200"
					Margin="1,0,0,4"
					HorizontalScrollBarVisibility="Disabled">

					<tags:TagDisplay
						TagSelected="OnInfoTagSelected"
						Tags="{Binding SelectedResult.Entry.Tags}" />
				</ScrollViewer>

				<ContentPresenter
					Grid.Row="3"
					Grid.ColumnSpan="2"
					Margin="1,1,1,6"
					Content="{Binding SelectedResult.Entry}"
					Style="{StaticResource LibrarySidebar}" />


				<ContentPresenter
					Grid.Row="4"
					Grid.ColumnSpan="2"
					Margin="1"
					Content="{Binding SelectedResult.Entry}"
					Style="{StaticResource LibraryActions}" />

			</Grid>

			<!--  Toolbar  -->
			<Grid
				Grid.Row="0"
				Grid.ColumnSpan="2"
				Margin="0,3,0,3">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition MinWidth="170" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ToggleButton
					Width="28"
					Margin="1,0"
					IsChecked="{Binding Favorites}"
					Style="{DynamicResource WpfUtilsIconToggleButton}">
					<wpfUtils:IconBlock
						Icon="Heart"
						IconFont="Solid" />
				</ToggleButton>

				<Border
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Margin="1,0,1,0"
					Style="{DynamicResource WpfUtilsControlBorder}" />

				<Button
					Grid.Column="1"
					Width="28"
					Height="Auto"
					Background="Transparent"
					Click="OnBackClicked"
					IsEnabled="{Binding CurrentGroup.IsRoot, Converter={StaticResource !B}}"
					ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">

					<wpfUtils:IconBlock Icon="TurnUp" />

				</Button>

				<ItemsControl
					Grid.Column="2"
					Margin="4,1,3,1"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					ItemsSource="{Binding Path}">

					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button
								Margin="0"
								Background="Transparent"
								Click="OnDirectorySelected">

								<StackPanel Orientation="Horizontal">

									<wpfUtils:IconBlock
										x:Name="Caret"
										Margin="0,4,6,2"
										FontSize="10"
										Icon="CaretRight" />

									<wpfUtils:IconBlock
										x:Name="Icon"
										Margin="0,2,6,2"
										Icon="Book"
										Visibility="Collapsed" />

									<TextBlock Text="{Binding Name}" />
								</StackPanel>
							</Button>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding="{Binding IsRoot}"
									Value="True">
									<Setter TargetName="Icon" Property="Visibility" Value="Visible" />
									<Setter TargetName="Caret" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>

						</DataTemplate>
					</ItemsControl.ItemTemplate>

				</ItemsControl>

				<tags:TagSelector
					Grid.Column="3"
					Margin="1,0"
					AllTags="{Binding AvailableTags}"
					Search="{Binding Search, Mode=TwoWay}"
					Tags="{Binding TagFilter.Tags}" />


				<ListBox
					Grid.Column="4"
					Width="64"
					Height="28"
					Margin="1,0"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBoxItem
						IsSelected="{Binding ViewList, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_IconViewTooltip}">
						<wpfUtils:IconBlock
							Icon="BorderAll"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding ViewList}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_ListViewTooltip}">
						<wpfUtils:IconBlock
							Icon="List"
							IconFont="Solid" />
					</ListBoxItem>
				</ListBox>


				<ListBox
					Grid.Column="5"
					Width="64"
					Height="28"
					Margin="1,0"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBoxItem
						IsSelected="{Binding Flatten, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_DirectoryViewTooltip}">
						<wpfUtils:IconBlock
							Icon="Folder"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding Flatten}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_FlattenViewTooltip}">
						<wpfUtils:IconBlock
							Icon="FileAlt"
							IconFont="Solid" />
					</ListBoxItem>
				</ListBox>

				<Button
					Grid.Column="6"
					Height="28"
					Margin="1,0"
					Click="OnBrowseClicked">
					<Button.Content>
						<StackPanel Orientation="Horizontal">

							<wpfUtils:IconBlock
								Margin="0,0,3,0"
								Icon="FolderOpen"
								IconFont="Solid" />
							<TextBlock Text="Open File..." />
						</StackPanel>
					</Button.Content>
				</Button>

			</Grid>

			<Border
				Grid.Row="3"
				Grid.Column="0"
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<!--  Icon Grid  -->
			<wpfUtils:ListBoxEx
				Grid.Row="3"
				Grid.Column="0"
				Margin="3"
				Background="Transparent"
				ClipToBounds="True"
				ItemsSource="{Binding Results, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedResult}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource !B2V}}">

				<ListBox.Template>
					<ControlTemplate TargetType="{x:Type ListBox}">
						<ScrollViewer
							Padding="{TemplateBinding Padding}"
							Background="{DynamicResource BackgroundBrush}"
							Focusable="false"
							Opacity="1"
							RenderTransformOrigin="0.5, 0.5">

							<ScrollViewer.RenderTransform>
								<TransformGroup>
									<ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" />
									<TranslateTransform x:Name="Translate" X="0" Y="0" />
								</TransformGroup>
							</ScrollViewer.RenderTransform>

							<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

							<ScrollViewer.Triggers>
								<triggers:StoryboardEnumTrigger
									Binding="{Binding NavigationAnimation, Mode=TwoWay}"
									Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
									<triggers:StoryboardEnumTrigger.Storyboards>

										<Storyboard x:Name="OpenDir_Out">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1"
												To="1.05"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="1"
												To="0"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="OpenDir_In">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="0.95"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="0"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="Back_Out">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1"
												To="0.95"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="1"
												To="0"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="Back_In">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1.05"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="0"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</triggers:StoryboardEnumTrigger.Storyboards>

								</triggers:StoryboardEnumTrigger>

							</ScrollViewer.Triggers>
						</ScrollViewer>


					</ControlTemplate>
				</ListBox.Template>

				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<controls:SmoothScrollingVirtualizingWrapPanel
							IsItemsHost="True"
							VirtualizingPanel.ScrollUnit="Item"
							VirtualizingPanel.VirtualizationMode="Recycling" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type results:Result}">

						<Grid
							Width="92"
							Height="128"
							Background="Transparent"
							ToolTip="{Binding Entry}">

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="32" />
							</Grid.RowDefinitions>

							<ContentPresenter
								Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
								Margin="3"
								Content="{Binding Entry}"
								Style="{DynamicResource LibraryIcon}" />

							<Grid
								Margin="0,5,5,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
								<wpfUtils:IconBlock
									Margin="-2,2,2,-2"
									FontSize="28"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="Heart"
									IconFont="Solid" />
								<wpfUtils:IconBlock
									FontSize="28"
									Foreground="{DynamicResource TrimBrush}"
									Icon="Heart"
									IconFont="Solid" />

							</Grid>


							<TextBlock
								x:Name="NameBlock"
								Grid.Row="1"
								VerticalAlignment="Top"
								Text="{Binding Entry.Name}"
								TextAlignment="Center"
								TextWrapping="Wrap" />
						</Grid>


						<DataTemplate.Triggers>
							<DataTrigger
								Binding="{Binding Entry.Name}"
								Value="{x:Null}">
								<Setter TargetName="NameBlock" Property="Text" Value="{Binding EntryId}" />
								<Setter TargetName="NameBlock" Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
							</DataTrigger>
						</DataTemplate.Triggers>

					</DataTemplate>
				</ListBox.ItemTemplate>

			</wpfUtils:ListBoxEx>

			<!--  List  -->
			<ListBox
				Grid.Row="3"
				Grid.Column="0"
				Margin="6"
				Background="Transparent"
				ItemsSource="{Binding Results, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedResult}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource B2V}}">

				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type results:Result}">
						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<!--TODO <controls1:EntryIcon
							Width="48"
							Height="48"
							Margin="0,-6,0,-4" />-->

							<TextBlock
								Grid.Column="1"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Text="{Binding Entry.Name}"
								TextTrimming="CharacterEllipsis" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>
</panels:Panel>
