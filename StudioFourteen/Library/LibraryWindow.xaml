<panels:Panel
	x:Class="StudioFourteen.Library.LibraryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="clr-namespace:WpfUtils.Behaviours;assembly=WpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:structs="clr-namespace:StudioFourteen.Structs"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Library}"
	Width="1000"
	Height="650"
	MinWidth="680"
	MinHeight="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	TitleIcon="Book"
	mc:Ignorable="d">

	<Grid Margin="0,-24,0,0">

		<Grid x:Name="ContentArea">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<!--  Tabbar  -->
			<Grid
				Grid.Row="0"
				Margin="178,0,300,0">

				<ListBox
					HorizontalContentAlignment="Stretch"
					ItemsSource="{Binding Tabs}"
					SelectedItem="{Binding CurrentTab}"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBox.ItemContainerStyle>
						<Style
							BasedOn="{StaticResource WpfUtilsSwitchSelectorItemStyle}"
							TargetType="{x:Type ListBoxItem}">
							<Setter Property="HorizontalContentAlignment" Value="stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:LibraryTab}">
							<Grid
								x:Name="MainGrid"
								HorizontalAlignment="Stretch">
								<TextBlock
									HorizontalAlignment="Center"
									Text="{Binding Name}"
									Visibility="{Binding ElementName=MainGrid, Path=ActualWidth, Converter={StaticResource GreaterThanToVisibility}, ConverterParameter=74}" />
								<wpfUtils:IconBlock
									HorizontalAlignment="Center"
									Icon="{Binding Icon}"
									IconFont="Solid"
									Visibility="{Binding ElementName=MainGrid, Path=ActualWidth, Converter={StaticResource LessThanToVisibility}, ConverterParameter=75}" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<ToggleButton
					Width="28"
					Margin="1,0"
					IsChecked="{Binding Favorites}"
					Style="{DynamicResource WpfUtilsIconToggleButton}"
					Visibility="Collapsed">
					<wpfUtils:IconBlock
						Icon="Heart"
						IconFont="Solid" />
				</ToggleButton>
			</Grid>

			<!--  Toolbar  -->
			<Grid
				Grid.Row="1"
				Margin="0,3,0,3">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" />
					<ColumnDefinition MinWidth="170" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>



				<Border
					Grid.Column="1"
					Margin="1,0,1,0"
					Style="{DynamicResource WpfUtilsControlBorder}">
					<StackPanel Orientation="Horizontal">
						<Button
							Width="28"
							Height="Auto"
							Background="Transparent"
							Click="OnBackClicked"
							IsEnabled="{Binding CurrentGroup.Parent, Converter={StaticResource NotNullToBoolConverter}}"
							ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
							<wpfUtils:IconBlock Icon="ArrowLeft" />
						</Button>

						<Button
							Width="28"
							Height="Auto"
							Background="Transparent"
							Click="OnBackClicked"
							IsEnabled="False"
							ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
							<wpfUtils:IconBlock Icon="ArrowRight" />
						</Button>
					</StackPanel>
				</Border>

				<Border
					Grid.Column="2"
					Margin="1,0,1,0"
					Style="{DynamicResource WpfUtilsControlBorder}">

					<ItemsControl
						Margin="1"
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						ItemsSource="{Binding Path}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									HorizontalAlignment="Right"
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid>


									<StackPanel Orientation="Horizontal">
										<Button
											Margin="0"
											Padding="10,0"
											Background="Transparent"
											Click="OnDirectorySelected">

											<Grid>
												<wpfUtils:IconBlock
													x:Name="Icon"
													Margin="2"
													Icon="{Binding Icon}" />

												<TextBlock
													x:Name="Name"
													Text="{Binding Name}"
													Visibility="Collapsed" />

											</Grid>
										</Button>

										<ToggleButton
											x:Name="SubDirButton"
											Margin="0"
											Padding="6,0"
											Background="Transparent"
											Style="{DynamicResource WpfUtilsIconToggleButton}"
											Visibility="{Binding HasSubGroups, Converter={StaticResource B2V}}">
											<Path
												Grid.Column="1"
												Margin="3"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Data="M 0,0 5,3 0,6"
												Stroke="{Binding ElementName=SubDirButton, Path=Foreground}"
												StrokeThickness="1" />


										</ToggleButton>
									</StackPanel>

									<wpfUtils:PopOut
										MinWidth="150"
										MaxHeight="400"
										Padding="0"
										Background="{DynamicResource ControlBackgroundBrush}"
										IsOpen="{Binding ElementName=SubDirButton, Path=IsChecked}"
										PlacementTarget="{Binding ElementName=SubDirButton}"
										StaysOpen="False"
										Style="{DynamicResource WpfUtilsPopOut}">

										<wpfUtils:PopOut.Header>
											<TextBlock
												Margin="10"
												Foreground="{DynamicResource ForegroundLightBrush}">
												<Run Text="{Binding Name, Mode=OneTime}" />
												<Run Text="/" />
											</TextBlock>
										</wpfUtils:PopOut.Header>

										<ScrollViewer
											Margin="0"
											HorizontalScrollBarVisibility="Disabled">
											<ItemsControl ItemsSource="{Binding GroupEntries}">
												<ItemsControl.ItemTemplate>
													<DataTemplate DataType="{x:Type local:GroupEntryBase}">
														<Button
															HorizontalContentAlignment="Left"
															Background="Transparent"
															Click="OnDirectorySwapClicked">
															<TextBlock
																Margin="6,4"
																Text="{Binding Name}" />
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</wpfUtils:PopOut>


								</Grid>

								<DataTemplate.Triggers>
									<DataTrigger
										Binding="{Binding Icon}"
										Value="None">
										<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
										<Setter TargetName="Name" Property="Visibility" Value="Visible" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>
				</Border>

				<tags:TagSelector
					Grid.Column="3"
					Margin="1,0"
					AllTags="{Binding AvailableTags}"
					Search="{Binding Search, Mode=TwoWay}"
					Tags="{Binding TagFilter.Tags}" />


				<ListBox
					Grid.Column="4"
					Width="64"
					Height="28"
					Margin="1,0"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBoxItem
						IsSelected="{Binding ViewList, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_IconViewTooltip}">
						<wpfUtils:IconBlock
							Icon="BorderAll"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding ViewList}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_ListViewTooltip}">
						<wpfUtils:IconBlock
							Icon="List"
							IconFont="Solid" />
					</ListBoxItem>
				</ListBox>


				<ListBox
					Grid.Column="5"
					Width="64"
					Height="28"
					Margin="1,0"
					Style="{DynamicResource WpfUtilsSwitchSelector}">
					<ListBoxItem
						IsSelected="{Binding Flatten, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_DirectoryViewTooltip}">
						<wpfUtils:IconBlock
							Icon="Folder"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding Flatten}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_FlattenViewTooltip}">
						<wpfUtils:IconBlock
							Icon="FileAlt"
							IconFont="Solid" />
					</ListBoxItem>
				</ListBox>

				<Button
					Grid.Column="6"
					Height="28"
					Margin="1,0"
					Click="OnBrowseClicked">
					<Button.Content>
						<StackPanel Orientation="Horizontal">

							<wpfUtils:IconBlock
								Margin="0,0,3,0"
								Icon="FolderOpen"
								IconFont="Solid" />
							<TextBlock Text="Open File..." />
						</StackPanel>
					</Button.Content>
				</Button>

			</Grid>

			<Border
				Grid.Row="2"
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<!--  Icon Grid  -->
			<wpfUtils:ListBoxEx
				Grid.Row="2"
				Margin="3"
				Background="Transparent"
				ClipToBounds="True"
				ItemsSource="{Binding Results, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedResult}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource !B2V}}">

				<ListBox.Template>
					<ControlTemplate TargetType="{x:Type ListBox}">
						<ScrollViewer
							Padding="{TemplateBinding Padding}"
							Background="{DynamicResource BackgroundBrush}"
							Focusable="false"
							Opacity="1"
							RenderTransformOrigin="0.5, 0.5">

							<ScrollViewer.RenderTransform>
								<TransformGroup>
									<ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" />
									<TranslateTransform x:Name="Translate" X="0" Y="0" />
								</TransformGroup>
							</ScrollViewer.RenderTransform>

							<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

							<ScrollViewer.Triggers>
								<triggers:StoryboardEnumTrigger
									Binding="{Binding NavigationAnimation, Mode=TwoWay}"
									Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
									<triggers:StoryboardEnumTrigger.Storyboards>

										<Storyboard x:Name="OpenDir_Out">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1"
												To="1.05"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="1"
												To="0"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="OpenDir_In">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="0.95"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="0"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="Back_Out">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1"
												To="0.95"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="1"
												To="0"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseIn" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>


										<Storyboard x:Name="Back_In">
											<DoubleAnimation
												Storyboard.TargetName="Scale"
												Storyboard.TargetProperty="ScaleX"
												From="1.05"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="Opacity"
												From="0"
												To="1"
												Duration="0:00:00.050">
												<DoubleAnimation.EasingFunction>
													<SineEase EasingMode="EaseOut" />
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</triggers:StoryboardEnumTrigger.Storyboards>

								</triggers:StoryboardEnumTrigger>

							</ScrollViewer.Triggers>
						</ScrollViewer>


					</ControlTemplate>
				</ListBox.Template>

				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<controls:SmoothScrollingVirtualizingWrapPanel
							IsItemsHost="True"
							VirtualizingPanel.ScrollUnit="Item"
							VirtualizingPanel.VirtualizationMode="Recycling" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>

				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type results:Result}">

						<Grid
							Width="92"
							Height="128"
							Background="Transparent"
							MouseEnter="OnResultMouseEnter"
							MouseLeave="OnResultMouseLeave"
							MouseRightButtonUp="OnResultMouseRight">

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="32" />
							</Grid.RowDefinitions>

							<ContentPresenter
								Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
								Margin="3"
								Content="{Binding Entry}"
								Style="{DynamicResource LibraryIcon}" />

							<Grid
								Margin="0,5,5,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
								<wpfUtils:IconBlock
									Margin="-2,2,2,-2"
									FontSize="28"
									Foreground="{DynamicResource BackgroundBrush}"
									Icon="Heart"
									IconFont="Solid" />
								<wpfUtils:IconBlock
									FontSize="28"
									Foreground="{DynamicResource TrimBrush}"
									Icon="Heart"
									IconFont="Solid" />

							</Grid>


							<TextBlock
								x:Name="NameBlock"
								Grid.Row="1"
								VerticalAlignment="Top"
								Text="{Binding Entry.Name}"
								TextAlignment="Center"
								TextWrapping="Wrap" />
						</Grid>


						<DataTemplate.Triggers>
							<DataTrigger
								Binding="{Binding Entry.Name}"
								Value="{x:Null}">
								<Setter TargetName="NameBlock" Property="Text" Value="{Binding EntryId}" />
								<Setter TargetName="NameBlock" Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
							</DataTrigger>
						</DataTemplate.Triggers>

					</DataTemplate>
				</ListBox.ItemTemplate>

			</wpfUtils:ListBoxEx>

			<!--  List  -->
			<ListBox
				Grid.Row="2"
				Margin="6"
				Background="Transparent"
				ItemsSource="{Binding Results, IsAsync=True}"
				MouseDoubleClick="OnItemDoubleClicked"
				SelectedItem="{Binding SelectedResult}"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling"
				Visibility="{Binding ViewList, Converter={StaticResource B2V}}">

				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type results:Result}">
						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<!--TODO <controls1:EntryIcon
							Width="48"
							Height="48"
							Margin="0,-6,0,-4" />-->

							<TextBlock
								Grid.Column="1"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Text="{Binding Entry.Name}"
								TextTrimming="CharacterEllipsis" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<menu:LibraryContextMenu x:Name="LibraryContextMenu" />

	</Grid>
</panels:Panel>
