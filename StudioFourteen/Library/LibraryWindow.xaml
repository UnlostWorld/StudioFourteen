<panels:Panel
	x:Class="StudioFourteen.Library.LibraryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="clr-namespace:WpfUtils.Behaviors;assembly=WpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:input="clr-namespace:StudioFourteen.Input"
	xmlns:local="clr-namespace:StudioFourteen.Library"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:menu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:results="clr-namespace:StudioFourteen.Library.Results"
	xmlns:structs="clr-namespace:StudioFourteen.Structs"
	xmlns:tags="clr-namespace:StudioFourteen.Tags"
	xmlns:triggers="clr-namespace:WpfUtils.Triggers;assembly=WpfUtils"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Library}"
	Width="800"
	Height="600"
	MinWidth="280"
	MinHeight="300"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	MouseMove="OnMouseMove"
	Subtitle="{Binding CurrentTab.Name}"
	TitleIcon="fa-Book"
	mc:Ignorable="d">

	<Grid>
		<Grid x:Name="ContentArea">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<!--  Toolbar  -->
			<Grid Grid.Row="0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Border
					Grid.Column="0"
					Margin="1">
					<StackPanel Orientation="Horizontal">
						<Button
							Width="28"
							Height="Auto"
							Background="Transparent"
							Click="OnBackClicked"
							IsEnabled="{Binding CurrentGroup.Parent, Converter={StaticResource NotNullToBoolConverter}}"
							ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
							<wpfUtils:IconBlock Icon="ArrowLeft" />
						</Button>

						<Button
							Width="28"
							Height="Auto"
							Background="Transparent"
							Click="OnBackClicked"
							IsEnabled="False"
							ToolTip="{DynamicResource LOC_Library_GoUpTooltip}">
							<wpfUtils:IconBlock Icon="ArrowRight" />
						</Button>
					</StackPanel>

					<Border.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsControlBorder}"
							TargetType="{x:Type Border}">

							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>

				</Border>

				<Border Margin="1">
					<Border.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsControlBorder}"
							TargetType="{x:Type Border}">

							<Setter Property="Grid.Column" Value="1" />
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="0" />
									<Setter Property="Grid.ColumnSpan" Value="5" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>

					<ItemsControl
						Margin="1"
						Focusable="False"
						ItemsSource="{Binding Path}">

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid>


									<StackPanel Orientation="Horizontal">
										<Button
											Margin="0"
											Padding="10,0"
											Background="Transparent"
											Click="OnDirectorySelected">

											<Grid>
												<wpfUtils:IconBlock
													x:Name="Icon"
													Margin="2"
													Icon="{Binding Icon}" />

												<TextBlock
													x:Name="Name"
													Text="{Binding Name}"
													Visibility="Collapsed" />

											</Grid>
										</Button>

										<ToggleButton
											x:Name="SubDirButton"
											Margin="0"
											Padding="6,0"
											Background="Transparent"
											Style="{DynamicResource WpfUtilsIconToggleButton}"
											Visibility="{Binding HasSubGroups, Converter={StaticResource B2V}}">
											<Path
												Grid.Column="1"
												Margin="3"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Data="M 0,0 5,3 0,6"
												Stroke="{Binding ElementName=SubDirButton, Path=Foreground}"
												StrokeThickness="1" />


										</ToggleButton>
									</StackPanel>

									<wpfUtils:PopOut
										MinWidth="150"
										MaxHeight="400"
										Padding="0"
										Background="{DynamicResource ControlBackgroundBrush}"
										IsOpen="{Binding ElementName=SubDirButton, Path=IsChecked}"
										PlacementTarget="{Binding ElementName=SubDirButton}"
										StaysOpen="False"
										Style="{DynamicResource WpfUtilsPopOut}">

										<wpfUtils:PopOut.Header>
											<TextBlock
												Margin="10"
												Foreground="{DynamicResource ForegroundLightBrush}">
												<Run Text="{Binding Name, Mode=OneTime}" />
												<Run Text="/" />
											</TextBlock>
										</wpfUtils:PopOut.Header>

										<ScrollViewer
											Margin="0"
											HorizontalScrollBarVisibility="Disabled">
											<ItemsControl ItemsSource="{Binding GroupEntries}">
												<ItemsControl.ItemTemplate>
													<DataTemplate DataType="{x:Type local:GroupEntryBase}">
														<Button
															HorizontalContentAlignment="Left"
															Background="Transparent"
															Click="OnDirectorySwapClicked">
															<TextBlock
																Margin="6,4"
																Text="{Binding Name}" />
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</wpfUtils:PopOut>


								</Grid>

								<DataTemplate.Triggers>
									<DataTrigger
										Binding="{Binding Icon}"
										Value="None">
										<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
										<Setter TargetName="Name" Property="Visibility" Value="Visible" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ItemsControl.ItemTemplate>

					</ItemsControl>
				</Border>


				<wpfUtils:SwitchSelector
					x:Name="ViewModeArea"
					Width="64"
					Height="28"
					Margin="1">
					<ListBoxItem
						IsSelected="{Binding ViewList, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_IconViewTooltip}">
						<wpfUtils:IconBlock
							Icon="BorderAll"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding ViewList}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_ListViewTooltip}">
						<wpfUtils:IconBlock
							Icon="List"
							IconFont="Solid" />
					</ListBoxItem>

					<wpfUtils:SwitchSelector.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsSwitchSelector}"
							TargetType="{x:Type wpfUtils:SwitchSelector}">

							<Setter Property="Grid.Column" Value="2" />
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="2" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</wpfUtils:SwitchSelector.Style>
				</wpfUtils:SwitchSelector>


				<wpfUtils:SwitchSelector
					x:Name="FlattenModeArea"
					Width="64"
					Height="28"
					Margin="1">
					<ListBoxItem
						IsSelected="{Binding Flatten, Converter={StaticResource !B}}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_DirectoryViewTooltip}">
						<wpfUtils:IconBlock
							Icon="Folder"
							IconFont="Solid" />
					</ListBoxItem>
					<ListBoxItem
						IsSelected="{Binding Flatten}"
						Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}"
						ToolTip="{DynamicResource LOC_Library_FlattenViewTooltip}">
						<wpfUtils:IconBlock
							Icon="FileAlt"
							IconFont="Solid" />
					</ListBoxItem>

					<wpfUtils:SwitchSelector.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsSwitchSelector}"
							TargetType="{x:Type wpfUtils:SwitchSelector}">

							<Setter Property="Grid.Column" Value="3" />

							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="3" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</wpfUtils:SwitchSelector.Style>
				</wpfUtils:SwitchSelector>

				<Button
					x:Name="BrowseArea"
					Height="28"
					Margin="1"
					Click="OnBrowseClicked">

					<Button.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsButton}"
							TargetType="{x:Type Button}">

							<Setter Property="Grid.Column" Value="4" />
							<Setter Property="Content">
								<Setter.Value>
									<StackPanel Orientation="Horizontal">
										<wpfUtils:IconBlock
											Margin="0,0,3,0"
											Icon="FolderOpen"
											IconFont="Solid" />
										<TextBlock Text="{DynamicResource LOC_Library_OpenFile}" />
									</StackPanel>
								</Setter.Value>
							</Setter>

							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="4" />
									<Setter Property="Grid.Row" Value="1" />
									<Setter Property="Content" Value="..." />
									<Setter Property="Width" Value="28" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>

				<ComboBox
					Grid.Row="1"
					Grid.Column="1"
					MinWidth="50"
					ItemsSource="{Binding Tabs}"
					SelectedItem="{Binding CurrentTab}"
					Visibility="{Binding NarrowMode, Converter={StaticResource B2V}}">

					<wpfUtils:PopOut.Header>
						<TextBlock
							Margin="10"
							Text="Select a file type to filter by:" />
					</wpfUtils:PopOut.Header>

					<ComboBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:LibraryTab}">
							<Grid
								x:Name="MainGrid"
								Background="Transparent"
								ToolTip="{Binding Name}">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="22" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<wpfUtils:IconBlock
									Grid.Column="0"
									HorizontalAlignment="Center"
									Icon="{Binding Icon}"
									IconFont="Solid" />

								<TextBlock
									x:Name="LabelTextBlock"
									Grid.Column="1"
									Margin="6,-1,0,0"
									Text="{Binding Name}" />
							</Grid>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding="{Binding ElementName=MainGrid, Path=ActualWidth, Converter={StaticResource LessThanToBool}, ConverterParameter=75}"
									Value="True">
									<Setter TargetName="LabelTextBlock" Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</DataTemplate.Triggers>

						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<!--  Filter Bar  -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="0.5*"
						MinWidth="50" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid.Resources />

				<wpfUtils:SwitchSelector
					Grid.Column="0"
					HorizontalContentAlignment="Stretch"
					ItemsSource="{Binding Tabs}"
					SelectedItem="{Binding CurrentTab}"
					Visibility="{Binding NarrowMode, Converter={StaticResource !B2V}}">
					<ListBox.ItemContainerStyle>
						<Style
							BasedOn="{StaticResource WpfUtilsSwitchSelectorItemStyle}"
							TargetType="{x:Type ListBoxItem}">
							<Setter Property="HorizontalContentAlignment" Value="stretch" />
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:LibraryTab}">
							<Grid
								Width="25"
								Background="Transparent"
								ToolTip="{Binding Name}">
								<wpfUtils:IconBlock
									HorizontalAlignment="Center"
									Icon="{Binding Icon}"
									IconFont="Solid" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</wpfUtils:SwitchSelector>

				<tags:TagSelector
					SelectedTags="{Binding TagFilter.Tags}"
					Tags="{Binding AvailableTags}">
					<tags:TagSelector.Style>
						<Style
							BasedOn="{StaticResource TagSelectorStyle}"
							TargetType="{x:Type tags:TagSelector}">
							<Setter Property="Grid.Column" Value="1" />

							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="0" />
									<Setter Property="Grid.ColumnSpan" Value="3" />
									<Setter Property="Grid.Row" Value="1" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</tags:TagSelector.Style>
				</tags:TagSelector>

				<Grid>
					<TextBox
						Padding="25,0,3,0"
						Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

					<wpfUtils:IconBlock
						Margin="8,0,0,0"
						HorizontalAlignment="Left"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Icon="Search" />

					<Grid.Style>
						<Style TargetType="{x:Type Grid}">
							<Setter Property="Grid.Column" Value="2" />

							<Style.Triggers>
								<DataTrigger
									Binding="{Binding NarrowMode}"
									Value="True">
									<Setter Property="Grid.Column" Value="0" />
									<Setter Property="Grid.ColumnSpan" Value="3" />
									<Setter Property="Grid.Row" Value="2" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
				</Grid>
			</Grid>


			<Border
				Grid.Row="2"
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>

					<Grid.Resources>
						<ControlTemplate
							x:Key="ListTemplate"
							TargetType="{x:Type ListBox}">
							<ScrollViewer
								Padding="{TemplateBinding Padding}"
								Background="{DynamicResource BackgroundBrush}"
								Focusable="false"
								Opacity="1"
								RenderTransformOrigin="0.5, 0.5">

								<ScrollViewer.RenderTransform>
									<TransformGroup>
										<ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Mode=Self}}" />
										<TranslateTransform x:Name="Translate" X="0" Y="0" />
									</TransformGroup>
								</ScrollViewer.RenderTransform>

								<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

								<ScrollViewer.Triggers>
									<triggers:StoryboardEnumTrigger
										Binding="{Binding NavigationAnimation, Mode=TwoWay}"
										Target="{Binding RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
										<triggers:StoryboardEnumTrigger.Storyboards>

											<Storyboard x:Name="OpenDir_Out">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1"
													To="1.05"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="1"
													To="0"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="OpenDir_In">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="0.95"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="0"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="Back_Out">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1"
													To="0.95"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="1"
													To="0"
													Duration="0:00:00.050">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>


											<Storyboard x:Name="Back_In">
												<DoubleAnimation
													Storyboard.TargetName="Scale"
													Storyboard.TargetProperty="ScaleX"
													From="1.05"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation
													Storyboard.TargetProperty="Opacity"
													From="0"
													To="1"
													Duration="0:00:00.100">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</triggers:StoryboardEnumTrigger.Storyboards>

									</triggers:StoryboardEnumTrigger>

								</ScrollViewer.Triggers>
							</ScrollViewer>


						</ControlTemplate>
					</Grid.Resources>


					<!--  Icon Grid  -->
					<wpfUtils:ListBoxEx
						x:Name="ResultsGrid"
						Grid.Row="2"
						Margin="3"
						input:Navigation.Back="OnListBack"
						input:Navigation.Enter="OnListEnter"
						Background="Transparent"
						ClipToBounds="True"
						ItemsSource="{Binding Results, IsAsync=True}"
						SelectedItem="{Binding SelectedResult}"
						SelectionMode="Extended"
						Template="{StaticResource ListTemplate}"
						VirtualizingPanel.ScrollUnit="Pixel"
						VirtualizingPanel.VirtualizationMode="Recycling"
						Visibility="{Binding ViewList, Converter={StaticResource !B2V}}">

						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<controls:SmoothScrollingVirtualizingWrapPanel
									IsItemsHost="True"
									VirtualizingPanel.ScrollUnit="Item"
									VirtualizingPanel.VirtualizationMode="Recycling" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>

						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type results:Result}">

								<Grid
									Width="92"
									Height="128"
									Background="Transparent"
									MouseLeftButtonUp="OnResultMouseLeft"
									MouseRightButtonUp="OnResultMouseRight"
									ToolTip="!"
									ToolTipOpening="OnResultToolTipOpening">

									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="32" />
									</Grid.RowDefinitions>

									<ContentPresenter
										Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
										Margin="3"
										Content="{Binding Entry}"
										Style="{DynamicResource LibraryIcon}" />

									<Grid
										Margin="0,5,5,0"
										HorizontalAlignment="Right"
										VerticalAlignment="Top"
										Visibility="{Binding Entry.IsFavorite, Converter={StaticResource B2V}}">
										<wpfUtils:IconBlock
											Margin="-2,2,2,-2"
											FontSize="28"
											Foreground="{DynamicResource BackgroundBrush}"
											Icon="Heart"
											IconFont="Solid" />
										<wpfUtils:IconBlock
											FontSize="28"
											Foreground="{DynamicResource TrimBrush}"
											Icon="Heart"
											IconFont="Solid" />

									</Grid>


									<TextBlock
										x:Name="NameBlock"
										Grid.Row="1"
										VerticalAlignment="Top"
										Text="{Binding Entry.Name}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</Grid>


								<DataTemplate.Triggers>
									<DataTrigger
										Binding="{Binding Entry.Name}"
										Value="{x:Null}">
										<Setter TargetName="NameBlock" Property="Text" Value="{Binding EntryId}" />
										<Setter TargetName="NameBlock" Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
									</DataTrigger>
								</DataTemplate.Triggers>

							</DataTemplate>
						</ListBox.ItemTemplate>

					</wpfUtils:ListBoxEx>

					<!--  List  -->
					<ListBox
						Grid.Row="2"
						Margin="6"
						Background="Transparent"
						ItemsSource="{Binding Results, IsAsync=True}"
						SelectedItem="{Binding SelectedResult}"
						Template="{StaticResource ListTemplate}"
						VirtualizingPanel.ScrollUnit="Pixel"
						VirtualizingPanel.VirtualizationMode="Recycling"
						Visibility="{Binding ViewList, Converter={StaticResource B2V}}">

						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type results:Result}">
								<Grid
									MouseLeftButtonUp="OnResultMouseLeft"
									MouseRightButtonUp="OnResultMouseRight"
									ToolTip="!"
									ToolTipOpening="OnResultToolTipOpening">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<ContentPresenter
										Grid.Column="0"
										Width="32"
										Height="32"
										Margin="3"
										Content="{Binding Entry}"
										Style="{DynamicResource LibraryIcon}" />

									<TextBlock
										Grid.Column="1"
										Margin="6,0,0,0"
										VerticalAlignment="Center"
										Text="{Binding Entry.Name}"
										TextTrimming="CharacterEllipsis" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>
		</Grid>

		<menu:LibraryContextMenu x:Name="LibraryContextMenu" />

	</Grid>
</panels:Panel>
