<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:StudioFourteen.Converters"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:StudioFourteen.Markup;assembly="
	xmlns:sources="clr-namespace:StudioFourteen.Library.Sources">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	<converters:GreaterThanToVisibilityConverter x:Key="GreaterThanToVisibility" />
	<converters:StringHasContentToVisibilityConverter x:Key="StringHasContentToVisibility" />

	<DataTemplate x:Key="LibrarySidebar_CharacterAppearance">
		<Grid />
	</DataTemplate>


	<DataTemplate x:Key="LibrarySidebar_Item" DataType="{x:Type gameData:ItemLibraryEntry}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Description, Converter={StaticResource NotNullToVisibilityConverter}}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{Binding ClassJobsName}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Visibility="{Binding EquipLevel, Converter={StaticResource GreaterThanToVisibility}, ConverterParameter=1}">
					<Run Text="Lv." />
					<Run Text="{Binding EquipLevel, Mode=OneWay}" />
				</TextBlock>

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{Binding UICategoryName}" />

			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate x:Key="LibrarySidebar_Status" DataType="{x:Type gameData:StatusLibraryEntry}">
		<Grid>
			<StackPanel>
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Description, Converter={StaticResource NotNullToVisibilityConverter}}" />
			</StackPanel>
		</Grid>
	</DataTemplate>

	<DataTemplate x:Key="LibrarySidebar_FileEntry" DataType="{x:Type sources:FileEntry}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Description, Converter={StaticResource StringHasContentToVisibility}}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Author}"
					Visibility="{Binding Author, Converter={StaticResource StringHasContentToVisibility}}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Visibility="{Binding Version, Converter={StaticResource StringHasContentToVisibility}}">
					<Run Text="Ver: " />
					<Run Text="{Binding Version, Mode=OneWay}" />
				</TextBlock>
			</StackPanel>

			<Grid
				Grid.Row="1"
				MaxHeight="200"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Visibility="{Binding Image, Converter={StaticResource NotNullToVisibilityConverter}}">

				<Border
					Name="Mask"
					Margin="1"
					Background="Black"
					CornerRadius="4" />

				<Image Source="{Binding Image}">
					<Image.OpacityMask>
						<VisualBrush Visual="{Binding ElementName=Mask}" />
					</Image.OpacityMask>
				</Image>
			</Grid>
		</Grid>
	</DataTemplate>

	<DataTemplate x:Key="LibrarySidebar_Territory" DataType="{x:Type gameData:TerritoryTypeLibraryEntry}">
		<StackPanel>

			<Image Source="{Binding ThumbnailPath}" />

			<StackPanel>
				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{Binding Zone}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{Binding Region}" />

				<TextBlock Foreground="{DynamicResource ForegroundLightBrush}" Text="{Binding Place}" />
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<Style x:Key="LibrarySidebar" TargetType="{x:Type ContentPresenter}">
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

</ResourceDictionary>
