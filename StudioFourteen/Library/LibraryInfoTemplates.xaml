<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:appearance="clr-namespace:StudioFourteen.Appearance"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:excel="clr-namespace:StudioFourteen.GameData.Excel"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:markup="clr-namespace:WpfUtils.Markup;assembly=WpfUtils"
	xmlns:services="clr-namespace:StudioFourteen.Services"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<DataTemplate
		x:Key="LibraryInfo_Simple"
		DataType="{x:Type library:LibraryEntryBase}">
		<TextBlock
			Margin="3,0,0,0"
			Text="{Binding Name}"
			TextWrapping="Wrap" />
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryInfo_DataSheetLibrarySource"
		DataType="{x:Type gameData:DataSheetLibrarySource}">
		<StackPanel>
			<TextBlock
				Margin="3,0,0,0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{DynamicResource LOC_Library_DataSheetLibrarySourceDesc}" />
		</StackPanel>
	</DataTemplate>


	<DataTemplate
		x:Key="LibraryInfo_GroupPoseCharactersLibrarySource"
		DataType="{x:Type appearance:GroupPoseCharactersLibrarySource}">
		<StackPanel>
			<TextBlock
				Margin="3,0,0,0"
				Text="{Binding Name}"
				TextWrapping="Wrap" />

			<TextBlock
				Foreground="{DynamicResource ForegroundLightBrush}"
				Style="{DynamicResource Body}"
				Text="{DynamicResource LOC_Library_GroupPoseCharactersLibrarySourceDesc}" />
		</StackPanel>
	</DataTemplate>



	<markup:TemplateSelector x:Key="LibraryInfoTemplateSelector">

		<markup:TemplateSelectorEntry
			TargetType="{x:Type gameData:DataSheetLibrarySource}"
			Template="{StaticResource LibraryInfo_DataSheetLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type appearance:GroupPoseCharactersLibrarySource}"
			Template="{StaticResource LibraryInfo_GroupPoseCharactersLibrarySource}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type library:LibraryEntryBase}"
			Template="{StaticResource LibraryInfo_Simple}" />

		<markup:TemplateSelectorEntry
			TargetType="{x:Type excel:LibraryExcelRow}"
			Template="{StaticResource LibraryInfo_Simple}" />

	</markup:TemplateSelector>

	<Style
		x:Key="LibraryInfo"
		TargetType="{x:Type ContentPresenter}">
		<Setter Property="ContentTemplateSelector" Value="{StaticResource LibraryInfoTemplateSelector}" />
		<Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>


</ResourceDictionary>