<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:StudioFourteen.Posing.Shared"
	xmlns:controls="clr-namespace:StudioFourteen.Controls">

	<ControlTemplate x:Key="PoseSelectionControlTemplate" TargetType="{x:Type local:PoseSelectionControl}">
		<Grid>
			<Ellipse Fill="{TemplateBinding Background}" />

			<Ellipse
				x:Name="Highlight"
				Fill="{DynamicResource ControlHighlightBrush}"
				Opacity="0" />

			<Ellipse
				x:Name="Base"
				Margin="5"
				Fill="{TemplateBinding Foreground}"
				Visibility="Collapsed" />

			<TextBlock
				x:Name="LabelText"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Text="{TemplateBinding Label}"
				Foreground="{TemplateBinding Foreground}"
				FontSize="7"
				Margin="0,0,0,1"
				FontWeight="Bold"/>

		</Grid>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseHover" Value="true">
				<Setter TargetName="Highlight" Property="Opacity" Value="1" />
				<Setter TargetName="Base" Property="Fill" Value="{DynamicResource ControlForegroundHighlightBrush}" />
				<Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource ControlForegroundHighlightBrush}" />
			</Trigger>

			<Trigger Property="IsSelected" Value="true">
				<Setter TargetName="Base" Property="Fill" Value="{DynamicResource TrimBrush}" />
				<Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource TrimBrush}" />
			</Trigger>

			<Trigger Property="Label" Value="{x:Null}">
				<Setter TargetName="Base" Property="Visibility" Value="Visible" />
				<Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
			</Trigger>

			<Trigger Property="IsValid" Value="false">
				<Setter Property="Visibility" Value="Collapsed" />
			</Trigger>

		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="{x:Type local:PoseSelectionControl}">
		<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundLightBrush}" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Margin" Value="2" />
		<Setter Property="Template" Value="{StaticResource PoseSelectionControlTemplate}" />
		<Setter Property="Width" Value="15" />
	</Style>

</ResourceDictionary>
