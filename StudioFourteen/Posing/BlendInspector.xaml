<mvm:View
	x:Class="StudioFourteen.Posing.BlendInspector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:librarySource="clr-namespace:StudioFourteen.Library.Sources"
	xmlns:local="clr-namespace:StudioFourteen.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<StackPanel Margin="1">

		<Image
			Height="100"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Opacity="0.5"
			Source="{Binding BlendSelection.Target.Icon}"
			Stretch="Uniform" />

		<s14:Slider
			Maximum="{Binding BlendMaximum}"
			Minimum="{Binding BlendMinimum}"
			Change="1"
			Style="{DynamicResource FlatSlider}"
			Value="{Binding BlendValue}" />

		<s14:NumberBox
			Maximum="{Binding BlendMaximum}"
			Minimum="{Binding BlendMinimum}"
			Value="{Binding BlendValue}" />

		<ToggleButton
			Content="Delimit"
			IsChecked="{Binding ExtendClamps}" />

	</StackPanel>
</mvm:View>
