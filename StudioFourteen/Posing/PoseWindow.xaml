<windows:CharacterPanelBase
	x:Class="StudioFourteen.Posing.PoseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:body="clr-namespace:StudioFourteen.Posing.Body"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:hands="clr-namespace:StudioFourteen.Posing.Hands"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	xmlns:windows="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	Title="{DynamicResource LOC_Pose}"
	Width="700"
	Height="550"
	MinWidth="500"
	MinHeight="300"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	TitleIcon="fa-Running"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="180" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Column="0" Margin="1,0,2,1">

			<TabControl
				x:Name="GuiTabs"
				Padding="1"
				SelectedIndex="{Binding SelectedTab}"
				Style="{DynamicResource WpfUtilsSideTabs}">
				<pose:PoseTabItem>
					<TabItem.Header>
						<controls:IconControl Margin="12" Icon="fa-person"/>
					</TabItem.Header>

					<TabControl Margin="-3" SelectedIndex="{Binding SelectedBodyTab}">
						<pose:PoseTabItem Header="{DynamicResource LOC_Pose_Simple}">

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*" />
									<ColumnDefinition Width="2.7*" />
									<ColumnDefinition Width="1*" />
								</Grid.ColumnDefinitions>

								<body:BodySimpleView
									UpdateWithAppearance="True"
									x:Name="BodyView"
									Grid.RowSpan="3"
									Grid.Column="0"
									Margin="10"
									FlipSides="{Binding FlipSides}" />

								<pose:SimpleView
									x:Name="ClothesView"
									Grid.RowSpan="3"
									Grid.Column="1"
									Margin="10"
									FlipSides="{Binding FlipSides}"
									LayoutName="Clothes" />

								<TextBlock
									Grid.RowSpan="3"
									Grid.Column="0"
									Margin="10,0,0,0"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									FontSize="48"
									FontWeight="Bold"
									Foreground="{DynamicResource ControlBackgroundBrush}"
									IsHitTestVisible="False"
									Text="L"
									Visibility="{Binding FlipSides, Converter={StaticResource B2V}}" />

								<TextBlock
									Grid.RowSpan="3"
									Grid.Column="0"
									Margin="0,0,0,0"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									FontSize="48"
									FontWeight="Bold"
									Foreground="{DynamicResource ControlBackgroundBrush}"
									IsHitTestVisible="False"
									Text="R"
									Visibility="{Binding FlipSides, Converter={StaticResource !B2V}}" />

								<TextBlock
									Grid.RowSpan="3"
									Grid.Column="1"
									Margin="0,0,40,0"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									FontSize="48"
									FontWeight="Bold"
									Foreground="{DynamicResource ControlBackgroundBrush}"
									IsHitTestVisible="False"
									Text="R"
									Visibility="{Binding FlipSides, Converter={StaticResource B2V}}" />

								<TextBlock
									Grid.RowSpan="3"
									Grid.Column="1"
									Margin="0,0,40,0"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									FontSize="48"
									FontWeight="Bold"
									Foreground="{DynamicResource ControlBackgroundBrush}"
									IsHitTestVisible="False"
									Text="L"
									Visibility="{Binding FlipSides, Converter={StaticResource !B2V}}" />

								<Grid Grid.Column="2" Margin="0,10">
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>

									<pose:SimpleView
										x:Name="TailView"
										Grid.Row="0"
										FlipSides="{Binding FlipSides}"
										LayoutName="Tail" />

									<pose:SimpleView
										x:Name="PenisView"
										Grid.Row="1"
										FlipSides="{Binding FlipSides}"
										LayoutName="Penis" />

									<pose:SimpleView
										x:Name="VaginaView"
										Grid.Row="2"
										FlipSides="{Binding FlipSides}"
										LayoutName="Vagina" />
								</Grid>
							</Grid>
						</pose:PoseTabItem>

						<pose:PoseTabItem Header="{DynamicResource LOC_Pose_Matrix}">
							<ScrollViewer>
								<body:MatrixView />
							</ScrollViewer>
						</pose:PoseTabItem>

					</TabControl>
				</pose:PoseTabItem>

				<pose:PoseTabItem>
					<TabItem.Header>
						<controls:IconControl Margin="12" Icon="fa-hand"/>
					</TabItem.Header>

					<TabControl Margin="-3" SelectedIndex="{Binding SelectedHandsTab}">
						<pose:PoseTabItem Header="{DynamicResource LOC_Pose_Simple}">
							<Grid>
								<Rectangle
									Grid.RowSpan="3"
									Fill="Transparent"
									MouseDown="OnBackgroundMouseDown" />

								<pose:SimpleView
									x:Name="HandsView"
									Grid.Row="0"
									FlipSides="{Binding FlipSides}"
									LayoutName="Hands" />
							</Grid>
						</pose:PoseTabItem>
						<pose:PoseTabItem Header="{DynamicResource LOC_Pose_Matrix}">
							<hands:MatrixView />
						</pose:PoseTabItem>
					</TabControl>

				</pose:PoseTabItem>

				<pose:PoseTabItem>
					<TabItem.Header>
						<controls:IconControl Margin="12" Icon="fa-face-grin"/>
					</TabItem.Header>

					<TabControl
						Margin="-3"
						Padding="0"
						SelectedIndex="{Binding SelectedFaceTab}">

						<pose:PoseTabItem Header="Expression">
							<pose:ExpressionsView FlipSides="{Binding FlipSides}" ObjectTableIndex="{Binding TargetObjectIndex}" />
						</pose:PoseTabItem>

						<pose:PoseTabItem Header="{DynamicResource LOC_Pose_Simple}">
							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>

								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>

								<pose:SimpleView
									x:Name="FaceView"
									Grid.RowSpan="3"
									Grid.ColumnSpan="3"
									FlipSides="{Binding FlipSides}"
									LayoutName="Face" />

								<pose:SimpleView
									x:Name="TongueView"
									Grid.Row="2"
									Grid.Column="2"
									FlipSides="{Binding FlipSides}"
									LayoutName="Tongue" />
							</Grid>
						</pose:PoseTabItem>
					</TabControl>

				</pose:PoseTabItem>

				<pose:PoseTabItem>
					<TabItem.Header>
						<controls:IconControl Margin="12" Icon="Wing"/>
					</TabItem.Header>

					<pose:SimpleView
						x:Name="DiabolosView"
						FlipSides="{Binding FlipSides}"
						LayoutName="DiabolosWings" />

				</pose:PoseTabItem>
			</TabControl>
		</Grid>

		<Border Grid.Column="1">
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0">
					<TextBlock
						HorizontalAlignment="Center"
						Style="{DynamicResource Header}"
						Text="{Binding Selection.Name}" />

					<TextBlock
						Margin="0,0,0,3"
						HorizontalAlignment="Center"
						FontSize="10"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Style="{DynamicResource Subscript}"
						Text="{Binding Selection.Subtitle}" />
				</StackPanel>

				<Border
					Grid.Row="1"
					Margin="1"
					Style="{DynamicResource WpfUtilsControlBorder}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<ComboBox
							Grid.Column="0"
							SelectedValue="{Binding Selection.MirrorMode}"
							SelectedValuePath="Tag"
							Visibility="{Binding Selection.CanMirror, Converter={StaticResource B2V}}">

							<wpfUtils:PopOut.Header>
								<TextBlock Margin="10" Text="{DynamicResource LOC_Pose_Mirror_Header}" />
							</wpfUtils:PopOut.Header>

							<ComboBoxItem Tag="{x:Static pose:MirrorModes.None}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="22" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<controls:IconControl Grid.Column="0" Icon="fa-minus"/>
									<TextBlock Grid.Column="1" Text="{DynamicResource LOC_Pose_Mirror_None}" />
								</Grid>
							</ComboBoxItem>

							<ComboBoxItem Tag="{x:Static pose:MirrorModes.MirrorTCopyRS}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="22" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<controls:IconControl Grid.Column="0" Icon="fa-left-long"/>
									<TextBlock Grid.Column="1" Text="{DynamicResource LOC_Pose_Mirror_Copy}" />
								</Grid>
							</ComboBoxItem>

							<ComboBoxItem Tag="{x:Static pose:MirrorModes.MirrorTRCopyS}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="22" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<controls:IconControl Grid.Column="0" Icon="fa-left-right"/>
									<TextBlock Grid.Column="1" Text="{DynamicResource LOC_Pose_Mirror_Flip}" />
								</Grid>
							</ComboBoxItem>
						</ComboBox>

						<Button
							Grid.Column="1"
							Width="28"
							Background="Transparent"
							Click="OnResetSelectionClicked">
							<controls:IconControl Icon="fa-rotate-back"/>
						</Button>

						<ToggleButton
							Grid.Column="2"
							Width="28"
							Background="Transparent"
							IsChecked="{Binding Selection.LockTransform, FallbackValue=false}"
							IsEnabled="{Binding Selection.CanLockTransform, FallbackValue=false}"
							Style="{DynamicResource WpfUtilsIconToggleButton}"
							ToolTip="{DynamicResource LOC_Pose_LockTransform}">
							<controls:IconControl Grid.Column="0" Icon="fa-circle-pause"/>
						</ToggleButton>
					</Grid>
				</Border>


				<ScrollViewer
					Grid.Row="2"
					HorizontalScrollBarVisibility="Disabled"
					PanningMode="VerticalOnly">
					<Grid>

						<!--  TODO: Dynamic inspectors?  -->
						<pose:TransformInspector
							Persistence="{Binding Persistence}"
							Selection="{Binding Selection}"
							Visibility="{Binding IsSelectionTransform, Converter={StaticResource B2V}}" />

						<pose:BlendInspector
							VerticalAlignment="Top"
							Selection="{Binding Selection}"
							Visibility="{Binding IsSelectionBlend, Converter={StaticResource B2V}}" />

						<pose:EyeInspector Selection="{Binding Selection}" Visibility="{Binding IsSelectionEye, Converter={StaticResource B2V}}" />

					</Grid>
				</ScrollViewer>
			</Grid>
		</Border>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource WpfUtilsControlBorder}">

			<Grid>

				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
					<ToggleButton
						Width="100"
						Background="Transparent"
						IsChecked="{Binding FlipSides}"
						Style="{DynamicResource WpfUtilsIconToggleButton}"
						ToolTip="{DynamicResource LOC_Pose_FlipSides}">
						<TextBlock Text="Flip UI" />
					</ToggleButton>

					<Button
						Width="100"
						Background="Transparent"
						Click="OnFlipPoseClicked">
						<TextBlock Text="Flip Pose" />
					</Button>
				</StackPanel>

				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

					<Button
						Width="28"
						Background="Transparent"
						Click="OnRevertClicked"
						ToolTip="{DynamicResource LOC_Revert}">
						<controls:IconControl Icon="fa-undo"/>
					</Button>

					<Button
						Width="28"
						Background="Transparent"
						Click="OnClearClicked"
						ToolTip="{DynamicResource LOC_Pose_SelectCharacter}">
						<controls:IconControl Icon="fa-user"/>
					</Button>

					<Button
						Width="28"
						Background="Transparent"
						Click="OnReferenceClicked"
						ToolTip="{DynamicResource LOC_Pose_Reference}">
						<controls:IconControl Icon="fa-person"/>
					</Button>

					<Button
						Width="75"
						Background="Transparent"
						Click="OnImportClicked">
						<TextBlock Text="Import" />
					</Button>

					<Button
						Width="75"
						Background="Transparent"
						Click="OnExportClicked">
						<TextBlock Text="Export" />
					</Button>

				</StackPanel>
			</Grid>
		</Border>

		<wpfUtils:PopOut
			x:Name="SelectionHoverPopOut"
			Width="200"
			HorizontalAlignment="Center"
			IsHitTestVisible="False"
			Margin="0,6,0,0"
			IsOpen="{Binding IsHoverTooltipOpen}"
			PlacementTarget="{Binding HoverTarget}"
			Style="{DynamicResource WpfUtilsPopOut}">

			<wpfUtils:PopOut.Header>
				<StackPanel Margin="0,6,0,0">
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource ForegroundBrush}"
						Text="{Binding Hover.Name}" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Style="{DynamicResource Subscript}"
						Text="{Binding Hover.TypeName}" />
				</StackPanel>
			</wpfUtils:PopOut.Header>

			<StackPanel>
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Style="{DynamicResource Subscript}"
					Text="{Binding Hover.Subtitle}"
					Visibility="{Binding Hover.Subtitle, Converter={StaticResource NotEmptyToVisibility}}"/>

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Hover.Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Hover.Description, Converter={StaticResource NotEmptyToVisibility}}" />
			</StackPanel>

		</wpfUtils:PopOut>
	</Grid>
</windows:CharacterPanelBase>
