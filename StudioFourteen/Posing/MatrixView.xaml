                    <TextBlock Grid.Column="4" Grid.Row="3" Text="Pose_IVCS_Breasts" Style="{DynamicResource Label}" Margin="16, 0, 3, 0"/>
                    <StackPanel Grid.Column="5" Grid.Row="3" Orientation="Horizontal" >
