                    <StackPanel Grid.Column="4" Grid.Row="0" Orientation="Horizontal" >
                        <local:BoneView BoneName="iv_kougan_l" Label="L"/>
                        <local:BoneView BoneName="iv_kougan_r" Label="R"/>
