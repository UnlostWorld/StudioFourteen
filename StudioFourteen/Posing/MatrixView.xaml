                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Pose_Vagina" Style="{DynamicResource Label}" Margin="16, 0, 3, 0"/>
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" >
                        <local:BoneView BoneName="iv_omanko"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Grid.Row="1" Text="Pose_Clitoris" Style="{DynamicResource Label}" Margin="16, 0, 3, 0"/>
