<panels:Panel
	x:Class="StudioFourteen.Posing.PosePanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:body="clr-namespace:StudioFourteen.Posing.Body"
	xmlns:characters="clr-namespace:StudioFourteen.Scene.GameObjects.Characters"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:hands="clr-namespace:StudioFourteen.Posing.Hands"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	Width="750"
	Height="350"
	MinWidth="600"
	MinHeight="400"
	VerticalAlignment="Top"
	VerticalContentAlignment="Top"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	Subtitle="{Binding CharacterName}"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
			<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Column="0" Margin="1,0,2,1">

			<TabControl
				x:Name="GuiTabs"
				Padding="1"
				SelectedIndex="{Binding SelectedTab}"
				Style="{DynamicResource SideTabs}">
				<pose:PoseTabItem Header="{DynamicResource ICON_Pose_Body}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="2.7*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>

						<!--<Border Grid.Column="0" Width="128"
							Style="{DynamicResource ControlBorder}" />-->

						<body:BodySimpleView
							x:Name="BodyView"
							Grid.RowSpan="3"
							Grid.Column="1"
							Margin="10"
							FlipSides="{Binding FlipSides}"
							GameObject="{Binding Skeleton}"
							UpdateWithAppearance="True" />

						<pose:SimpleView
							x:Name="ClothesView"
							Grid.RowSpan="3"
							Grid.Column="2"
							Margin="10"
							FlipSides="{Binding FlipSides}"
							GameObject="{Binding Skeleton}"
							LayoutName="Clothes" />

						<TextBlock
							Grid.RowSpan="3"
							Grid.Column="1"
							Margin="10,0,0,0"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							FontSize="48"
							FontWeight="Bold"
							Foreground="{DynamicResource ControlBackgroundBrush}"
							IsHitTestVisible="False"
							Text="L"
							Visibility="{Binding FlipSides, Converter={StaticResource B2V}}" />

						<TextBlock
							Grid.RowSpan="3"
							Grid.Column="1"
							Margin="0,0,0,0"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							FontSize="48"
							FontWeight="Bold"
							Foreground="{DynamicResource ControlBackgroundBrush}"
							IsHitTestVisible="False"
							Text="R"
							Visibility="{Binding FlipSides, Converter={StaticResource !B2V}}" />

						<TextBlock
							Grid.RowSpan="3"
							Grid.Column="2"
							Margin="0,0,40,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							FontSize="48"
							FontWeight="Bold"
							Foreground="{DynamicResource ControlBackgroundBrush}"
							IsHitTestVisible="False"
							Text="R"
							Visibility="{Binding FlipSides, Converter={StaticResource B2V}}" />

						<TextBlock
							Grid.RowSpan="3"
							Grid.Column="2"
							Margin="0,0,40,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							FontSize="48"
							FontWeight="Bold"
							Foreground="{DynamicResource ControlBackgroundBrush}"
							IsHitTestVisible="False"
							Text="L"
							Visibility="{Binding FlipSides, Converter={StaticResource !B2V}}" />

						<Grid Grid.Column="3" Margin="0,10">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<pose:SimpleView
								x:Name="TailView"
								Grid.Row="0"
								FlipSides="{Binding FlipSides}"
								GameObject="{Binding Skeleton}"
								LayoutName="Tail" />

							<pose:SimpleView
								x:Name="PenisView"
								Grid.Row="1"
								FlipSides="{Binding FlipSides}"
								GameObject="{Binding Skeleton}"
								LayoutName="Penis" />

							<pose:SimpleView
								x:Name="VaginaView"
								Grid.Row="2"
								FlipSides="{Binding FlipSides}"
								GameObject="{Binding Skeleton}"
								LayoutName="Vagina" />
						</Grid>
					</Grid>
				</pose:PoseTabItem>

				<pose:PoseTabItem Header="{DynamicResource ICON_Pose_Hands}">
					<Grid>
						<Rectangle
							Grid.RowSpan="3"
							Fill="Transparent"
							MouseDown="OnBackgroundMouseDown" />

						<pose:SimpleView
							x:Name="HandsView"
							Grid.Row="0"
							FlipSides="{Binding FlipSides}"
							GameObject="{Binding Skeleton}"
							LayoutName="Hands" />
					</Grid>
				</pose:PoseTabItem>

				<pose:PoseTabItem Header="{DynamicResource ICON_Pose_Face}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
							<ColumnDefinition />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>

						<!--<Border Grid.RowSpan="3" Grid.Column="0" Width="128"
							Style="{DynamicResource ControlBorder}" />-->

						<pose:SimpleView
							x:Name="FaceView"
							Grid.RowSpan="3"
							Grid.Column="1"
							Grid.ColumnSpan="3"
							FlipSides="{Binding FlipSides}"
							GameObject="{Binding Skeleton}"
							LayoutName="Face" />

						<pose:SimpleView
							x:Name="TongueView"
							Grid.Row="2"
							Grid.Column="3"
							FlipSides="{Binding FlipSides}"
							GameObject="{Binding Skeleton}"
							LayoutName="Tongue" />
					</Grid>
				</pose:PoseTabItem>

				<pose:PoseTabItem Header="{DynamicResource ICON_Pose_Wings}">
					<pose:SimpleView
						x:Name="DiabolosView"
						FlipSides="{Binding FlipSides}"
						GameObject="{Binding Skeleton}"
						LayoutName="DiabolosWings" />
				</pose:PoseTabItem>

				<pose:PoseTabItem Header="{DynamicResource ICON_Pose_Matrix}">
					<ScrollViewer>
						<StackPanel>
							<body:MatrixView
								GameObject="{Binding Skeleton}" />
							<hands:MatrixView
								GameObject="{Binding Skeleton}" />
						</StackPanel>
					</ScrollViewer>
				</pose:PoseTabItem>
			</TabControl>
		</Grid>


		<Grid Grid.Column="1" Width="200"
			Visibility="{Binding CollapseInspector, Converter={StaticResource !B2V}}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<ContentPresenter
				Grid.Row="0"
				Margin="3,3,3,6"
				Content="{Binding Selection}"
				ContentTemplate="{DynamicResource InspectorHeader}" />

			<ScrollViewer
				Grid.Row="1"
				HorizontalScrollBarVisibility="Disabled"
				PanningMode="VerticalOnly">

				<ScrollViewer.Resources>

					<!--  Override the character inspector for basic transforms only  -->
					<DataTemplate DataType="{x:Type characters:Character}">
						<ContentPresenter Content="{Binding .}" ContentTemplate="{DynamicResource TransformSceneObjectBaseInspector}" />
					</DataTemplate>
				</ScrollViewer.Resources>

				<ContentPresenter Content="{Binding Selection}" />
			</ScrollViewer>
		</Grid>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="1"
			Style="{DynamicResource ControlBorder}">

			<Grid>

				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

					<ToggleButton Content="{DynamicResource LOC_Pose_Enable}"
						IsChecked="{Binding Skeleton.EnablePosing}" />

					<ToggleButton
						Width="100"
						Background="Transparent"
						IsChecked="{Binding FlipSides}"
						Style="{DynamicResource IconToggleButton}"
						ToolTip="{DynamicResource LOC_Pose_FlipSides}">
						<TextBlock Text="Flip UI" />
					</ToggleButton>

					<Button
						Width="100"
						Background="Transparent"
						Click="OnFlipPoseClicked">
						<TextBlock Text="Flip Pose" />
					</Button>

					<ToggleButton
						IsChecked="{Binding CollapseInspector}"
						Width="28"
						Height="28"
						Grid.ColumnSpan="2"
						VerticalAlignment="Top"
						HorizontalAlignment="Right"
						Background="Transparent"
						Style="{DynamicResource IconToggleButton}">
						<ToggleButton.Content>
							<Grid>
								<icons:IconView Icon="{DynamicResource ICON_SidebarRight_Collapse}"
									Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource !B2V}}" />
								<icons:IconView Icon="{DynamicResource ICON_SidebarRight_Expand}"
									Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, Converter={StaticResource B2V}}" />
							</Grid>
						</ToggleButton.Content>
					</ToggleButton>

				</StackPanel>

				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

					<Button
						Width="28"
						Background="Transparent"
						Click="OnRevertClicked"
						ToolTip="{DynamicResource LOC_Revert}">
						<icons:IconView Icon="{DynamicResource ICON_Pose_Reset}" />
					</Button>

					<Button
						Width="28"
						Background="Transparent"
						Click="OnReferenceClicked"
						ToolTip="{DynamicResource LOC_Pose_Reference}">
						<icons:IconView Icon="{DynamicResource ICON_Pose_Reference}" />
					</Button>

					<Button
						Width="75"
						Background="Transparent"
						Click="OnImportClicked">
						<TextBlock Text="Import" />
					</Button>

					<Button
						Width="75"
						Background="Transparent"
						Click="OnExportClicked">
						<TextBlock Text="Export" />
					</Button>

				</StackPanel>
			</Grid>
		</Border>

		<s14:PopOut
			x:Name="SelectionHoverPopOut"
			Width="200"
			Margin="0,6,0,0"
			HorizontalAlignment="Center"
			IsHitTestVisible="False"
			IsOpen="{Binding IsHoverTooltipOpen}"
			PlacementTarget="{Binding HoverTarget}"
			Style="{DynamicResource PopOut}">

			<s14:PopOut.Header>
				<StackPanel Margin="0,6,0,0">
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource ForegroundBrush}"
						Text="{Binding Hover.Name}" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource ForegroundLightBrush}"
						Style="{DynamicResource Subscript}"
						Text="{Binding Hover.TypeName}" />
				</StackPanel>
			</s14:PopOut.Header>

			<StackPanel>
				<TextBlock
					HorizontalAlignment="Center"
					Foreground="{DynamicResource ForegroundLightBrush}"
					Style="{DynamicResource Subscript}"
					Text="{Binding Hover.Subtitle}"
					Visibility="{Binding Hover.Subtitle, Converter={StaticResource NotEmptyToVisibility}}" />

				<TextBlock
					Foreground="{DynamicResource ForegroundLightBrush}"
					Text="{Binding Hover.Description}"
					TextWrapping="Wrap"
					Visibility="{Binding Hover.Description, Converter={StaticResource NotEmptyToVisibility}}" />
			</StackPanel>

		</s14:PopOut>

	</Grid>
</panels:Panel>
