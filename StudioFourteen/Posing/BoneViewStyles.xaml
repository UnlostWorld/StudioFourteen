<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StudioFourteen.Posing">
    
    <ControlTemplate x:Key="BoneViewTemplate">
        <Ellipse StrokeThickness="1" Stroke="{DynamicResource ForegroundLightBrush}"/>
    </ControlTemplate>

    <Style TargetType="{x:Type local:BoneView}">
        <Setter Property="Template" Value="{StaticResource BoneViewTemplate}"/>


        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>

    </Style>
</ResourceDictionary>