<mvm:View
	x:Class="StudioFourteen.Posing.EyeInspector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	d:DesignWidth="200"
	mc:Ignorable="d">
	<Grid>
		<StackPanel>
			<TextBlock
				HorizontalAlignment="Center"
				Style="{DynamicResource LeftLabel}"
				Text="Look"
				ToolTip="Look with your special eyes" />

			<controls:AreaSlider
				Height="{Binding ActualWidth, RelativeSource={RelativeSource Mode=Self}}"
				Margin="3"
				IsCircular="True"
				MaximumX="28"
				MaximumY="20"
				MinimumX="-28"
				MinimumY="-20"
				PreviewMouseDown="OnLookPreviewMouseDown"
				PreviewMouseUp="OnLookPreviewMouseUp"
				ValueX="{Binding LookX, Mode=TwoWay}"
				ValueY="{Binding LookY, Mode=TwoWay}" />


			<TextBlock Style="{DynamicResource LeftLabel}" Text="Iris Size" />
			<controls:NumberBox
				Maximum="2"
				Minimum="0.75"
				Slider="Absolute"
				TickFrequency="0.01"
				Value="{Binding IrisSize}" />


		</StackPanel>
	</Grid>
</mvm:View>
