<shared:PoseViewBase
	x:Class="StudioFourteen.Posing.Hands.MatrixView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shared="clr-namespace:StudioFourteen.Posing.Shared"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Grid>
		<StackPanel>

			<GroupBox Header="{DynamicResource LOC_PoseMatrix_LeftHandCategory}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<TextBlock
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Wrist}" />
					<StackPanel Grid.Row="0" Grid.Column="1">
						<shared:SkeletonBoneControl SelectionName="n_hte_l" />
					</StackPanel>

					<TextBlock
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Hand}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl SelectionName="j_te_l" />
					</StackPanel>

					<TextBlock
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Weapon}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="5"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl SelectionName="n_buki_l" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Thumb}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_oya_a_l" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_oya_b_l" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Index}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_hito_a_l" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_hito_b_l" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_hito_c_l" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Middle}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="5"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_naka_a_l" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_naka_b_l" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_naka_c_l" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Ring}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_kusu_a_l" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_kusu_b_l" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_kusu_c_l" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Pinky}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_ko_a_l" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_ko_b_l" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_ko_c_l" />
					</StackPanel>

				</Grid>
			</GroupBox>

			<GroupBox Header="{DynamicResource LOC_PoseMatrix_RightHandCategory}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />

					</Grid.RowDefinitions>

					<TextBlock
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Wrist}" />
					<StackPanel Grid.Row="0" Grid.Column="1">
						<shared:SkeletonBoneControl SelectionName="n_hte_r" />
					</StackPanel>

					<TextBlock
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Hand}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl SelectionName="j_te_r" />
					</StackPanel>

					<TextBlock
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Weapon}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="5"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl SelectionName="n_buki_r" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Thumb}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_oya_a_r" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_oya_b_r" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Index}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_hito_a_r" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_hito_b_r" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_hito_c_r" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Middle}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="5"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_naka_a_r" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_naka_b_r" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_naka_c_r" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Ring}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_kusu_a_r" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_kusu_b_r" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_kusu_c_r" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Pinky}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="3"
						Orientation="Horizontal">
						<shared:SkeletonBoneControl Label="1" SelectionName="j_ko_a_r" />
						<shared:SkeletonBoneControl Label="2" SelectionName="j_ko_b_r" />
						<shared:SkeletonBoneControl Label="3" SelectionName="iv_ko_c_r" />
					</StackPanel>

				</Grid>
			</GroupBox>
		</StackPanel>
	</Grid>
</shared:PoseViewBase>
