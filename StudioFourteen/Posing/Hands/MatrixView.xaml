<UserControl
	x:Class="StudioFourteen.Posing.Hands.MatrixView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=WpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="B2V" />
		<converters:InvertedBoolToVisibilityConverter x:Key="!B2V" />
		<converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
	</UserControl.Resources>

	<Grid>
		<StackPanel>

			<GroupBox Header="{DynamicResource LOC_PoseMatrix_LeftHandCategory}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />

					</Grid.RowDefinitions>

					<TextBlock
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Wrist}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="1">
						<local:BoneView BoneName="n_hte_l" />
					</StackPanel>
					
					<TextBlock
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Hand}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_te_l" />
					</StackPanel>

					<TextBlock
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Weapon}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="5"
						Orientation="Horizontal">
						<local:BoneView BoneName="n_buki_l" />
					</StackPanel>

					<TextBlock
						Grid.Column="0"
						Grid.Row="1"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Thumb}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_oya_a_l" Label="1" />
						<local:BoneView BoneName="j_oya_b_l" Label="2" />
					</StackPanel>

					<TextBlock
						Grid.Column="2"
						Grid.Row="1"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Index}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_hito_a_l" Label="1" />
						<local:BoneView BoneName="j_hito_b_l" Label="2" />
						<local:BoneView BoneName="iv_hito_c_l" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Middle}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="5"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_naka_a_l" Label="1" />
						<local:BoneView BoneName="j_naka_b_l" Label="2" />
						<local:BoneView BoneName="iv_naka_c_l" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Ring}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_kusu_a_l" Label="1" />
						<local:BoneView BoneName="j_kusu_b_l" Label="2" />
						<local:BoneView BoneName="iv_kusu_c_l" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Pinky}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_ko_a_l" Label="1" />
						<local:BoneView BoneName="j_ko_b_l" Label="2" />
						<local:BoneView BoneName="iv_ko_c_l" Label="3" />
					</StackPanel>

				</Grid>
			</GroupBox>

			<GroupBox Header="{DynamicResource LOC_PoseMatrix_RightHandCategory}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />

					</Grid.RowDefinitions>

					<TextBlock
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Wrist}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="1">
						<local:BoneView BoneName="n_hte_r" />
					</StackPanel>
					
					<TextBlock
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Hand}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_te_r" />
					</StackPanel>

					<TextBlock
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Weapon}" />
					<StackPanel
						Grid.Row="0"
						Grid.Column="5"
						Orientation="Horizontal">
						<local:BoneView BoneName="n_buki_r" />
					</StackPanel>

					<TextBlock
						Grid.Column="0"
						Grid.Row="1"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Thumb}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_oya_a_r" Label="1" />
						<local:BoneView BoneName="j_oya_b_r" Label="2" />
					</StackPanel>

					<TextBlock
						Grid.Column="2"
						Grid.Row="1"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Index}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_hito_a_r" Label="1" />
						<local:BoneView BoneName="j_hito_b_r" Label="2" />
						<local:BoneView BoneName="iv_hito_c_r" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="1"
						Grid.Column="4"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Middle}" />
					<StackPanel
						Grid.Row="1"
						Grid.Column="5"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_naka_a_r" Label="1" />
						<local:BoneView BoneName="j_naka_b_r" Label="2" />
						<local:BoneView BoneName="iv_naka_c_r" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Ring}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_kusu_a_r" Label="1" />
						<local:BoneView BoneName="j_kusu_b_r" Label="2" />
						<local:BoneView BoneName="iv_kusu_c_r" Label="3" />
					</StackPanel>

					<TextBlock
						Grid.Row="2"
						Grid.Column="2"
						Margin="16,0,3,0"
						Style="{DynamicResource Label}"
						Text="{DynamicResource LOC_Pose_Pinky}" />
					<StackPanel
						Grid.Row="2"
						Grid.Column="3"
						Orientation="Horizontal">
						<local:BoneView BoneName="j_ko_a_r" Label="1" />
						<local:BoneView BoneName="j_ko_b_r" Label="2" />
						<local:BoneView BoneName="iv_ko_c_r" Label="3" />
					</StackPanel>

				</Grid>
			</GroupBox>
		</StackPanel>
	</Grid>
</UserControl>
