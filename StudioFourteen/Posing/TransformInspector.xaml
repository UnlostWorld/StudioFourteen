<mvm:View
	x:Class="StudioFourteen.Posing.TransformInspector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Posing"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:pose="clr-namespace:StudioFourteen.Posing"
	xmlns:windows="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<Grid IsEnabled="{Binding Selection.IsReady}">
		<StackPanel>
			<Grid Margin="1,3,1,1">
				<Border Style="{DynamicResource WpfUtilsControlBorder}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid
							Grid.Row="0"
							Height="168">
							<pose:RotationGizmo Rotation="{Binding WorldRotation, Mode=TwoWay}" />
						</Grid>

						<ListBox
							Grid.Row="1"
							SelectedIndex="{Binding Services.Pose.EditMode}"
							Style="{DynamicResource WpfUtilsSwitchSelectorNoBorder}">

							<ListBoxItem Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}">
								<wpfUtils:IconBlock
									Icon="Arrows"
									ToolTip="{DynamicResource LOC_Translate}" />
							</ListBoxItem>

							<ListBoxItem Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}">
								<wpfUtils:IconBlock
									Icon="Rotate"
									ToolTip="{DynamicResource LOC_Rotate}" />
							</ListBoxItem>

							<ListBoxItem Style="{DynamicResource WpfUtilsSwitchSelectorItemStyle}">
								<wpfUtils:IconBlock
									Icon="Maximize"
									ToolTip="{DynamicResource LOC_Scale}" />
							</ListBoxItem>
						</ListBox>
					</Grid>
				</Border>
			</Grid>

			<!--  Translate  -->
			<Expander IsExpanded="{Binding ExpandTranslationSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						DecimalPlaces="{Binding DecimalPlacesDisplay}"
						X="{Binding TranslationX}"
						Y="{Binding TranslationY}"
						Z="{Binding TranslationZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="Arrows"
								ToolTip="{DynamicResource LOC_Translate}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_TranslationSliderX"
						Grid.Row="0"
						Grid.Column="1"
						LargeChange="{Binding Selection.TranslationLargeChange}"
						RelativeRange="{Binding Selection.TranslationRange}"
						RelativeValue="{Binding TranslationX}"
						SmallChange="{Binding Selection.TranslationSmallChange}" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_TranslationSliderY"
						Grid.Row="1"
						Grid.Column="1"
						LargeChange="{Binding Selection.TranslationLargeChange}"
						RelativeRange="{Binding Selection.TranslationRange}"
						RelativeValue="{Binding TranslationY}"
						SmallChange="{Binding Selection.TranslationSmallChange}" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_TranslationSliderZ"
						Grid.Row="2"
						Grid.Column="1"
						LargeChange="{Binding Selection.TranslationLargeChange}"
						RelativeRange="{Binding Selection.TranslationRange}"
						RelativeValue="{Binding TranslationZ}"
						SmallChange="{Binding Selection.TranslationSmallChange}" />
				</Grid>
			</Expander>

			<!--  Rotate  -->
			<Expander IsExpanded="{Binding ExpandRotationSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						DecimalPlaces="{Binding DecimalPlacesDisplay}"
						X="{Binding EulerRotationX}"
						Y="{Binding EulerRotationY}"
						Z="{Binding EulerRotationZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="Rotate"
								ToolTip="{DynamicResource LOC_Rotation}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:Slider
						Grid.Row="0"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						MouseDown="OnEulerDown"
						MouseUp="OnEulerUp"
						SmallChange="1"
						Value="{Binding EulerRotationX}" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:Slider
						Grid.Row="1"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						MouseDown="OnEulerDown"
						MouseUp="OnEulerUp"
						SmallChange="1"
						Value="{Binding EulerRotationY}" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:Slider
						Grid.Row="2"
						Grid.Column="1"
						Maximum="179.9"
						Minimum="-179.9"
						MouseDown="OnEulerDown"
						MouseUp="OnEulerUp"
						SmallChange="1"
						Value="{Binding EulerRotationZ}" />
				</Grid>
			</Expander>

			<!--  Scale  -->
			<Expander IsExpanded="{Binding ExpandScaleSliders}">
				<Expander.Header>
					<wpfUtils:MultiNumberBox
						Margin="0"
						DecimalPlaces="{Binding DecimalPlacesDisplay}"
						X="{Binding ScaleX}"
						Y="{Binding ScaleY}"
						Z="{Binding ScaleZ}">
						<wpfUtils:MultiNumberBox.Prefix>
							<wpfUtils:IconBlock
								Margin="6,1,2,0"
								Foreground="{DynamicResource BackgroundLightBrush}"
								Icon="Maximize"
								ToolTip="{DynamicResource LOC_Scale}" />
						</wpfUtils:MultiNumberBox.Prefix>
					</wpfUtils:MultiNumberBox>

				</Expander.Header>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="X:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_ScaleSliderX"
						Grid.Row="0"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleX}"
						SmallChange="0.01" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Y:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_ScaleSliderY"
						Grid.Row="1"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleY}"
						SmallChange="0.01" />

					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Margin="3,0"
						Style="{DynamicResource RightLabel}"
						Text="Z:" />
					<wpfUtils:RelativeSlider
						x:Name="PART_ScaleSliderZ"
						Grid.Row="2"
						Grid.Column="1"
						RelativeRange="1"
						RelativeValue="{Binding ScaleZ}"
						SmallChange="0.01" />
				</Grid>
			</Expander>
		</StackPanel>
	</Grid>

</mvm:View>
