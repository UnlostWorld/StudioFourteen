<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.Controls"
	xmlns:svg="https://github.com/dotnetprojects/SVGImage"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<ControlTemplate
		x:Key="IconControlTemplate"
		TargetType="{x:Type local:IconControl}">

		<ControlTemplate.Resources>
			<DataTemplate DataType="{x:Type local:FontAwesomeIcon}">
				<Viewbox>
					<fa:IconBlock
						Margin="0"
						FontSize="64"
						Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:IconControl}}, Path=Foreground}"
						Icon="{Binding Icon}"
						IconFont="{Binding Font}" />
				</Viewbox>
			</DataTemplate>

			<DataTemplate DataType="{x:Type sys:String}">
				<svg:SVGImage
					UriSource="{Binding .}" />
			</DataTemplate>
		</ControlTemplate.Resources>

		<ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
	</ControlTemplate>

	<Style TargetType="{x:Type local:IconControl}">
		<Setter Property="Height" Value="14" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Template" Value="{StaticResource IconControlTemplate}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Width" Value="14" />
	</Style>
</ResourceDictionary>
