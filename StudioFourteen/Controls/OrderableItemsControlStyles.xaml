<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:shapes="clr-namespace:StudioFourteen.Shapes">

	<ControlTemplate x:Key="StudioOrderbleItemTemplate" TargetType="{x:Type controls:OrderableItemControl}">
		<Border Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="24" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<controls:Grip
					x:Name="PART_Grip"
					Grid.Column="0"
					Direction="Vertical" />

				<ContentPresenter
					Grid.Column="1"
					Content="{TemplateBinding Content}"
					ContentTemplate="{TemplateBinding ContentTemplate}" />
			</Grid>
		</Border>
	</ControlTemplate>

	<Style x:Key="StudioOrderableItem" TargetType="{x:Type controls:OrderableItemControl}">
		<Setter Property="Template" Value="{StaticResource StudioOrderbleItemTemplate}"/>
	</Style>

	<Style TargetType="{x:Type controls:OrderableItemsControl}">
		<Setter Property="ItemContainerStyle" Value="{StaticResource StudioOrderableItem}"/>
	</Style>

</ResourceDictionary>
