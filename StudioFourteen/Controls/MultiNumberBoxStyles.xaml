<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:StudioFourteen.Controls"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils">


	<ControlTemplate TargetType="{x:Type local:MultiNumberBox}"
		x:Key="MultiNumberBoxTemplate">
		<Grid>
			<ItemsControl ItemsSource="{TemplateBinding Channels}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="22" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Margin="3,0"
								Style="{DynamicResource RightLabel}"
								Text="{Binding Label}" />

							<local:NumberBox
								Grid.Row="0"
								Grid.Column="1"
								Change="{Binding Change}"
								Maximum="{Binding Maximum}"
								Minimum="{Binding Minimum}"
								Value="{Binding Value}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>
	</ControlTemplate>

	<Style x:Key="StudioMultiNumberBox"
		TargetType="{x:Type local:MultiNumberBox}">
		<Setter Property="Template" Value="{StaticResource MultiNumberBoxTemplate}" />
	</Style>

	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:Color4Box}" >
		<Setter Property="Minimum" Value="0"/>
		<Setter Property="Maximum" Value="1"/>
		<Setter Property="Change" Value="0.1"/>
	</Style>

	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:Color3Box}" >
		<Setter Property="Minimum" Value="0"/>
		<Setter Property="Maximum" Value="1"/>
		<Setter Property="Change" Value="0.1"/>
	</Style>


	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:Vector4Box}" />

	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:Vector3Box}" />

	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:Vector2Box}" />

	<Style BasedOn="{StaticResource StudioMultiNumberBox}"
		TargetType="{x:Type local:QuaternionBox}" >
		<Setter Property="Minimum" Value="-180"/>
		<Setter Property="Maximum" Value="180"/>
		<Setter Property="Change" Value="5"/>
	</Style>

</ResourceDictionary>