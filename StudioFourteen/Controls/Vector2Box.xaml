<mvm:View
	x:Class="StudioFourteen.Controls.Vector2Box"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	x:Name="View"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<Expander IsExpanded="{Binding Expand, ElementName=View}">
		<Expander.Header>
			<wpfUtils:MultiNumberBox
				Margin="0"
				AxisCount="2"
				DecimalPlaces="{Binding DecimalPlaces, ElementName=View}"
				Maximum="{Binding Maximum, ElementName=View}"
				Minimum="{Binding Minimum, ElementName=View}"
				X="{Binding ValueX, ElementName=View}"
				Y="{Binding ValueY, ElementName=View}">
				<wpfUtils:MultiNumberBox.Prefix>
					<wpfUtils:IconBlock
						Margin="6,1,2,0"
						Foreground="{DynamicResource BackgroundLightBrush}"
						Icon="{Binding Icon, ElementName=View}" />
				</wpfUtils:MultiNumberBox.Prefix>
			</wpfUtils:MultiNumberBox>

		</Expander.Header>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Margin="3,0"
				Style="{DynamicResource RightLabel}"
				Text="X:" />


			<TextBlock
				Grid.Row="1"
				Grid.Column="0"
				Margin="3,0"
				Style="{DynamicResource RightLabel}"
				Text="Y:" />

		</Grid>
	</Expander>
</mvm:View>
