<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Controls">

	<ControlTemplate x:Key="RadioButtonHighlight"
		TargetType="{x:Type s14:RadioButtonHighlighter}">
		<Grid>

			<Grid x:Name="PART_Highlight" IsHitTestVisible="False">
				<Border
					Margin="2"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Background="{DynamicResource BackgroundBrush}"
					CornerRadius="4"
					SnapsToDevicePixels="True" />
			</Grid>
			<ContentPresenter />
		</Grid>
	</ControlTemplate>

	<Style x:Key="RadioButtonHighlighter"
		TargetType="{x:Type s14:RadioButtonHighlighter}">
		<Setter Property="Focusable" Value="False" />

		<Setter Property="Template" Value="{StaticResource RadioButtonHighlight}" />
	</Style>

</ResourceDictionary>