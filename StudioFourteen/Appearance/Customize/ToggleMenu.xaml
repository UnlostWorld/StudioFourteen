<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Xaml"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

	<DataTemplate DataType="{x:Type local:ToggleMenu}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.ColumnSpan="2"
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}"
				Visibility="{Binding Name, Converter={StaticResource NotNullToVisibilityConverter}}" />

			<ToggleButton
				Grid.Row="1"
				Grid.Column="0"
				IsChecked="{Binding IsChecked}" />

			<ContentPresenter
				Grid.Row="1"
				Grid.Column="1"
				Content="{Binding InnerMenu}" />

		</Grid>
	</DataTemplate>
</ResourceDictionary>
