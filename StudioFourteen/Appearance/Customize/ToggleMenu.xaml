<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate DataType="{x:Type local:ToggleMenu}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.ColumnSpan="2"
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}"
				Visibility="{Binding Name, Converter={StaticResource NotNullToVisibilityConverter}}" />

			<ToggleButton
				Grid.Row="1"
				Grid.Column="0"
				IsChecked="{Binding IsChecked}" />

			<ContentPresenter
				Grid.Row="1"
				Grid.Column="1"
				Content="{Binding InnerMenu}" />

		</Grid>
	</DataTemplate>
</ResourceDictionary>