<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate DataType="{x:Type local:ToggleMenu}">
		<StackPanel>
			<ToggleButton
				Content="{Binding Name}"
				IsChecked="{Binding IsChecked}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>