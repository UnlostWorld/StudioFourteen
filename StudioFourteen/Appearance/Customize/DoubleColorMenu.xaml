<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:DoubleColorMenu}">
		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}" />

			<ContentPresenter
				Grid.Column="0"
				Margin="1"
				Content="{Binding Left}" />

			<ContentPresenter
				Grid.Column="1"
				Margin="1"
				Content="{Binding Right}" />

		</StackPanel>
	</DataTemplate>
</ResourceDictionary>