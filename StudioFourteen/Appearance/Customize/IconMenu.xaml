<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:IconMenu}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />

			<controls:SwitchSelector
				Height="Auto"
				HorizontalContentAlignment="Center"
				ItemsSource="{Binding Options}"
				SelectedItem="{Binding Selected}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Image
							Width="42"
							Height="42"
							Margin="0,2"
							Source="{Binding Image.Source}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</controls:SwitchSelector>

			<controls:NumberBox
				Maximum="{Binding Maximum}"
				Minimum="{Binding Minimum}"
				Value="{Binding Value}" />

		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
