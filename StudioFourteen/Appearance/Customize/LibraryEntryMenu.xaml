<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate DataType="{x:Type local:LibraryEntryMenu}">
		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}" />
			<library:LibrarySelectorButton
				Type="{Binding EntryType}"
				Value="{Binding Entry}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>