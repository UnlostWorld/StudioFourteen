<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:PercentageMenu}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />

			<s14:NumberBox
				Maximum="{Binding Maximum}"
				Minimum="{Binding Minimum}"
				Value="{Binding Value}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
