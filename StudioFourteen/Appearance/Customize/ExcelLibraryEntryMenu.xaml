<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:ExcelLibraryEntryMenu}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />
			<librarySelector:LibrarySelectorButton Type="{Binding EntryType}" Value="{Binding Entry}">

				<librarySelector:LibrarySelectorButton.PopOutHeader>
					<TextBlock Margin="12" Text="{Binding Name}" />
				</librarySelector:LibrarySelectorButton.PopOutHeader>
			</librarySelector:LibrarySelectorButton>

		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
