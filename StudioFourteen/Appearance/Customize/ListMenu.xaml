<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:ListMenu}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />

			<s14:SwitchSelector ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Label}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</s14:SwitchSelector>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
