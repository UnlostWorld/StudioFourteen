<UserControl
	x:Class="StudioFourteen.Appearance.Customize.CustomizeIconOption"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:WpfUtils.Converters;assembly=wpfUtils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Width="80"
	mc:Ignorable="d">

	<UserControl.Resources>
		<converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
		<BooleanToVisibilityConverter x:Key="B2V" />
		<converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
		<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
	</UserControl.Resources>

	<Grid x:Name="ContentArea">

		<ComboBox
			Height="54"
			ItemsSource="{Binding Options}"
			SelectedItem="{Binding SelectedOption}">

			<ComboBox.ToolTip>
				<StackPanel>
					<TextBlock Text="{Binding Menu.Name}" />
					<TextBlock
						Text="{Binding SelectedOption.Item.Name}"
						Visibility="{Binding SelectedOption.Item.Name, FallbackValue=Collapsed, Converter={StaticResource NotEmptyToVisibilityConverter}}" />
				</StackPanel>
			</ComboBox.ToolTip>

			<ComboBox.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid
						Width="350"
						Columns="4" />
				</ItemsPanelTemplate>
			</ComboBox.ItemsPanel>

			<ComboBox.ItemTemplate>
				<DataTemplate>
					<Viewbox>
						<Grid Visibility="{Binding Enabled, Converter={StaticResource B2V}}">

							<Grid
								x:Name="Icon"
								Width="64"
								Height="64"
								Margin="0,2"
								RenderTransformOrigin="0.5,0.5"
								SnapsToDevicePixels="True">

								<Grid.RenderTransform>
									<ScaleTransform ScaleX="1" />
								</Grid.RenderTransform>

								<Image
									Margin="1,1,1,3"
									Source="{Binding Icon.Source}"
									Stretch="Uniform" />

								<controls:XivTexImage
									Margin="-3"
									Path="ui/uld/icona_frame_hr1.tex"
									Rect="0, 0, 96, 96" />

							</Grid>

							<Grid
								x:Name="ItemOverlay"
								Background="Transparent"
								ToolTip="{Binding Item}"
								Visibility="Collapsed">

								<Grid
									Width="20"
									Height="20"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom">

									<Image Source="{Binding Item.Icon.Source}" />

									<controls:XivTexImage
										Path="ui/uld/icona_frame_hr1.tex"
										Rect="0, 0, 96, 96"
										SnapsToDevicePixels="True" />
								</Grid>

							</Grid>
						</Grid>
					</Viewbox>

					<DataTemplate.Triggers>
						<DataTrigger
							Binding="{Binding Item.Icon.Source, Converter={StaticResource NotNullToBoolConverter}}"
							Value="True">
							<Setter TargetName="ItemOverlay" Property="Visibility" Value="Visible" />
						</DataTrigger>

						<DataTrigger
							Binding="{Binding Flipped, RelativeSource={RelativeSource AncestorType=local:CustomizeIconOption}}"
							Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Icon"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											To="-1"
											Duration="0:0:0.150">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Icon"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											To="1"
											Duration="0:0:0.150">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</DataTemplate.Triggers>

				</DataTemplate>
			</ComboBox.ItemTemplate>


		</ComboBox>

	</Grid>
</UserControl>
