<UserControl
	x:Class="StudioFourteen.Appearance.Customize.CustomizeNumberOption"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=wpfUtils"
	Height="26"
	d:DesignWidth="256"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/wpfUtils;component/Styles/ListBoxStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid x:Name="ContentArea">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Border
			Grid.Column="1"
			Margin="1,0,0,0"
			CornerRadius="0,6,6,0"
			Style="{DynamicResource WpfUtilsControlBorder}">

			<ToggleButton
				x:Name="ShowCustom"
				Width="28"
				Margin="0"
				Background="Transparent"
				IsChecked="{Binding ManualEntry}">
				<wpfUtils:IconBlock
					FontSize="10"
					Icon="Pen" />
			</ToggleButton>
		</Border>

		<Border
			Grid.Column="0"
			CornerRadius="6,0,0,6"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>

				<ListBox
					x:Name="ValueList"
					Height="26"
					Margin="0"
					ItemsSource="{Binding Menu.Values}"
					SelectedItem="{Binding Value}">
					<ListBox.RenderTransform>
						<TranslateTransform />
					</ListBox.RenderTransform>

					<ListBox.Style>
						<Style
							BasedOn="{StaticResource WpfUtilsSwitchSelectorNoBorder}"
							TargetType="{x:Type ListBox}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding ManualEntry}"
									Value="True">
									<DataTrigger.EnterActions>
										<StopStoryboard BeginStoryboardName="FromManual" />
										<BeginStoryboard Name="ToManual">
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
													To="-28"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.EnterActions>
									<DataTrigger.ExitActions>
										<StopStoryboard BeginStoryboardName="ToManual" />
										<BeginStoryboard Name="FromManual">
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
													From="-28"
													To="0"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.ExitActions>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ListBox.Style>
				</ListBox>

				<wpfUtils:NumberBox
					Grid.Column="0"
					Height="{Binding ActualHeight, ElementName=ListSelector}"
					Margin="0"
					BorderBrush="Transparent"
					Buttons="True"
					Value="{Binding Value}">
					<wpfUtils:NumberBox.RenderTransform>
						<TranslateTransform Y="28" />
					</wpfUtils:NumberBox.RenderTransform>

					<wpfUtils:NumberBox.Style>
						<Style TargetType="{x:Type wpfUtils:NumberBox}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding ManualEntry}"
									Value="True">

									<DataTrigger.EnterActions>

										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
													From="28"
													To="0"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.EnterActions>
									<DataTrigger.ExitActions>

										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
													From="0"
													To="28"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.ExitActions>

								</DataTrigger>
							</Style.Triggers>
						</Style>
					</wpfUtils:NumberBox.Style>

				</wpfUtils:NumberBox>

			</Grid>

		</Border>
	</Grid>
</UserControl>
