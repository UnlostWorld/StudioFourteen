<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate DataType="{x:Type local:SelectorMenu}">
		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}"
				Visibility="{Binding Name, Converter={StaticResource NotNullToVisibilityConverter}}" />
			<ListBox
				ItemsSource="{Binding Options}"
				SelectedItem="{Binding Selected}"
				Style="{DynamicResource WpfUtilsSwitchSelector}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Label}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>