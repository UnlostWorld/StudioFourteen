<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:GenderMenu}">

		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />

			<s14:SwitchSelector SelectedIndex="{Binding Value}">
				<ListBoxItem>Masculine</ListBoxItem>
				<ListBoxItem>Feminine</ListBoxItem>
			</s14:SwitchSelector>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
