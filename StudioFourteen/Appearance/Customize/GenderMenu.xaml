<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<DataTemplate DataType="{x:Type local:GenderMenu}">

		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}" />

			<ListBox
				SelectedIndex="{Binding Value}"
				Style="{DynamicResource WpfUtilsSwitchSelector}">
				<ListBoxItem>Masculine</ListBoxItem>
				<ListBoxItem>Feminine</ListBoxItem>
			</ListBox>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>