<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:converters="clr-namespace:StudioFourteen.Converters"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<BooleanToVisibilityConverter x:Key="B2V" />
	<converters:EnumToVisibilityConverter x:Key="EnumToVisibility" />

	<DataTemplate DataType="{x:Type local:MultiIconMenu}">
		<StackPanel>
			<TextBlock Style="{DynamicResource LeftLabel}" Text="{Binding Name}" />

			<Border Style="{DynamicResource ControlBorder}">

				<ItemsControl
					Height="Auto"
					HorizontalContentAlignment="Center"
					ItemsSource="{Binding Options}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ToggleButton IsChecked="{Binding IsChecked}"
								Style="{DynamicResource IconToggleButton}">
								<Grid>
									<Border
										Background="{DynamicResource BackgroundBrush}"
										BorderBrush="{DynamicResource TrimBrush}"
										BorderThickness="1"
										CornerRadius="6"
										Visibility="{Binding IsChecked, Converter={StaticResource B2V}}" />

									<Image
										Width="42"
										Height="42"
										Margin="0,2"
										Source="{Binding Image.Source}"
										Visibility="{Binding Index, Converter={StaticResource EnumToVisibility}, ConverterParameter='!LegacyTattoo'}" />

									<Image
										Width="42"
										Height="42"
										Margin="0,2"
										Source="pack://application:,,,/StudioFourteen;component/Assets/LegacyTattoo.png"
										Visibility="{Binding Index, Converter={StaticResource EnumToVisibility}, ConverterParameter='LegacyTattoo'}" />

								</Grid>
							</ToggleButton>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>

		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
