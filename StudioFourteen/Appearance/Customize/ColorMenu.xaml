<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/WpfUtils;component/Styles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Color Menu  -->
	<DataTemplate DataType="{x:Type local:ColorMenu}">
		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}"
				Visibility="{Binding Name, Converter={StaticResource NotNullToVisibilityConverter}}" />

			<Grid x:Name="ContentArea">

				<Grid.ColumnDefinitions>
					<ColumnDefinition MaxWidth="64" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Border
					Grid.ColumnSpan="2"
					Style="{DynamicResource WpfUtilsControlBorder}" />

				<ToggleButton
					Name="ToggleButton"
					Margin="0"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Stretch"
					Background="Transparent"
					Style="{DynamicResource WpfUtilsIconToggleButton}">
					<Border
						Margin="5,6,5,5"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						CornerRadius="3">
						<Border.Background>
							<SolidColorBrush Color="{Binding Selected.Color}" />
						</Border.Background>
					</Border>
				</ToggleButton>

				<controls:PopOut
					Background="{DynamicResource ControlBackgroundBrush}"
					IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=ToggleButton}"
					PlacementTarget="{Binding ElementName=ToggleButton}"
					StaysOpen="False"
					Style="{DynamicResource WpfUtilsPopOut}">

					<controls:PopOut.Header>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.ColumnSpan="2"
								Margin="6,3,6,6"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding Name}" />

							<controls:NumberBox
								Grid.Row="1"
								Grid.Column="0"
								Buttons="True"
								Value="{Binding Value}" />

							<TextBox
								Grid.Row="1"
								Grid.Column="1"
								Width="64"
								IsReadOnly="True"
								Text="{Binding Selected.Hex}" />
						</Grid>
					</controls:PopOut.Header>


					<Grid>
						<ListBox
							ItemsSource="{Binding Options}"
							SelectedItem="{Binding Selected}">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="8" />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<Rectangle
										Width="20"
										Height="20"
										Margin="0">
										<Rectangle.Fill>
											<SolidColorBrush Color="{Binding Color, FallbackValue=Transparent}" />
										</Rectangle.Fill>
									</Rectangle>
								</DataTemplate>
							</ListBox.ItemTemplate>

							<ListBox.ItemContainerStyle>
								<Style
									BasedOn="{StaticResource WpfUtilsListBoxItem}"
									TargetType="{x:Type ListBoxItem}">
									<Setter Property="Padding" Value="0" />
									<Setter Property="Margin" Value="0" />
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="VerticalContentAlignment" Value="Stretch" />
									<Setter Property="HorizontalAlignment" Value="Stretch" />
									<Setter Property="VerticalAlignment" Value="Stretch" />

									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="{x:Type ListBoxItem}">
												<Grid
													Margin="0"
													Background="Transparent">

													<ContentPresenter
														Margin="0"
														Content="{TemplateBinding Content}"
														ContentTemplate="{TemplateBinding ContentTemplate}" />

													<Border
														x:Name="HoverBorder"
														BorderBrush="{DynamicResource BackgroundLightBrush}"
														BorderThickness="1"
														CornerRadius="0"
														IsHitTestVisible="False"
														Opacity="0"
														SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
														<Border.Background>
															<SolidColorBrush
																Opacity="0.25"
																Color="White" />
														</Border.Background>
													</Border>

													<Border
														x:Name="SelectionBorder"
														BorderBrush="{DynamicResource TrimBrush}"
														BorderThickness="1"
														CornerRadius="0"
														IsHitTestVisible="False"
														Opacity="0" />
												</Grid>

												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Trigger.EnterActions>
															<BeginStoryboard>
																<Storyboard>
																	<DoubleAnimation
																		Storyboard.TargetName="HoverBorder"
																		Storyboard.TargetProperty="Opacity"
																		To="1"
																		Duration="0:00:00.150">
																		<DoubleAnimation.EasingFunction>
																			<SineEase EasingMode="EaseOut" />
																		</DoubleAnimation.EasingFunction>
																	</DoubleAnimation>
																</Storyboard>
															</BeginStoryboard>
														</Trigger.EnterActions>
														<Trigger.ExitActions>
															<BeginStoryboard>
																<Storyboard>
																	<DoubleAnimation
																		Storyboard.TargetName="HoverBorder"
																		Storyboard.TargetProperty="Opacity"
																		To="0"
																		Duration="0:00:00.250">
																		<DoubleAnimation.EasingFunction>
																			<SineEase EasingMode="EaseIn" />
																		</DoubleAnimation.EasingFunction>
																	</DoubleAnimation>
																</Storyboard>
															</BeginStoryboard>
														</Trigger.ExitActions>
													</Trigger>
													<Trigger Property="IsSelected" Value="True">
														<Setter TargetName="SelectionBorder" Property="Opacity" Value="1" />
													</Trigger>
												</ControlTemplate.Triggers>

											</ControlTemplate>
										</Setter.Value>
									</Setter>

								</Style>
							</ListBox.ItemContainerStyle>
						</ListBox>
					</Grid>

				</controls:PopOut>

				<controls:NumberBox
					Grid.Column="1"
					Margin="0"
					BorderBrush="Transparent"
					Buttons="True"
					Maximum="255"
					Minimum="0"
					Value="{Binding Value}" />

			</Grid>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>