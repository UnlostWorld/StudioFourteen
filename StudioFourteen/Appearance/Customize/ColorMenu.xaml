<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s14="clr-namespace:StudioFourteen.Xaml"
	xmlns:converters="clr-namespace:StudioFourteen.Xaml"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Customize">

	<converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />

	<!--  Color Menu  -->
	<DataTemplate DataType="{x:Type local:ColorMenu}">
		<StackPanel>
			<TextBlock
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Name}"
				Visibility="{Binding Name, Converter={StaticResource NotNullToVisibilityConverter}}" />

			<Grid x:Name="ContentArea" Margin="1">

				<Grid.ColumnDefinitions>
					<ColumnDefinition MaxWidth="64" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Border Grid.ColumnSpan="2" Style="{DynamicResource ControlBorder}" />

				<ToggleButton
					Name="ToggleButton"
					Margin="0"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Stretch"
					Background="Transparent"
					Style="{DynamicResource IconToggleButton}">
					<Border
						Margin="5,6,5,5"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						CornerRadius="3">
						<Border.Background>
							<SolidColorBrush Color="{Binding Selected.Color}" />
						</Border.Background>
					</Border>
				</ToggleButton>

				<s14:PopOut
					Background="{DynamicResource ControlBackgroundBrush}"
					IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=ToggleButton}"
					PlacementTarget="{Binding ElementName=ToggleButton}"
					StaysOpen="False"
					Style="{DynamicResource PopOut}">

					<s14:PopOut.Header>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.ColumnSpan="2"
								Margin="6,3,6,6"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding Name}" />

							<s14:NumberBox
								Grid.Row="1"
								Grid.Column="0"
								Value="{Binding Value}" />

							<TextBox
								Grid.Row="1"
								Grid.Column="1"
								Width="64"
								IsReadOnly="True"
								Text="{Binding Selected.Hex}" />
						</Grid>
					</s14:PopOut.Header>


					<Grid>
						<ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="8" />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<Rectangle
										Width="20"
										Height="20"
										Margin="0">
										<Rectangle.Fill>
											<SolidColorBrush Color="{Binding Color, FallbackValue=Transparent}" />
										</Rectangle.Fill>
									</Rectangle>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

				</s14:PopOut>

				<s14:NumberBox
					Grid.Column="1"
					Margin="0"
					Maximum="255"
					Minimum="0"
					Value="{Binding Value}" />

			</Grid>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
