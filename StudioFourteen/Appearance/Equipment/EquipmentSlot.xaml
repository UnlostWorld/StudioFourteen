<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:libraryData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:librarySelector="clr-namespace:StudioFourteen.Library.Selector"
	xmlns:librarymenu="clr-namespace:StudioFourteen.Library.LibraryMenu"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Equipment">

	<DataTemplate DataType="{x:Type local:EquipmentSlotViewModel}">
		<Border
			Margin="0,1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<librarySelector:LibrarySelectorButton
					Grid.Column="0"
					Background="Transparent"
					PopOutHeader="{Binding SearchTitle}"
					SearchTags="{Binding SearchTags}"
					Type="{Binding LibraryType}"
					Value="{Binding Item}">

					<librarySelector:LibrarySelectorButton.ToolTipHeader>
						<TextBlock
							Margin="6"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding SlotName}" />
					</librarySelector:LibrarySelectorButton.ToolTipHeader>

					<librarySelector:LibrarySelectorButton.IconBackground>
						<Grid>
							<controls:XivTexImage
								Margin="0"
								Opacity="0.5"
								Path="ui/uld/icona_frame_hr1.tex"
								Rect="0, 192, 96, 96" />

							<controls:XivTexImage
								Margin="6"
								Path="ui/uld/character_hr1.tex"
								Rect="{Binding SlotBackgroundRect}" />
						</Grid>
					</librarySelector:LibrarySelectorButton.IconBackground>

					<librarySelector:LibrarySelectorButton.PopOutBackgroundDetail>
						<controls:XivTexImage
							Width="100"
							Height="100"
							Margin="0,-12,-12,0"
							Opacity="0.5"
							Path="ui/uld/character_hr1.tex"
							Rect="{Binding SlotBackgroundRect}">
							<controls:XivTexImage.LayoutTransform>
								<RotateTransform Angle="15" />
							</controls:XivTexImage.LayoutTransform>
						</controls:XivTexImage>
					</librarySelector:LibrarySelectorButton.PopOutBackgroundDetail>

					<librarySelector:LibrarySelectorButton.PopOutFooter>
						<Border
							Margin="3"
							Style="{DynamicResource WpfUtilsControlBorder}">
							<StackPanel Orientation="Vertical">
								<ToggleButton
									Height="44"
									HorizontalContentAlignment="Stretch"
									Background="Transparent"
									IsChecked="{Binding IsNone}"
									Style="{DynamicResource WpfUtilsIconToggleButton}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>

										<Viewbox
											Width="38"
											Height="38">
											<Grid
												Width="48"
												Height="48">
												<controls:XivTexImage
													x:Name="IconBack"
													Margin="0,0,0,0"
													Opacity="0.5"
													Path="ui/uld/icona_frame_hr1.tex"
													Rect="0, 192, 96, 96"
													Visibility="Collapsed" />

												<controls:XivIconImage
													Margin="4,3,3,5"
													Id="042422" />

												<controls:XivTexImage
													x:Name="IconShine"
													Path="ui/uld/icona_frame_hr1.tex"
													Rect="0, 0, 96, 96" />
											</Grid>
										</Viewbox>

										<Grid
											Grid.Column="1"
											VerticalAlignment="Center">
											<Grid.RowDefinitions>
												<RowDefinition />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<TextBlock
												Grid.Row="0"
												VerticalAlignment="Center"
												Text="None" />

											<TextBlock
												Grid.Row="1"
												VerticalAlignment="Center"
												Foreground="{DynamicResource ForegroundLightBrush}"
												Text="Nothing" />
										</Grid>
									</Grid>
								</ToggleButton>
							</StackPanel>
						</Border>
					</librarySelector:LibrarySelectorButton.PopOutFooter>

				</librarySelector:LibrarySelectorButton>

				<librarySelector:LibrarySelectorButton
					Grid.Column="1"
					Margin="-2,0"
					Background="Transparent"
					PopOutHeader="{Binding DyeSearchTitle}"
					Style="{DynamicResource LibrarySelectorIconOnly}"
					Type="{x:Type libraryData:StainLibraryEntry}"
					Value="{Binding Stain0}">
					<librarySelector:LibrarySelectorButton.ToolTipHeader>
						<TextBlock
							Margin="6"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding SlotName}" />
					</librarySelector:LibrarySelectorButton.ToolTipHeader>
				</librarySelector:LibrarySelectorButton>

				<librarySelector:LibrarySelectorButton
					Grid.Column="2"
					Margin="-2,0,0,0"
					Background="Transparent"
					PopOutHeader="{Binding DyeSearchTitle}"
					Style="{DynamicResource LibrarySelectorIconOnly}"
					Type="{x:Type libraryData:StainLibraryEntry}"
					Value="{Binding Stain1}">
					<librarySelector:LibrarySelectorButton.ToolTipHeader>
						<TextBlock
							Margin="6"
							Foreground="{DynamicResource ForegroundLightBrush}"
							Text="{Binding SlotName}" />
					</librarySelector:LibrarySelectorButton.ToolTipHeader>
				</librarySelector:LibrarySelectorButton>
			</Grid>
		</Border>
	</DataTemplate>

</ResourceDictionary>