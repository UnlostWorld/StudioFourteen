<mvm:View
	x:Class="StudioFourteen.Appearance.Equipment.EquipmentView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Appearance.Equipment"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mvm="clr-namespace:StudioFourteen.Mvm"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	mc:Ignorable="d">

	<Grid>

		<Grid.Resources>
			<Style
				x:Key="IconButton"
				BasedOn="{StaticResource WpfUtilsButton}"
				TargetType="{x:Type Button}">

				<Setter Property="Height" Value="54" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Button}">
							<Grid TextBlock.Foreground="{DynamicResource ForegroundLightBrush}">

								<Grid>

									<Border
										x:Name="HoverBackground"
										CornerRadius="4"
										Opacity="0"
										Style="{DynamicResource WpfUtilsControlHoverBorder}" />

									<Grid
										x:Name="IconHost"
										Margin="2,3,2,1">
										<Image
											Margin="4,3,4,5"
											SnapsToDevicePixels="True"
											Source="{TemplateBinding Content}" />

										<controls:XivTexImage
											x:Name="IconShine"
											Path="ui/uld/icona_frame_hr1.tex"
											Rect="0, 0, 96, 96"
											SnapsToDevicePixels="True" />
									</Grid>
								</Grid>

							</Grid>

							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="true">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="HoverBackground"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="0:0:0.150">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation
													Storyboard.TargetName="HoverBackground"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="0:0:0.250">
													<DoubleAnimation.EasingFunction>
														<SineEase EasingMode="EaseIn" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="Content" Value="{x:Null}">
									<Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
									<Setter TargetName="HoverBackground" Property="Visibility" Value="Visible" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Grid.Resources>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border
				Grid.RowSpan="4"
				Grid.ColumnSpan="2"
				Margin="1"
				Style="{DynamicResource WpfUtilsControlBorder}" />

			<controls:XivTexImage
				x:Name="BackgroundIcon"
				Grid.Row="1"
				Grid.RowSpan="2"
				Grid.Column="0"
				Width="48"
				Height="48"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Opacity="0.75"
				Path="ui/uld/character_hr1.tex"
				Rect="0, 144, 64, 64" />

			<Button
				Grid.Row="1"
				Grid.RowSpan="2"
				Grid.Column="0"
				Margin="1,-2,0,1"
				HorizontalAlignment="Stretch"
				Background="Transparent"
				Click="OnChangeClicked"
				Content="{Binding Item.Item.Icon.Source}"
				MouseUp="OnMouseUp"
				Style="{DynamicResource IconButton}"
				ToolTip="{Binding Item}" />

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="6,4,2,2"
				Style="{DynamicResource LeftLabel}"
				Text="{Binding Item.Item.Name}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />

			<wpfUtils:MultiNumberBox
				Grid.Row="1"
				Grid.Column="1"
				HorizontalContentAlignment="Center"
				Background="Transparent"
				X="{Binding Item.Set}"
				Y="{Binding Item.Base}"
				Z="{Binding Item.Variant}" />

			<StackPanel
				Grid.Row="2"
				Grid.Column="1"
				Orientation="Horizontal">
				<Button
					Height="30"
					Padding="4"
					Background="Transparent"
					Click="OnChangeDye1Clicked"
					ToolTip="{Binding Item.Stain0}">

					<Border
						Width="22"
						Height="22"
						BorderBrush="{DynamicResource BackgroundBrush}"
						BorderThickness="1"
						CornerRadius="3">

						<Border.Background>
							<ImageBrush ImageSource="{Binding Item.Stain0.Item.Icon.Source}" />
						</Border.Background>
					</Border>
				</Button>

				<Button
					Height="30"
					Padding="4"
					Background="Transparent"
					Click="OnChangeDye2Clicked"
					ToolTip="{Binding Item.Stain1}">

					<Border
						Width="22"
						Height="22"
						BorderBrush="{DynamicResource BackgroundBrush}"
						BorderThickness="1"
						CornerRadius="3">

						<Border.Background>
							<ImageBrush ImageSource="{Binding Item.Stain1.Item.Icon.Source}" />
						</Border.Background>
					</Border>
				</Button>
			</StackPanel>
		</Grid>
	</Grid>
</mvm:View>
