<panels:CharacterPanelBase
	x:Class="StudioFourteen.Appearance.CharacterPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Appearance"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Character}"
	Width="650"
	Height="600"
	ResizeMode="NoResize"
	Subtitle="{Binding CharacterName}"
	TitleIcon="UserShield"
	mc:Ignorable="d">
	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TabControl Grid.Row="0">
			<TabItem Header="{DynamicResource LOC_Character_Customize}">
				<local:CustomizeView Panel="{Binding RelativeSource={RelativeSource AncestorType=panels:CharacterPanelBase}}" />
			</TabItem>

			<TabItem Header="{DynamicResource LOC_Character_Gear}">
				<local:GearView Panel="{Binding RelativeSource={RelativeSource AncestorType=panels:CharacterPanelBase}}" />
			</TabItem>
		</TabControl>

		<Border
			Grid.Row="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Background="Transparent"
					Click="OnRevertClicked"
					IsEnabled="{Binding CanRevert}"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnImportClicked">
					<TextBlock Text="Import" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnExportClicked"
					ToolTip="{Binding ExportAppearanceToolTipText}">
					<TextBlock Text="Export" />
				</Button>

			</StackPanel>
		</Border>
	</Grid>
</panels:CharacterPanelBase>
