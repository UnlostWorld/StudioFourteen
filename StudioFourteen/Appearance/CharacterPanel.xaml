<panels:CharacterPanelBase
	x:Class="StudioFourteen.Appearance.CharacterPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:customize="clr-namespace:StudioFourteen.Appearance.Customize"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:equipment="clr-namespace:StudioFourteen.Appearance.Equipment"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:local="clr-namespace:StudioFourteen.Appearance"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	Title="{DynamicResource LOC_Character}"
	Width="350"
	Height="600"
	MinWidth="350"
	MinHeight="250"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="CanResizeWithGrip"
	Subtitle="{Binding CharacterName}"
	TitleIcon="{DynamicResource ICON_Title_Character}"
	mc:Ignorable="d">

	<Grid x:Name="ContentArea" IsEnabled="{Binding HasValidTarget}">

		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="Customize/ExcelLibraryEntryMenu.xaml" />
					<ResourceDictionary Source="Customize/ColorMenu.xaml" />
					<ResourceDictionary Source="Customize/SelectorMenu.xaml" />
					<ResourceDictionary Source="Customize/IconMenu.xaml" />
					<ResourceDictionary Source="Customize/DoubleColorMenu.xaml" />
					<ResourceDictionary Source="Customize/MultiIconMenu.xaml" />
					<ResourceDictionary Source="Customize/PercentageMenu.xaml" />
					<ResourceDictionary Source="Customize/ListMenu.xaml" />
					<ResourceDictionary Source="Customize/CustomizeLibraryEntryMenu.xaml" />
					<ResourceDictionary Source="Customize/ToggleMenu.xaml" />
					<ResourceDictionary Source="Customize/GenderMenu.xaml" />

					<ResourceDictionary Source="Equipment/WeaponSlot.xaml" />
					<ResourceDictionary Source="Equipment/EquipmentSlot.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="{Binding UseTwoColumns, Converter={StaticResource ColumnVisibility}, ConverterParameter=*}" />
		</Grid.ColumnDefinitions>

		<TabControl
			Grid.Row="0"
			Grid.Column="0"
			SelectedIndex="{Binding SelectedTab}"
			Style="{DynamicResource WpfUtilsSideTabs}">

			<!--  Body  -->
			<TabItem Header="{DynamicResource ICON_Pose_Body}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Customize.BodyMenus}" />
				</ScrollViewer>
			</TabItem>

			<!--  Face  -->
			<TabItem Header="{DynamicResource ICON_Pose_Face}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Customize.HeadMenus}" />
				</ScrollViewer>
			</TabItem>

			<!--  Makeup  -->
			<TabItem Header="{DynamicResource ICON_Character_Makeup}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Customize.MakeupMenus}" />
				</ScrollViewer>
			</TabItem>

			<!--  Equipment  -->
			<TabItem Header="{DynamicResource ICON_Character_Gear}"
				Visibility="{Binding UseTwoColumns, Converter={StaticResource !B2V}}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<TextBlock Style="{DynamicResource LeftLabel}" Text="Weapons" />
						<ItemsControl ItemsSource="{Binding Equipment.Weapons}" />

						<TextBlock Style="{DynamicResource LeftLabel}" Text="Equipment" />
						<ItemsControl ItemsSource="{Binding Equipment.Equipment}" />

						<TextBlock Style="{DynamicResource LeftLabel}" Text="Accessories" />
						<ItemsControl ItemsSource="{Binding Equipment.Accessories}" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>

		</TabControl>

		<Grid
			Grid.Column="1"
			Margin="2,0,0,0"
			Visibility="{Binding UseTwoColumns, Converter={StaticResource B2V}, FallbackValue=Collapsed}">

			<!--  Equipment  -->
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<StackPanel>
					<TextBlock Style="{DynamicResource LeftLabel}" Text="Weapons" />
					<ItemsControl ItemsSource="{Binding Equipment.Weapons}" />

					<TextBlock Style="{DynamicResource LeftLabel}" Text="Equipment" />
					<ItemsControl ItemsSource="{Binding Equipment.Equipment}" />

					<TextBlock Style="{DynamicResource LeftLabel}" Text="Accessories" />
					<ItemsControl ItemsSource="{Binding Equipment.Accessories}" />
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="0,2,0,0"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

				<Button
					Background="Transparent"
					Click="OnRevertClicked"
					Content="{DynamicResource ICON_Reset}"
					IsEnabled="{Binding CanRevert}"
					ToolTip="{DynamicResource LOC_Revert}" />

				<Button
					Width="75"
					Background="Transparent"
					Click="OnImportClicked">
					<TextBlock Text="Import" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnExportClicked"
					ToolTip="{Binding ExportAppearanceToolTipText}">
					<TextBlock Text="Export" />
				</Button>

			</StackPanel>
		</Border>
	</Grid>
</panels:CharacterPanelBase>