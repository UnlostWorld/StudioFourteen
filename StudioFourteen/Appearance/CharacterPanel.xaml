<panels:CharacterPanelBase
	x:Class="StudioFourteen.Appearance.CharacterPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:StudioFourteen.Appearance"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Character}"
	Width="680"
	Height="600"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="NoResize"
	Subtitle="{Binding CharacterName}"
	TitleIcon="UserShield"
	mc:Ignorable="d">

	<Grid IsEnabled="{Binding IsTargetLoading, Converter={StaticResource !B}}">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TabControl Grid.Row="0">
			<TabItem Header="{DynamicResource LOC_Character_Customize}">
				<local:CustomizeView />
			</TabItem>

			<TabItem Header="{DynamicResource LOC_Character_Gear}">
				<local:GearView />
			</TabItem>
		</TabControl>

		<Border
			Grid.Row="1"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">

				<TextBlock Text="{Binding IsTargetLoading}" />

				<Button
					Background="Transparent"
					Click="OnRevertClicked"
					IsEnabled="{Binding CanRevert}"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnImportClicked">
					<TextBlock Text="Import" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnExportClicked"
					ToolTip="{Binding ExportAppearanceToolTipText}">
					<TextBlock Text="Export" />
				</Button>

			</StackPanel>
		</Border>

		<ProgressBar
			Grid.RowSpan="2"
			Opacity="0.5">

			<ProgressBar.Style>
				<Style
					BasedOn="{StaticResource Spinner}"
					TargetType="{x:Type ProgressBar}">
					<Style.Triggers>
						<DataTrigger
							Binding="{Binding IsTargetLoading}"
							Value="True">

							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											From="0"
											To="1"
											Duration="0:00:00.250" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>

							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:00:00.500" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>

						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ProgressBar.Style>
		</ProgressBar>

	</Grid>
</panels:CharacterPanelBase>
