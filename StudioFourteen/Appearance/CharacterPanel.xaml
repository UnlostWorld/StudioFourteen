<panels:CharacterPanelBase
	x:Class="StudioFourteen.Appearance.CharacterPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:customize="clr-namespace:StudioFourteen.Appearance.Customize"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:equipment="clr-namespace:StudioFourteen.Appearance.Equipment"
	xmlns:gameData="clr-namespace:StudioFourteen.GameData.Library"
	xmlns:library="clr-namespace:StudioFourteen.Library"
	xmlns:local="clr-namespace:StudioFourteen.Appearance"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Character}"
	Width="350"
	Height="600"
	MinWidth="350"
	MinHeight="600"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="CanResizeWithGrip"
	Subtitle="{Binding CharacterName}"
	TitleIcon="UserShield"
	mc:Ignorable="d">

	<Grid IsEnabled="{Binding HasValidTarget}">

		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="Customize/ExcelLibraryEntryMenu.xaml" />
					<ResourceDictionary Source="Customize/ColorMenu.xaml" />
					<ResourceDictionary Source="Customize/SelectorMenu.xaml" />
					<ResourceDictionary Source="Customize/IconMenu.xaml" />
					<ResourceDictionary Source="Customize/DoubleColorMenu.xaml" />
					<ResourceDictionary Source="Customize/MultiColorMenu.xaml" />
					<ResourceDictionary Source="Customize/PercentageMenu.xaml" />
					<ResourceDictionary Source="Customize/ListMenu.xaml" />
					<ResourceDictionary Source="Customize/CustomizeLibraryEntryMenu.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TabControl
			Grid.Row="0"
			Grid.Column="0"
			SelectedIndex="{Binding SelectedTab}"
			Style="{DynamicResource WpfUtilsSideTabs}">

			<!--  Body  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Person" />
				</TabItem.Header>

				<ItemsControl ItemsSource="{Binding Customize.BodyMenus}" />
			</TabItem>

			<!--  Face  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="FaceSmile"
						IconFont="Solid" />
				</TabItem.Header>

				<ItemsControl ItemsSource="{Binding Customize.HeadMenus}" />
			</TabItem>

			<!--  Makeup  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="PaintBrush"
						IconFont="Solid" />
				</TabItem.Header>

				<ItemsControl ItemsSource="{Binding Customize.MakeupMenus}" />
			</TabItem>

			<!--  Equipment  -->
			<TabItem Visibility="{Binding UseTwoColumns, Converter={StaticResource !B2V}}">
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Shirt"
						IconFont="Solid" />
				</TabItem.Header>

				<UniformGrid
					VerticalAlignment="Top"
					Columns="2">
					<equipment:EquipmentView Item="{Binding MainHand}" />
					<equipment:EquipmentView Item="{Binding OffHand}" />
					<equipment:EquipmentView Item="{Binding Head}" />
					<equipment:EquipmentView Item="{Binding Earring}" />
					<equipment:EquipmentView Item="{Binding Chest}" />
					<equipment:EquipmentView Item="{Binding Necklace}" />
					<equipment:EquipmentView Item="{Binding Hands}" />
					<equipment:EquipmentView Item="{Binding Bracelet}" />
					<equipment:EquipmentView Item="{Binding Legs}" />
					<equipment:EquipmentView Item="{Binding RingRight}" />
					<equipment:EquipmentView Item="{Binding Feet}" />
					<equipment:EquipmentView Item="{Binding RingLeft}" />

				</UniformGrid>

			</TabItem>

		</TabControl>

		<TabControl
			Grid.Column="1"
			Margin="2,0,0,0"
			Visibility="{Binding UseTwoColumns, Converter={StaticResource B2V}, FallbackValue=Collapsed}">
			<!--  Equipment  -->
			<TabItem>
				<TabItem.Header>
					<wpfUtils:IconBlock
						Margin="12"
						Icon="Shirt"
						IconFont="Solid" />
				</TabItem.Header>

				<UniformGrid
					VerticalAlignment="Top"
					Columns="2">
					<equipment:EquipmentView Item="{Binding MainHand}" />
					<equipment:EquipmentView Item="{Binding OffHand}" />
					<equipment:EquipmentView Item="{Binding Head}" />
					<equipment:EquipmentView Item="{Binding Earring}" />
					<equipment:EquipmentView Item="{Binding Chest}" />
					<equipment:EquipmentView Item="{Binding Necklace}" />
					<equipment:EquipmentView Item="{Binding Hands}" />
					<equipment:EquipmentView Item="{Binding Bracelet}" />
					<equipment:EquipmentView Item="{Binding Legs}" />
					<equipment:EquipmentView Item="{Binding RingRight}" />
					<equipment:EquipmentView Item="{Binding Feet}" />
					<equipment:EquipmentView Item="{Binding RingLeft}" />

				</UniformGrid>

			</TabItem>
		</TabControl>

		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="0,2,0,0"
			Style="{DynamicResource WpfUtilsControlBorder}">
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal">

				<Button
					Background="Transparent"
					Click="OnRevertClicked"
					IsEnabled="{Binding CanRevert}"
					ToolTip="{DynamicResource LOC_Revert}">
					<wpfUtils:IconBlock Icon="Undo" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnImportClicked">
					<TextBlock Text="Import" />
				</Button>

				<Button
					Width="75"
					Background="Transparent"
					Click="OnExportClicked"
					ToolTip="{Binding ExportAppearanceToolTipText}">
					<TextBlock Text="Export" />
				</Button>

			</StackPanel>
		</Border>
	</Grid>
</panels:CharacterPanelBase>
