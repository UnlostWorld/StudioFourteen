<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:svg="https://github.com/dotnetprojects/SVGImage">

	<DataTemplate DataType="{x:Type icons:Svg}">
		<icons:SvgIconView
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center"
			SizeType="SizeToContent"
			UriSource="{Binding UriSource}" />
	</DataTemplate>

	<DataTemplate DataType="{x:Type icons:Fa}">
		<icons:FaIconView Icon="{Binding Icon}" IconFont="{Binding Font}" />
	</DataTemplate>

	<ControlTemplate x:Key="FaIconViewTemplate" TargetType="{x:Type icons:FaIconView}">
		<fa:IconImage
			Foreground="{TemplateBinding Foreground}"
			Icon="{TemplateBinding Icon}"
			IconFont="{TemplateBinding IconFont}" />
	</ControlTemplate>

	<Style TargetType="{x:Type icons:FaIconView}">
		<Setter Property="Template" Value="{StaticResource FaIconViewTemplate}" />
	</Style>

</ResourceDictionary>
