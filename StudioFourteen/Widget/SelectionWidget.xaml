<panels:Panel
	x:Class="StudioFourteen.Widget.SelectionWidget"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:StudioFourteen.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:icons="clr-namespace:StudioFourteen.Icons"
	xmlns:local="clr-namespace:StudioFourteen.Widget"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:silk="clr-namespace:WpfUtils.Silk;assembly=WpfUtils"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	HostStyle="{DynamicResource PanelWidgetStyle}"
	RememberWindowState="False"
	SizeToContent="WidthAndHeight"
	mc:Ignorable="d">

	<Grid Width="256" Height="450">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<silk:AnimationState Binding="{Binding Hide}">
			<silk:AnimationState.Enter>
				<silk:DoubleAnimation
					Delay="200"
					Easing="SineIn"
					Property="Opacity"
					From="1"
					To="0"
					Duration="150" />
			</silk:AnimationState.Enter>

			<silk:AnimationState.Exit>
				<silk:DoubleAnimation
					Delay="200"
					Easing="SineOut"
					Property="Opacity"
					From="0"
					To="1"
					Duration="150" />
			</silk:AnimationState.Exit>
		</silk:AnimationState>

		<Grid
			Grid.Column="0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top">

			<silk:DoubleAnimation
				Key="Opening"
				Easing="SineIn"
				Property="Opacity"
				From="0"
				To="1"
				Duration="100" />

			<silk:DoubleAnimation
				Key="Closing"
				Easing="SineIn"
				Property="Opacity"
				From="1"
				To="0"
				Duration="100" />

			<Border
				Background="Black"
				CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}"
				Opacity="0.5">
				<Border.Effect>
					<DropShadowEffect
						BlurRadius="10"
						Opacity="0.25"
						ShadowDepth="0" />
				</Border.Effect>
			</Border>

			<wpfUtils:SwitchSelector
				Width="28"
				Margin="0"
				ItemsSource="{Binding Gizmos}"
				SelectedValue="{Binding SelectedGizmo}"
				Style="{DynamicResource WpfUtilsSwitchSelectorVertical}">

				<wpfUtils:SwitchSelector.ItemTemplate>
					<DataTemplate>
						<icons:IconView
							Height="20"
							Margin="4"
							Icon="{Binding Icon}" />
					</DataTemplate>
				</wpfUtils:SwitchSelector.ItemTemplate>
			</wpfUtils:SwitchSelector>
		</Grid>

		<Grid
			Grid.Column="1"
			Margin="3,0,0,0"
			VerticalAlignment="Top">

			<silk:AnimationState Binding="{Binding Expanded}">
				<silk:AnimationState.Enter>
					<silk:DoubleAnimation
						Easing="SineIn"
						Property="Opacity"
						From="0"
						To="1"
						Duration="150" />
				</silk:AnimationState.Enter>

				<silk:AnimationState.Exit>
					<silk:DoubleAnimation
						Easing="SineOut"
						Property="Opacity"
						From="1"
						To="0"
						Duration="150" />
				</silk:AnimationState.Exit>

			</silk:AnimationState>

			<Border Background="Black" CornerRadius="{DynamicResource WpfUtilsBorderOuterCornerRadius}">
				<Border.Effect>
					<DropShadowEffect
						BlurRadius="10"
						Opacity="0.25"
						ShadowDepth="0" />
				</Border.Effect>
			</Border>

			<Border Style="{DynamicResource WpfUtilsControlBorder}">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>

					<Border
						Margin="2"
						Background="{DynamicResource BackgroundBrush}"
						CornerRadius="{DynamicResource WpfUtilsBorderInnerCornerRadius}">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<ContentPresenter
								Grid.Column="0"
								Content="{Binding Current}"
								ContentTemplate="{DynamicResource InspectorHeader}" />

							<ToggleButton
								Grid.Column="1"
								Width="30"
								Height="30"
								Margin="3,0,0,0"
								Background="Transparent"
								Content="{DynamicResource ICON_Window_Close}"
								IsChecked="{Binding Expanded, Converter={StaticResource !B}}"
								Style="{DynamicResource WpfUtilsIconToggleButton}" />
						</Grid>
					</Border>

					<Border
						Grid.Row="1"
						Margin="2"
						Background="{DynamicResource BackgroundBrush}"
						CornerRadius="{DynamicResource WpfUtilsBorderInnerCornerRadius}">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled">
							<ContentPresenter Margin="2" Content="{Binding Current}" />
						</ScrollViewer>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</panels:Panel>
