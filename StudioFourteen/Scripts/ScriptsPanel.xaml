<panels:Panel
	x:Class="StudioFourteen.Scripts.ScriptsPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
	xmlns:local="clr-namespace:StudioFourteen.Scripts"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:panels="clr-namespace:StudioFourteen.Panels"
	xmlns:wpfUtils="clr-namespace:WpfUtils.Controls;assembly=WpfUtils"
	Title="{DynamicResource LOC_Scripts}"
	Width="300"
	Height="400"
	MaxHeight="800"
	d:Background="{DynamicResource BackgroundBrush}"
	d:DataContext="{Binding Path=., RelativeSource={RelativeSource Mode=Self}}"
	ResizeMode="CanResizeWithGrip"
	TitleIcon="Robot"
	mc:Ignorable="d">

	<Grid>
		<ItemsControl
			ItemsSource="{Binding Scripts}"
			VirtualizingPanel.ScrollUnit="Pixel">

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Button
						Margin="0"
						Padding="12,0,6,0"
						HorizontalContentAlignment="Stretch"
						Background="Transparent"
						BorderThickness="0"
						Click="OnScriptClicked"
						IsEnabled="{Binding IsRunning, Converter={StaticResource !B}}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="22" />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Foreground="{DynamicResource ForegroundLightBrush}"
								Text="{Binding Name}" />

							<wpfUtils:IconBlock
								Grid.Column="1"
								Icon="CirclePlay"
								Visibility="{Binding IsRunning, Converter={StaticResource B2V}}" />

						</Grid>
					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</Grid>
</panels:Panel>
