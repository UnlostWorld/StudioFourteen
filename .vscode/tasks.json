{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build",
			"command": "msbuild.exe",
			"args": [
				"StudioFourteen.sln",
				"-nologo",
				"-nr:false",
				"-p:platform=x64",
				"-p:configuration=Debug",
				"-Restore",
			],
			"problemMatcher": ["$msCompile"],
			"group": {
			  "kind": "build",
			  "isDefault": true
			},
			"options": {
				"statusbar": {
					"label": "$(file-code) Build",
					"hide": true,
				}
			}
		},

		{
			"label": "Disconnect" ,
			"command": "${command:workbench.action.debug.disconnect}",
		},
		{
			"label": "Restart",
			"command": "${command:workbench.action.debug.start}",
			"dependsOn": ["Disconnect"],
			"options": {
				"statusbar": {
					"label": "$(debug-rerun) Run",
					"hide": false,
				}
			}
		},
	]
}