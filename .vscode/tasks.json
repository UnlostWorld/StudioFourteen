{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build",
			"command": "msbuild.exe",
			"args": [
				"StudioFourteen.sln",
				"-nologo",
				"-nr:false",
				"-p:platform=x64",
				"-p:configuration=Debug",
				"-Restore",
				"/consoleloggerparameters:'ForceNoAlign;NoSummary'",
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"statusbar": {
					"label": "$(beaker)"
				}
			}
		},
	]
}