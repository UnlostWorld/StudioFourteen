{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build",
			"command": "msbuild.exe",
			"args": [
				"StudioFourteen.sln",
				"-nologo",
				"-nr:false",
				"-p:platform=x64",
				"-p:configuration=Debug",
				"-Restore",
				"/p:DefineConstants='BUILD DALAMUD'",
				"/consoleloggerparameters:'ForceNoAlign;NoSummary'",
				"/verbosity:quiet"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"statusbar": {
					"label": "$(beaker)"
				}
			},
			"presentation": {
				// Hey did you know VSCode will just keep expanding the terminal until it
				// runs out of memory if you do lots of builds? 🙃
                "clear": true
            }
		},
	]
}